<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      mc:Ignorable="d"
      Title="SettingsPage"
      Scrollable="False">
    <controls:SectionHost x:Name="Host" Header="Settings" Layout="Rail">
        <controls:SectionItem Label="Roblox version" TabLabel="Version" PageType="{x:Type pages:RobloxVersionsPage}" />
        <controls:SectionItem Label="Channel and downloads" TabParent="{x:Type pages:RobloxVersionsPage}" PageType="{x:Type pages:ChannelPage}" />
        <controls:SectionItem Label="Classic client" TabParent="{x:Type pages:RobloxVersionsPage}" PageType="{x:Type pages:ClassicClientPage}" />
        <controls:SectionItem Label="Deployment" PageType="{x:Type pages:BehaviourPage}" />
        <controls:SectionItem Label="Mods" PageType="{x:Type pages:ModsPage}" />
        <controls:SectionItem Label="Extensions" TabParent="{x:Type pages:ModsPage}" PageType="{x:Type pages:ExtensionsPage}" />
        <controls:SectionItem Label="Appearance" PageType="{x:Type pages:AppearancePage}" />
        <controls:SectionItem Label="Launcher window" TabParent="{x:Type pages:AppearancePage}" PageType="{x:Type pages:BootstrapperStylePage}" />
        <controls:SectionItem Label="Notifications" PageType="{x:Type pages:NotificationsPage}" />
        <controls:SectionItem Label="Hotkeys" PageType="{x:Type pages:HotkeysPage}" />
        <controls:SectionItem Label="Shortcuts" TabParent="{x:Type pages:HotkeysPage}" PageType="{x:Type pages:ShortcutsPage}" />
        <controls:SectionItem Label="Account and backup" PageType="{x:Type pages:PhasmaStrapPage}" />
        <controls:SectionItem Label="Integrations" PageType="{x:Type pages:IntegrationsPage}" />
        <controls:SectionItem Label="Game chat" TabParent="{x:Type pages:IntegrationsPage}" PageType="{x:Type pages:GameChatPage}" />
        <controls:SectionItem Label="Developer" TabLabel="Developer tools" PageType="{x:Type pages:DeveloperToolsPage}" />
        <controls:SectionItem Label="Diagnostics" TabParent="{x:Type pages:DeveloperToolsPage}" PageType="{x:Type pages:DiagnosticsPage}" />
        <controls:SectionItem Label="News" TabParent="{x:Type pages:DeveloperToolsPage}" PageType="{x:Type pages:ReleasesPage}" />
    </controls:SectionHost>
</ui:UiPage>
