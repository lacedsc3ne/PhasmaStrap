<UserControl
    x:Class="PhasmaStrap.UI.Elements.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Focusable="False">

    <!--  The header at the top of a page: a small section label, the title, a one line description and optional buttons on the right.  -->
    <StackPanel>
    <Border
        x:Name="Card" Margin="0,0,0,22"
        Padding="24,20,24,20"
        BorderBrush="{DynamicResource PhasmaStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}"
        ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource SolidBackgroundFillColorTertiary}" Offset="0" />
                <GradientStop Color="{DynamicResource SolidBackgroundFillColorBase}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="EyebrowText"
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PhasmaAccentBrush}" />
                    <TextBlock x:Name="TitleText" FontSize="26" Style="{DynamicResource PhasmaHeading}" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,6,0,0"
                        FontSize="14.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ContentPresenter x:Name="ActionsPresenter" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
        <Border x:Name="TabLine" Margin="0,0,0,22" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
        </Border>
    </StackPanel>
</UserControl>
