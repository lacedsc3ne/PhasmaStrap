<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ServerBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ServerBrowserViewModel, IsDesignTimeCreatable=True}"
      Title="ServerBrowserPage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <!--  Thin fill bar for how full a server is  -->
        <Style x:Key="FillBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource PhasmaSelectedBrush}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource PhasmaAccentBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Ping coloured by how good it is  -->
        <Style x:Key="PingText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PingTone}" Value="good">
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingTone}" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingTone}" Value="bad">
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaBadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:UiPage.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,14">
            <controls:PageHeader Eyebrow="Games" Title="Server browser" Subtitle="Join the server with the best ping instead of the one Roblox picks.">
                <StackPanel Orientation="Horizontal">
                    <Button Height="34" Padding="14,0" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Menu_ServerBrowser_Search}"
                            Command="{Binding SearchCommand, Mode=OneTime}" />
                    <Button Margin="8,0,0,0" Height="34" Padding="14,0" Style="{DynamicResource PhasmaAccentButton}"
                            IsEnabled="{Binding HasPingedServers, Mode=OneWay}"
                            Command="{Binding JoinFastestCommand, Mode=OneTime}"
                            ToolTip="{x:Static resources:Strings.Menu_ServerBrowser_JoinsWhicheverServerAboveReportedLowest}"
                            Content="{x:Static resources:Strings.Menu_ServerBrowser_JoinFastest}" />
                </StackPanel>
            </controls:PageHeader>

            <!--  Which place to look at  -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Width="260" VerticalAlignment="Center" PlaceholderText="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_PlaceholderText}"
                            Text="{Binding PlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_Title}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand, Mode=OneTime}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource PhasmaSelectedBrush}" Visibility="{Binding HasGameIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding GameIconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Text="{Binding HeaderTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding HeaderDetail, Mode=OneWay}" ToolTip="{Binding StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!--  Public servers  -->
            <Border Style="{DynamicResource PhasmaPanel}">
                <StackPanel>
                    <Grid Margin="20,0" Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SERVER" Style="{DynamicResource PhasmaTableHead}" />
                        <TextBlock Grid.Column="1" Text="REGION" Style="{DynamicResource PhasmaTableHead}" />
                        <TextBlock Grid.Column="2" Text="PLAYERS" Style="{DynamicResource PhasmaTableHead}" />
                        <TextBlock Grid.Column="3" Text="PING" Style="{DynamicResource PhasmaTableHead}" />
                    </Grid>

                    <ItemsControl x:Name="ServerList" ItemsSource="{Binding Servers, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource PhasmaTableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding ShortJobId}" FontFamily="{DynamicResource PhasmaMono}" FontSize="13" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding JobId}" />
                                        <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding City}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Region}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ProgressBar Width="110" Style="{DynamicResource PhasmaMiniBar}" Maximum="{Binding MaxPlayers}" Value="{Binding Playing, Mode=OneWay}" />
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding PlayersText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="3" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource PhasmaTag}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PingTone}" Value="good">
                                                            <Setter Property="Background" Value="#1F3DDC97" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PhasmaGoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PingTone}" Value="warn">
                                                            <Setter Property="Background" Value="#1FF5B841" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PingTone}" Value="bad">
                                                            <Setter Property="Background" Value="#1FFF6A64" />
                                                            <Setter Property="TextElement.Foreground" Value="#FF6A64" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PingText}" />
                                        </Border>
                                        <Button Grid.Column="4" Height="28" HorizontalAlignment="Right" Padding="12,0" Style="{DynamicResource PhasmaSoftButton}" FontSize="13"
                                                Content="{x:Static resources:Strings.Menu_ServerBrowser_Join}"
                                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Margin="4,12,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Uses the game's own public server list. It does not sign in, read your session, or measure real ping to any server. For a measured pick, turn on the Matchmaker in Deployment settings." />
        </StackPanel>
    </ScrollViewer>
</ui:UiPage>
