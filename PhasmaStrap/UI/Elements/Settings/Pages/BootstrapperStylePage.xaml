<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.BootstrapperStylePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="800"
      Title="BootstrapperStylePage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>

    <!--  The loading window's look. Split out of Appearance to match the settings rail; it shares Appearance's view model.  -->
    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="{x:Static resources:Strings.Menu_Appearance_Bootstrapper_Title}" />
            <Border Margin="10,2,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                <TextBlock Text="Look and feel" />
            </Border>
        </StackPanel>
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="The window you see while Roblox loads." />

        <!--  The loading window: a small mock of it, and a button that shows the real one  -->
        <Border Margin="0,0,0,12" Padding="16" Style="{DynamicResource PhasmaCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="240" Height="120" Margin="0,0,18,0" CornerRadius="{DynamicResource PhasmaCornerRadius}" ClipToBounds="True" BorderThickness="1"
                        BorderBrush="{DynamicResource PhasmaStrokeBrush}" Background="{DynamicResource PhasmaPopupBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="36" Height="36" HorizontalAlignment="Center" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{DynamicResource PhasmaAccentBrush}">
                            <ui:SymbolIcon Symbol="Rocket24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                        </Border>
                        <Border Width="104" Height="6" Margin="0,14,0,0" HorizontalAlignment="Center" CornerRadius="3" Background="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Width="168" Height="5" Margin="0,12,0,0" HorizontalAlignment="Center" CornerRadius="3" Background="{DynamicResource PhasmaSelectedBrush}">
                            <Border Width="104" Height="5" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource PhasmaAccentBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="The window you see while Roblox loads" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Appearance_Bootstrapper_Description}" />
                    <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PreviewBootstrapperCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_Preview}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <controls:CardColumns>
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Appearance_Style_Title}"
                                   Description="Dark theme does not apply to Legacy and Vista">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Style_Title}">
                    <ComboBox MinWidth="140" Padding="10,5,10,5" ItemsSource="{Binding Dialogs, Mode=OneTime}" Text="{Binding Dialog, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <!--  Custom themes only matter for the custom dialog style  -->
                <StackPanel Visibility="{Binding CustomThemesExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <Grid Margin="2,10,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="Custom themes" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Your own layouts" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource PhasmaSoftButton}" Command="{Binding AddCustomThemeCommand, Mode=OneTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_New}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource PhasmaBadBrush}" IsEnabled="{Binding IsCustomThemeSelected, Mode=OneWay}" Command="{Binding DeleteCustomThemeCommand, Mode=OneTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Delete}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="CustomThemesListBox" MaxHeight="200" MinHeight="60" Margin="0,0,0,10" ItemsSource="{Binding CustomThemes, Mode=OneWay}" SelectionChanged="CustomThemeSelection" SelectedIndex="{Binding SelectedCustomThemeIndex, Mode=TwoWay}" />

                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="False">
                                        <Setter Property="StackPanel.Visibility" Value="Collapsed"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock FontSize="12" Text="{x:Static resources:Strings.Common_Name}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBox Margin="0,4,0,0" Text="{Binding SelectedCustomThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,6,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding RenameCustomThemeCommand, Mode=OneTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Rename24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Rename}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,6,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditCustomThemeCommand, Mode=OneTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DesktopEdit24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Edit}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ExportCustomThemeCommand, Mode=OneTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowExportRtl24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Export}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Margin="2,0,2,12" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Appearance_CustomThemes_NoneSelected}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="True">
                                        <Setter Property="TextBlock.Visibility" Value="Collapsed"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="IconSelector" Header="Icon and title">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Icon_Title}">
                    <ComboBox MinWidth="150" Padding="10,5,10,5" ItemsSource="{Binding Icons, Mode=OneWay}" SelectedValuePath="IconType" SelectedValue="{Binding Icon, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Height="16" Source="{Binding ImageSource, Mode=OneWay}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_CustomisationTitle_Title}" Description="Text at the top of the window">
                    <ui:TextBox Width="150" Text="{Binding Title, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_CustomisationIcon_Title}" Description="A multi size .ico, 16 to 128 px. Set Icon to Custom to use it.">
                    <Button Style="{DynamicResource PhasmaSoftButton}" Command="{Binding BrowseCustomIconLocationCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Common_Browse}" />
                        </StackPanel>
                    </Button>
                </controls:OptionControl>

                <ui:TextBox Margin="0,0,0,12" PlaceholderText="Path to an .ico file" Text="{Binding CustomIconLocation, Mode=TwoWay}" />
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
