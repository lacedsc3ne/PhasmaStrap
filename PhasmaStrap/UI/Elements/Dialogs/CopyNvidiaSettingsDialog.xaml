<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.CopyNvidiaSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_CopyNvidiaSettings_Title}"
        Width="440"
        MinHeight="0"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" />
        <TextBlock Grid.Row="0" Margin="20,0,60,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" TextTrimming="CharacterEllipsis"
                   FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="15" FontWeight="Bold" Foreground="White"
                   Text="{Binding Source={x:Static resources:Strings.Dialog_CopyNvidiaSettings_Title}, Converter={StaticResource PhasmaUpper}}" />
        <ui:TitleBar Grid.Row="0" Height="52" MinHeight="52" Padding="0" Title="" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />

        <StackPanel Grid.Row="1" Margin="20,18,20,20">
            <TextBlock x:Name="CountText" Margin="0,0,0,16" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,0,0,6" Style="{StaticResource PhasmaCaption}" Text="FORMAT" />
            <ComboBox x:Name="FormatBox" MinWidth="200" HorizontalAlignment="Left" SelectedIndex="0" />
        </StackPanel>

        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="80" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" Click="Cancel_Click" Style="{DynamicResource PhasmaSoftButton}" />
                <Button x:Name="CopyButton" MinWidth="80" Margin="8,0,0,0" IsDefault="True" Click="Copy_Click" Style="{DynamicResource PhasmaAccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{x:Static resources:Strings.Common_Copy}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
