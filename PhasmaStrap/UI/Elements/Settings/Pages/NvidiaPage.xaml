<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.NvidiaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="NvidiaPage"
      Scrollable="True"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <ui:UiPage.Resources>
        <!--  Status line under a card that hides itself while empty  -->
        <Style x:Key="StatusLine" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="{x:Static resources:Strings.Menu_Nvidia_Title}" />
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="Applied to a dedicated Roblox driver profile, separate from the game's own FastFlags. Needs an NVIDIA GPU." />

        <!--  No NVIDIA GPU or driver: empty state  -->
        <Border Style="{DynamicResource PhasmaCard}" Padding="20" Visibility="{Binding UnavailableVisibility}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Warning24" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource PhasmaWarnBrush}" />
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Nvidia_Unavailable_Title}" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UnavailableReason}" />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding AvailableVisibility}">
            <!--  Main view  -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NvidiaEditorViewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!--  Driver profile banner with the page actions  -->
                <Border Style="{DynamicResource PhasmaCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{DynamicResource PhasmaAccentSoftBrush}">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding GpuBannerTitle}" />
                            <TextBlock Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Nvidia_ApplyCard_Description}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_Setup_Description}" AutomationProperties.Name="NVIDIA setup" Click="NvidiaSetup_Click">
                                <ui:SymbolIcon Symbol="Info24" FontSize="14" />
                            </Button>
                            <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" ToolTip="{x:Static resources:Strings.Menu_Nvidia_AdvancedEditor_Description}" Click="AdvancedEditor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Code24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Advanced editor" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ApplyButton" Margin="6,0,0,0" Style="{DynamicResource PhasmaAccentButton}" Content="{x:Static resources:Strings.Menu_Nvidia_ApplyButton}" Click="Apply_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:CardColumns>
                    <controls:SettingsCard Header="Game details">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_BackgroundFrameRateLimit_Title}" Description="Only while Roblox is unfocused. 0 is uncapped.">
                            <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="140" Min="0" Max="1000" Value="{Binding BackgroundFrameRateLimit, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_BenchmarkOverlay_Title}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_BenchmarkOverlay_Description}">
                            <ComboBox MinWidth="100" MaxWidth="220" ItemsSource="{Binding BenchmarkOverlayModes, Mode=OneTime}" SelectedItem="{Binding BenchmarkOverlayMode, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_DlssSuperResolution_Title}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_DlssSuperResolution_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding DlssSuperResolution, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_DlssFrameGeneration_Title}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_DlssFrameGeneration_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding DlssFrameGeneration, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Low latency modes">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_LowLatencyMode_Title}" Description="Limits how far ahead the CPU queues frames">
                            <ComboBox MinWidth="100" ItemsSource="{Binding LowLatencyModes, Mode=OneTime}" SelectedItem="{Binding LowLatencyMode, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_FrlLowLatencyMode_Title}" Description="Couples the limiter to low latency pacing">
                            <ComboBox MinWidth="100" ItemsSource="{Binding FrlLowLatencyModes, Mode=OneTime}" SelectedItem="{Binding FrlLowLatencyMode, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Hardware and driver overrides">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_ResizableBar_Title}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_ResizableBar_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding ResizableBar, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_Mfaa_Title}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_Mfaa_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding Mfaa, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_Fxaa_Title}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_Fxaa_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding Fxaa, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_GammaCorrection_Title}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_GammaCorrection_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding GammaCorrection, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_SilkSmoothness_Title}" ToolTip="{x:Static resources:Strings.Menu_Nvidia_SilkSmoothness_Description}">
                            <ComboBox MinWidth="100" ItemsSource="{Binding SilkSmoothnessModes, Mode=OneTime}" SelectedItem="{Binding SilkSmoothness, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Nvidia_TextureLodBias_Title}" Description="{Binding TextureLodBiasLabel}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="120" Minimum="-32" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TextureLodBias, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="24" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TextureLodBias, Mode=OneWay}" />
                            </StackPanel>
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <!--  Raw driver settings by ID  -->
                    <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Nvidia_CustomSettings_Title}" Description="By raw NVIDIA Profile Inspector setting ID, applied with everything else.">
                        <ItemsControl ItemsSource="{Binding CustomSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{DynamicResource PhasmaDivider}" />
                                        <Grid Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding HexId}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Consolas" FontSize="12" Text="{Binding Value}" />
                                            <Button Grid.Column="3" Margin="6,0,0,0" Padding="4" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Common_Delete}" Tag="{Binding}" Click="RemoveCustomSetting_Click">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_CustomSettings_Empty}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomSettings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <WrapPanel Margin="0,4,0,6">
                            <Button Margin="0,0,6,6" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Menu_Nvidia_CustomSettings_AddButton}" Click="AddCustomSetting_Click" />
                            <Button Margin="0,0,6,6" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Nvidia_ExportNipButton}" Click="ExportNip_Click" />
                            <Button Margin="0,0,6,6" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Nvidia_CopySettingsButton}" Click="CopySettings_Click" />
                            <Button Margin="0,0,0,6" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Nvidia_ReloadButton}" Click="Reload_Click" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource StatusLine}" Text="{Binding StatusMessage}" />
                    </controls:SettingsCard>
                </controls:CardColumns>
            </StackPanel>

            <!--  Advanced editor view  -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NvidiaEditorViewMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <controls:SettingsCard Header="Advanced editor" Description="{x:Static resources:Strings.Menu_Nvidia_Editor_Description}">
                    <controls:SettingsCard.HeaderContent>
                        <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Back}" Click="AdvancedEditorBack_Click" />
                    </controls:SettingsCard.HeaderContent>

                    <StackPanel>
                        <WrapPanel>
                            <Button Margin="0,0,6,8" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Menu_FastFlagEditor_AddNew}" Click="AddCustomSetting_Click" />
                            <Button x:Name="DeleteSelectedButton" Margin="0,0,6,8" Content="{x:Static resources:Strings.Menu_FastFlagEditor_DeleteSelected}" Click="DeleteSelectedSettings_Click">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PhasmaGhostButton}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource PhasmaBadBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=NvidiaEditorGrid, Path=SelectedItems.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Margin="0,0,6,8" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Nvidia_Editor_DeleteAll}" Click="DeleteAllSettings_Click" />
                            <Button x:Name="ResetNipButton" Margin="0,0,6,8" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Nvidia_Editor_ResetNip}" Click="ResetNip_Click" />
                            <Button x:Name="ApplyButtonGrid" Margin="0,0,0,8" Style="{DynamicResource PhasmaAccentButton}" Content="{x:Static resources:Strings.Menu_Nvidia_Editor_ApplyButton}" Click="Apply_Click" />
                        </WrapPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="EditorSearchTextBox" Grid.Column="0" Icon="Search32" PlaceholderText="{x:Static resources:Strings.Menu_Nvidia_Editor_Search}" TextChanged="EditorSearchTextBox_TextChanged" />
                            <Border Grid.Column="1" Margin="10,0,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                                <TextBlock FontSize="11" Text="{Binding CustomSettings.Count, StringFormat={x:Static resources:Strings.Menu_Nvidia_Editor_FlagsAdded}}" />
                            </Border>
                            <Border Grid.Column="2" Margin="6,0,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                                <TextBlock FontSize="11" Text="{Binding ElementName=NvidiaEditorGrid, Path=SelectedItems.Count, StringFormat={x:Static resources:Strings.Menu_Nvidia_Editor_Selected}}" />
                            </Border>
                        </Grid>

                        <Grid MinHeight="160">
                            <DataGrid Name="NvidiaEditorGrid" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" IsReadOnly="True" SelectionMode="Extended">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </DataGrid.Style>

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Height" Value="32" />
                                        <Setter Property="Padding" Value="8,0,8,0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                        <Setter Property="Height" Value="32" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}" Padding="6,0,6,0">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.Menu_Nvidia_Editor_Column_Type}" Binding="{Binding Type}" Width="Auto" />
                                    <DataGridTextColumn Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="{x:Static resources:Strings.Menu_Nvidia_Editor_Column_SettingId}" Binding="{Binding HexId}" Width="Auto" />
                                    <DataGridTextColumn Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CustomSettings.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="Flag24" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Margin="0,8,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Nvidia_Editor_EmptyState}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,10,0,10">
                            <Button Margin="0,0,6,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Nvidia_ExportNipButton}" Click="ExportNip_Click" />
                            <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Nvidia_CopySettingsButton}" Click="CopySettings_Click" />
                        </WrapPanel>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Flag history">
                    <controls:SettingsCard.HeaderContent>
                        <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Nvidia_Editor_History_ClearButton}" Click="ClearFlagHistory_Click" />
                    </controls:SettingsCard.HeaderContent>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{x:Static resources:Strings.Menu_Nvidia_Editor_History_Empty}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FlagHistory.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding FlagHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
