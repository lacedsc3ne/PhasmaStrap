<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.AssetWarpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="AssetWarpPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <!--  A check box row inside a card: box on the left, title and a short line under it  -->
        <Style x:Key="BlockRowCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BlockRowNote" TargetType="TextBlock">
            <Setter Property="Margin" Value="30,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="{x:Static resources:Strings.Menu_FastFlagSettings_Tab_AssetWarp}" />
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" MaxWidth="760" HorizontalAlignment="Left"
                   Text="Blocks whole categories of asset from loading in game, for a performance boost. Works by taking blocked asset types out of the request the game makes for them." />

        <controls:OptionControl Margin="0,0,0,12" Header="{x:Static resources:Strings.Menu_AssetWarp_Enabled_Title}" Description="{Binding StatusText, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding AssetWarpEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:CardColumns IsEnabled="{Binding AssetWarpEnabled, Mode=OneWay}">
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_FastFlagSettings_AssetBlocking}" Description="{x:Static resources:Strings.Menu_FastFlagSettings_StripSpecificAssetCategoriesFromDownloading}">
                <StackPanel>
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <StackPanel Margin="2,10,2,10">
                        <CheckBox Style="{StaticResource BlockRowCheck}" Content="{x:Static resources:Strings.Menu_AssetWarp_DisableTextures_Title}"
                                  ToolTip="{x:Static resources:Strings.Menu_AssetWarp_DisableTextures_Description}" IsChecked="{Binding DisableAllTextures, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource BlockRowNote}" Text="Texture and texture pack entries" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <StackPanel Margin="2,10,2,10">
                        <CheckBox Style="{StaticResource BlockRowCheck}" Content="{x:Static resources:Strings.Menu_AssetWarp_DisableDecals_Title}"
                                  ToolTip="{x:Static resources:Strings.Menu_AssetWarp_DisableDecals_Description}" IsChecked="{Binding DisableAllDecals, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <StackPanel Margin="2,10,2,10">
                        <CheckBox Style="{StaticResource BlockRowCheck}" Content="{x:Static resources:Strings.Menu_AssetWarp_DisableImages_Title}"
                                  ToolTip="{x:Static resources:Strings.Menu_AssetWarp_DisableImages_Description}" IsChecked="{Binding DisableAllImages, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <StackPanel Margin="2,10,2,10">
                        <CheckBox Style="{StaticResource BlockRowCheck}" Content="{x:Static resources:Strings.Menu_AssetWarp_DisableAnimations_Title}"
                                  ToolTip="{x:Static resources:Strings.Menu_AssetWarp_DisableAnimations_Description}" IsChecked="{Binding DisableAllAnimations, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource BlockRowNote}" Text="Breaks games with no fallback animation" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <StackPanel Margin="2,10,2,10">
                        <CheckBox Style="{StaticResource BlockRowCheck}" Content="{x:Static resources:Strings.Menu_AssetWarp_DisableMeshes_Title}"
                                  ToolTip="{x:Static resources:Strings.Menu_AssetWarp_DisableMeshes_Description}" IsChecked="{Binding DisableAllMeshes, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource BlockRowNote}" Text="Makes all 3D geometry invisible" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_FastFlagSettings_PreloadBehavior}" Description="Warms the asset cache so games feel quicker">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetWarp_PreloadEnabled_Title}" Description="Repeat lookups skip the network">
                    <ui:ToggleSwitch IsChecked="{Binding PreloadEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetWarp_PreloadCacheLimit_Title}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="110" VerticalAlignment="Center" Minimum="256" Maximum="8192" TickFrequency="256" IsSnapToTickEnabled="True" Value="{Binding PreloadCacheMb, Mode=TwoWay}" />
                        <TextBlock Margin="8,0,0,0" MinWidth="52" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PreloadCacheSizeDisplay, Mode=OneWay}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetWarp_PreloadAvatar_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding PreloadAvatar, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_AssetWarp_PreloadCrossGame_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding PreloadCrossGame, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
