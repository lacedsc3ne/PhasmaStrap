<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:PhasmaStrap.Resources"
             xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="{x:Static resources:Strings.Menu_Title}"
             MinWidth="1000"
             MinHeight="620"
             Width="1240"
             Height="760"
             ExtendsContentIntoTitleBar="True"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed"
             SizeChanged="MainWindow_SizeChanged"
             Loaded="MainWindow_MistLoaded">

    <Window.Resources>
        <BlurEffect x:Key="MistBlurLarge" Radius="70" />

        <Storyboard x:Key="MistDrift" Timeline.DesiredFrameRate="30" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="MistTranslate1" Storyboard.TargetProperty="X" From="-80" To="100" Duration="0:0:14" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MistTranslate1" Storyboard.TargetProperty="Y" From="30" To="-40" Duration="0:0:11" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MistTranslate2" Storyboard.TargetProperty="X" From="90" To="-110" Duration="0:0:16" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MistTranslate2" Storyboard.TargetProperty="Y" From="-40" To="35" Duration="0:0:12.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--  The navigation control laid out as a row of tabs in the top bar. Footer items stay registered but are not drawn.  -->
        <ControlTemplate x:Key="TopNavigation" TargetType="{x:Type ui:NavigationFluent}">
            <Grid>
                <ItemsControl
                    Focusable="False"
                    ItemsSource="{TemplateBinding Items}"
                    KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl Focusable="False" ItemsSource="{TemplateBinding Footer}" Visibility="Collapsed" />
            </Grid>
        </ControlTemplate>

        <Style x:Key="TopTab" TargetType="{x:Type ui:NavigationItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource PhasmaFocusVisual}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:NavigationItem}">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Margin="2,11" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="Transparent" />
                            <ContentPresenter Margin="14,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border
                                x:Name="Underline"
                                Height="2"
                                Margin="12,0"
                                VerticalAlignment="Bottom"
                                CornerRadius="1"
                                Background="{DynamicResource PhasmaAccentBrush}"
                                Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Drifting mist behind everything (Look and feel can turn it off)  -->
        <Canvas Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False" Opacity="{DynamicResource PhasmaMistOpacity}">
            <Ellipse x:Name="Mist1" Width="480" Height="480" Canvas.Left="-160" Canvas.Top="-200" Opacity="0.12" Effect="{StaticResource MistBlurLarge}" Fill="{DynamicResource BackgroundGlowPrimaryBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate1" X="-80" Y="30" />
                </Ellipse.RenderTransform>
                <Ellipse.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#8F000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
            <Ellipse x:Name="Mist2" Width="420" Height="420" Canvas.Left="760" Canvas.Top="260" Opacity="0.15" Effect="{StaticResource MistBlurLarge}" Fill="{DynamicResource BackgroundGlowSecondaryBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="MistTranslate2" X="90" Y="-40" />
                </Ellipse.RenderTransform>
                <Ellipse.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#80000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
        </Canvas>

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Icon="Info20" Timeout="10000" Margin="200,0,200,20" Grid.RowSpan="2" Panel.ZIndex="10" />

        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Appearance="Success" Icon="CheckmarkCircle32" Timeout="3000" Margin="200,0,200,84" Grid.RowSpan="2" Panel.ZIndex="9" />

        <!--  Top bar: brand, page tabs, search, launch, notifications, settings, account  -->
        <ui:TitleBar
            x:Name="RootTitleBar"
            Grid.Row="0"
            Title=""
            MinHeight="56"
            Padding="0"
            ForceShutdown="False"
            MinimizeToTray="False"
            UseSnapLayout="True" />

        <!--  Sits over the title bar. The grid has no background, so its empty space still drags the window.  -->
        <Grid x:Name="TopBar" Grid.Row="0" Margin="16,0,140,0" Panel.ZIndex="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False">
                <Border Width="28" Height="28">
                    <Image Width="20" Height="20" Source="pack://application:,,,/PhasmaStrap.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock x:Name="BrandText" Margin="10,0,4,0" VerticalAlignment="Center" FontSize="14" Text="PhasmaStrap" Style="{DynamicResource PhasmaHeading}" />
            </StackPanel>

            <ui:NavigationFluent
                x:Name="RootNavigation"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                Template="{StaticResource TopNavigation}"
                Frame="{Binding ElementName=RootFrame}"
                SelectedPageIndex="0">
                <ui:NavigationFluent.Items>
                    <ui:NavigationItem Style="{StaticResource TopTab}" Content="Games" PageType="{x:Type pages:HomePage}" Icon="Games24" PageTag="games" />
                    <ui:NavigationItem Style="{StaticResource TopTab}" Content="Social" PageType="{x:Type pages:PeoplePage}" Icon="People24" PageTag="people" />
                    <ui:NavigationItem Style="{StaticResource TopTab}" Content="Performance" PageType="{x:Type pages:PerformancePage}" Icon="Gauge24" PageTag="performance" />
                    <ui:NavigationItem Style="{StaticResource TopTab}" Content="FastFlags" PageType="{x:Type pages:FastFlagSettingsPage}" Icon="Flag24" PageTag="fastflagsettings" />
                    <ui:NavigationItem Style="{StaticResource TopTab}" Content="Capture" PageType="{x:Type pages:CapturePage}" Icon="Camera24" PageTag="capture" />
                </ui:NavigationFluent.Items>
                <ui:NavigationFluent.Footer>
                    <ui:NavigationItem Content="Settings" PageType="{x:Type pages:SettingsPage}" Icon="Settings24" PageTag="settings" />
                </ui:NavigationFluent.Footer>
            </ui:NavigationFluent>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox
                    x:Name="SettingsSearchBox"
                    Width="250"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    PlaceholderText="{x:Static resources:Strings.Menu_Settings_SearchPlaceholder}"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    TextChanged="SettingsSearchBox_TextChanged"
                    PreviewKeyDown="SettingsSearchBox_PreviewKeyDown"
                    GotKeyboardFocus="SettingsSearchBox_GotKeyboardFocus"
                    LostKeyboardFocus="SettingsSearchBox_LostKeyboardFocus" />

                <Border
                    Height="32"
                    Margin="2,0,8,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PhasmaAccentSoftBrush}"
                    BorderBrush="{DynamicResource PhasmaAccentStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="LaunchButton"
                            Padding="11,0,10,0"
                            Click="LaunchButton_Click"
                            Style="{DynamicResource PhasmaSplitPart}"
                            ToolTip="Save your settings and start Roblox">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="12" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Launch" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Margin="0,7" Fill="{DynamicResource PhasmaAccentStrokeBrush}" />
                        <Button
                            x:Name="LaunchMenuButton"
                            Width="26"
                            Padding="0"
                            Click="LaunchMenuButton_Click"
                            Style="{DynamicResource PhasmaSplitPart}"
                            ToolTip="More launch options"
                            AutomationProperties.Name="More launch options">
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Button.ContextMenu>
                            <ContextMenu x:Name="LaunchMenu">
                                <MenuItem Header="{x:Static resources:Strings.Menu_Settings_SaveAndLaunch}" Click="LaunchButton_Click" />
                                <MenuItem x:Name="TestModeMenuItem" Header="{x:Static resources:Strings.Menu_TestMode}" IsCheckable="True" Click="TestModeMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="{x:Static resources:Strings.Menu_Save}" Click="SaveMenuItem_Click" />
                                <MenuItem Header="{x:Static resources:Strings.Menu_Settings_Restart}" Click="RestartMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>

                <Button
                    x:Name="NotificationsButton"
                    Click="NotificationsButton_Click"
                    Style="{DynamicResource PhasmaIconButton}"
                    ToolTip="Notifications"
                    AutomationProperties.Name="Notifications">
                    <Grid>
                        <ui:SymbolIcon Symbol="Alert24" FontSize="18" />
                        <Ellipse
                            x:Name="NotificationsBadge"
                            Width="8"
                            Height="8"
                            Margin="0,-2,-3,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{DynamicResource PhasmaAccentBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button
                    x:Name="SettingsButton"
                    Click="SettingsButton_Click"
                    Style="{DynamicResource PhasmaIconButton}"
                    ToolTip="Settings"
                    AutomationProperties.Name="Settings">
                    <ui:SymbolIcon x:Name="SettingsButtonIcon" Symbol="Settings24" FontSize="18" />
                </Button>

                <Button
                    x:Name="AccountButton"
                    Height="34"
                    Margin="6,0,0,0"
                    Padding="5,0,10,0"
                    Click="AccountButton_Click"
                    Style="{DynamicResource PhasmaSoftButton}"
                    ToolTip="Sign in to PhasmaStrap">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="AccountAvatar" Width="22" Height="22" CornerRadius="11" Visibility="Collapsed" Margin="0,0,7,0">
                            <Border.Background>
                                <ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <ui:SymbolIcon x:Name="AccountIcon" Symbol="Person24" FontSize="15" Margin="4,0,6,0" VerticalAlignment="Center" />
                        <StackPanel x:Name="AccountTextPanel" Orientation="Horizontal">
                            <TextBlock x:Name="AccountLabel" VerticalAlignment="Center" FontSize="12.5" MaxWidth="120" TextTrimming="CharacterEllipsis" Text="Log in" />
                            <ui:SymbolIcon x:Name="AccountChevron" Symbol="ChevronDown24" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="AccountMenu">
                            <MenuItem x:Name="AccountWhoItem" IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="Account settings" Click="AccountSettings_Click" />
                            <MenuItem Header="Open my profile on the website" Click="AccountWebsite_Click" />
                            <MenuItem Header="{x:Static resources:Strings.Menu_About_Title}" Click="About_Click" />
                            <Separator />
                            <MenuItem Header="Sign out" Click="AccountSignOut_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" IsHitTestVisible="False" />

        <!--  Search everything: settings, pages, your flags and games you've played  -->
        <Popup x:Name="SettingsSearchPopup"
               PlacementTarget="{Binding ElementName=SettingsSearchBox}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Focusable="False">
            <Border Width="780" Height="470" Margin="0,0,8,8" Padding="0" Style="{DynamicResource PhasmaPopupSurface}">
                <DockPanel>
                    <StackPanel x:Name="SearchChips" DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10,12,8">
                        <ToggleButton x:Name="SearchChipAll" Style="{DynamicResource PhasmaChip}" Focusable="False" Tag="All" Click="SearchChip_Click" IsChecked="True" Content="All" />
                        <ToggleButton x:Name="SearchChipSettings" Style="{DynamicResource PhasmaChip}" Focusable="False" Tag="Settings" Click="SearchChip_Click" Content="Settings" />
                        <ToggleButton x:Name="SearchChipFlags" Style="{DynamicResource PhasmaChip}" Focusable="False" Tag="Flags" Click="SearchChip_Click" Content="Your flags" />
                        <ToggleButton x:Name="SearchChipGames" Style="{DynamicResource PhasmaChip}" Focusable="False" Tag="Games" Click="SearchChip_Click" Content="Games" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" Padding="12,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsSearchFooter" Grid.Column="0" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="↑↓ move    Enter open    Tab filter    Esc close" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="SettingsSearchResults"
                                 Grid.Column="0"
                                 Margin="6,0,6,6"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemContainerStyle="{DynamicResource PhasmaListItem}"
                                 MouseMove="SettingsSearchResults_MouseMove"
                                 PreviewMouseLeftButtonUp="SettingsSearchResults_PreviewMouseLeftButtonUp"
                                 PreviewKeyDown="SettingsSearchBox_PreviewKeyDown">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8,10,8,4">
                                                <TextBlock Text="{Binding Name}" Style="{DynamicResource PhasmaCaption}" />
                                                <TextBlock Text="{Binding ItemCount}" Margin="6,0,0,0" Style="{DynamicResource PhasmaCaption}" Opacity="0.6" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                                                CornerRadius="7" Background="{DynamicResource PhasmaSelectedBrush}">
                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                                            <Border.Visibility>
                                                <Binding Path="HasBadge">
                                                    <Binding.Converter>
                                                        <BooleanToVisibilityConverter />
                                                    </Binding.Converter>
                                                </Binding>
                                            </Border.Visibility>
                                            <TextBlock Text="{Binding Badge}" FontSize="10" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="SettingsSearchEmpty" Grid.Column="0" Margin="24" Visibility="Collapsed" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Style="{DynamicResource PhasmaSubtle}" />

                        <Border Grid.Column="1" Background="{DynamicResource PhasmaStrokeBrush}" />

                        <DockPanel x:Name="SearchDetail" Grid.Column="2" Margin="16,8,16,12"
                                   DataContext="{Binding SelectedItem, ElementName=SettingsSearchResults}">
                            <Button x:Name="SearchDetailOpen" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Focusable="False"
                                    Style="{DynamicResource PhasmaAccentButton}" Content="{Binding OpenLabel}" Click="SearchDetailOpen_Click" />
                            <StackPanel>
                                <Border Width="40" Height="40" HorizontalAlignment="Left" CornerRadius="10" Background="{DynamicResource PhasmaAccentSoftBrush}">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Header}" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border Margin="0,8,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10" />
                                </Border>
                                <TextBlock Text="Where" Margin="0,16,0,4" Style="{DynamicResource PhasmaCaption}" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Description}" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap" MaxHeight="150" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>

        <!--  Notification history  -->
        <Popup x:Name="NotificationsPopup"
               PlacementTarget="{Binding ElementName=NotificationsButton}"
               Placement="Bottom"
               HorizontalOffset="-310"
               VerticalOffset="8"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="370" MaxHeight="480" Margin="0,0,10,10" Padding="0" Style="{DynamicResource PhasmaPopupSurface}">
                <DockPanel>
                    <!--  Title, unread count, do not disturb and a shortcut to the notification settings  -->
                    <Grid DockPanel.Dock="Top" Margin="14,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Text="Notifications" Style="{DynamicResource PhasmaHeading}" />
                            <Border x:Name="NotificationsNewTag" Margin="8,0,0,0" Style="{DynamicResource PhasmaTag}" Visibility="Collapsed">
                                <TextBlock x:Name="NotificationsNewText" FontSize="11" Text="0 new" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{x:Static resources:Strings.Menu_Notifications_DoNotDisturb}" />
                            <ui:ToggleSwitch x:Name="DoNotDisturbToggle" VerticalAlignment="Center" Click="DoNotDisturbToggle_Click"
                                             ToolTip="Keep alerts in this list without showing them on screen"
                                             AutomationProperties.Name="Do not disturb" />
                            <Button Width="30" Height="30" Margin="6,0,0,0" Click="NotificationSettings_Click" Style="{DynamicResource PhasmaIconButton}"
                                    ToolTip="Notification settings" AutomationProperties.Name="Notification settings">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PhasmaDivider}" />

                    <!--  Footer actions  -->
                    <Grid DockPanel.Dock="Bottom" Margin="8,6,8,8">
                        <Button HorizontalAlignment="Left" Click="ClearNotifications_Click" Style="{DynamicResource PhasmaGhostButton}">
                            <TextBlock Text="Clear history" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Button>
                        <Button HorizontalAlignment="Right" Click="SendTestNotification_Click" Style="{DynamicResource PhasmaGhostButton}" ToolTip="Show a test alert">
                            <TextBlock Text="Send test" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>
                    <Border DockPanel.Dock="Bottom" Style="{DynamicResource PhasmaDivider}" />

                    <!--  Empty state  -->
                    <StackPanel x:Name="NotificationsEmpty" DockPanel.Dock="Top" Margin="24,28,24,28" HorizontalAlignment="Center">
                        <Border Width="40" Height="40" HorizontalAlignment="Center" CornerRadius="12" Background="{DynamicResource PhasmaSelectedBrush}">
                            <ui:SymbolIcon Symbol="Alert24" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="You're all caught up" />
                        <TextBlock Margin="0,4,0,0" MaxWidth="280" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Alerts about friends, servers, updates and captures will show up here." />
                    </StackPanel>

                    <ListBox x:Name="NotificationsList"
                             Margin="6,6,6,4"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{DynamicResource PhasmaListItem}"
                             PreviewMouseLeftButtonUp="NotificationsList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="30" Height="30" VerticalAlignment="Top" CornerRadius="8" Background="{DynamicResource PhasmaSelectedBrush}">
                                        <ui:SymbolIcon Symbol="Alert24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Timestamp}" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="7" Height="7" Margin="10,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource PhasmaAccentBrush}"
                                             Visibility="{Binding NewVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>

        <!--  Page content on one glass panel  -->
        <Border Grid.Row="1" Margin="14,12,14,14" Style="{DynamicResource PhasmaPanel}">
            <Frame x:Name="RootFrame" />
        </Border>

        <!--  Shown while something has changed that has not been saved yet  -->
        <Border
            x:Name="UnsavedBar"
            Grid.Row="1"
            Margin="0,0,0,30"
            Padding="16,8,8,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Panel.ZIndex="8"
            Style="{DynamicResource PhasmaPopupSurface}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource PhasmaWarnBrush}" />
                <TextBlock x:Name="UnsavedText" VerticalAlignment="Center" FontSize="13" Text="You have changes that are not saved yet" />
                <Button Margin="12,0,0,0" Click="DiscardButton_Click" Style="{DynamicResource PhasmaGhostButton}" ToolTip="Throw away the changes you have not saved">
                    <TextBlock Text="Reset" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button Margin="6,0,0,0" Click="SaveMenuItem_Click" Style="{DynamicResource PhasmaAccentButton}">
                    <TextBlock Text="{x:Static resources:Strings.Menu_Save}" />
                </Button>
                <Button Margin="6,0,0,0" Click="LaunchButton_Click" Style="{DynamicResource PhasmaSoftButton}">
                    <TextBlock Text="{x:Static resources:Strings.Menu_Settings_SaveAndLaunch}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
