<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ShortcutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ShortcutsViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="ShortcutsPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Shortcuts}" />
            <Border Style="{DynamicResource PhasmaTagNeutral}" Margin="12,0,0,0">
                <TextBlock FontSize="11" Text="Look and feel" />
            </Border>
        </StackPanel>

        <controls:CardColumns>
            <!--  Create a shortcut: one row of fields  -->
            <controls:SettingsCard controls:CardColumns.FullRow="True" Header="Create a shortcut" Description="A game shortcut uses that game's own icon.">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,5" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="What it launches" />
                    <ComboBox Grid.Row="1" Grid.Column="0" Padding="10,5,10,5" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ShortcutTargets, Mode=OneTime}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedShortcutTarget, Mode=TwoWay}" />

                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Margin="10,0,0,0" MaxWidth="360" HorizontalAlignment="Stretch"
                                Visibility="{Binding IsGameTargetSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Margin="0,0,0,5" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Place ID or game link" />
                        <ui:TextBox PlaceholderText="{x:Static resources:Strings.Menu_Shortcuts_PlaceIDGameLink}" Text="{Binding GameShortcutInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{x:Static resources:Strings.Menu_Shortcuts_GameShortcuts_Description}" />
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,0,5" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Where to put it" />
                    <ComboBox Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" MinWidth="120" Padding="10,5,10,5"
                              ItemsSource="{Binding ShortcutLocations, Mode=OneTime}"
                              SelectedItem="{Binding SelectedShortcutLocation, Mode=TwoWay}" />

                    <Button Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" Style="{DynamicResource PhasmaAccentButton}"
                            IsEnabled="{Binding NotBusy, Mode=OneWay}" Command="{Binding CreateShortcutCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Shortcuts_CreateShortcut}" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="10,6,0,0" HorizontalAlignment="Right" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GameShortcutStatus, Mode=OneWay}" />
                </Grid>
            </controls:SettingsCard>

            <!--  Shortcuts that already exist  -->
            <controls:SettingsCard Header="Your shortcuts">
                <controls:SettingsCard.HeaderContent>
                    <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="Refresh" Command="{Binding RefreshShortcutsCommand, Mode=OneTime}">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                    </Button>
                </controls:SettingsCard.HeaderContent>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Margin="0,10,0,10" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="No shortcuts yet. Make one above, or turn on a quick shortcut.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasExistingShortcuts}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  ShortcutsList: the code behind attaches the right click menu to it  -->
                    <ItemsControl x:Name="ShortcutsList" ItemsSource="{Binding ExistingShortcuts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Background="Transparent">
                                    <Border Style="{DynamicResource PhasmaDivider}" />
                                    <Grid Margin="0,9,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="28" Height="28" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource PhasmaSelectedBrush}">
                                            <Grid>
                                                <ui:SymbolIcon Symbol="Link24" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Image Source="{Binding Icon, Mode=OneTime}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name, Mode=OneTime}" ToolTip="{Binding Path, Mode=OneTime}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Launches, Mode=OneTime}" />
                                                <TextBlock FontSize="12" Margin="5,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="&#183;" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Location, Mode=OneTime}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="Rename" AutomationProperties.Name="Rename shortcut"
                                                    Command="{Binding DataContext.RenameShortcutCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Rename24" FontSize="14" />
                                            </Button>
                                            <Button Margin="4,0,0,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="Remove"
                                                    Command="{Binding DataContext.RemoveShortcutCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:SettingsCard>

            <!--  Quick shortcuts: fixed icons PhasmaStrap can make for you  -->
            <controls:SettingsCard Header="Quick shortcuts" Description="Desktop and Start menu icons">
                <controls:OptionControl Header="{x:Static resources:Strings.Common_Shortcuts_Desktop}" Description="Opens the launch menu">
                    <ui:ToggleSwitch IsChecked="{Binding DesktopIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Common_Shortcuts_StartMenu}">
                    <ui:ToggleSwitch IsChecked="{Binding StartMenuIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" ToolTip="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding PlayerIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}" ToolTip="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}"
                                        Visibility="{Binding IsStudioOptionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding StudioIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Title}" ToolTip="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding SettingsIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Shortcuts_ExtractIcons_Title}"
                    Description="{Binding Source={x:Static resources:Strings.Menu_Shortcuts_ExtractIcons_Description}, Converter={StaticResource StringFormatConverter},ConverterParameter='https://bloxstraplabs.com/wiki/info/using-roblox-icons-for-shortcuts/'}">
                    <ui:ToggleSwitch IsChecked="{Binding ExtractIconsTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <!--  Studio companion plugin  -->
            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_Shortcuts_StudioCompanion_Title}"
                                   Description="A Studio plugin that tells PhasmaStrap what you are working on">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Shortcuts_EnableStudioCompanion}" Description="{Binding StudioPluginStatus, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Shortcuts_Reinstall}"
                                IsEnabled="{Binding StudioPluginEnabled}" Command="{Binding ReinstallStudioPluginCommand, Mode=OneTime}" />
                        <ui:ToggleSwitch IsChecked="{Binding StudioPluginEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
