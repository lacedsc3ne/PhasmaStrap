<UserControl x:Class="PhasmaStrap.UI.Elements.Settings.Games.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:GameViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1180"
             d:DesignHeight="640">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="PingDot" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PingLevel}" Value="good">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingLevel}" Value="ok">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingLevel}" Value="bad">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaBadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="196" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Banner  -->
        <Grid Grid.Row="0" Margin="14,10,14,0">
            <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}" Background="{DynamicResource PhasmaPanelRaisedBrush}" />
            <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding BannerUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#330B0B0F" />
                        <GradientStop Offset="1" Color="#F20B0B0F" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,5" Foreground="White"
                    Style="{DynamicResource PhasmaGhostButton}" Background="#660B0B0F"
                    Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" Margin="0,0,6,0" Foreground="White" />
                    <TextBlock Text="Back" FontSize="12.5" />
                </StackPanel>
            </Button>

            <Grid Margin="20,0,20,18" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="96" Height="96">
                    <Border CornerRadius="18" Background="{DynamicResource PhasmaSelectedBrush}" />
                    <Border CornerRadius="18" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=192}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="18,0,16,2" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Creator}" FontSize="12" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,6" Text="{Binding Name}" FontSize="30" FontWeight="Bold" FontFamily="{DynamicResource PhasmaHeadingFont}" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource PhasmaGoodBrush}" />
                        <TextBlock Text="{Binding PlayingText}" FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Margin="14,0,0,0" Text="{Binding StatsText}" FontSize="12.5" Foreground="#B3FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Text="{Binding Status}" FontSize="11.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Margin="0,0,6,0" Style="{DynamicResource PhasmaIconButton}" Foreground="White" Background="#660B0B0F" Command="{Binding CopyLinkCommand}" ToolTip="Copy the game link" AutomationProperties.Name="Copy the game link">
                        <ui:SymbolIcon Symbol="Link24" FontSize="16" />
                    </Button>
                    <Button Margin="0,0,10,0" Style="{DynamicResource PhasmaIconButton}" Foreground="White" Background="#660B0B0F" Command="{Binding OpenWebsiteCommand}" ToolTip="Open on the Roblox website" AutomationProperties.Name="Open on the Roblox website">
                        <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                    </Button>
                    <Button Height="42" Padding="18,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PlayCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                            <TextBlock Text="{Binding PlayText}" FontSize="14" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Tabs  -->
        <StackPanel Grid.Row="1" Margin="22,12,22,10" Orientation="Horizontal">
            <RadioButton GroupName="GameTabs" Content="Servers" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsServersTab, Mode=TwoWay}" />
            <RadioButton GroupName="GameTabs" Content="Private servers" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsPrivateTab, Mode=TwoWay}" />
            <RadioButton GroupName="GameTabs" Content="About" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsAboutTab, Mode=TwoWay}" />
        </StackPanel>

        <Border Grid.Row="1" Height="1" Margin="14,0" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!--  Places and subplaces  -->
            <DockPanel Grid.Column="0" Margin="12,12,0,12">
                <TextBlock DockPanel.Dock="Top" Margin="10,0,0,8" Text="{Binding PlacesTitle}" Style="{DynamicResource PhasmaCaption}" />
                <ui:TextBox
                    DockPanel.Dock="Top"
                    Margin="6,0,6,8"
                    PlaceholderText="Search places"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    Text="{Binding PlaceSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding PlaceSearchVisibility}"
                    AutomationProperties.Name="Search places" />
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Places}"
                    SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                    ItemContainerStyle="{DynamicResource PhasmaListItem}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:PlaceItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36">
                                    <Border CornerRadius="8" Background="{DynamicResource PhasmaSelectedBrush}" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,8" Background="{DynamicResource PhasmaStrokeBrush}" />

            <!--  SERVERS  -->
            <DockPanel Grid.Column="1" Margin="16,12,16,12" Visibility="{Binding ServersTabVisibility}">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <WrapPanel VerticalAlignment="Center">
                        <ToggleButton Content="Hide full" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding HideFull, Mode=TwoWay}" />
                        <RadioButton GroupName="ServerSort" Content="Lowest ping" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortByPing, Mode=TwoWay}" />
                        <RadioButton GroupName="ServerSort" Content="Most players" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortByPlayers, Mode=TwoWay}" />
                        <RadioButton GroupName="ServerSort" Content="Most space" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortBySpace, Mode=TwoWay}" />
                    </WrapPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding ServersBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshServersCommand}" IsEnabled="{Binding ServersNotBusy}" ToolTip="Look again" AutomationProperties.Name="Refresh servers">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Margin="2,0,0,8" Text="{Binding ServerStatus}" Style="{DynamicResource PhasmaSubtle}" />

                <Grid DockPanel.Dock="Top" Margin="12,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PING" Style="{DynamicResource PhasmaCaption}" />
                    <TextBlock Grid.Column="1" Text="PLAYERS" Style="{DynamicResource PhasmaCaption}" />
                    <TextBlock Grid.Column="2" Text="SERVER" Style="{DynamicResource PhasmaCaption}" />
                </Grid>

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Servers}"
                    ItemContainerStyle="{DynamicResource PhasmaListItem}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:ServerRow}">
                            <Grid MinHeight="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Margin="0,0,8,0" Style="{StaticResource PingDot}" />
                                    <TextBlock Text="{Binding PingText}" FontSize="12.5" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="120" Height="5" VerticalAlignment="Center">
                                        <Border CornerRadius="3" Background="{DynamicResource PhasmaSelectedBrush}" />
                                        <Border Width="{Binding FillWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource PhasmaAccentBrush}" />
                                    </Grid>
                                    <TextBlock Margin="10,0,0,0" Text="{Binding PlayersText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding ShortJobId}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding Server.JobId}" />
                                <Button Grid.Column="3" Padding="12,4" Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding CanJoin}"
                                        Command="{Binding DataContext.JoinServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="Join" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!--  PRIVATE SERVERS  -->
            <DockPanel Grid.Column="1" Margin="16,12,16,12" Visibility="{Binding PrivateTabVisibility}">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock VerticalAlignment="Center" Text="{Binding PrivateStatus}" Style="{DynamicResource PhasmaSubtle}" />
                    <Button HorizontalAlignment="Right" Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshPrivateCommand}" ToolTip="Look again" AutomationProperties.Name="Refresh private servers">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                    </Button>
                </Grid>
                <ui:TextBox
                    DockPanel.Dock="Top"
                    Margin="0,0,0,10"
                    PlaceholderText="Search private servers by name or owner"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    Text="{Binding PrivateSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding PrivateSearchVisibility}"
                    AutomationProperties.Name="Search private servers" />
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding PrivateServers}"
                    ItemContainerStyle="{DynamicResource PhasmaListItem}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:GamePrivateServerRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PhasmaSelectedBrush}">
                                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Padding="14,5" Style="{DynamicResource PhasmaSoftButton}"
                                        Command="{Binding DataContext.JoinPrivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="Join" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!--  ABOUT  -->
            <ScrollViewer Grid.Column="1" Margin="16,12,8,12" VerticalScrollBarVisibility="Auto" Visibility="{Binding AboutTabVisibility}">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding StatsText}" Style="{DynamicResource PhasmaSubtle}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,14,0,0" Text="{Binding AboutText}" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Margin="0,8" Background="{DynamicResource PhasmaStrokeBrush}" />

            <!--  Launch setup  -->
            <ScrollViewer Grid.Column="2" Margin="1,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,14,18,14">
                    <TextBlock Margin="0,0,0,12" Text="Launch setup" Style="{DynamicResource PhasmaHeading}" />

                    <TextBlock Text="Applies to" Style="{StaticResource FieldLabel}" />
                    <Border Padding="3" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{DynamicResource PhasmaHoverBrush}">
                        <UniformGrid Columns="2">
                            <RadioButton GroupName="ProfileScope" Margin="0" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding WholeGame, Mode=TwoWay}">
                                <TextBlock Text="Whole game" FontSize="12" />
                            </RadioButton>
                            <RadioButton GroupName="ProfileScope" Margin="0" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding OnlyThisPlace, Mode=TwoWay}">
                                <TextBlock Text="{Binding ScopePlaceText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <TextBlock Margin="0,16,0,6" Text="FastFlag profile" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding ProfileNote}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Button Margin="-8,4,0,0" HorizontalAlignment="Left" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding EditFlagsCommand}">
                        <TextBlock Text="Manage profiles and their flags" FontSize="12" Foreground="{DynamicResource PhasmaAccentBrush}" />
                    </Button>

                    <Border Margin="0,10,0,12" Style="{DynamicResource PhasmaDivider}" />

                    <TextBlock Text="Overlay" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Text="{Binding OverlaySummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                        <Button HorizontalAlignment="Right" Padding="10,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditOverlayCommand}">
                            <TextBlock Text="Change" FontSize="12" />
                        </Button>
                    </Grid>

                    <TextBlock Margin="0,14,0,6" Text="Resolution" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Text="{Binding ResolutionSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                        <Button HorizontalAlignment="Right" Padding="10,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditResolutionCommand}">
                            <TextBlock Text="Change" FontSize="12" />
                        </Button>
                    </Grid>

                    <Border Margin="0,16,0,14" Style="{DynamicResource PhasmaDivider}" />

                    <Button Height="38" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding JoinBestCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="Join the lowest ping server" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,8,0,0" Text="{Binding PlaceHint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
