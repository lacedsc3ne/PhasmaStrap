<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      Title="NotificationsPage"
      Scrollable="True"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Title="{x:Static resources:Strings.Menu_Notifications_Title}" Subtitle="{Binding SummaryText, Mode=OneWay}">
            <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding SendTestNotificationCommand, Mode=OneTime}"
                    IsEnabled="{Binding NotificationsEnabled, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Alert24" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_Notifications_SendTestNotification}" />
                </StackPanel>
            </Button>
        </controls:PageHeader>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <controls:SettingsCard Grid.Column="0" VerticalAlignment="Top"
                                   Header="{x:Static resources:Strings.Menu_Notifications_General_Title}"
                                   Description="Where toasts appear and whether they appear at all">
                <controls:OptionControl
                    x:Name="EnabledOption"
                    Flat="True"
                    Header="{x:Static resources:Strings.Menu_Notifications_Enabled_Title}"
                    Description="{x:Static resources:Strings.Menu_Notifications_Enabled_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0"
                    Header="{x:Static resources:Strings.Menu_Notifications_DoNotDisturb}"
                    Description="{x:Static resources:Strings.Menu_Notifications_SuppressesScreenToastPopupRestSession}"
                    IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding DoNotDisturbEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0" Header="Corner to start from" Description="They follow the screen Roblox is on"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <ComboBox MinWidth="170" Padding="10,5,10,5" ItemsSource="{Binding NotificationPositionOptions, Mode=OneTime}" SelectedIndex="{Binding NotificationPositionIndex, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0" Header="Distance from the side" Description="In pixels"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="180" VerticalAlignment="Center" Minimum="0" Maximum="1200" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding NotificationOffsetX, Mode=TwoWay}" />
                        <TextBlock MinWidth="52" Margin="14,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" Foreground="White" Text="{Binding NotificationOffsetX, StringFormat='{}{0} px'}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0" Header="Distance from the top or bottom" Description="In pixels, from the edge you picked"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="180" VerticalAlignment="Center" Minimum="0" Maximum="1200" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding NotificationOffsetY, Mode=TwoWay}" />
                        <TextBlock MinWidth="52" Margin="14,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" Foreground="White" Text="{Binding NotificationOffsetY, StringFormat='{}{0} px'}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0" Header="Width" Description="How wide each pop up is, in pixels"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="180" VerticalAlignment="Center" Minimum="300" Maximum="700" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding NotificationWidth, Mode=TwoWay}" />
                        <TextBlock MinWidth="52" Margin="14,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" Foreground="White" Text="{Binding NotificationWidth, StringFormat='{}{0} px'}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0" Header="Try it" Description="{Binding PlacementSummary, Mode=OneWay}"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding SendTestNotificationCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Notifications_SendTestNotification}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="10,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="Reset placement" Command="{Binding ResetPlacementCommand}">
                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Grid.Column="2" VerticalAlignment="Top" Header="Placement preview" Description="Where a toast lands on the screen Roblox is on">
                <StackPanel Margin="20,4,20,18">
                    <Border Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" phui:CutCorners.Size="6" SnapsToDevicePixels="True">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="1920" Height="1080">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="1">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="2">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="3">
                                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="4">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="5">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="{Binding NotificationOffsetX}" />
                                    <Border Width="{Binding NotificationOffsetX}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="4">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel>
                                        <Border Height="{Binding NotificationOffsetY}" />
                                        <Border Width="{Binding NotificationWidth}" Height="130" BorderBrush="{DynamicResource PhasmaAccentBrush}" BorderThickness="8" Background="{DynamicResource PhasmaAccentSoftBrush}" />
                                        <Border Width="{Binding NotificationWidth}" Height="110" Margin="0,24,0,0" Background="#0AFFFFFF" />
                                        <Border Height="{Binding NotificationOffsetY}" />
                                    </StackPanel>
                                    <Border Width="{Binding NotificationOffsetX}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="1">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NotificationPositionIndex}" Value="4">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <TextBlock Margin="0,12,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PlacementSummary, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>
        </Grid>

        <controls:SettingsCard Header="Everything that can pop up" Description="And what sets it off. Hover one to see when it shows.">
            <Grid Margin="18,0,18,0">
                <ItemsControl Margin="-18,0,-18,0" ItemsSource="{Binding Catalogue, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Style="{DynamicResource PhasmaDivider}" />
                                <TextBlock Margin="20,16,20,10" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" />
                                <ItemsControl ItemsSource="{Binding Kinds, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Background="Transparent" ToolTip="{Binding Trigger}">
                                                <Grid MinHeight="68" Margin="20,12,20,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Center" phui:CutCorners.Size="6"
                                                            Background="{Binding Tint, TargetNullValue={StaticResource PhasmaS3Brush}}">
                                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{Binding Accent, TargetNullValue={StaticResource PhasmaInfoBrush}}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Text="{Binding Name}" />
                                                        <TextBlock Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Trigger}" />
                                                    </StackPanel>
                                                    <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                                     IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                                     Visibility="{Binding HasToggle, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                     IsEnabled="{Binding DataContext.NotificationsEnabled, RelativeSource={RelativeSource AncestorType=ui:UiPage}, Mode=OneWay}" />
                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasToggle}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border Style="{DynamicResource PhasmaTagNeutral}">
                                                            <TextBlock FontSize="10" Text="Always on" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Notifications_History_Title}"
                               Description="{x:Static resources:Strings.Menu_Notifications_HistoryOnlyShowsNotificationsFiredBy}">
            <controls:SettingsCard.HeaderContent>
                <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ClearHistoryCommand, Mode=OneTime}" IsEnabled="{Binding HasHistory}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Notifications_History_Clear}" />
                    </StackPanel>
                </Button>
            </controls:SettingsCard.HeaderContent>

            <Grid Margin="18,0,18,0">
                <StackPanel Margin="-18,0,-18,0">
                    <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,18,20,18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Notifications_History_Empty}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </controls:SettingsCard>
    </StackPanel>
</ui:UiPage>
