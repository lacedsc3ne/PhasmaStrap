<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:games="clr-namespace:PhasmaStrap.UI.Elements.Settings.Games"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:HomeViewModel, IsDesignTimeCreatable=False}"
      Title="HomePage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <Style x:Key="H2Bar" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="4" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PhasmaAccentBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <SkewTransform AngleX="-14" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="H2Text" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="H2Note" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="14,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="TileName" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileMeta" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="GameTile" DataType="{x:Type dmodels:GameCard}">
            <Button
                Margin="0,0,14,14"
                Padding="0"
                BorderThickness="0"
                Background="Transparent"
                HorizontalContentAlignment="Stretch"
                Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                CommandParameter="{Binding}"
                Style="{DynamicResource PhasmaGhostButton}"
                phui:CutCorners.Size="0"
                ToolTip="{Binding Name}">
                <Border Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Height="88">
                            <Border Background="{DynamicResource PhasmaS3Brush}" />
                            <Border>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=300}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                            <Border
                                Margin="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource PhasmaPanelBrush}"
                                Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Style="{DynamicResource PhasmaTag}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Flag24" FontSize="11" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ProfileName, Converter={StaticResource PhasmaUpper}}" FontSize="10.5" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                        <StackPanel Margin="12,10,12,12">
                            <TextBlock Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" Style="{StaticResource TileName}" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TileMeta}">
                                        <Setter Property="Text" Value="{Binding Subtitle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPlaying}" Value="True">
                                                <Setter Property="Text" Value="{Binding PlayingText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="LibraryTile" DataType="{x:Type dmodels:GameCard}">
            <Button
                Margin="0,0,14,14"
                Padding="0"
                BorderThickness="0"
                Background="Transparent"
                HorizontalContentAlignment="Stretch"
                Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                CommandParameter="{Binding}"
                Style="{DynamicResource PhasmaGhostButton}"
                phui:CutCorners.Size="0"
                ToolTip="{Binding Name}">
                <Border Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Height="144">
                            <Border Background="{DynamicResource PhasmaS3Brush}" />
                            <Border>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=300}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                            <Border
                                Margin="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource PhasmaPanelBrush}"
                                Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Style="{DynamicResource PhasmaTag}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Flag24" FontSize="11" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ProfileName, Converter={StaticResource PhasmaUpper}}" FontSize="10.5" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Border>
                            <StackPanel Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Button Width="30" Height="30" Margin="0,0,6,0" Style="{DynamicResource PhasmaIconButton}" Background="{DynamicResource PhasmaPanelBrush}" Foreground="White"
                                        Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}"
                                        ToolTip="Copy the game link" AutomationProperties.Name="Copy the game link">
                                    <ui:SymbolIcon Symbol="Link24" FontSize="14" />
                                </Button>
                                <Button Width="30" Height="30" Padding="0" Style="{DynamicResource PhasmaAccentButton}" phui:CutCorners.Size="6"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}"
                                        ToolTip="{x:Static resources:Strings.Common_Launch}" AutomationProperties.Name="Launch">
                                    <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="12,12,12,12">
                            <TextBlock Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" Style="{StaticResource TileName}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TileMeta}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TileWrap">
            <UniformGrid Columns="6" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TileWrap7">
            <UniformGrid Columns="7" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TileWrap4">
            <UniformGrid Columns="4" />
        </ItemsPanelTemplate>

    </ui:UiPage.Resources>

    <Grid x:Name="GamesRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="HomeTab" GroupName="GamesTabs" IsChecked="True" Content="Home" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="home" />
                <RadioButton x:Name="LibraryTab" GroupName="GamesTabs" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="library">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Library" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Library.Count}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ServerBrowserTab" GroupName="GamesTabs" Content="Server browser" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="serverbrowser" />
                <RadioButton x:Name="PrivateTab" GroupName="GamesTabs" Content="{x:Static resources:Strings.Menu_PrivateServers_PrivateServers}" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="privateservers" />
                <RadioButton x:Name="HistoryTab" GroupName="GamesTabs" Content="{x:Static resources:Strings.Menu_Notifications_History_Title}" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="history" />
            </StackPanel>
            <ui:TextBox x:Name="CatalogSearchBox" Width="420" HorizontalAlignment="Right" Icon="Search24" ClearButtonEnabled="True"
                        PlaceholderText="Search the catalog, paste a link or place ID"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HomeVisibility}">
            <StackPanel Margin="0,0,14,22">

                <controls:PageHeader Eyebrow="Games" Title="Home" Subtitle="Pick up where you left off, see which friends are in a game, and find something new.">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox
                            Width="420"
                            VerticalAlignment="Center"
                            Icon="Search24"
                            ClearButtonEnabled="True"
                            PlaceholderText="Search the catalog, paste a link or place ID"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <Button Width="40" Height="40" Margin="10,0,0,0" Padding="0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding RefreshCommand}" ToolTip="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}"
                                AutomationProperties.Name="Refresh">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                        </Button>
                        <Button Height="40" Margin="10,0,0,0" Padding="16,0" Style="{DynamicResource PhasmaGhostButton}"
                                Command="{Binding ShowTabCommand}" CommandParameter="serverbrowser">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Server24" FontSize="15" Margin="0,0,8,0" />
                                <TextBlock Text="Server browser" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:PageHeader>

                <Grid Margin="0,0,0,30" Visibility="{Binding HeroVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" MinHeight="300" Style="{DynamicResource PhasmaPanel}" ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource PhasmaSelectedBrush}" />
                            <Border>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Hero.BannerUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FA0D0D12" />
                                        <GradientStop Offset="0.42" Color="#E00D0D12" />
                                        <GradientStop Offset="1" Color="#400D0D12" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Width="18" Height="18" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource PhasmaAccentBrush}" BorderThickness="2,2,0,0" />
                            <Border Width="18" Height="18" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{DynamicResource PhasmaAccentBrush}" BorderThickness="0,0,2,2" />

                            <StackPanel Margin="32,30,28,30" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="2" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentBrush}" />
                                    <TextBlock Text="CONTINUE PLAYING" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Margin="0,14,0,0" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="44" FontWeight="Bold" Foreground="White"
                                           Text="{Binding Hero.Name, Converter={StaticResource PhasmaUpper}}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding HeroDetail}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Margin="0,14,0,20" Orientation="Horizontal">
                                    <Border Margin="0,0,8,0" Style="{DynamicResource PhasmaTag}" Visibility="{Binding Hero.HasProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Flag24" FontSize="11" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Hero.ProfileName, Converter={StaticResource PhasmaUpper}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource PhasmaTagGood}" Visibility="{Binding Hero.HasPlaying, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource PhasmaGoodBrush}" />
                                            <TextBlock Text="{Binding Hero.PlayingText, Converter={StaticResource PhasmaUpper}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Height="50" Margin="0,0,10,8" Padding="30,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PlayCommand}" CommandParameter="{Binding Hero}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="15" Margin="0,0,10,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                            <TextBlock Text="{Binding Source=Play, Converter={StaticResource PhasmaUpper}}" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Height="50" Margin="0,0,10,8" Padding="18,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding OpenHeroServersCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Server24" FontSize="15" Margin="0,0,8,0" />
                                            <TextBlock Text="Pick a server" FontSize="14.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HeroPlacesButton" Height="50" Margin="0,0,0,8" Padding="16,0" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Click="HeroPlaces_Click" ToolTip="Launch a place, or launch with a flag profile once" AutomationProperties.Name="Places">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Grid24" FontSize="15" Margin="0,0,8,0" />
                                            <TextBlock Text="Places" FontSize="14.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource PhasmaPanel}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,18,20,16" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="FRIENDS PLAYING" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding FriendsCountText}" />
                                </StackPanel>
                            </Border>
                            <Border DockPanel.Dock="Bottom" Padding="20,12,20,14" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{Binding FriendsStatus}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Height="34" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaGhostButton}"
                                            Command="{Binding StartPartyCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding PartyButtonText}" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FriendsPlaying}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dmodels:FriendPlayingRow}">
                                            <Border Padding="16,11" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                        <Ellipse Fill="{DynamicResource PhasmaS4Brush}" />
                                                        <ui:SymbolIcon Symbol="Person24" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Ellipse Width="10" Height="10" Margin="0,0,-1,-1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource PhasmaGoodBrush}" Stroke="{DynamicResource PhasmaPanelBrush}" StrokeThickness="2" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Location}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Height="26" Padding="11,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaAccentButton}" phui:CutCorners.Size="6"
                                                            IsEnabled="{Binding Joinable}"
                                                            Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="Join" FontSize="12.5" FontWeight="Bold" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Margin="0,0,0,30" Padding="26,22" Style="{DynamicResource PhasmaCard}" Visibility="{Binding WelcomeVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source='Nothing played yet', Converter={StaticResource PhasmaUpper}}" FontSize="22" Style="{DynamicResource PhasmaTitle}" />
                        <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Search the catalog above, paste a game link, or just start Roblox. Games you play show up here with their places, servers and launch setup." />
                        <Button HorizontalAlignment="Left" Height="40" Padding="18,0" Style="{DynamicResource PhasmaAccentButton}" Click="LaunchRoblox_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,14" Visibility="{Binding HeroVisibility}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource H2Bar}" />
                        <TextBlock Text="{Binding Source=Library, Converter={StaticResource PhasmaUpper}}" Style="{StaticResource H2Text}" />
                        <TextBlock Text="{Binding Source='Recent first', Converter={StaticResource PhasmaUpper}}" Style="{StaticResource H2Note}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Height="32" Padding="12,0" Style="{DynamicResource PhasmaGhostButton}" Click="ShowLibrary_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LibraryCountText, Converter={StaticResource PhasmaUpper}}" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl Margin="0,0,-14,0" ItemsSource="{Binding HomeLibrary}" ItemTemplate="{StaticResource GameTile}" ItemsPanel="{StaticResource TileWrap7}" Focusable="False" />

                <StackPanel Margin="0,16,0,0" Visibility="{Binding SortsVisibility}">
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource H2Bar}" />
                            <TextBlock Text="{Binding Source='Trending in the catalog', Converter={StaticResource PhasmaUpper}}" Style="{StaticResource H2Text}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="32" Padding="12,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding BrowseCommand}" Visibility="{Binding BrowseVisibility}"
                                ToolTip="Every game in this list">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Browse" FontSize="13" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl Margin="0,0,0,16" ItemsSource="{Binding Sorts}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dmodels:CatalogSortRow}">
                                <ToggleButton Content="{Binding Name}" Style="{DynamicResource PhasmaChip}"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                              CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Margin="0,0,-14,0" ItemsSource="{Binding SortGames}" ItemTemplate="{StaticResource GameTile}" ItemsPanel="{StaticResource TileWrap}" Focusable="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding LibraryVisibility}">
            <StackPanel Margin="0,0,14,22">
                <controls:PageHeader Eyebrow="Games" Title="Library" Subtitle="Every game you have played through PhasmaStrap, with its play time. Right click a game for more ways to launch it.">
                    <ui:TextBox
                        Width="380"
                        VerticalAlignment="Center"
                        Icon="Search24"
                        ClearButtonEnabled="True"
                        PlaceholderText="Search the catalog, paste a link or place ID"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                </controls:PageHeader>

                <Grid Margin="0,-6,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <WrapPanel VerticalAlignment="Center">
                            <RadioButton GroupName="LibraryFilter" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding IsFilterAll, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="All played" />
                                    <TextBlock Margin="6,0,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" FontWeight="Normal" Opacity="0.7" VerticalAlignment="Center" Text="{Binding Library.Count}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LibraryFilter" Content="Recent" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding IsFilterRecent, Mode=TwoWay}" />
                            <RadioButton GroupName="LibraryFilter" Content="Has its own flags" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding IsFilterOwnFlags, Mode=TwoWay}" />
                            <RadioButton GroupName="LibraryFilter" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding IsFilterFavourites, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Heart24" FontSize="12" Margin="0,0,5,0" />
                                    <TextBlock Text="Favourites" />
                                    <TextBlock Margin="6,0,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" FontWeight="Normal" Opacity="0.7" VerticalAlignment="Center" Text="{Binding FavouriteCount}" />
                                </StackPanel>
                            </RadioButton>
                        </WrapPanel>
                        <TextBlock Margin="0,10,0,0" Text="{Binding LibraryViewNote}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton Style="{DynamicResource PhasmaChip}" IsChecked="{Binding MostPlayed, Mode=TwoWay}" ToolTip="Most played first instead of most recent first">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDown24" FontSize="12" Margin="0,0,5,0" />
                                <TextBlock Text="Most played" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Height="32" Padding="12,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Padding="26,22" Style="{DynamicResource PhasmaCard}" Visibility="{Binding LibraryEmptyVisibility}">
                    <StackPanel>
                        <ui:SymbolIcon HorizontalAlignment="Left" Symbol="Games24" FontSize="24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static resources:Strings.Menu_Home_NoHistoryYet}, Converter={StaticResource PhasmaUpper}}" Style="{DynamicResource PhasmaHeading}" />
                        <TextBlock Margin="0,4,0,14" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Games you play through PhasmaStrap show up here with their play time." />
                        <Button HorizontalAlignment="Left" Height="38" Padding="16,0" Style="{DynamicResource PhasmaAccentButton}" Click="LaunchRoblox_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,4,0,14" TextWrapping="Wrap" Text="{Binding LibraryViewEmptyText}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding LibraryViewEmptyVisibility}" />

                <ItemsControl Margin="0,0,-14,0" ItemsSource="{Binding LibraryView}" ItemTemplate="{StaticResource LibraryTile}" ItemsPanel="{StaticResource TileWrap4}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SearchVisibility}">
            <StackPanel Margin="0,0,14,22">
                <controls:PageHeader Eyebrow="Games" Title="Catalog" Subtitle="{Binding SearchStatus}">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing Margin="0,0,14,0" Width="18" Height="18" VerticalAlignment="Center" IsIndeterminate="True"
                                         Visibility="{Binding SearchBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ui:TextBox
                            Width="380"
                            VerticalAlignment="Center"
                            Icon="Search24"
                            ClearButtonEnabled="True"
                            PlaceholderText="Search the catalog, paste a link or place ID"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <Button Width="40" Height="40" Margin="10,0,0,0" Padding="0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding RefreshCommand}" ToolTip="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}"
                                AutomationProperties.Name="Refresh">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                        </Button>
                        <Button Height="40" Margin="10,0,0,0" Padding="14,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ClearSearchCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:PageHeader>

                <Border Margin="0,0,0,20" Style="{DynamicResource PhasmaCard}" Padding="20,16" Visibility="{Binding LinkVisibility}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source='Ready to join', Converter={StaticResource PhasmaUpper}}" Style="{DynamicResource PhasmaHeading}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding LinkText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Height="40" Padding="18,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding JoinLinkCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="{x:Static resources:Strings.Common_Launch}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ItemsControl Margin="0,0,-14,0" ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource GameTile}" ItemsPanel="{StaticResource TileWrap}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Visibility="{Binding GameVisibility}">
            <games:GameView DataContext="{Binding Game}" />
        </Grid>

        <Frame
            Grid.Row="1"
            Margin="0,0,0,0"
            Background="Transparent"
            JournalOwnership="OwnsJournal"
            NavigationUIVisibility="Hidden"
            Source="{Binding SectionSource, Mode=OneWay}"
            Visibility="{Binding SectionVisibility, Mode=OneWay}" />
    </Grid>
</ui:UiPage>
