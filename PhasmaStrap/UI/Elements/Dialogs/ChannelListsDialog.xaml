<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.ChannelListsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Dialogs"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_ChannelLists_Title}"
        Width="720"
        Height="520"
        MinHeight="360"
        MinWidth="520"
        ResizeMode="CanResize"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <ui:UiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="GridHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource PhasmaUpper}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Padding="14,0" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonoCell" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NameCell" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </ui:UiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="12,8" Title="{Binding Source={x:Static resources:Strings.Dialog_ChannelLists_Title}, Converter={StaticResource PhasmaUpper}}"
                     Background="{DynamicResource PhasmaChromeBrush}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Icon="pack://application:,,,/PhasmaStrap.ico" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <TextBlock Grid.Row="1" Margin="20,18,20,14" FontSize="13.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Dialog_ChannelLists_Description}" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="20,0,20,18">
            <Border BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1">
                <DataGrid x:Name="ChannelDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          Margin="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          HorizontalGridLinesBrush="{DynamicResource PhasmaStrokeBrush}"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          CellStyle="{StaticResource GridCell}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemsSource="{Binding Channels}"
                          MouseDoubleClick="ChannelDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static resources:Strings.Dialog_ChannelLists_ColumnChannel}" Width="180" Binding="{Binding ChannelName}" ElementStyle="{StaticResource NameCell}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Dialog_ChannelLists_ColumnVersion}" Width="*" Binding="{Binding Version}" ElementStyle="{StaticResource MonoCell}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Dialog_ChannelLists_ColumnVersionGuid}" Width="*" Binding="{Binding VersionGuid}" ElementStyle="{StaticResource MonoCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource PhasmaPanelBrush}" Opacity="0.9" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="200" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="{x:Static resources:Strings.Dialog_ChannelLists_Loading}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button HorizontalAlignment="Left" Style="{StaticResource PhasmaSoftButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button MinWidth="90" Style="{StaticResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Close}" IsCancel="True" Click="Close_Click" />
                    <Button MinWidth="90" Margin="10,0,0,0" Style="{StaticResource PhasmaAccentButton}" Content="{x:Static resources:Strings.Dialog_ChannelLists_Select}" IsDefault="True" Click="SelectButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
