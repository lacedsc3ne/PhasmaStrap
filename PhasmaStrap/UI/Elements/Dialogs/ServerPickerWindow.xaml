<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.ServerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        mc:Ignorable="d"
        Title="Choose a server"
        Width="520"
        Height="560"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <base:WpfUiWindow.Resources>
        <Style x:Key="ServerRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PhasmaAccentStrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="12,8" Title="CHOOSE A SERVER" ShowMinimize="False" ShowMaximize="False" Icon="pack://application:,,,/PhasmaStrap.ico"
                     Background="{DynamicResource PhasmaChromeBrush}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <StackPanel Grid.Row="1" Margin="22,20,22,12">
            <TextBlock x:Name="GameText" Margin="0,0,0,4" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            <TextBlock x:Name="HeadlineText" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="19" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Text="Looking for servers..." />
            <TextBlock x:Name="DetailText" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Roblox is waiting for your choice. Do nothing and it picks a server itself." />
            <ProgressBar x:Name="TimeBar" Margin="0,12,0,0" Height="3" Style="{StaticResource PhasmaMiniBar}" Minimum="0" Maximum="1" Value="1" ToolTip="Time left before Roblox picks a server itself" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="14,0,14,0">
            <ui:ProgressRing x:Name="Searching" IsIndeterminate="True" Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <ListBox x:Name="ServerList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource ServerRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ServerList_MouseDoubleClick" SelectionChanged="ServerList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Region}" />
                                <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Players}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource PhasmaBadBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PingTone}" Value="good">
                                                    <Setter Property="Fill" Value="{DynamicResource PhasmaGoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PingTone}" Value="warn">
                                                    <Setter Property="Fill" Value="{DynamicResource PhasmaWarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" Text="{Binding Ping}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock Grid.Row="3" Margin="22,10,22,14" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Ping is estimated from the distance to the datacenter. Enter joins, Esc lets Roblox choose." />

        <Border Grid.Row="4" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Click="Skip_Click" Style="{StaticResource PhasmaSoftButton}" Content="Let Roblox choose" />
                <Button x:Name="JoinButton" Margin="10,0,0,0" IsEnabled="False" Click="Join_Click" Style="{StaticResource PhasmaAccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Join this server" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
