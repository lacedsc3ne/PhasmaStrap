<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.OverlaysCrosshairPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      Title="OverlaysCrosshairPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Eyebrow="Performance · Overlays" Title="Crosshair"
                             Subtitle="A crosshair centred on the game window. Design it in the editor, then turn it on per game or everywhere." />

        <controls:SettingsCard Margin="0,0,0,18">
            <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Overlays_CrosshairEnabled_Title}" Description="Centred on the game window while you are in a game">
                <ui:ToggleSwitch IsChecked="{Binding CrosshairEnabled, Mode=TwoWay}" />
            </controls:OptionControl>
        </controls:SettingsCard>

        <Border Margin="0,0,0,18" Style="{DynamicResource PhasmaCard}" Padding="20,18,20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="140" Height="140" ClipToBounds="True" Background="#FF2A5A8C" BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" phui:CutCorners.Size="6">
                    <Image Source="{Binding CrosshairPreview}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <StackPanel Grid.Column="1" Margin="22,0,20,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="CURRENT CROSSHAIR" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource PhasmaHeading}" FontSize="22" Foreground="White" Text="{Binding CrosshairName, Converter={StaticResource PhasmaUpper}}" />
                    <TextBlock Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left" FontSize="13.5" LineHeight="20" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Shown at its real size. Build your own from arms, a centre dot and a ring, with outline, rotation, T shape and opacity. Save designs and share them as a short code." />
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Center" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding OpenCrosshairEditorCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Target24" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_OpenCrosshairEditor}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <controls:CardColumns Spacing="16">
            <controls:SettingsCard VerticalAlignment="Top" Header="{x:Static resources:Strings.Menu_Rendering_FocusMode}">
                <controls:OptionControl Flat="True" Header="Overlay focus mode" Description="Hides the HUD and crosshair without turning them off. Bind it on Hotkeys.">
                    <ui:ToggleSwitch IsChecked="{Binding FocusModeEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard VerticalAlignment="Top" Header="{x:Static resources:Strings.Menu_Rendering_GameOverrides}"
                                   Description="A place with its own HUD and crosshair state.">
                <StackPanel>
                    <Border Margin="-20,0,-20,14" Style="{DynamicResource PhasmaDivider}" />
                    <DockPanel Margin="0,0,0,14" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding AddPlaceProfileCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_Add}" />
                            </StackPanel>
                        </Button>
                        <WrapPanel>
                            <ui:TextBox Width="160" Margin="0,0,12,4" FontFamily="{DynamicResource PhasmaMono}" PlaceholderText="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_Title}" Text="{Binding AssignPlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Source={x:Static resources:Strings.Menu_Rendering_HUD}, Converter={StaticResource PhasmaUpper}}" />
                                <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding AssignHudEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Source={x:Static resources:Strings.Menu_Overlays_Crosshair_Title}, Converter={StaticResource PhasmaUpper}}" />
                                <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding AssignCrosshairEnabled, Mode=TwoWay}" />
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Margin="0,-6,0,14" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource PhasmaWarnBrush}" Text="{Binding PlaceProfileStatus, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaceProfileStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding PlaceProfiles, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="-20,0,-20,0">
                                <Border Style="{DynamicResource PhasmaDivider}" />
                                <Grid Margin="20,12,20,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Text="{Binding Display}" />
                                    <Button Grid.Column="1" Margin="12,0,0,0" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Mods_Remove}"
                                            Command="{Binding DataContext.RemovePlaceProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
