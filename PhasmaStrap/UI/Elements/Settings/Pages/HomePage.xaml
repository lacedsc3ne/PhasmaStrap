<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:games="clr-namespace:PhasmaStrap.UI.Elements.Settings.Games"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:HomeViewModel, IsDesignTimeCreatable=False}"
      Title="HomePage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <!--  A square game tile: artwork, profile tag, name and a small line under it  -->
        <DataTemplate x:Key="GameTile" DataType="{x:Type dmodels:GameCard}">
            <Button
                Width="148"
                Margin="0,0,16,18"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                CommandParameter="{Binding}"
                Style="{DynamicResource PhasmaGhostButton}"
                ToolTip="{Binding Name}">
                <StackPanel>
                    <Grid Height="148">
                        <Border CornerRadius="{DynamicResource PhasmaCornerRadius}" Background="{DynamicResource PhasmaSelectedBrush}" />
                        <Border CornerRadius="{DynamicResource PhasmaCornerRadius}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=300}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border
                            Margin="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="#D90B0B0F"
                            CornerRadius="6"
                            Padding="7,2"
                            Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flag24" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource PhasmaAccentBrush}" />
                                <TextBlock Text="{Binding ProfileName}" FontSize="11" FontWeight="SemiBold" Foreground="White" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Margin="2,8,2,0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="2,2,2,0" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Subtitle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPlaying}" Value="True">
                                        <Setter Property="Text" Value="{Binding PlayingText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TileWrap">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

    </ui:UiPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Tabs and catalog search  -->
        <Grid Grid.Row="0" Margin="22,16,22,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" Text="Games" Style="{DynamicResource PhasmaTitle}" />
                <RadioButton x:Name="HomeTab" GroupName="GamesTabs" IsChecked="True" Content="Home" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="home" />
                <RadioButton x:Name="LibraryTab" GroupName="GamesTabs" Content="Library" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="library" />
                <RadioButton x:Name="PrivateTab" GroupName="GamesTabs" Content="{x:Static resources:Strings.Menu_PrivateServers_PrivateServers}" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="privateservers" />
                <RadioButton x:Name="HistoryTab" GroupName="GamesTabs" Content="{x:Static resources:Strings.Menu_Notifications_History_Title}" Style="{DynamicResource PhasmaTab}"
                             Command="{Binding ShowTabCommand}" CommandParameter="history" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox
                    x:Name="CatalogSearchBox"
                    Width="400"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    PlaceholderText="Search the catalog, or paste a link or place ID"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshCommand}" ToolTip="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}"
                        AutomationProperties.Name="Refresh">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  HOME  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HomeVisibility}">
            <StackPanel Margin="22,12,18,22">

                <!--  Continue where you left off, with friends who are playing  -->
                <Grid Height="300" Visibility="{Binding HeroVisibility}">
                    <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}" Background="{DynamicResource PhasmaPanelRaisedBrush}" />
                    <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Hero.BannerUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#F00B0B0F" />
                                <GradientStop Offset="0.55" Color="#990B0B0F" />
                                <GradientStop Offset="1" Color="#260B0B0F" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="30,26,18,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,20,8" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Top">
                                <Border Style="{DynamicResource PhasmaTagNeutral}" Background="#26FFFFFF">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="History24" FontSize="11" Margin="0,0,5,0" Foreground="#E6FFFFFF" />
                                        <TextBlock Text="Continue where you left off" Foreground="#E6FFFFFF" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="0,14,0,0" FontSize="40" FontWeight="Bold" FontFamily="{DynamicResource PhasmaHeadingFont}" Foreground="White"
                                           Text="{Binding Hero.Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#CCFFFFFF" Text="{Binding HeroDetail}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <Border Margin="0,0,8,0" Style="{DynamicResource PhasmaTag}" Visibility="{Binding Hero.HasProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Flag24" FontSize="11" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Hero.ProfileName}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource PhasmaTagNeutral}" Background="#26FFFFFF" Visibility="{Binding Hero.HasPlaying, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource PhasmaGoodBrush}" />
                                            <TextBlock Text="{Binding Hero.PlayingText}" Foreground="#E6FFFFFF" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                <Button Height="42" Padding="20,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PlayCommand}" CommandParameter="{Binding Hero}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                        <TextBlock Text="Play" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Height="42" Margin="10,0,0,0" Padding="16,0" Style="{DynamicResource PhasmaSoftButton}" Background="#660B0B0F" Foreground="White"
                                        Command="{Binding OpenHeroServersCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Server24" FontSize="15" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock Text="Servers, places and launch setup" FontSize="13.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!--  Friends playing  -->
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="{DynamicResource PhasmaCornerRadius}" Background="#B30B0B0F" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Friends playing" FontSize="13.5" Foreground="White" Style="{DynamicResource PhasmaHeading}" />
                                </Grid>
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11.5" Foreground="#B3FFFFFF" TextWrapping="Wrap" Text="{Binding FriendsStatus}" />
                                <ItemsControl ItemsSource="{Binding FriendsPlaying}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dmodels:FriendPlayingRow}">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="16" Background="#33FFFFFF">
                                                    <Border CornerRadius="16">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Padding="10,4" Style="{DynamicResource PhasmaSoftButton}" Foreground="White"
                                                        IsEnabled="{Binding Joinable}"
                                                        Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Join" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!--  First run: nothing played yet  -->
                <Border Padding="26,22" Style="{DynamicResource PhasmaCard}" Visibility="{Binding WelcomeVisibility}">
                    <StackPanel>
                        <TextBlock Text="Nothing played yet" Style="{DynamicResource PhasmaTitle}" />
                        <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Search the catalog above, paste a game link, or just start Roblox. Games you play show up here with their places, servers and launch setup." />
                        <Button HorizontalAlignment="Left" Height="38" Padding="16,0" Style="{DynamicResource PhasmaAccentButton}" Click="LaunchRoblox_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--  Your library  -->
                <Grid Margin="0,26,0,12" Visibility="{Binding HeroVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Your library" FontSize="16" Style="{DynamicResource PhasmaHeading}" VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0" Text="Recent first" VerticalAlignment="Center" Style="{DynamicResource PhasmaSubtle}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{DynamicResource PhasmaGhostButton}" Click="ShowLibrary_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LibraryCountText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11" Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding HomeLibrary}" ItemTemplate="{StaticResource GameTile}" ItemsPanel="{StaticResource TileWrap}" Focusable="False" />

                <!--  Catalog front page  -->
                <StackPanel Visibility="{Binding SortsVisibility}">
                    <Grid Margin="0,14,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="In the catalog" FontSize="16" Style="{DynamicResource PhasmaHeading}" VerticalAlignment="Center" />
                            <ItemsControl Margin="14,0,0,0" ItemsSource="{Binding Sorts}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:CatalogSortRow}">
                                        <ToggleButton Content="{Binding Name}" Style="{DynamicResource PhasmaChip}"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                      CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SortGames}" ItemTemplate="{StaticResource GameTile}" ItemsPanel="{StaticResource TileWrap}" Focusable="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  LIBRARY  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding LibraryVisibility}">
            <StackPanel Margin="22,12,18,22">
                <TextBlock Margin="0,0,0,14" Text="{Binding LibraryCountText}" Style="{DynamicResource PhasmaSubtle}" />
                <TextBlock Visibility="{Binding LibraryEmptyVisibility}" Text="{x:Static resources:Strings.Menu_Home_NoHistoryYet}" Style="{DynamicResource PhasmaSubtle}" />
                <ItemsControl ItemsSource="{Binding Library}" ItemTemplate="{StaticResource GameTile}" ItemsPanel="{StaticResource TileWrap}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <!--  SEARCH  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SearchVisibility}">
            <StackPanel Margin="22,12,18,22">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ClearSearchCommand}" Padding="8,5">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Back" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding SearchStatus}" Style="{DynamicResource PhasmaHeading}" />
                    <ui:ProgressRing Margin="12,0,0,0" Width="18" Height="18" IsIndeterminate="True"
                                     Visibility="{Binding SearchBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Border Margin="0,0,0,18" Style="{DynamicResource PhasmaCard}" Visibility="{Binding LinkVisibility}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ready to join" Style="{DynamicResource PhasmaHeading}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding LinkText}" Style="{DynamicResource PhasmaSubtle}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Height="36" Padding="16,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding JoinLinkCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="{x:Static resources:Strings.Common_Launch}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource GameTile}" ItemsPanel="{StaticResource TileWrap}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <!--  GAME PAGE  -->
        <Grid Grid.Row="1" Visibility="{Binding GameVisibility}">
            <games:GameView DataContext="{Binding Game}" />
        </Grid>

        <!--  Private servers and history keep their own pages  -->
        <Frame
            Grid.Row="1"
            Margin="22,8,8,0"
            Background="Transparent"
            JournalOwnership="OwnsJournal"
            NavigationUIVisibility="Hidden"
            Source="{Binding SectionSource, Mode=OneWay}"
            Visibility="{Binding SectionVisibility, Mode=OneWay}" />
    </Grid>
</ui:UiPage>
