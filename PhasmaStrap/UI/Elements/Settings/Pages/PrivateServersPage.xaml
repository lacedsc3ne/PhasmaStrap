<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.PrivateServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="800"
      Title="PrivateServersPage">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SectionCount" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="12,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="H2Bar" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="4" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PhasmaAccentBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <SkewTransform AngleX="-14" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="H2Text" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <DataTemplate x:Key="ServerTemplate">
            <Border Style="{DynamicResource PhasmaTableRow}" Padding="16,10" MinHeight="60">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" Style="{DynamicResource PhasmaThumb}">
                        <Grid>
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding ServerName}" />
                        <TextBlock Margin="0,1,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding GameLine}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaTagWarn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TagText}" Value="Can join now">
                                            <Setter Property="Background" Value="#293DDC97" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PhasmaGoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Server.Active}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource PhasmaSelectedBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TagText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TagText, Converter={StaticResource PhasmaUpper}}" FontSize="11" />
                        </Border>
                        <Border Margin="6,0,0,0" Style="{DynamicResource PhasmaTag}" Background="#296AA8FF" TextElement.Foreground="{DynamicResource PhasmaInfoBrush}" Visibility="{Binding FriendVisibility}" ToolTip="The owner is one of your Roblox friends">
                            <TextBlock Text="{Binding Source=Friend, Converter={StaticResource PhasmaUpper}}" FontSize="11" />
                        </Border>
                        <Border Margin="6,0,0,0" Style="{DynamicResource PhasmaTagNeutral}" Visibility="{Binding HiddenVisibility}" ToolTip="Hidden from this list. Right click to show it again.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="EyeOff24" FontSize="11" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Source=Hidden, Converter={StaticResource PhasmaUpper}}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="12,0,0,0" MinWidth="120" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StatusText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,10,0" Width="32" Height="32" Padding="0" Style="{DynamicResource PhasmaGhostButton}" phui:CutCorners.Size="6"
                                Visibility="{Binding OwnerVisibility}" ToolTip="{x:Static resources:Strings.Menu_PrivateServers_CopyServerSInviteLink}" AutomationProperties.Name="{x:Static resources:Strings.Menu_History_CopyLink}"
                                Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Link24" FontSize="14" />
                        </Button>
                        <Button Margin="0,0,10,0" Height="32" Padding="10,0" Style="{DynamicResource PhasmaGhostButton}" phui:CutCorners.Size="6"
                                Visibility="{Binding OwnerVisibility}" ToolTip="{x:Static resources:Strings.Menu_PrivateServers_MakeNewInviteLinkOldOne}" AutomationProperties.Name="{x:Static resources:Strings.Menu_PrivateServers_NewLink}"
                                Command="{Binding DataContext.NewLinkCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_PrivateServers_NewLink}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,10,0" Width="32" Height="32" Padding="0" Style="{DynamicResource PhasmaGhostButton}" phui:CutCorners.Size="6"
                                ToolTip="{x:Static resources:Strings.Menu_PrivateServers_OpenGameSServerListRoblox}" AutomationProperties.Name="Open on Roblox"
                                Command="{Binding DataContext.OpenOnRobloxCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Open24" FontSize="14" />
                        </Button>
                        <Button Height="32" Padding="14,0" Style="{DynamicResource PhasmaAccentButton}" phui:CutCorners.Size="6" IsEnabled="{Binding CanJoin}"
                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="12" Margin="0,0,7,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_ServerBrowser_Join}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:UiPage.Resources>

    <ScrollViewer x:Name="ServersRoot" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,14">
            <controls:PageHeader Eyebrow="Games" Title="Private servers" Subtitle="Save the links to your private servers and join them in one click.">
                <Button Height="40" Padding="18,0" Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding NotBusy}" Command="{Binding LoadCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_PrivateServers_LoadMyPrivateServers}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:PageHeader>

            <Border Padding="20" Style="{DynamicResource PhasmaPanel}" Visibility="{Binding ListsVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Visibility="{Binding ListsVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="104" MaxWidth="150" />
                        <ColumnDefinition Width="*" MinWidth="104" MaxWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="104" MaxWidth="180" />
                        <ColumnDefinition Width="*" MinWidth="104" MaxWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="104" MaxWidth="170" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Icon="Search24" PlaceholderText="{x:Static resources:Strings.Menu_PrivateServers_SearchGamesServerNamesUsernames}" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1" Margin="10,0,0,0" Padding="10,5,10,5" ToolTip="{x:Static resources:Strings.Menu_PrivateServers_WhoseServersShowFriendsAreListed}" ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding Owner, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2" Margin="10,0,0,0" Padding="10,5,10,5" ToolTip="{x:Static resources:Strings.Menu_PrivateServers_OnlyServersGame}" ItemsSource="{Binding GameOptions}" SelectedItem="{Binding Game, Mode=TwoWay}" />
                    <ComboBox Grid.Column="3" Margin="10,0,0,0" Padding="10,5,10,5" SelectedIndex="{Binding ShowIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_YoursShared}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_OnlyYours}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_OnlySharedYou}" />
                    </ComboBox>
                    <ComboBox Grid.Column="4" Margin="10,0,0,0" Padding="10,5,10,5" SelectedIndex="{Binding StatusIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_AnyStatus}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_CanJoinNow}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_Inactive}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_EndingWithin30Days}" />
                    </ComboBox>
                    <ComboBox Grid.Column="5" Margin="10,0,0,0" Padding="10,5,10,5" SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_SortByGame}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_SortByOwner}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_PrivateServers_EndingSoonestFirst}" />
                    </ComboBox>
                </Grid>

            </Grid>
            </Border>

            <DockPanel Margin="0,18,0,0">
                <ui:ProgressRing DockPanel.Dock="Left" Margin="0,0,10,0" Width="16" Height="16" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding ListsVisibility}">
                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal" Visibility="{Binding HiddenToggleVisibility}">
                        <ToggleButton Style="{DynamicResource PhasmaChip}" IsChecked="{Binding ShowHidden, Mode=TwoWay}" ToolTip="Also list the servers you hid">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Eye24" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding HiddenText}" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Height="28" Padding="10,0" Style="{DynamicResource PhasmaGhostButton}" phui:CutCorners.Size="6" Command="{Binding ShowAllHiddenCommand, Mode=OneTime}" ToolTip="Stop hiding every server">
                            <TextBlock Text="Unhide all" FontSize="12.5" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Text="{Binding FilterSummary}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Button Margin="10,0,0,0" Height="28" Padding="10,0" Style="{DynamicResource PhasmaGhostButton}" phui:CutCorners.Size="6" Command="{Binding ClearFiltersCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_PrivateServers_ClearFilters}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status}" />
            </DockPanel>

            <Border Margin="0,18,0,0" Padding="26,22" Style="{DynamicResource PhasmaCard}" Visibility="{Binding NotLoadedVisibility}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Left" Symbol="LockClosed24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static resources:Strings.Menu_PrivateServers_PrivateServers}, Converter={StaticResource PhasmaUpper}}" Style="{DynamicResource PhasmaHeading}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_PrivateServers_OwnPrivateServersOnesSharedYou}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding ListsVisibility}">
                <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NoMatchesVisibility}" Text="{x:Static resources:Strings.Menu_PrivateServers_NoServersMatchTheseFilters}" />

                <StackPanel Visibility="{Binding YoursVisibility}">
                    <StackPanel Margin="0,26,0,14" Orientation="Horizontal">
                        <Border Style="{StaticResource H2Bar}" />
                        <TextBlock Style="{StaticResource H2Text}" Text="{Binding Source={x:Static resources:Strings.Menu_PrivateServers_Yours}, Converter={StaticResource PhasmaUpper}}" />
                        <TextBlock Style="{StaticResource SectionCount}" Text="{Binding Owned.Count}" />
                    </StackPanel>
                    <TextBlock Margin="2,0,0,8" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NoOwnedVisibility}" Text="{x:Static resources:Strings.Menu_PrivateServers_YouDonTOwnAnyPrivate}" />
                    <Border Style="{DynamicResource PhasmaPanel}"><ItemsControl Margin="0,-1,0,0" ItemsSource="{Binding Owned}" ItemTemplate="{StaticResource ServerTemplate}" Focusable="False" /></Border>
                </StackPanel>

                <StackPanel Visibility="{Binding SharedVisibility}">
                    <StackPanel Margin="0,26,0,14" Orientation="Horizontal">
                        <Border Style="{StaticResource H2Bar}" />
                        <TextBlock Style="{StaticResource H2Text}" Text="{Binding Source={x:Static resources:Strings.Menu_PrivateServers_SharedYou}, Converter={StaticResource PhasmaUpper}}" />
                        <TextBlock Style="{StaticResource SectionCount}" Text="{Binding Shared.Count}" />
                    </StackPanel>
                    <TextBlock Margin="2,0,0,8" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NoSharedVisibility}" Text="{x:Static resources:Strings.Menu_PrivateServers_NobodyHasAddedYouTheirPrivate}" />
                    <Border Style="{DynamicResource PhasmaPanel}"><ItemsControl Margin="0,-1,0,0" ItemsSource="{Binding Shared}" ItemTemplate="{StaticResource ServerTemplate}" Focusable="False" /></Border>
                </StackPanel>

                <Border Margin="0,20,0,0" Padding="16,12" CornerRadius="10" Background="#126AA8FF" BorderBrush="#406AA8FF" BorderThickness="1">
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,1,12,0" VerticalAlignment="Top" Symbol="Info24" FontSize="16" Foreground="{DynamicResource PhasmaInfoBrush}" />
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Replacing an invite link makes the old one stop working, for when a link has got around too far." />
                    </DockPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ui:UiPage>
