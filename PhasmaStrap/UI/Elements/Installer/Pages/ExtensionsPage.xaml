<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Installer.Pages.ExtensionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Installer.Pages"
      xmlns:smodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance smodels:ExtensionsViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExtensionsPage"
      Scrollable="True"
      Loaded="UiPage_Loaded">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source={x:Static resources:Strings.Installer_Extensions_Title}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{x:Static resources:Strings.Installer_Extensions_Text}" />

        <Border Margin="0,14,0,0" DataContext="{Binding Rojo}" Style="{StaticResource PhasmaCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="ROJO" />
                        <TextBlock Margin="0,2,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding InstalledVersionText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Margin="0,0,6,0" Padding="10,5" FontSize="12" Command="{Binding InstallOrUpdateCommand}" IsEnabled="{Binding CanInstallOrUpdate}" Style="{StaticResource PhasmaAccentButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="13" Symbol="ArrowDownload24" />
                                <TextBlock Margin="6,0,0,0" Text="{Binding InstallOrUpdateButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,6,0" Padding="10,5" FontSize="12" Command="{Binding ToggleServeCommand}" IsEnabled="{Binding CanToggleServe}" Style="{StaticResource PhasmaSoftButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="13" Symbol="Play24" />
                                <TextBlock Margin="6,0,0,0" Text="{Binding ServeButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Padding="10,5" FontSize="12" Command="{Binding UninstallCommand}" Content="{x:Static resources:Strings.Common_Delete}" Foreground="{DynamicResource PhasmaRedTextBrush}" IsEnabled="{Binding CanUninstall}" Style="{StaticResource PhasmaSoftButton}" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Syncs external files into Roblox Studio for development. Unlike the tools below, PhasmaStrap downloads and manages Rojo itself." TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ProjectPathText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,20,0,0" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source={x:Static resources:Strings.Installer_Extensions_Other_Title}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Installer_Extensions_Other_Text}" TextWrapping="Wrap" />
        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Extensions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="14,10" Style="{StaticResource PhasmaCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DisplayName}" />
                                <TextBlock Margin="0,2,0,2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Margin="0,0,6,0" Padding="10,5" FontSize="12" IsEnabled="{Binding IsInstalled}" Style="{StaticResource PhasmaAccentButton}"
                                        Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="13" Filled="True" Symbol="Play24" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static resources:Strings.Common_Launch}" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,0" Padding="10,5" FontSize="12" Content="{x:Static resources:Strings.Common_Browse}" Style="{StaticResource PhasmaSoftButton}"
                                        Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <Button Padding="10,5" FontSize="12" Content="{x:Static resources:Strings.Common_Delete}" Foreground="{DynamicResource PhasmaRedTextBrush}" IsEnabled="{Binding IsInstalled}" Style="{StaticResource PhasmaSoftButton}"
                                        Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
