<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.UninstallerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Dialogs"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Dialogs"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance dmodels:UninstallerViewModel, IsDesignTimeCreatable=True}"
        Title="PhasmaStrap"
        MinWidth="0"
        MinHeight="0"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Height="32"
            Padding="12,0,0,0"
            Background="{DynamicResource PhasmaChromeBrush}"
            FontFamily="{DynamicResource PhasmaMono}"
            FontSize="11"
            FontWeight="Medium"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Title="{Binding Source={x:Static resources:Strings.Uninstaller_Title}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}"
            CanMaximize="False"
            Icon="pack://application:,,,/PhasmaStrap.ico"
            KeyboardNavigation.TabNavigation="None"
            ShowMaximize="False"
            ShowMinimize="False" />
        <Border Grid.Row="0" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" IsHitTestVisible="False" />

        <StackPanel Grid.Row="1" Margin="22,20,22,20">
            <controls:MarkdownTextBlock FontSize="13.5" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MarkdownText="{Binding Text, Mode=OneTime}" TextWrapping="Wrap" />
            <CheckBox Margin="0,14,0,0" FontSize="13.5" FontWeight="SemiBold" Content="{x:Static resources:Strings.Uninstaller_KeepData_Label}" IsChecked="{Binding KeepData, Mode=TwoWay}" />
            <TextBlock Margin="30,2,0,0" FontSize="12" LineHeight="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Uninstaller_KeepData_Description}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding KeepData, Mode=OneWay}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="18,12"
            Background="{DynamicResource PhasmaPanelBrush}"
            BorderBrush="{DynamicResource PhasmaStrokeBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" FlowDirection="LeftToRight" Orientation="Horizontal">
                <Button MinWidth="100" Command="{Binding ConfirmUninstallCommand}" Content="{x:Static resources:Strings.Uninstaller_Uninstall}" Style="{StaticResource PhasmaAccentButton}" />
                <Button MinWidth="100" Margin="10,0,0,0" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" Style="{StaticResource PhasmaSoftButton}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
