<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.CopyFlagsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_CopyFlags_Title}"
        Width="420"
        MinHeight="0"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="12,8" Title="{Binding Source={x:Static resources:Strings.Dialog_CopyFlags_Title}, Converter={StaticResource PhasmaUpper}}"
                     Background="{DynamicResource PhasmaChromeBrush}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Icon="pack://application:,,,/PhasmaStrap.ico" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <StackPanel Grid.Row="1" Margin="22,20,22,20">
            <StackPanel Orientation="Horizontal">
                <Border RenderTransformOrigin="0.5,0.5" Width="4" Height="20" Margin="3,0,12,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentBrush}">
                    <Border.RenderTransform>
                        <SkewTransform AngleX="-14" />
                    </Border.RenderTransform>
                </Border>
                <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="17" FontWeight="Bold" Foreground="White"
                           Text="{Binding Source={x:Static resources:Strings.Dialog_CopyFlags_Title}, Converter={StaticResource PhasmaUpper}}" />
            </StackPanel>
            <TextBlock x:Name="CountText" Margin="0,10,0,16" FontSize="13.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ComboBox x:Name="FormatBox" MinWidth="200" SelectedIndex="0" HorizontalAlignment="Stretch" />
        </StackPanel>

        <Border Grid.Row="2" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="90" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" Click="Cancel_Click" Style="{StaticResource PhasmaSoftButton}" />
                <Button x:Name="CopyButton" MinWidth="100" Margin="10,0,0,0" IsDefault="True" Click="Copy_Click" Style="{StaticResource PhasmaAccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Copy}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
