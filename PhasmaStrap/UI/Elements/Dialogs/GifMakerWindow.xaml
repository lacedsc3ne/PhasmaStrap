<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.GifMakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:phui="clr-namespace:PhasmaStrap.UI"
        Title="Make a GIF"
        Width="1080"
        Height="740"
        MinWidth="860"
        MinHeight="580"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <base:WpfUiWindow.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource PhasmaCaption}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SmallIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconOnly" TargetType="ButtonBase" BasedOn="{StaticResource PhasmaIconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" />
        <StackPanel Grid.Row="0" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False" Panel.ZIndex="1">
            <Image Width="14" Height="14" Margin="0,0,8,0" Source="pack://application:,,,/Resources/PhasmaStrapLogo.png" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="MAKE A GIF" />
        </StackPanel>
        <ui:TitleBar Grid.Row="0" Height="32" MinHeight="32" Padding="0" Title="" />

        <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="20,18,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" phui:CutCorners.Size="9" ClipToBounds="True" Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Margin="10" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#CC0D0D12" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" IsHitTestVisible="False">
                                <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedItem.Content, ElementName=MotionBox, Converter={StaticResource PhasmaUpper}}" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="InfoText" Grid.Row="1" Margin="0,10,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Border Grid.Row="2" Margin="0,14,0,16" Style="{StaticResource PhasmaDivider}" />

                    <StackPanel Grid.Row="3">
                        <TextBlock Style="{StaticResource Section}" Text="MOTION" />
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Movement" />
                            <ComboBox x:Name="MotionBox" Grid.Column="1" SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="None (still)" />
                                <ComboBoxItem Content="Zoom in" />
                                <ComboBoxItem Content="Zoom out" />
                                <ComboBoxItem Content="Pan left to right" />
                                <ComboBoxItem Content="Pan right to left" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Between pictures" />
                            <ComboBox x:Name="TransitionBox" Grid.Column="1" SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="Crossfade" />
                                <ComboBoxItem Content="Cut" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Each picture" />
                            <Slider x:Name="SecondsSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0.5" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="2" ValueChanged="Slider_Changed" />
                            <TextBlock x:Name="SecondsText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,16">
                            <TextBlock Style="{StaticResource Section}" Text="PICTURES" />
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="One picture makes a moving shot. Add more to make a slideshow - they play in this order." />

                            <ListBox x:Name="PictureList" Margin="0,12,0,0" MaxHeight="230" Background="Transparent" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" SelectionChanged="PictureList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="52" Height="30" ClipToBounds="True" Background="{DynamicResource PhasmaS3Brush}">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="210" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Margin="0,0,6,0" Click="Add_Click" Focusable="False" Style="{DynamicResource PhasmaSoftButton}">
                                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Style="{StaticResource SmallIcon}" Margin="0,0,6,0" /><TextBlock Text="Add screenshots" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <ui:Button x:Name="UpButton" Style="{StaticResource IconOnly}" AutomationProperties.Name="Earlier" ToolTip="Earlier" Click="Up_Click">
                                    <ui:SymbolIcon Symbol="ArrowUp24" Style="{StaticResource SmallIcon}" />
                                </ui:Button>
                                <ui:Button x:Name="DownButton" Style="{StaticResource IconOnly}" AutomationProperties.Name="Later" ToolTip="Later" Click="Down_Click">
                                    <ui:SymbolIcon Symbol="ArrowDown24" Style="{StaticResource SmallIcon}" />
                                </ui:Button>
                                <ui:Button x:Name="RemoveButton" Style="{StaticResource IconOnly}" AutomationProperties.Name="Remove from the GIF" ToolTip="Remove from the GIF" Click="Remove_Click">
                                    <ui:SymbolIcon Symbol="Delete24" Style="{StaticResource SmallIcon}" />
                                </ui:Button>
                            </StackPanel>

                            <Border Margin="0,18,0,18" Style="{StaticResource PhasmaDivider}" />
                            <TextBlock Style="{StaticResource Section}" Text="SIZE AND SMOOTHNESS" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Width" />
                                <ComboBox x:Name="WidthBox" Grid.Column="1" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="320 px" Tag="320" />
                                    <ComboBoxItem Content="480 px" Tag="480" />
                                    <ComboBoxItem Content="640 px" Tag="640" />
                                    <ComboBoxItem Content="800 px" Tag="800" />
                                    <ComboBoxItem Content="960 px" Tag="960" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Frame rate" />
                                <ComboBox x:Name="FpsBox" Grid.Column="1" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="10 fps (smallest)" Tag="10" />
                                    <ComboBoxItem Content="15 fps" Tag="15" />
                                    <ComboBoxItem Content="20 fps" Tag="20" />
                                    <ComboBoxItem Content="25 fps (smoothest)" Tag="25" />
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="DitherBox" Margin="0,12,0,0" Content="Smoother colours (bigger file)" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <TextBlock Margin="0,14,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Saved GIFs go with your clips: Capture > Instant Replay > All clips (filter: GIFs)." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="SaveProgress" Width="200" Height="4" Margin="0,0,12,0" Maximum="1" Visibility="Collapsed" Style="{DynamicResource PhasmaMiniBar}" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RevealButton" Margin="0,0,8,0" Visibility="Collapsed" Click="Reveal_Click" Focusable="False" Style="{DynamicResource PhasmaSoftButton}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen24" Style="{StaticResource SmallIcon}" Margin="0,0,6,0" /><TextBlock Text="Show in folder" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Margin="0,0,8,0" Click="Save_Click" Focusable="False" Style="{DynamicResource PhasmaAccentButton}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" Style="{StaticResource SmallIcon}" Margin="0,0,6,0" Foreground="White" /><TextBlock Text="Save GIF" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Content="Close" Click="Close_Click" Focusable="False" Style="{DynamicResource PhasmaSoftButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
