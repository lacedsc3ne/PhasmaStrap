<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      Title="FastFlagsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <ui:UiPage.Resources>
        <!--  Engine preset chips. RadioButtons so a click on the active one keeps it lit; the trigger follows ActiveEnginePreset.  -->
        <Style x:Key="PresetChip" TargetType="RadioButton" BasedOn="{StaticResource PhasmaChip}">
            <Setter Property="IsChecked" Value="False" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Command" Value="{Binding ApplyEnginePresetCommand, Mode=OneTime}" />
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        </Style>

        <!--  Inner tabs drawn as pills. Kept as a real TabControl so settings search can still switch tabs.  -->
        <Style x:Key="FlagTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PhasmaFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Fill" Padding="12,6" Background="Transparent" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlagTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource FlagTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <!--  The "Fast Flag Editor" button now sits in the FastFlags header (FastFlagSettingsPage)  -->
                                <WrapPanel IsItemsHost="True" VerticalAlignment="Center" KeyboardNavigation.TabIndex="1" />
                            </DockPanel>
                            <Border Grid.Row="1" Margin="0,8,0,14" Style="{DynamicResource PhasmaDivider}" />
                            <ContentPresenter Grid.Row="2" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <!--  Manager switch and engine presets, as one bar  -->
        <Border Style="{DynamicResource PhasmaCard}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Turning this off stops anything here from reaching Roblox" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{x:Static resources:Strings.Menu_FastFlags_EnginePreset_Description}">
                    <Border Width="1" Height="28" Margin="14,0,14,0" Background="{DynamicResource PhasmaStrokeStrongBrush}" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_FastFlags_EnginePreset_Title}" />
                    <RadioButton Tag="Default" Content="{x:Static resources:Strings.Common_Default}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource PresetChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveEnginePreset}" Value="Default">
                                        <Setter Property="IsChecked" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton Tag="Balanced" Content="{x:Static resources:Strings.Menu_FastFlags_Balanced}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource PresetChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveEnginePreset}" Value="Balanced">
                                        <Setter Property="IsChecked" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton Tag="Performance" Content="{x:Static resources:Strings.Menu_FastFlags_Performance}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource PresetChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveEnginePreset}" Value="Performance">
                                        <Setter Property="IsChecked" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton Tag="Quality" Content="{x:Static resources:Strings.Menu_Capture_Quality}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource PresetChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveEnginePreset}" Value="Quality">
                                        <Setter Property="IsChecked" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Style="{StaticResource FlagTabs}">
            <TabItem Header="Presets">
                <controls:CardColumns>
                    <controls:SettingsCard controls:CardColumns.FullRow="True" Header="Display quality" Description="Anti aliasing, display scaling and texture quality.">
                        <controls:MarkdownTextBlock Margin="0,0,0,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    MarkdownText="{Binding Source={x:Static resources:Strings.Menu_FastFlags_Presets_D3DExclusiveFullscreenInfo}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://bloxstraplabs.com/wiki/features/engine-settings/#exclusive-fullscreen'}" />

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}">
                            <ComboBox Padding="10,5,10,5" Width="150" ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}" Text="{Binding SelectedMSAALevel, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}"
                                                Description="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Description}"
                                                HelpLink="https://bloxstraplabs.com/wiki/features/engine-settings/#preserving-rendering-quality">
                            <ui:ToggleSwitch IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}">
                            <ComboBox Padding="10,5,10,5" Width="150" ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}" Text="{Binding SelectedTextureQuality, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>
                    </controls:SettingsCard>
                </controls:CardColumns>
            </TabItem>

            <TabItem Header="Rendering">
                <controls:CardColumns>
                    <controls:SettingsCard Header="Frame rate and refresh" Description="Frame rate limits and the frame rate manager">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_NewFpsSystem_Title}" Description="Newer FPS and frame time tracking">
                            <ui:ToggleSwitch IsChecked="{Binding NewFpsSystem, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_TargetRefreshRate_Title}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding RefreshRates.Keys, Mode=OneTime}" Text="{Binding SelectedRefreshRate, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_FramerateBufferPercentage_Title}">
                            <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="140" Min="0" Max="100" Value="{Binding FPSBufferPercentage, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_FramerateLimitFFlag_Title}" Description="Separate from the Performance cap">
                            <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="140" Min="0" Max="2000" Value="{Binding FramerateLimit, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="Match my monitor" Description="{Binding MatchMonitorDescription, Mode=OneTime}">
                            <ui:ToggleSwitch IsChecked="{Binding MatchMonitorFramerate, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_FRMQualityLevel_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_FRMQualityLevel_Description}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding QualityLevels.Keys, Mode=OneTime}" Text="{Binding SelectedQualityLevel, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_MinimalRendering_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_MinimalRendering_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding MinimalRendering, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Resolution and distance rendering" Description="How far and how sharply the world is drawn">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_DynamicResolution_Title}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding DynamicResolutions.Keys, Mode=OneTime}" Text="{Binding SelectedDynamicResolution, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_DistanceRendering_Title}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding DistanceRenderings.Keys, Mode=OneTime}" Text="{Binding SelectedDistanceRendering, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_TextureSkipping_Title}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding TextureSkippings.Keys, Mode=OneTime}" Text="{Binding SelectedTextureSkipping, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_RenderingMode_Title}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding RenderingModes.Keys, Mode=OneTime}" Text="{Binding SelectedRenderingMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Lighting and sky" Description="Light culling, lighting technology and the sky">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_LightCulling_Title}" Description="GPU and CPU light culling">
                            <ui:ToggleSwitch IsChecked="{Binding LightCulling, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_MoreLighting_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_MoreLighting_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding MoreLighting, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_LightingMode_Title}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding LightingModes.Keys, Mode=OneTime}" Text="{Binding SelectedLightingMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_GraySky_Title}" Description="Three steps: off, gray, white">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding SkyModes, Mode=OneTime}" Text="{Binding SelectedSkyMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Post processing and shadows" Description="Effects, player shadows and occlusion checks">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_DisablePostFX_Title}">
                            <ui:ToggleSwitch IsChecked="{Binding DisablePostFX, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_DisablePlayerShadows_Title}">
                            <ui:ToggleSwitch IsChecked="{Binding DisablePlayerShadows, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_RenderOcclusionChecks_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_RenderOcclusionChecks_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding RenderOcclusion, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_DisableSkyBloom_Title}">
                            <ui:ToggleSwitch IsChecked="{Binding DisableSky, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Quality overrides" Description="Force a quality or mesh detail level instead of the automatic one">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_MeshQuality_Title}">
                            <ui:ToggleSwitch IsChecked="{Binding MeshQualityEnabled, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_MeshQualityLevel_Title}" Visibility="{Binding MeshQualityEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="140" Min="0" Max="3" Value="{Binding MeshQuality, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Shaders and Vulkan" Description="Shader glint level and Vulkan compatibility">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_ForceBuggyVulkan_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_ForceBuggyVulkan_Description}">
                            <ui:TextBox Width="160" Text="{Binding ForceBuggyVulkan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_BypassVulkan_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_BypassVulkan_Description}">
                            <ui:TextBox Width="160" Text="{Binding BypassVulkan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_ShaderGlintLevel_Title}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding Shaders.Keys, Mode=OneTime}" Text="{Binding SelectedShaderLevel, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_ShadersEnabled_Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ShadersEnabled, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_ShadersRoughnessClamp_Title}">
                            <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="150" Min="-640000000" Max="0" Value="{Binding ShadersLimit, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="World detail and foliage" Description="Grass distance, particle detail and terrain">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_MinGrassDistance_Title}">
                            <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="140" Min="0" Max="5000" Value="{Binding MinGrassDistance, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_MaxGrassDistance_Title}">
                            <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="140" Min="0" Max="5000" Value="{Binding MaxGrassDistance, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_GrassMovementFactor_Title}">
                            <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding GrassMovementOptions}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SelectedGrassMovementFactor, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_LowPolyMeshes_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_LowPolyMeshes_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding LowPolyMeshes, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_WorserParticles_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_WorserParticles_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding WorserParticles, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_DisableTerrainTextures_Title}">
                            <ui:ToggleSwitch IsChecked="{Binding DisableTerrainTextures, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Miscellaneous visuals" Description="Theming, camera and clothing">
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_RainbowTheme_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_RainbowTheme_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding RainbowTheme, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_BGRATextureSupport_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_BGRATextureSupport_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding BGRA, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_UnlimitedCameraZoom_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_UnlimitedCameraZoom_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding UnlimitedCameraZoom, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_DisableLayeredClothing_Title}">
                            <ui:ToggleSwitch IsChecked="{Binding LayeredClothing, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Prerender_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_Prerender_Description}">
                            <ui:ToggleSwitch IsChecked="{Binding Prerender, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </controls:SettingsCard>
                </controls:CardColumns>
            </TabItem>

            <TabItem Header="Interface">
                <StackPanel>
                    <controls:CardColumns>
                        <controls:SettingsCard Header="Accessibility and text" Description="Text size, language and readability">
                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_MoreSensitivityNumbers_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_MoreSensitivityNumbers_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding MoreSensetivityNumbers, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_PreferredTextSizeScaling_Title}">
                                <ui:ToggleSwitch IsChecked="{Binding TextSizeChanger, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_UIFontSizePadding_Title}">
                                <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="140" Min="1" Max="20" Value="{Binding FontSize, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_LanguageSelector_Title}">
                                <ui:ToggleSwitch IsChecked="{Binding LanguageSelector, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_Pseudolocalization_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_Pseudolocalization_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding Pseudolocalization, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Interface appearance" Description="Blur, dark mode, Chrome UI and other looks">
                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_NoGuiBlur_Title}">
                                <ui:ToggleSwitch IsChecked="{Binding NoGuiBlur, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_EnableDarkMode_Title}">
                                <ui:ToggleSwitch IsChecked="{Binding EnableDarkMode, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_OldChromeUI_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_OldChromeUI_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding OldChromeUI, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_RedFontDebugHighlight_Title}">
                                <ui:ToggleSwitch IsChecked="{Binding RedFont, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_GrayAvatarThumbnails_Title}">
                                <ui:ToggleSwitch IsChecked="{Binding GrayAvatar, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Menus and navigation" Description="The in game menu, details page and VR toggle">
                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_RemoveMiddleDetailsPage_Title}">
                                <ui:ToggleSwitch IsChecked="{Binding NoMoreMiddle, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_IGMenuVersion_Title}">
                                <ComboBox Padding="10,5,10,5" Width="130" ItemsSource="{Binding IGMenuVersions.Keys, Mode=OneTime}" Text="{Binding SelectedIGMenuVersion, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_OldRobloxStudioCoreUI_Title}" Description="{x:Static resources:Strings.Menu_FastFlags_OldRobloxStudioCoreUI_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding RobloxStudioCoreUI, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlags_AlwaysShowVRToggle_Title}">
                                <ui:ToggleSwitch IsChecked="{Binding VRToggle, Mode=TwoWay}" />
