<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="AppearancePage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="{x:Static resources:Strings.Menu_Appearance_Title}" />
            <Border Margin="10,2,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                <TextBlock Text="Look and feel" />
            </Border>
        </StackPanel>
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="Theme, effects and background for PhasmaStrap." />

        <controls:CardColumns>
            <controls:SettingsCard Header="Theme and language">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Global_Theme_Title}">
                    <ComboBox Padding="10,5,10,5" MinWidth="130" ItemsSource="{Binding Themes, Mode=OneTime}" Text="{Binding Theme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Language_Title}" Description="Needs a relaunch">
                    <ComboBox Padding="10,5,10,5" MinWidth="130" MaxWidth="200" ItemsSource="{Binding Languages, Mode=OneTime}" Text="{Binding SelectedLanguage, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Title}" Description="Overrides colors in PhasmaStrap's own menus">
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Edit}" Command="{Binding EditColorThemeCommand}" />
                        <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding CustomColorThemeEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Appearance_VisualEffects_Title}">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_WindowBackdrop_Title}" Description="Material behind PhasmaStrap's windows">
                    <ComboBox Padding="10,5,10,5" MinWidth="120" ItemsSource="{Binding BackdropStyles, Mode=OneTime}" Text="{Binding WindowBackdropStyle, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_ThemeTransition_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding ThemeTransitionEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_SmoothProgressBars_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding SmoothProgressBarsEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_SnowEffect_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding SnowEffectEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_ControllerNavigation}" Description="Use an Xbox or generic gamepad">
                    <ui:ToggleSwitch IsChecked="{Binding ControllerNavigationEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_Title}"
                                   Description="A picture, GIF or video behind this window. Copied into PhasmaStrap so it keeps working.">
                <controls:SettingsCard.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding NotImporting, Mode=OneWay}" Command="{Binding AddBackgroundCommand}"
                                Visibility="{Binding GlobalBackgroundEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_AddImageGIFVideo}" />
                            </StackPanel>
                        </Button>
                        <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding GlobalBackgroundEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard.HeaderContent>

                <StackPanel Margin="0,0,0,14" Visibility="{Binding GlobalBackgroundEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding BackgroundStatus, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackgroundStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BackgroundStatus}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Margin="0,0,0,10" Padding="20" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBackgrounds}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon HorizontalAlignment="Center" Symbol="ImageMultiple24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Appearance_NoBackgroundsAddedYet}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Backgrounds, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="170" Margin="0,0,10,10" Padding="3" CornerRadius="{DynamicResource PhasmaCornerRadius}" Background="{DynamicResource PhasmaHoverBrush}" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <Grid Height="90">
                                            <Border CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="#22000000" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="6,1" CornerRadius="5" Background="#B0000000">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAnimated}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_GIF}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="6,1" CornerRadius="5" Background="#B0000000">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Play12" FontSize="10" Foreground="White" Margin="0,0,3,0" />
                                                    <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_VIDEO}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="4,4,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <Button Grid.Column="1" Width="26" Height="26" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Appearance_RemoveBackground}"
                                                    Command="{Binding DataContext.RemoveBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete16" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_OpacityTitle}"
                                   ToolTip="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_OpacityDescription}" />
                        <Slider Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="{Binding GlobalBackgroundOverlayOpacity, Mode=TwoWay}"
                                ToolTip="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_OpacityDescription}" />
                        <TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Pause a video background while the window is not in front" />
                        <ui:ToggleSwitch Grid.Column="3" VerticalAlignment="Center" IsChecked="{Binding VideoPauseInactive, Mode=TwoWay}"
                                         ToolTip="{x:Static resources:Strings.Menu_Appearance_PauseVideoBackgroundWhileSettingsWindow}" />
                    </Grid>
                </StackPanel>
            </controls:SettingsCard>
        </controls:CardColumns>

        <!--  Theme studio: look tokens that apply live across the whole app  -->
        <Border Padding="18" Style="{DynamicResource PhasmaCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Theme studio" Style="{DynamicResource PhasmaHeading}" FontSize="16" />
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Style="{DynamicResource PhasmaSubtle}"
                                       Text="Accent, glass, roundness and spacing. Changes show up straight away everywhere in PhasmaStrap." />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <!--  Themes export as one small .phtheme file you can share  -->
                            <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ImportLookCommand}" ToolTip="Import .phtheme">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowImport24" FontSize="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Import" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Margin="4,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ExportLookCommand}" ToolTip="Save as a .phtheme file to share">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Export" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Margin="4,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ResetLookCommand}">
                                <TextBlock Text="Reset" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,16,0,8" Text="Start from" Style="{DynamicResource PhasmaCaption}" />
                    <ItemsControl ItemsSource="{Binding LookPresets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,0" Padding="8" HorizontalContentAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}"
                                        Command="{Binding DataContext.ApplyLookPresetCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Height="22" CornerRadius="6" Background="{Binding Brush}" />
                                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding Name}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,18,0,8" Text="Accent" Style="{DynamicResource PhasmaCaption}" />
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding AccentSwatches}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="30" Height="30" Margin="0,0,6,0" Padding="0" Style="{DynamicResource PhasmaGhostButton}" ToolTip="{Binding Hex}"
                                            Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                            CommandParameter="{Binding Hex}">
                                        <Grid>
                                            <Ellipse Width="28" Height="28" StrokeThickness="2">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Width="20" Height="20" Fill="{Binding Brush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:TextBox Width="110" Margin="6,0,0,0" VerticalAlignment="Center" PlaceholderText="#RRGGBB"
                                    Text="{Binding AccentHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <TextBlock Text="Panel opacity" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock HorizontalAlignment="Right" Style="{DynamicResource PhasmaSubtle}" Text="{Binding PanelOpacityPercent, StringFormat={}{0:0}%}" />
                    </Grid>
                    <Slider Margin="0,6,0,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                            Value="{Binding PanelOpacityPercent, Mode=TwoWay}" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Panel colour" FontWeight="SemiBold" FontSize="13" />
                        <Button HorizontalAlignment="Right" Margin="0,-6,-8,-6" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding FollowThemePanelCommand}" ToolTip="Go back to the colour your theme uses">
                            <TextBlock Text="Use theme colour" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Style="{DynamicResource PhasmaSubtle}" FontSize="11.5"
                               Text="The card every page sits on. Panel opacity sets how see through it is." />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding PanelSwatches}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="30" Height="30" Margin="0,0,6,0" Padding="0" Style="{DynamicResource PhasmaGhostButton}" ToolTip="{Binding Hex}"
                                            Command="{Binding DataContext.SelectPanelColorCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                            CommandParameter="{Binding Hex}">
                                        <Grid>
                                            <Ellipse Width="28" Height="28" StrokeThickness="2">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Width="20" Height="20" Fill="{Binding Brush}" Stroke="{DynamicResource PhasmaStrokeStrongBrush}" StrokeThickness="1" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:TextBox Width="110" Margin="6,0,0,0" VerticalAlignment="Center" PlaceholderText="#RRGGBB"
                                    Text="{Binding PanelColorHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <Button Margin="6,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding PickPanelColorCommand}" ToolTip="Choose any colour">
                            <TextBlock Text="Pick" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="Window tint" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock HorizontalAlignment="Right" Style="{DynamicResource PhasmaSubtle}" Text="{Binding WindowTintPercent, StringFormat={}{0:0}%}" />
                    </Grid>
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Style="{DynamicResource PhasmaSubtle}" FontSize="11.5"
                               Text="Lower lets the desktop blur or your background picture show through more." />
                    <Slider Margin="0,6,0,0" Minimum="40" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                            Value="{Binding WindowTintPercent, Mode=TwoWay}" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="Roundness" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock HorizontalAlignment="Right" Style="{DynamicResource PhasmaSubtle}" Text="{Binding CornerRadiusValue, StringFormat={}{0:0} px}" />
                    </Grid>
                    <Slider Margin="0,6,0,0" Minimum="0" Maximum="24" SmallChange="1" LargeChange="4" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True"
                            Value="{Binding CornerRadiusValue, Mode=TwoWay}" />

                    <Grid Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Compact spacing" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Style="{DynamicResource PhasmaSubtle}" FontSize="11.5" Text="Tighter rows and padding to fit more on screen." />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding CompactDensity, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Drifting mist" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Style="{DynamicResource PhasmaSubtle}" FontSize="11.5" Text="The soft coloured glow behind the window." />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MistEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Button Margin="-8,12,0,0" HorizontalAlignment="Left" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding EditColorThemeCommand}">
                        <TextBlock Text="Edit every colour in the colour theme editor" FontSize="12" Foreground="{DynamicResource PhasmaAccentBrush}" />
                    </Button>
                </StackPanel>

                <!--  Live sample: a small copy of the app window drawn with the same theme tokens, so every change above shows here at once  -->
                <Border Grid.Column="2" Padding="14" VerticalAlignment="Top" Style="{DynamicResource PhasmaPanel}" IsHitTestVisible="False" Focusable="False">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="APPLICATION" Style="{DynamicResource PhasmaCaption}" />
                            <Border HorizontalAlignment="Right" Style="{DynamicResource PhasmaTagNeutral}">
                                <TextBlock FontSize="10" Text="Updates as you drag" />
                            </Border>
                        </Grid>

                        <Border Margin="0,10,0,0" Height="196" ClipToBounds="True" CornerRadius="{DynamicResource PhasmaCornerRadius}"
                                Background="{DynamicResource PhasmaScrimBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Title bar  -->
                                <Grid Grid.Row="0" Margin="8,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource PhasmaAccentBrush}" />
                                        <TextBlock Margin="5,0,0,0" FontSize="9.5" FontWeight="SemiBold" FontFamily="{DynamicResource PhasmaHeadingFont}" Text="PhasmaStrap" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1" CornerRadius="4" Background="{DynamicResource PhasmaAccentBrush}">
                                        <TextBlock FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaAccentTextBrush}" Text="Launch" />
                                    </Border>
                                </Grid>

                                <!--  The panel every page sits on, with the side rail and a page  -->
                                <Border Grid.Row="1" Margin="6,0,6,6" Padding="6" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}"
                                        Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Border Padding="6,4" CornerRadius="5" Background="{DynamicResource PhasmaSelectedBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Games24" FontSize="10" />
                                                    <TextBlock Margin="5,0,0,0" FontSize="9.5" FontWeight="SemiBold" Text="Games" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Margin="6,6,0,0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="People24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="People" />
                                            </StackPanel>
                                            <StackPanel Margin="6,6,0,0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Gauge24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Performance" />
                                            </StackPanel>
                                            <StackPanel Margin="6,6,0,0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Flag24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="FastFlags" />
                                            </StackPanel>
                                            <StackPanel Margin="6,6,0,0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Color24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Look and feel" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <Border Style="{DynamicResource PhasmaCard}" Padding="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="5" Background="{DynamicResource PhasmaAccentSoftBrush}">
