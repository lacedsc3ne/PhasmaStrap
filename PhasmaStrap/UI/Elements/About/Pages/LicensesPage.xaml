<ui:UiPage x:Class="PhasmaStrap.UI.Elements.About.Pages.LicensesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      Title="AboutPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source={x:Static resources:Strings.Menu_About_Licenses}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" />
        <Grid Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/bloxstraplabs/bloxstrap/blob/main/LICENSE" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Bloxstrap" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
            <Button Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/lepoco/wpfui/blob/main/LICENSE" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="WPF-UI" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
            <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/securifybv/ShellLink/blob/master/LICENSE.txt" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="ShellLink" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
            <Button Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/Lachee/discord-rpc-csharp/blob/master/LICENSE" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="DiscordRPC" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/MaximumADHD/Roblox-Studio-Mod-Manager/blob/main/LICENSE" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Roblox Studio Mod Manager" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
            <Button Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/icsharpcode/SharpZipLib/blob/master/LICENSE.txt" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="SharpZipLib" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
            <Button Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/xoofx/markdig/blob/master/license.txt" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Markdig" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_BSD2}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
            <Button Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/icsharpcode/AvalonEdit/blob/master/LICENSE" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="AvalonEdit" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
            <Button Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/XamlAnimatedGif/XamlAnimatedGif/blob/master/LICENSE.txt" Style="{StaticResource PhasmaSoftButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="XamlAnimatedGif" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Licenses_Apache}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Open24" />
                </Grid>
            </Button>
        </Grid>
    </StackPanel>
</ui:UiPage>
