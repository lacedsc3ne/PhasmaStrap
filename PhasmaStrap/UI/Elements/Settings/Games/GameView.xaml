<UserControl x:Class="PhasmaStrap.UI.Elements.Settings.Games.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
             xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
             xmlns:phui="clr-namespace:PhasmaStrap.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:GameViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1180"
             d:DesignHeight="640">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="PingDot" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PingLevel}" Value="good">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingLevel}" Value="ok">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingLevel}" Value="bad">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaBadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabCount" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="7,1,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCard" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaCard}">
            <Setter Property="Padding" Value="16,14,16,13" />
        </Style>
        <Style x:Key="StatLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StatValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StatSub" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SectionBar" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="4" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="3,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PhasmaAccentBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <SkewTransform AngleX="-14" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionCount" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="12,3,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailRow" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="20,10" />
        </Style>
        <Style x:Key="DetailKey" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="DetailValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HeadText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="VirtualList" TargetType="{x:Type ItemsControl}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ItemsControl}">
                        <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScopeSwitch" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="{DynamicResource PhasmaS3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="phui:CutCorners.Size" Value="6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">

            <Grid MinHeight="240" phui:CutCorners.Size="12">
                <Border Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" />
                <Border Margin="1" Opacity="0.3">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding BannerUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=768}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border Margin="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#F50D0D12" />
                            <GradientStop Offset="0.55" Color="#C00D0D12" />
                            <GradientStop Offset="1" Color="#600D0D12" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Margin="1" Opacity="0.16">
                    <Border.Background>
                        <RadialGradientBrush Center="0.72,0.1" GradientOrigin="0.72,0.1" RadiusX="0.45" RadiusY="1.1">
                            <GradientStop Offset="0" Color="{DynamicResource PhasmaAccentColor}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Path Margin="16,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,18 L0,0 L18,0" Stroke="{DynamicResource PhasmaAccentBrush}" StrokeThickness="2" />
                <Path Margin="0,0,16,16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M18,0 L18,18 L0,18" Stroke="{DynamicResource PhasmaAccentBrush}" StrokeThickness="2" />

                <Button Margin="46,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="32" Padding="12,0" Style="{DynamicResource PhasmaGhostButton}"
                        Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" AutomationProperties.Name="Back to the catalog">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" Margin="0,0,7,0" />
                        <TextBlock Text="Catalog" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Margin="32,76,32,28" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="104" Height="104" VerticalAlignment="Bottom">
                        <Border CornerRadius="18" Background="{DynamicResource PhasmaAccentSoftBrush}" />
                        <Border CornerRadius="18" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=192}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="22,0,20,0" VerticalAlignment="Bottom">
                        <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="BY " /><Run Text="{Binding CreatorLine, Mode=OneWay, Converter={StaticResource PhasmaUpper}}" /><Run Text="  ·  UNIVERSE " /><Run Text="{Binding UniverseIdText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PlaceCountText, Mode=OneWay}" /><Run Text=" PLACES" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="38" FontWeight="Bold"
                                   Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Border Margin="0,0,8,4" Style="{DynamicResource PhasmaTagGood}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource PhasmaGoodBrush}" />
                                    <TextBlock Text="{Binding PlayingText, Converter={StaticResource PhasmaUpper}}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,4" Style="{DynamicResource PhasmaTagGood}" Visibility="{Binding VerifiedTagVisibility}">
                                <TextBlock Text="VERIFIED" />
                            </Border>
                            <Border Margin="0,0,8,4" Style="{DynamicResource PhasmaTagNeutral}" Visibility="{Binding GenreTagVisibility}">
                                <TextBlock Text="{Binding Genre, Converter={StaticResource PhasmaUpper}}" />
                            </Border>
                            <Border Margin="0,0,8,4" Style="{DynamicResource PhasmaTagNeutral}" Visibility="{Binding AgeTagVisibility}">
                                <TextBlock Text="{Binding AgeText, Converter={StaticResource PhasmaUpper}}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Margin="0,4,0,0" Text="{Binding StatsText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Button Margin="0,0,10,0" Width="40" Height="40" Padding="0" Style="{DynamicResource PhasmaGhostButton}"
                                Command="{Binding ToggleFavouriteCommand}" ToolTip="{Binding FavouriteTip}" AutomationProperties.Name="Favourite">
                            <Grid>
                                <ui:SymbolIcon Symbol="Heart24" FontSize="16" Visibility="{Binding NotFavouriteVisibility}" />
                                <ui:SymbolIcon Symbol="Heart24" Filled="True" FontSize="16" Foreground="{DynamicResource PhasmaAccentBrush}" Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                        <Button Margin="0,0,10,0" Width="40" Height="40" Padding="0" Style="{DynamicResource PhasmaGhostButton}"
                                Command="{Binding CopyLinkCommand}" ToolTip="Copy the game link" AutomationProperties.Name="Copy the game link">
                            <ui:SymbolIcon Symbol="Link24" FontSize="16" />
                        </Button>
                        <Button x:Name="MoreButton" Margin="0,0,10,0" Width="40" Height="40" Padding="0" Style="{DynamicResource PhasmaGhostButton}"
                                Click="MoreButton_Click" ToolTip="More" AutomationProperties.Name="More">
                            <ui:SymbolIcon Symbol="MoreHorizontal16" FontSize="16" />
                        </Button>

                        <Button Height="40" Padding="18,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PlayCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14" Margin="0,0,9,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="{Binding PlayText}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayMenuButton" Height="40" Margin="2,0,0,0" Padding="11,0" Style="{DynamicResource PhasmaAccentButton}"
                                Click="PlayMenuButton_Click" ToolTip="More ways to launch" AutomationProperties.Name="Choose how to launch">
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="14" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <UniformGrid Rows="1" Margin="0,20,-12,0">
                <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="PLAYING NOW" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding StatPlaying}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="LIKES" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding StatLikes}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding StatLikesDetail}" Style="{StaticResource StatSub}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="VISITS" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding StatVisits}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="FAVOURITES" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding StatFavourites}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="MAX PLAYERS" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding StatMaxPlayers}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="CREATED" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding StatCreated}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="UPDATED" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding StatUpdated}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" />
                <WrapPanel>
                    <RadioButton GroupName="GameTabs" Content="OVERVIEW" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsOverviewTab, Mode=TwoWay}" />
                    <RadioButton GroupName="GameTabs" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsPlacesTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PLACES" />
                            <TextBlock Text="{Binding Places.Count}" Style="{StaticResource TabCount}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="GameTabs" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsServersTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SERVERS" />
                            <TextBlock Text="{Binding ServerCountText}" Style="{StaticResource TabCount}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="GameTabs" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsPrivateTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PRIVATE SERVERS" />
                            <TextBlock Text="{Binding PrivateCountText}" Style="{StaticResource TabCount}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="GameTabs" Content="HISTORY" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsHistoryTab, Mode=TwoWay}" />
                    <RadioButton GroupName="GameTabs" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsPassesTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PASSES AND ITEMS" />
                            <TextBlock Text="{Binding PassCountText}" Style="{StaticResource TabCount}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="GameTabs" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsBadgesTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BADGES" />
                            <TextBlock Text="{Binding BadgeCountText}" Style="{StaticResource TabCount}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="GameTabs" Content="MEDIA" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsMediaTab, Mode=TwoWay}" />
                    <RadioButton GroupName="GameTabs" Content="SETTINGS" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsSettingsTab, Mode=TwoWay}" />
                </WrapPanel>
            </Grid>

            <Grid Margin="0,20,0,0" Visibility="{Binding OverviewTabVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <UniformGrid Columns="3" Margin="0,0,-12,16">
                        <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="YOUR PLAYTIME" Style="{StaticResource StatLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PlaytimeValue}" Style="{StaticResource StatValue}" />
                                    <TextBlock Margin="6,0,0,4" VerticalAlignment="Bottom" Text="{Binding PlaytimeUnit}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Through PhasmaStrap" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="LAST PLAYED" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{Binding LastPlayedPlace}" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="PLACE ID" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding SelectedPlaceIdText}" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{Binding SelectedPlaceCaption}" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <controls:SettingsCard Style="{StaticResource PhasmaSettingsCard}" Header="What this game starts with" Description="Applied every time you launch it through PhasmaStrap.">
                        <controls:OptionControl Flat="True" Header="Applies to" Description="Set it up for the whole game, or for one place only.">
                            <Border Width="260" Style="{StaticResource ScopeSwitch}">
                                <UniformGrid Columns="2">
                                    <RadioButton GroupName="OverviewTabScope" Margin="0" Style="{DynamicResource PhasmaSegButton}" IsChecked="{Binding WholeGame, Mode=TwoWay}">
                                        <TextBlock Text="Whole game" FontSize="12.5" />
                                    </RadioButton>
                                    <RadioButton GroupName="OverviewTabScope" Margin="0" Style="{DynamicResource PhasmaSegButton}" IsChecked="{Binding OnlyThisPlace, Mode=TwoWay}">
                                        <TextBlock Text="{Binding ScopePlaceText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                        </controls:OptionControl>
                        <controls:OptionControl Flat="True" Header="FastFlag profile" Description="{Binding ProfileNote}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox MinWidth="190" Padding="10,5,10,5" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" />
                                <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Width="34" Height="34" Padding="0" Command="{Binding EditFlagsCommand}" ToolTip="Manage profiles and their flags" AutomationProperties.Name="Manage profiles and their flags">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>
                        <controls:OptionControl Flat="True" Header="Overlay override" Description="The HUD and crosshair this place starts with.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock MaxWidth="220" VerticalAlignment="Center" Text="{Binding OverlaySummary}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <Button Margin="10,0,0,0" Padding="12,6" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditOverlayCommand}">
                                    <TextBlock Text="Change" FontSize="12.5" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>
                        <controls:OptionControl Flat="True" Header="Resolution override" Description="The screen mode this place switches to while you play.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock MaxWidth="220" VerticalAlignment="Center" Text="{Binding ResolutionSummary}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <Button Margin="10,0,0,0" Padding="12,6" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditResolutionCommand}">
                                    <TextBlock Text="Change" FontSize="12.5" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <WrapPanel Margin="0,4,0,16">
                        <Button Height="40" Margin="0,0,10,8" Padding="18,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PlayCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="Launch" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="40" Margin="0,0,10,8" Padding="16,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding CopyLinkCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Link24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Copy game link" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="40" Margin="0,0,10,8" Padding="16,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding ShowTabCommand}" CommandParameter="places">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Show places" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <UniformGrid Columns="2" Margin="0,0,-12,0">
                        <Border Style="{DynamicResource PhasmaPanel}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Margin="20,16,20,12" Text="THE BASICS" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Genre" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding GenreText}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Creator" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding CreatorLine}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Created" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding CreatedText}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Last updated" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding StatUpdated}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Place ID" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding SelectedPlaceIdText}" FontFamily="{DynamicResource PhasmaMono}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Universe ID" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding UniverseIdText}" FontFamily="{DynamicResource PhasmaMono}" Style="{StaticResource DetailValue}" /></Grid></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource PhasmaPanel}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Margin="20,16,20,12" Text="HOW IT PLAYS" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Server size" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding ServerSizeText}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Avatar type" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding AvatarTypeText}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Places" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding PlaceCountText}" Style="{StaticResource DetailValue}" /></Grid></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource PhasmaPanel}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Margin="20,16,20,12" Text="STORE AND ACCESS" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Access" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding AccessText}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Private servers" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding PrivateServersText}" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Copying" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding CopyingText}" Style="{StaticResource DetailValue}" /></Grid></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource PhasmaPanel}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Margin="20,16,20,12" Text="CHAT AND SAFETY" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Age rating" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding AgeText}" TextWrapping="Wrap" Style="{StaticResource DetailValue}" /></Grid></Border>
                                <Border Style="{StaticResource DetailRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Content" Style="{StaticResource DetailKey}" /><TextBlock Text="{Binding DescriptorsText}" TextWrapping="Wrap" Style="{StaticResource DetailValue}" /></Grid></Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{DynamicResource PhasmaPanel}">
                        <StackPanel>
                            <TextBlock Margin="20,18,20,16" Text="ABOUT THIS GAME" Style="{StaticResource CardTitle}" />
                            <Border Style="{DynamicResource PhasmaDivider}" />
                            <StackPanel Margin="20,16,20,18">
                                <TextBlock Text="{Binding StatsText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" LineHeight="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" MaxHeight="220" Text="{Binding AboutText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="13" LineHeight="21"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{DynamicResource PhasmaPanel}">
                        <StackPanel>
                            <Grid Margin="20,18,14,16">
                                <StackPanel Margin="0,0,34,0">
                                    <TextBlock Text="FRIENDS IN THIS GAME" Style="{StaticResource CardTitle}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding FriendsStatus}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshFriendsCommand}"
                                        ToolTip="Look again" AutomationProperties.Name="Refresh friends">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding FriendsInGame}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:GameFriendRow}">
                                        <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="32" Height="32">
                                                    <Border CornerRadius="16" Background="{DynamicResource PhasmaSelectedBrush}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border CornerRadius="16">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,1,0,0" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Padding="11,4" Style="{DynamicResource PhasmaAccentButton}" Visibility="{Binding JoinVisibility}"
                                                        Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="Join" FontSize="12" FontWeight="Bold" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0" phui:CutCorners.Size="9">
                        <Border Background="{DynamicResource PhasmaPanelBrush}" />
                        <Border Background="{DynamicResource PhasmaInfoBrush}" Opacity="0.07" />
                        <Border BorderBrush="{DynamicResource PhasmaInfoBrush}" BorderThickness="1" Opacity="0.3" />
                        <DockPanel Margin="16,14">
                            <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,1,12,0" VerticalAlignment="Top" Symbol="Info24" FontSize="15" Foreground="{DynamicResource PhasmaInfoBrush}" />
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Changes to flags only apply when the game starts. If Roblox is already open with other flags, PhasmaStrap can close it first. That is set on Per game flags." />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,20,0,0" Visibility="{Binding PlacesTabVisibility}">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="{Binding PlacesHeader, Converter={StaticResource PhasmaUpper}}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding PlacesTitle, Converter={StaticResource PhasmaUpper}}" Style="{StaticResource SectionCount}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Text="Most games are made of several places: a lobby, maps, a trading hub" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:TextBox
                        Grid.Column="1"
                        Width="260"
                        VerticalAlignment="Center"
                        PlaceholderText="Search places"
                        Icon="Search24"
                        ClearButtonEnabled="True"
                        Text="{Binding PlaceSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding PlaceSearchVisibility}"
                        AutomationProperties.Name="Search places" />
                </Grid>

                <Border Style="{DynamicResource PhasmaPanel}">
                    <ItemsControl Margin="0,-1,0,0" ItemsSource="{Binding Places}" MaxHeight="{Binding ViewportHeight, ElementName=PageScroll}" Style="{StaticResource VirtualList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dmodels:PlaceItem}">
                                <Border Style="{DynamicResource PhasmaTableRow}" Padding="20,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="110" Height="62">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=192}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <Border Margin="10,0,0,0" Style="{DynamicResource PhasmaTag}" Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="START PLACE" FontSize="10.5" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0" Text="{Binding DetailText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Margin="0,0,10,0" Style="{DynamicResource PhasmaSoftButton}"
                                                    Command="{Binding DataContext.ShowPlaceServersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Server24" FontSize="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="Servers" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,0,10,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                                    Command="{Binding DataContext.PlaceFlagsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Flag24" FontSize="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="Own flags for this place" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{DynamicResource PhasmaAccentButton}" Padding="16,7"
                                                    Command="{Binding DataContext.PlayPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                                    <TextBlock Text="Launch" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Margin="0,16,0,0" phui:CutCorners.Size="9">
                    <Border Background="{DynamicResource PhasmaPanelBrush}" />
                    <Border Background="{DynamicResource PhasmaInfoBrush}" Opacity="0.07" />
                    <Border BorderBrush="{DynamicResource PhasmaInfoBrush}" BorderThickness="1" Opacity="0.3" />
                    <DockPanel Margin="16,13">
                        <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,12,0" Symbol="Info24" FontSize="15" Foreground="{DynamicResource PhasmaInfoBrush}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Giving one place its own flags wins over the whole game's profile for that place." />
                    </DockPanel>
                </Grid>
                <TextBlock Margin="2,10,0,0" Text="{Binding PlaceHint}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <Grid Margin="0,20,0,0" MinHeight="520" Height="{Binding ViewportHeight, ElementName=PageScroll}" Visibility="{Binding ServersTabVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*" MinWidth="170" MaxWidth="232" />
                    <ColumnDefinition Width="0.55*" />
                    <ColumnDefinition Width="0.25*" MinWidth="230" MaxWidth="290" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource PhasmaPanel}">
                    <DockPanel Margin="12,16,12,12">
                        <TextBlock DockPanel.Dock="Top" Margin="4,0,0,10" Text="PLACES IN THIS GAME" Style="{StaticResource FieldLabel}" />

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding PrivateRailVisibility}">
                            <Border Margin="0,0,0,12" Style="{DynamicResource PhasmaDivider}" />
                            <TextBlock Margin="4,0,0,8" Text="PRIVATE SERVERS" Style="{StaticResource FieldLabel}" />
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="PrivateRail" ItemsSource="{Binding PrivateServers}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dmodels:GamePrivateServerRow}">
                                            <Button Margin="0,0,0,4" Padding="6,6" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" Style="{DynamicResource PhasmaGhostButton}"
                                                    Command="{Binding DataContext.ShowTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="private"
                                                    ToolTip="Right click to join or copy its link">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" Background="{DynamicResource PhasmaS3Brush}">
                                                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding RailText}" FontSize="11.5" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <ui:TextBox
                            DockPanel.Dock="Top"
                            Margin="0,0,0,10"
                            PlaceholderText="Search places"
                            Icon="Search24"
                            ClearButtonEnabled="True"
                            Text="{Binding PlaceSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding PlaceSearchVisibility}"
                            AutomationProperties.Name="Search places" />
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Places}"
                            SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                            ItemContainerStyle="{DynamicResource PhasmaListItem}"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type dmodels:PlaceItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Caption}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <DockPanel Grid.Column="1" Margin="16,0,16,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding RegionChips}" Focusable="False" Visibility="{Binding RegionChipsVisibility}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dmodels:RegionChip}">
                                    <ToggleButton Margin="0,0,8,8" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Globe24" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Label}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <ToggleButton Margin="0,0,8,8" Content="Ping under 80" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding PingUnder80, Mode=TwoWay}" />
                            <ToggleButton Margin="0,0,8,8" Content="Has space" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding HideFull, Mode=TwoWay}" ToolTip="Hide full servers" />
                            <ToggleButton Margin="0,0,8,8" Content="Friends inside" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding FriendsInside, Mode=TwoWay}" Visibility="{Binding FriendsInsideVisibility}" />
                            <Border Width="1" Height="20" Margin="2,0,10,8" VerticalAlignment="Center" Background="{DynamicResource PhasmaStrokeBrush}" />
                            <RadioButton Margin="0,0,8,8" GroupName="ServerSort" Content="Lowest ping" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortByPing, Mode=TwoWay}" />
                            <RadioButton Margin="0,0,8,8" GroupName="ServerSort" Content="Most players" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortByPlayers, Mode=TwoWay}" />
                            <RadioButton Margin="0,0,8,8" GroupName="ServerSort" Content="Most space" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortBySpace, Mode=TwoWay}" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding ServersBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding ServerStatus}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshServersCommand}" IsEnabled="{Binding ServersNotBusy}" ToolTip="Look again" AutomationProperties.Name="Refresh servers">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                        </Button>
                    </Grid>

                    <Border Style="{DynamicResource PhasmaPanel}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" Padding="12,11,12,10">
                                <Grid Margin="6,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" MinWidth="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="REGION" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="1" Text="PLAYERS" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="2" Text="PING" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="3" Text="FPS" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="4" Text="UPTIME" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="5" Text="FRIENDS" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="6" Width="58" />
                                </Grid>
                            </Border>

                            <ListBox
                                x:Name="ServerList"
                                Margin="6,4,6,4"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding Servers}"
                                ItemContainerStyle="{DynamicResource PhasmaListItem}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:ServerRow}">
                                        <Grid MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" MinWidth="70" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Margin="0,0,8,0" Padding="5,1" Background="{DynamicResource PhasmaS3Brush}"
                                                        Visibility="{Binding HasRegion, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Badge}" FontFamily="{DynamicResource PhasmaMono}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <TextBlock MaxWidth="90" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Region}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Text" Value="{Binding City}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasRegion}" Value="False">
                                                                    <Setter Property="Text" Value="{Binding ShortJobId}" />
                                                                    <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
                                                                    <Setter Property="FontSize" Value="11.5" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Grid Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MaxWidth="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Height="4" VerticalAlignment="Center" Stretch="Fill" StretchDirection="DownOnly">
                                                    <Grid Width="120" Height="4">
                                                        <Border Background="{DynamicResource PhasmaSelectedBrush}" />
                                                        <Border Width="{Binding FillWidth}" HorizontalAlignment="Left" Background="{DynamicResource PhasmaAccentBrush}" />
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding PlayersText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Margin="0,0,7,0" Style="{StaticResource PingDot}" />
                                                <TextBlock Text="{Binding PingText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding FpsText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding UptimeText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                            <ItemsControl Grid.Column="5" VerticalAlignment="Center" ItemsSource="{Binding Friends}" Focusable="False" ToolTip="{Binding FriendsTip}"
                                                          Visibility="{Binding HasFriends, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type dmodels:ServerFriend}">
                                                        <Grid Width="22" Height="22" Margin="0,0,-5,0">
                                                            <Border CornerRadius="11" Background="{DynamicResource PhasmaSelectedBrush}" BorderBrush="{DynamicResource PhasmaPanelBrush}" BorderThickness="1">
                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initial}" FontSize="9.5" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border CornerRadius="11">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=48}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Grid.Column="6" Width="58" Padding="0,5" Style="{DynamicResource PhasmaAccentButton}" IsEnabled="{Binding CanJoin}"
                                                    Command="{Binding DataContext.JoinServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding JoinText}" FontSize="12" FontWeight="Bold" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <Border Grid.Column="2" Style="{DynamicResource PhasmaPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" Padding="18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" Margin="0,0,14,0" Background="{DynamicResource PhasmaAccentBrush}" phui:CutCorners.Size="6">
                                    <ui:SymbolIcon Symbol="Options24" FontSize="16" Foreground="White" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Text="LAUNCH SETUP" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,16,16,16">
                                <TextBlock Text="APPLIES TO" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource ScopeSwitch}">
                                    <UniformGrid Columns="2">
                                        <RadioButton GroupName="ProfileScope" Margin="0" Style="{DynamicResource PhasmaSegButton}" IsChecked="{Binding WholeGame, Mode=TwoWay}">
                                            <TextBlock Text="Whole game" FontSize="12.5" />
                                        </RadioButton>
                                        <RadioButton GroupName="ProfileScope" Margin="0" Style="{DynamicResource PhasmaSegButton}" IsChecked="{Binding OnlyThisPlace, Mode=TwoWay}">
                                            <TextBlock Text="{Binding ScopePlaceText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>

                                <TextBlock Margin="0,18,0,8" Text="FASTFLAG PROFILE" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding ProfileNote}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Button Margin="-8,4,0,0" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="8,4" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding EditFlagsCommand}">
                                    <TextBlock Text="Manage profiles and their flags" FontSize="12.5" Foreground="{DynamicResource PhasmaRedTextBrush}" />
                                </Button>

                                <Border Margin="0,12,0,16" Style="{DynamicResource PhasmaDivider}" />

                                <TextBlock Text="OVERLAY" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding OverlaySummary}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,76,0" />
                                    <Button HorizontalAlignment="Right" Padding="11,5" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditOverlayCommand}">
                                        <TextBlock Text="Change" FontSize="12.5" />
                                    </Button>
                                </Grid>

                                <TextBlock Margin="0,18,0,8" Text="RESOLUTION" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding ResolutionSummary}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,76,0" />
                                    <Button HorizontalAlignment="Right" Padding="11,5" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditResolutionCommand}">
                                        <TextBlock Text="Change" FontSize="12.5" />
                                    </Button>
                                </Grid>

                                <StackPanel Visibility="{Binding AccountVisibility}">
                                    <TextBlock Margin="0,18,0,8" Text="ACCOUNT" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type dmodels:GameAccountOption}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="20" Height="20" Margin="0,0,8,0" CornerRadius="10" Background="{DynamicResource PhasmaAccentSoftBrush}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initial}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaRedTextBrush}" />
                                                    </Border>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding AccountNote}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <Border Margin="0,18,0,16" Style="{DynamicResource PhasmaDivider}" />

                                <Button Height="40" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding JoinBestCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                        <TextBlock Text="Join the best server" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Margin="0,10,0,0" Text="{Binding PlaceHint}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <StackPanel Margin="0,20,0,0" Visibility="{Binding PrivateTabVisibility}">
                <Grid Margin="0,0,0,18">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="PRIVATE SERVERS IN THIS GAME" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Text="{Binding PrivateStatus}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                Command="{Binding DataContext.ShowTabCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="privateservers">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open all private servers" FontSize="13" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Width="30" Height="30" Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshPrivateCommand}" ToolTip="Look again" AutomationProperties.Name="Refresh private servers">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ui:TextBox
                    Width="360"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left"
                    PlaceholderText="Search private servers by name or owner"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    Text="{Binding PrivateSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding PrivateSearchVisibility}"
                    AutomationProperties.Name="Search private servers" />
                <Border Style="{DynamicResource PhasmaPanel}" ClipToBounds="True" Visibility="{Binding PrivateRailVisibility}">
                    <ListBox
                        x:Name="PrivateList"
                        Margin="0,-1,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding PrivateServers}"
                        ItemContainerStyle="{DynamicResource PhasmaBareItem}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dmodels:GamePrivateServerRow}">
                                <Border Style="{DynamicResource PhasmaTableRow}" Padding="16,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" Background="{DynamicResource PhasmaAccentSoftBrush}">
                                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" Foreground="{DynamicResource PhasmaRedTextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Margin="0,0,8,0" HorizontalAlignment="Right" Style="{DynamicResource PhasmaTagNeutral}" Visibility="{Binding FriendVisibility}"
                                                ToolTip="The owner is one of your Roblox friends">
                                            <TextBlock Text="FRIEND" />
                                        </Border>
                                        <Border Grid.Column="3" Margin="0,0,12,0">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaTagGood}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#12FFFFFF" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText, Converter={StaticResource PhasmaUpper}}" />
                                        </Border>
                                        <Button Grid.Column="4" Padding="14,7" Style="{DynamicResource PhasmaAccentButton}"
                                                Command="{Binding DataContext.JoinPrivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                                <TextBlock Text="Join" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <Grid Margin="0,20,0,0" Visibility="{Binding HistoryTabVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Padding="22,20" Style="{DynamicResource PhasmaCard}" Visibility="{Binding HistoryEmptyVisibility}">
                        <StackPanel>
                            <ui:SymbolIcon HorizontalAlignment="Left" Symbol="History24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Margin="0,10,0,0" Text="NO SESSIONS YET" Style="{StaticResource CardTitle}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Play this game through PhasmaStrap and each visit shows up here, with the server and how long you stayed." />
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource PhasmaPanel}" Visibility="{Binding HistoryListVisibility}">
                        <StackPanel>
                            <Grid Margin="20,18,14,16">
                                <TextBlock VerticalAlignment="Center" Text="YOUR VISITS" Style="{StaticResource CardTitle}" />
                                <Button HorizontalAlignment="Right" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshHistoryCommand}"
                                        ToolTip="Look again" AutomationProperties.Name="Refresh history">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="WHEN" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="1" Text="PLACE AND SERVER" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="2" Text="TIME" HorizontalAlignment="Right" Margin="0,0,12,0" Style="{StaticResource HeadText}" />
                                    <TextBlock Grid.Column="3" Text="FPS" HorizontalAlignment="Right" Margin="0,0,12,0" Style="{StaticResource HeadText}" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Sessions}" MaxHeight="{Binding ViewportHeight, ElementName=PageScroll}" Style="{StaticResource VirtualList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:GameSessionRow}">
                                        <Border Style="{DynamicResource PhasmaTableRow}" Padding="16,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding WhenText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PlaceText}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ServerText}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding TimeText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" />
                                                <TextBlock Grid.Column="3" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding FpsText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Button Grid.Column="4" HorizontalAlignment="Right" Padding="11,5" Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding CanRejoin}"
                                                        Command="{Binding DataContext.RejoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="Rejoin" FontSize="12" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{DynamicResource PhasmaPanel}">
                        <StackPanel>
                            <StackPanel Margin="20,18,20,16">
                                <TextBlock Text="LAST 14 DAYS" Style="{StaticResource CardTitle}" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding HistorySummary}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Style="{DynamicResource PhasmaDivider}" />
                            <ItemsControl Height="100" Margin="18,16,18,18" ItemsSource="{Binding DayBars}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:GameDayBar}">
                                        <Grid Margin="2,0">
                                            <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaAccentBrush}" Opacity="0.5" />
                                            <Border Height="{Binding Height}" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaAccentBrush}" Opacity="0.8" ToolTip="{Binding Tip}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0" phui:CutCorners.Size="9">
                        <Border Background="{DynamicResource PhasmaPanelBrush}" />
                        <Border Background="{DynamicResource PhasmaInfoBrush}" Opacity="0.07" />
                        <Border BorderBrush="{DynamicResource PhasmaInfoBrush}" BorderThickness="1" Opacity="0.3" />
                        <DockPanel Margin="16,14">
                            <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,1,12,0" VerticalAlignment="Top" Symbol="Info24" FontSize="15" Foreground="{DynamicResource PhasmaInfoBrush}" />
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Sessions come from the session history on Activity. FPS needs the HUD or Instant Replay running while you play." />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,20,0,0" Visibility="{Binding PassesTabVisibility}">
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource SectionBar}" />
                        <TextBlock Text="GAME PASSES" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding PassCountText}" Style="{StaticResource SectionCount}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Text="One time purchases that unlock something in this game." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding PassesNote}" Visibility="{Binding PassesNoteVisibility}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ItemsControl Margin="0,0,-14,0" ItemsSource="{Binding Passes}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,14,14" Padding="16" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Border Width="64" Height="64" HorizontalAlignment="Left">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=150}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Margin="0,14,0,0" Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Price, StringFormat={}{0:N0} R$}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OnSale}" Value="False">
                                                        <Setter Property="Text" Value="Not for sale" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Margin="0,20,0,0" Visibility="{Binding BadgesTabVisibility}">
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource SectionBar}" />
                        <TextBlock Text="BADGES" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding BadgeCountText}" Style="{StaticResource SectionCount}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Text="Awards you can earn in this game, with how many players have them." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding BadgesNote}" Visibility="{Binding BadgesNoteVisibility}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <Border Style="{DynamicResource PhasmaPanel}">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="BADGE" Style="{StaticResource HeadText}" />
                                <TextBlock Grid.Column="2" Text="WIN RATE" Style="{StaticResource HeadText}" />
                                <TextBlock Grid.Column="3" Text="AWARDED" HorizontalAlignment="Right" Style="{StaticResource HeadText}" />
                            </Grid>
                        </Border>
                        <ItemsControl Margin="0,-1,0,0" ItemsSource="{Binding Badges}" MaxHeight="{Binding ViewportHeight, ElementName=PageScroll}" Style="{StaticResource VirtualList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource PhasmaTableRow}" Padding="16,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" HorizontalAlignment="Left" CornerRadius="21" Background="{DynamicResource PhasmaS3Brush}">
                                                <Border CornerRadius="21">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=150}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar Width="70" Maximum="100" Value="{Binding WinRate, Mode=OneWay}" Style="{DynamicResource PhasmaMiniBar}" />
                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding WinRate, StringFormat={}{0:0.0}% win rate}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Text="{Binding Awarded, StringFormat={}{0:N0} awarded}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,20,0,0" Visibility="{Binding MediaTabVisibility}">
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource SectionBar}" />
                        <TextBlock Text="MEDIA" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Text="Screenshots and videos from the game's page." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding MediaNote}" Visibility="{Binding MediaNoteVisibility}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ItemsControl Margin="0,0,-14,0" ItemsSource="{Binding Media}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,14,14" Height="190">
                                <Border Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" />
                                <Border Margin="1">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=768}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Style="{DynamicResource PhasmaTagNeutral}" Background="#D90C0C0E" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="VIDEO" Foreground="White" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Margin="0,20,0,0" Visibility="{Binding SettingsTabVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <controls:SettingsCard Style="{StaticResource PhasmaSettingsCard}" Header="What this game starts with" Description="Applied every time you launch it through PhasmaStrap.">
                        <controls:OptionControl Flat="True" Header="Applies to" Description="Set it up for the whole game, or for one place only.">
                            <Border Width="260" Style="{StaticResource ScopeSwitch}">
                                <UniformGrid Columns="2">
                                    <RadioButton GroupName="OverviewScope" Margin="0" Style="{DynamicResource PhasmaSegButton}" IsChecked="{Binding WholeGame, Mode=TwoWay}">
                                        <TextBlock Text="Whole game" FontSize="12.5" />
                                    </RadioButton>
                                    <RadioButton GroupName="OverviewScope" Margin="0" Style="{DynamicResource PhasmaSegButton}" IsChecked="{Binding OnlyThisPlace, Mode=TwoWay}">
                                        <TextBlock Text="{Binding ScopePlaceText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                        </controls:OptionControl>

                        <controls:OptionControl Flat="True" Header="FastFlag profile" Description="{Binding ProfileNote}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox MinWidth="190" Padding="10,5,10,5" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" />
                                <Button Margin="8,0,0,0" Width="34" Height="34" Padding="0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding EditFlagsCommand}" ToolTip="Manage profiles and their flags" AutomationProperties.Name="Manage profiles and their flags">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>

                        <controls:OptionControl Flat="True" Header="Overlay override" Description="The HUD and crosshair this place starts with.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock MaxWidth="220" VerticalAlignment="Center" Text="{Binding OverlaySummary}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <Button Margin="10,0,0,0" Padding="12,6" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditOverlayCommand}">
                                    <TextBlock Text="Change" FontSize="12.5" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>

                        <controls:OptionControl Flat="True" Header="Resolution override" Description="The screen mode this place switches to while you play.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock MaxWidth="220" VerticalAlignment="Center" Text="{Binding ResolutionSummary}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <Button Margin="10,0,0,0" Padding="12,6" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditResolutionCommand}">
                                    <TextBlock Text="Change" FontSize="12.5" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>

                        <controls:OptionControl Flat="True" Header="Account" Description="{Binding AccountNote}" Visibility="{Binding AccountVisibility}">
                            <ComboBox MinWidth="220" ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:GameAccountOption}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="20" Height="20" Margin="0,0,8,0" CornerRadius="10" Background="{DynamicResource PhasmaAccentSoftBrush}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initial}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaRedTextBrush}" />
                                            </Border>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{DynamicResource PhasmaPanel}">
                        <StackPanel>
                            <StackPanel Margin="20,18,20,16">
                                <TextBlock Text="SUMMARY" Style="{StaticResource CardTitle}" />
                                <TextBlock Margin="0,3,0,0" Text="What Play does right now" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Border Style="{StaticResource DetailRow}" Padding="20,12">
                                <DockPanel>
                                    <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,16,0" Symbol="Flag24" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,1,0,0" Text="{Binding ProfileNote}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource DetailRow}" Padding="20,12">
                                <DockPanel>
                                    <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,16,0" Symbol="Desktop24" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ResolutionSummary}" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,1,0,0" Text="{Binding OverlaySummary}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource DetailRow}" Padding="20,12" Visibility="{Binding AccountVisibility}">
                                <DockPanel>
                                    <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,16,0" Symbol="Person24" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedAccount.Name}" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,1,0,0" Text="{Binding AccountNote}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource DetailRow}" Padding="16,14">
                                <Button Height="40" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PlayCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                        <TextBlock Text="{Binding PlayText}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0" phui:CutCorners.Size="9">
                        <Border Background="{DynamicResource PhasmaPanelBrush}" />
                        <Border Background="{DynamicResource PhasmaInfoBrush}" Opacity="0.07" />
                        <Border BorderBrush="{DynamicResource PhasmaInfoBrush}" BorderThickness="1" Opacity="0.3" />
                        <DockPanel Margin="16,14">
                            <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,1,12,0" VerticalAlignment="Top" Symbol="Info24" FontSize="15" Foreground="{DynamicResource PhasmaInfoBrush}" />
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Changes to flags only apply when the game starts. If Roblox is already open with other flags, PhasmaStrap can close it first. That is set on Per game flags." />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
