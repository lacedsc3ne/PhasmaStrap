<UserControl x:Class="PhasmaStrap.UI.Elements.Settings.Games.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
             xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:GameViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1180"
             d:DesignHeight="640">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="PingDot" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PingLevel}" Value="good">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingLevel}" Value="ok">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingLevel}" Value="bad">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaBadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Small count next to a tab name, hidden while empty  -->
        <Style x:Key="TabCount" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Small stat card on the Overview tab  -->
        <Style x:Key="StatCard" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaCard}">
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!--  One line note with an info icon  -->
        <Style x:Key="InfoNote" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaCard}">
            <Setter Property="Background" Value="{DynamicResource PhasmaPanelBrush}" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <!--  The launch setup scope switch, used on Overview and next to the servers  -->
        <Style x:Key="ScopeSwitch" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="{DynamicResource PhasmaCornerRadiusSmall}" />
            <Setter Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Banner  -->
        <Grid Grid.Row="0" MinHeight="196" Margin="14,10,14,0">
            <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}" Background="{DynamicResource PhasmaPanelRaisedBrush}" />
            <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding BannerUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border CornerRadius="{DynamicResource PhasmaCornerRadiusLarge}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#330B0B0F" />
                        <GradientStop Offset="1" Color="#F20B0B0F" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button Margin="14,12" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,5" Foreground="White"
                    Style="{DynamicResource PhasmaGhostButton}"
                    Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                    AutomationProperties.Name="Back to the catalog">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" Margin="0,0,6,0" Foreground="White" />
                    <TextBlock Text="Catalog" FontSize="12.5" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Grid Margin="22,56,20,18" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="104" Height="104">
                    <Border CornerRadius="18" Background="{DynamicResource PhasmaSelectedBrush}" />
                    <Border CornerRadius="18" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=192}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="18,0,16,2" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Creator}" FontSize="12" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,6" Text="{Binding Name}" FontSize="30" FontWeight="Bold" FontFamily="{DynamicResource PhasmaHeadingFont}" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource PhasmaGoodBrush}" />
                        <TextBlock Text="{Binding PlayingText}" FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Margin="16,0,0,0" Text="{Binding StatsText}" FontSize="12.5" Foreground="#B3FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Text="{Binding Status}" FontSize="11.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <!--  Favourite: shows up under Favourites in the Library  -->
                    <Button Margin="0,0,8,0" Style="{DynamicResource PhasmaIconButton}" Foreground="White" Background="#660B0B0F" BorderBrush="#26FFFFFF"
                            Command="{Binding ToggleFavouriteCommand}" ToolTip="{Binding FavouriteTip}" AutomationProperties.Name="Favourite">
                        <Grid>
                            <ui:SymbolIcon Symbol="Heart24" FontSize="15" Visibility="{Binding NotFavouriteVisibility}" />
                            <ui:SymbolIcon Symbol="Heart24" Filled="True" FontSize="15" Foreground="{DynamicResource PhasmaAccentBrush}" Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button Margin="0,0,8,0" Style="{DynamicResource PhasmaIconButton}" Foreground="White" Background="#660B0B0F" BorderBrush="#26FFFFFF"
                            Command="{Binding CopyLinkCommand}" ToolTip="Copy the game link" AutomationProperties.Name="Copy the game link">
                        <ui:SymbolIcon Symbol="Link24" FontSize="15" />
                    </Button>
                    <Button x:Name="MoreButton" Margin="0,0,10,0" Style="{DynamicResource PhasmaIconButton}" Foreground="White" Background="#660B0B0F" BorderBrush="#26FFFFFF"
                            Click="MoreButton_Click" ToolTip="More" AutomationProperties.Name="More">
                        <ui:SymbolIcon Symbol="MoreHorizontal16" FontSize="15" />
                    </Button>

                    <!--  Play, with the other ways to launch under the arrow  -->
                    <Button Height="40" Padding="20,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PlayCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                            <TextBlock Text="{Binding PlayText}" FontSize="14" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayMenuButton" Height="40" Margin="1,0,0,0" Padding="10,0" Style="{DynamicResource PhasmaAccentButton}"
                            Click="PlayMenuButton_Click" ToolTip="More ways to launch" AutomationProperties.Name="Choose how to launch">
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="13" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Tabs  -->
        <StackPanel Grid.Row="1" Margin="22,12,22,10" Orientation="Horizontal">
            <RadioButton GroupName="GameTabs" Content="Overview" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsOverviewTab, Mode=TwoWay}" />
            <RadioButton GroupName="GameTabs" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsPlacesTab, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Places" />
                    <TextBlock Text="{Binding Places.Count}" Style="{StaticResource TabCount}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="GameTabs" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsServersTab, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Servers" />
                    <TextBlock Text="{Binding ServerCountText}" Style="{StaticResource TabCount}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="GameTabs" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsPrivateTab, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Private servers" />
                    <TextBlock Text="{Binding PrivateCountText}" Style="{StaticResource TabCount}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="GameTabs" Content="History" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding IsHistoryTab, Mode=TwoWay}" />
        </StackPanel>

        <Border Grid.Row="1" Height="1" Margin="14,0" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" />

        <!--  OVERVIEW  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding OverviewTabVisibility}">
            <Grid Margin="22,16,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Your playtime" Style="{DynamicResource PhasmaSubtle}" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding PlaytimeValue}" FontSize="22" FontWeight="Bold" FontFamily="{DynamicResource PhasmaHeadingFont}" />
                                    <TextBlock Margin="6,0,0,3" VerticalAlignment="Bottom" Text="{Binding PlaytimeUnit}" Style="{DynamicResource PhasmaSubtle}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Text="Through PhasmaStrap" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,12,0" Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Last played" Style="{DynamicResource PhasmaSubtle}" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding LastPlayedText}" FontSize="22" FontWeight="Bold" FontFamily="{DynamicResource PhasmaHeadingFont}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding LastPlayedPlace}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Place ID" Style="{DynamicResource PhasmaSubtle}" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding SelectedPlaceIdText}" FontSize="22" FontWeight="Bold" FontFamily="{DynamicResource PhasmaHeadingFont}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding SelectedPlaceCaption}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <controls:SettingsCard Header="What this game starts with" Description="Applied every time you launch it through PhasmaStrap.">
                        <controls:OptionControl Header="Applies to" Description="Set it up for the whole game, or for one place only.">
                            <Border Width="260" Style="{StaticResource ScopeSwitch}">
                                <UniformGrid Columns="2">
                                    <RadioButton GroupName="OverviewScope" Margin="0" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding WholeGame, Mode=TwoWay}">
                                        <TextBlock Text="Whole game" FontSize="12" />
                                    </RadioButton>
                                    <RadioButton GroupName="OverviewScope" Margin="0" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding OnlyThisPlace, Mode=TwoWay}">
                                        <TextBlock Text="{Binding ScopePlaceText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                        </controls:OptionControl>

                        <controls:OptionControl Header="FastFlag profile" Description="{Binding ProfileNote}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox MinWidth="190" Padding="10,5,10,5" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" />
                                <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" Command="{Binding EditFlagsCommand}" ToolTip="Manage profiles and their flags" AutomationProperties.Name="Manage profiles and their flags">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>

                        <controls:OptionControl Header="Overlay override" Description="The HUD and crosshair this place starts with.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock MaxWidth="220" VerticalAlignment="Center" Text="{Binding OverlaySummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                <Button Margin="10,0,0,0" Padding="10,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditOverlayCommand}">
                                    <TextBlock Text="Change" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>

                        <controls:OptionControl Header="Resolution override" Description="The screen mode this place switches to while you play.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock MaxWidth="220" VerticalAlignment="Center" Text="{Binding ResolutionSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                <Button Margin="10,0,0,0" Padding="10,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditResolutionCommand}">
                                    <TextBlock Text="Change" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </controls:OptionControl>
                    </controls:SettingsCard>

                    <WrapPanel>
                        <Button Height="40" Margin="0,0,10,8" Padding="18,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding PlayCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="Launch" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="40" Margin="0,0,10,8" Padding="16,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding CopyLinkCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Link24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Copy game link" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="40" Margin="0,0,10,8" Padding="16,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding ShowTabCommand}" CommandParameter="places">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Show places" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{DynamicResource PhasmaCard}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="About this game" FontSize="13.5" Style="{DynamicResource PhasmaHeading}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding StatsText}" Style="{DynamicResource PhasmaSubtle}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" MaxHeight="220" Text="{Binding AboutText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12.5" LineHeight="19"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!--  Friends playing it now, then friends you played it with  -->
                    <Border Margin="0,12,0,0" Style="{DynamicResource PhasmaCard}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Friends in this game" FontSize="13.5" Style="{DynamicResource PhasmaHeading}" />
                                <Button HorizontalAlignment="Right" Width="26" Height="26" Margin="0,-4" Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshFriendsCommand}"
                                        ToolTip="Look again" AutomationProperties.Name="Refresh friends">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="12" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding FriendsInGame}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:GameFriendRow}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30">
                                                <Border CornerRadius="15" Background="{DynamicResource PhasmaSelectedBrush}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <Border CornerRadius="15">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Padding="10,4" Style="{DynamicResource PhasmaSoftButton}" Visibility="{Binding JoinVisibility}"
                                                    Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="Join" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FriendsStatus}" Style="{DynamicResource PhasmaSubtle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource InfoNote}">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" Symbol="Info24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Changes to flags only apply when the game starts. If Roblox is already open with other flags, PhasmaStrap can close it first. That is set on Per game flags." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  PLACES  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding PlacesTabVisibility}">
            <StackPanel Margin="22,16,18,18">
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlacesHeader}" FontSize="14" Style="{DynamicResource PhasmaHeading}" VerticalAlignment="Center" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Most games are made of several places: a lobby, maps, a trading hub" Style="{DynamicResource PhasmaSubtle}" />
                    </StackPanel>
                    <ui:TextBox
                        Width="220"
                        HorizontalAlignment="Right"
                        PlaceholderText="Search places"
                        Icon="Search24"
                        ClearButtonEnabled="True"
                        Text="{Binding PlaceSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding PlaceSearchVisibility}"
                        AutomationProperties.Name="Search places" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Places}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:PlaceItem}">
                            <Border Margin="0,0,0,10" Padding="12" Style="{DynamicResource PhasmaCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="110" Height="62">
                                        <Border CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{DynamicResource PhasmaSelectedBrush}" />
                                        <Border CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=192}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <Border Margin="8,0,0,0" Style="{DynamicResource PhasmaTagNeutral}" Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Start place" FontSize="10.5" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding DetailText}" Style="{DynamicResource PhasmaSubtle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Margin="0,0,8,0" Style="{DynamicResource PhasmaSoftButton}"
                                                Command="{Binding DataContext.ShowPlaceServersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Server24" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Servers" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="0,0,8,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                                Command="{Binding DataContext.PlaceFlagsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Flag24" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="Own flags for this place" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource PhasmaAccentButton}"
                                                Command="{Binding DataContext.PlayPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                                <TextBlock Text="Launch" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,2,0,0" Style="{StaticResource InfoNote}">
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,10,0" Symbol="Info24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Giving one place its own flags wins over the whole game's profile for that place." />
                    </DockPanel>
                </Border>
                <TextBlock Margin="2,8,0,0" Text="{Binding PlaceHint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!--  SERVERS: places rail, public servers, launch setup  -->
        <Grid Grid.Row="2" Visibility="{Binding ServersTabVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!--  Places and subplaces  -->
            <DockPanel Grid.Column="0" Margin="12,12,0,12">
                <TextBlock DockPanel.Dock="Top" Margin="10,2,0,8" Text="PLACES IN THIS GAME" Style="{DynamicResource PhasmaCaption}" />

                <!--  Private servers in this game, under the places  -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding PrivateRailVisibility}">
                    <TextBlock Margin="10,0,0,6" Text="PRIVATE SERVERS" Style="{DynamicResource PhasmaCaption}" />
                    <ItemsControl x:Name="PrivateRail" ItemsSource="{Binding PrivateServers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dmodels:GamePrivateServerRow}">
                                <Button Margin="0,0,6,2" Padding="8,6" HorizontalContentAlignment="Stretch" Style="{DynamicResource PhasmaGhostButton}"
                                        Command="{Binding DataContext.ShowTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="private"
                                        ToolTip="Right click to join or copy its link">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PhasmaSelectedBrush}">
                                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="13" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RailText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ui:TextBox
                    DockPanel.Dock="Top"
                    Margin="6,0,6,8"
                    PlaceholderText="Search places"
                    Icon="Search24"
                    ClearButtonEnabled="True"
                    Text="{Binding PlaceSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding PlaceSearchVisibility}"
                    AutomationProperties.Name="Search places" />
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Places}"
                    SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                    ItemContainerStyle="{DynamicResource PhasmaListItem}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:PlaceItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36">
                                    <Border CornerRadius="8" Background="{DynamicResource PhasmaSelectedBrush}" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,8" Background="{DynamicResource PhasmaStrokeBrush}" />

            <DockPanel Grid.Column="1" Margin="16,12,16,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <!--  Regions, once PhasmaStrap knows where the servers are  -->
                        <ItemsControl ItemsSource="{Binding RegionChips}" Focusable="False" Visibility="{Binding RegionChipsVisibility}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dmodels:RegionChip}">
                                    <ToggleButton Style="{DynamicResource PhasmaChip}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Globe24" FontSize="12" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Label}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ToggleButton Content="Ping under 80" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding PingUnder80, Mode=TwoWay}" />
                        <ToggleButton Content="Has space" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding HideFull, Mode=TwoWay}" ToolTip="Hide full servers" />
                        <ToggleButton Content="Friends inside" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding FriendsInside, Mode=TwoWay}" Visibility="{Binding FriendsInsideVisibility}" />
                        <Border Width="1" Height="18" Margin="4,0,8,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaStrokeBrush}" />
                        <RadioButton GroupName="ServerSort" Content="Lowest ping" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortByPing, Mode=TwoWay}" />
                        <RadioButton GroupName="ServerSort" Content="Most players" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortByPlayers, Mode=TwoWay}" />
                        <RadioButton GroupName="ServerSort" Content="Most space" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding SortBySpace, Mode=TwoWay}" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                        <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding ServersBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding ServerStatus}" Style="{DynamicResource PhasmaSubtle}" />
                        <Button Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshServersCommand}" IsEnabled="{Binding ServersNotBusy}" ToolTip="Look again" AutomationProperties.Name="Refresh servers">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="12,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="REGION" Style="{DynamicResource PhasmaCaption}" />
                    <TextBlock Grid.Column="1" Text="PLAYERS" Style="{DynamicResource PhasmaCaption}" />
                    <TextBlock Grid.Column="2" Text="PING" Style="{DynamicResource PhasmaCaption}" />
                    <TextBlock Grid.Column="3" Text="FPS" Style="{DynamicResource PhasmaCaption}" />
                    <TextBlock Grid.Column="4" Text="UPTIME" Style="{DynamicResource PhasmaCaption}" />
                    <TextBlock Grid.Column="5" Text="FRIENDS" Style="{DynamicResource PhasmaCaption}" />
                    <TextBlock Grid.Column="6" Width="64" />
                </Grid>

                <ListBox
                    x:Name="ServerList"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Servers}"
                    ItemContainerStyle="{DynamicResource PhasmaListItem}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:ServerRow}">
                            <Grid MinHeight="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" MinWidth="150" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Region badge and city, or the short server ID while the region isn't known  -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Margin="0,0,8,0" Padding="5,1" CornerRadius="4" Background="{DynamicResource PhasmaSelectedBrush}"
                                            Visibility="{Binding HasRegion, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock MaxWidth="96" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Region}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="{Binding City}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRegion}" Value="False">
                                                        <Setter Property="Text" Value="{Binding ShortJobId}" />
                                                        <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
                                                        <Setter Property="FontSize" Value="11.5" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="120" Height="5" VerticalAlignment="Center">
                                        <Border CornerRadius="3" Background="{DynamicResource PhasmaSelectedBrush}" />
                                        <Border Width="{Binding FillWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource PhasmaAccentBrush}" />
                                    </Grid>
                                    <TextBlock Margin="10,0,0,0" Text="{Binding PlayersText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Margin="0,0,8,0" Style="{StaticResource PingDot}" />
                                    <TextBlock Text="{Binding PingText}" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding FpsText}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding UptimeText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <!--  Friends in this server  -->
                                <ItemsControl Grid.Column="5" VerticalAlignment="Center" ItemsSource="{Binding Friends}" Focusable="False" ToolTip="{Binding FriendsTip}"
                                              Visibility="{Binding HasFriends, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dmodels:ServerFriend}">
                                            <Grid Width="20" Height="20" Margin="0,0,-4,0">
                                                <Border CornerRadius="10" Background="{DynamicResource PhasmaSelectedBrush}" BorderBrush="{DynamicResource PhasmaPanelBrush}" BorderThickness="1">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initial}" FontSize="9.5" FontWeight="SemiBold" />
                                                </Border>
                                                <Border CornerRadius="10">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=48}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Grid.Column="6" Width="64" Padding="0,4" Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding CanJoin}"
                                        Command="{Binding DataContext.JoinServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding JoinText}" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Margin="0,8" Background="{DynamicResource PhasmaStrokeBrush}" />

            <!--  Launch setup  -->
            <ScrollViewer Grid.Column="2" Margin="1,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,14,18,14">
                    <TextBlock Margin="0,0,0,12" Text="Launch setup" Style="{DynamicResource PhasmaHeading}" />

                    <TextBlock Text="Applies to" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource ScopeSwitch}">
                        <UniformGrid Columns="2">
                            <RadioButton GroupName="ProfileScope" Margin="0" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding WholeGame, Mode=TwoWay}">
                                <TextBlock Text="Whole game" FontSize="12" />
                            </RadioButton>
                            <RadioButton GroupName="ProfileScope" Margin="0" Style="{DynamicResource PhasmaTab}" IsChecked="{Binding OnlyThisPlace, Mode=TwoWay}">
                                <TextBlock Text="{Binding ScopePlaceText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <TextBlock Margin="0,16,0,6" Text="FastFlag profile" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding ProfileNote}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Button Margin="-8,4,0,0" HorizontalAlignment="Left" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding EditFlagsCommand}">
                        <TextBlock Text="Manage profiles and their flags" FontSize="12" Foreground="{DynamicResource PhasmaAccentBrush}" />
                    </Button>

                    <Border Margin="0,10,0,12" Style="{DynamicResource PhasmaDivider}" />

                    <TextBlock Text="Overlay" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Text="{Binding OverlaySummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                        <Button HorizontalAlignment="Right" Padding="10,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditOverlayCommand}">
                            <TextBlock Text="Change" FontSize="12" />
                        </Button>
                    </Grid>

                    <TextBlock Margin="0,14,0,6" Text="Resolution" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Text="{Binding ResolutionSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                        <Button HorizontalAlignment="Right" Padding="10,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding EditResolutionCommand}">
                            <TextBlock Text="Change" FontSize="12" />
                        </Button>
                    </Grid>

                    <!--  Which saved account Play and Join use for this game  -->
                    <StackPanel Visibility="{Binding AccountVisibility}">
                        <TextBlock Margin="0,14,0,6" Text="Account" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type dmodels:GameAccountOption}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" Margin="0,0,8,0" CornerRadius="9" Background="{DynamicResource PhasmaAccentSoftBrush}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initial}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaAccentBrush}" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="0,6,0,0" Text="{Binding AccountNote}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Border Margin="0,16,0,14" Style="{DynamicResource PhasmaDivider}" />

                    <Button Height="38" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding JoinBestCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                            <TextBlock Text="Join the best server" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,8,0,0" Text="{Binding PlaceHint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  PRIVATE SERVERS  -->
        <DockPanel Grid.Row="2" Margin="22,16,18,16" Visibility="{Binding PrivateTabVisibility}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Private servers in this game" FontSize="14" Style="{DynamicResource PhasmaHeading}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding PrivateStatus}" Style="{DynamicResource PhasmaSubtle}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,0,6,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                            Command="{Binding DataContext.ShowTabCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="privateservers">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Open all private servers" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshPrivateCommand}" ToolTip="Look again" AutomationProperties.Name="Refresh private servers">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
            <ui:TextBox
                DockPanel.Dock="Top"
                Margin="0,0,0,10"
                PlaceholderText="Search private servers by name or owner"
                Icon="Search24"
                ClearButtonEnabled="True"
                Text="{Binding PrivateSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding PrivateSearchVisibility}"
                AutomationProperties.Name="Search private servers" />
            <ListBox
                x:Name="PrivateList"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding PrivateServers}"
                ItemContainerStyle="{DynamicResource PhasmaBareItem}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type dmodels:GamePrivateServerRow}">
                        <Border Margin="0,0,0,8" Padding="14,10" Style="{DynamicResource PhasmaCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource PhasmaSelectedBrush}">
                                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Margin="0,0,8,0" HorizontalAlignment="Right" Style="{DynamicResource PhasmaTagNeutral}" Visibility="{Binding FriendVisibility}"
                                        ToolTip="The owner is one of your Roblox friends">
                                    <TextBlock Text="Friend" FontSize="11" />
                                </Border>
                                <Border Grid.Column="3" Margin="0,0,14,0">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaTag}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource PhasmaSelectedBrush}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateText}" FontSize="11" />
                                </Border>
                                <Button Grid.Column="4" Padding="14,6" Style="{DynamicResource PhasmaAccentButton}"
                                        Command="{Binding DataContext.JoinPrivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                        <TextBlock Text="Join" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--  HISTORY  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HistoryTabVisibility}">
            <Grid Margin="22,16,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <!--  Empty state  -->
                    <Border Padding="22,20" Style="{DynamicResource PhasmaCard}" Visibility="{Binding HistoryEmptyVisibility}">
                        <StackPanel>
                            <ui:SymbolIcon HorizontalAlignment="Left" Symbol="History24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Margin="0,10,0,0" Text="No sessions yet" Style="{DynamicResource PhasmaHeading}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{DynamicResource PhasmaSubtle}" Text="Play this game through PhasmaStrap and each visit shows up here, with the server and how long you stayed." />
                        </StackPanel>
                    </Border>

                    <Border Padding="8,6" Style="{DynamicResource PhasmaCard}" Visibility="{Binding HistoryListVisibility}">
                        <StackPanel>
                            <Grid Margin="10,8,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="When" Style="{DynamicResource PhasmaCaption}" />
                                <TextBlock Grid.Column="1" Text="Place and server" Style="{DynamicResource PhasmaCaption}" />
                                <TextBlock Grid.Column="2" Text="Time" Style="{DynamicResource PhasmaCaption}" />
                                <TextBlock Grid.Column="3" Text="FPS" Style="{DynamicResource PhasmaCaption}" />
                                <Button Grid.Column="4" Margin="0,-8" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" Command="{Binding RefreshHistoryCommand}"
                                        ToolTip="Look again" AutomationProperties.Name="Refresh history">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:GameSessionRow}">
                                        <StackPanel>
                                            <Border Style="{DynamicResource PhasmaDivider}" />
                                            <Grid Margin="10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding WhenText}" FontSize="12.5" />
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PlaceText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ServerText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding TimeText}" FontSize="12.5" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding FpsText}" FontSize="12.5" />
                                                <Button Grid.Column="4" Padding="12,5" Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding CanRejoin}"
                                                        Command="{Binding DataContext.RejoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="Rejoin" FontSize="12" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Padding="16,14" Style="{DynamicResource PhasmaCard}">
                        <StackPanel>
                            <TextBlock Text="Last 14 days" FontSize="13.5" Style="{DynamicResource PhasmaHeading}" />
                            <ItemsControl Height="92" Margin="0,12,0,0" ItemsSource="{Binding DayBars}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:GameDayBar}">
                                        <Border Height="{Binding Height}" Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                                Background="{DynamicResource PhasmaAccentBrush}" Opacity="0.75" ToolTip="{Binding Tip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,10,0,0" Text="{Binding HistorySummary}" Style="{DynamicResource PhasmaSubtle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource InfoNote}">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" Symbol="Info24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Sessions come from the session history on Activity. FPS needs the HUD or Instant Replay running while you play." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
