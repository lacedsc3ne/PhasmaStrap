<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.CaptureReplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:CaptureViewModel, IsDesignTimeCreatable=True}"
      Title="CaptureReplayPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <!--  The key field (DataContext is the HotkeyRow): looks like a key cap, lights up while it is listening  -->
        <Style x:Key="HotkeyCaptureButton" TargetType="Button" BasedOn="{StaticResource PhasmaSoftButton}">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="ToolTip" Value="Click, then press the key or combination. Esc cancels and keeps the current hotkey." />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasGesture}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsListening}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HotkeyStatusText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,0,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!--  Small dark buttons that sit on top of a thumbnail  -->
        <Style x:Key="ThumbOverlayButton" TargetType="Button" BasedOn="{StaticResource PhasmaGhostButton}">
            <Setter Property="Background" Value="#8C000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <!--  Actions  -->
        <WrapPanel Margin="0,0,0,6">
            <Button Margin="0,0,8,6" Style="{DynamicResource PhasmaSoftButton}" ToolTip="{x:Static resources:Strings.Menu_Capture_EveryClipSearchFiltersRename}" Command="{Binding OpenClipLibraryCommand, Mode=OneTime}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="VideoClip24" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding AllClipsText}" />
                </StackPanel>
            </Button>
            <Button Margin="0,0,8,6" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding OpenReplaysFolderCommand, Mode=OneTime}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_Capture_OpenFolder}" />
                </StackPanel>
            </Button>
            <!--  What the rolling buffer holds right now, from the settings below  -->
            <TextBlock Margin="4,0,12,6" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ReplayBufferText, Mode=OneWay}"
                       ToolTip="{Binding ReplayEstimateText, Mode=OneWay}" />
            <TextBlock Margin="4,0,0,6" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ReplayStatus, Mode=OneWay}" />
        </WrapPanel>

        <controls:CardColumns Columns="3" MinColumnWidth="280">
            <controls:SettingsCard Header="Recording">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_EnableInstantReplay}" x:Name="InstantReplayOption">
                    <ui:ToggleSwitch IsChecked="{Binding InstantReplayEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Save hotkey" Description="Writes the last few seconds to a clip">
                    <StackPanel Orientation="Horizontal">
                        <!--  Uid="Capture" and Tag are used by the code behind to keep listening when this is clicked  -->
                        <Button Uid="Capture" DataContext="{Binding ReplayHotkey}" Style="{StaticResource HotkeyCaptureButton}"
                                Content="{Binding ButtonText}" Tag="{Binding}" Click="CaptureButton_Click" />
                        <Button Margin="6,0,0,0" Focusable="False" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                Content="{x:Static resources:Strings.ContextMenu_OutputConsole_Clear}"
                                IsEnabled="{Binding ReplayHotkey.HasGesture}" Tag="{Binding ReplayHotkey}" Click="ClearButton_Click" />
                    </StackPanel>
                </controls:OptionControl>

                <TextBlock Text="{Binding ReplayHotkey.StatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HotkeyStatusText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReplayHotkey.HasStatus}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ReplayHotkey.StatusIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_ClipLength}" Description="Up to 5 minutes" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="110" VerticalAlignment="Center" Minimum="5" Maximum="{Binding MaxClipSeconds, Mode=OneTime}" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding InstantReplayClipSeconds, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="34" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ClipLengthText, Mode=OneWay}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_CopyNewClipsClipboard}">
                    <ui:ToggleSwitch IsChecked="{Binding CopyReplayToClipboard, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Capture_Quality}">
                <controls:OptionControl Header="Quality preset" Description="Sets the four below together" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
                    <ComboBox Width="130" ItemsSource="{Binding PresetOptions, Mode=OneTime}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_FrameRate}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
                    <Grid MinWidth="110">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SelectedFps, Mode=OneWay}" Visibility="{Binding PresetSummaryVisibility, Mode=OneWay}" />
                        <ComboBox Width="110" HorizontalAlignment="Right" ItemsSource="{Binding FpsOptions, Mode=OneTime}" SelectedItem="{Binding SelectedFps, Mode=TwoWay}"
                                  Visibility="{Binding PresetCustomVisibility, Mode=OneWay}" />
                    </Grid>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Performance_InGameResolutionMode_Title}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
                    <Grid MinWidth="110">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SelectedResolution, Mode=OneWay}" Visibility="{Binding PresetSummaryVisibility, Mode=OneWay}" />
                        <ComboBox Width="110" HorizontalAlignment="Right" ItemsSource="{Binding ResolutionOptions, Mode=OneTime}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                  Visibility="{Binding PresetCustomVisibility, Mode=OneWay}" />
                    </Grid>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_Quality}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
                    <Grid MinWidth="110">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SelectedQuality, Mode=OneWay}" Visibility="{Binding PresetSummaryVisibility, Mode=OneWay}" />
                        <ComboBox Width="110" HorizontalAlignment="Right" ItemsSource="{Binding QualityOptions, Mode=OneTime}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                                  Visibility="{Binding PresetCustomVisibility, Mode=OneWay}" />
                    </Grid>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_EncodeGraphicsCard}" Description="Far less CPU, saves in a fraction of a second" IsEnabled="{Binding InnerContent.IsChecked, ElementName=InstantReplayOption, Mode=OneWay}">
                    <Grid MinWidth="60">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding GpuEncodingText, Mode=OneWay}" Visibility="{Binding PresetSummaryVisibility, Mode=OneWay}" />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding GpuEncoding, Mode=TwoWay}" Visibility="{Binding PresetCustomVisibility, Mode=OneWay}" />
                    </Grid>
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="Sound" Description="Needs encoding on the graphics card">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_RecordGameSound}" Description="Only what Roblox plays, not Discord or music" IsEnabled="{Binding SoundAvailable, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding RecordSound, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_RecordMyMicrophoneToo}" Description="Mixed in exactly as it sounds" IsEnabled="{Binding SoundAvailable, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding RecordMicrophone, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_Microphone}" IsEnabled="{Binding MicrophonePickerEnabled, Mode=OneWay}">
                    <ComboBox Width="150" Padding="10,5,10,5" ItemsSource="{Binding MicrophoneOptions, Mode=OneTime}" SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard controls:CardColumns.FullRow="True" Header="Latest clips">
                <!--  Empty state  -->
                <StackPanel HorizontalAlignment="Center" Margin="0,16,0,22">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReplays}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="VideoClip24" FontSize="32" Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Capture_NoReplaysSavedYet}" />
                    <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Turn on Instant Replay and press the save hotkey in game" />
                </StackPanel>

                <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding RecentReplays, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,10,12" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{x:Static resources:Strings.Common_Copy}" Command="{Binding Tag.CopyReplayCommand}" CommandParameter="{Binding DataContext}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static resources:Strings.Menu_Capture_CopyFilePath}" Command="{Binding Tag.CopyReplayPathCommand}" CommandParameter="{Binding DataContext}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Link24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{x:Static resources:Strings.Common_Open}" Command="{Binding Tag.OpenReplayCommand}" CommandParameter="{Binding DataContext}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static resources:Strings.Common_Edit}" Command="{Binding Tag.EditReplayCommand}" CommandParameter="{Binding DataContext}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static resources:Strings.Common_Rename}" Command="{Binding Tag.RenameReplayCommand}" CommandParameter="{Binding DataContext}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Rename24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static resources:Strings.Menu_Capture_ShowFolder}" Command="{Binding Tag.RevealReplayCommand}" CommandParameter="{Binding DataContext}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{x:Static resources:Strings.Common_Delete}" Command="{Binding Tag.DeleteReplayCommand}" CommandParameter="{Binding DataContext}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Grid Height="88">
                                        <Border Style="{DynamicResource PhasmaThumb}" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenReplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>
                                        <Border Margin="6" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="5" Background="#99000000" IsHitTestVisible="False" Visibility="{Binding SymbolBadgeVisibility}">
                                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="12" Foreground="White" />
                                        </Border>
                                        <!--  Clip length, read from the file and cached  -->
                                        <Border Margin="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="5" Background="#AA000000" IsHitTestVisible="False" Visibility="{Binding DurationVisibility}">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding DurationText}" />
                                        </Border>
                                        <StackPanel Margin="0,0,6,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                                            <Button Style="{StaticResource ThumbOverlayButton}" ToolTip="{x:Static resources:Strings.Menu_Capture_CopyClipClipboardReadyPasteInto}" AutomationProperties.Name="{x:Static resources:Strings.Common_Copy}"
                                                    Command="{Binding DataContext.CopyReplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Copy16" FontSize="12" />
                                            </Button>
                                            <Button Margin="4,0,0,0" Style="{StaticResource ThumbOverlayButton}" Content="{x:Static resources:Strings.Common_Edit}" ToolTip="{x:Static resources:Strings.Menu_Capture_TrimCropSlowDownSpeedUp}" Visibility="{Binding EditVisibility}"
                                                    Command="{Binding DataContext.EditReplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ThumbOverlayButton}" ToolTip="{x:Static resources:Strings.Menu_Capture_DeleteClip}" AutomationProperties.Name="{x:Static resources:Strings.Menu_Capture_DeleteClip}"
                                                    Command="{Binding DataContext.DeleteReplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete16" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding TakenDisplay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SettingsCard>
        </controls:CardColumns>

        <TextBlock Margin="2,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ReplayEstimateText, Mode=OneWay}" />
    </StackPanel>
</ui:UiPage>
