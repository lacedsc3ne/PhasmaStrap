<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.FastFlagGamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="FastFlagGamesPage"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource PhasmaCaption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </ui:UiPage.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,24,14">
                <controls:PageHeader Title="{x:Static resources:Strings.Menu_FastFlagGames_Games}" Subtitle="When you launch one through PhasmaStrap it starts with your flags plus the changes in its profile." />

                <Grid Margin="0,0,0,16" Visibility="{Binding ManagerDisabledVisibility, Mode=OneWay}">
                    <Border Background="{DynamicResource PhasmaWarnBrush}" Opacity="0.07" CornerRadius="10" />
                    <Border BorderBrush="{DynamicResource PhasmaWarnBrush}" BorderThickness="1" Opacity="0.28" CornerRadius="10" />
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource PhasmaWarnBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Text="{x:Static resources:Strings.Menu_FastFlagEditor_PhasmaStrapIsnTManagingFastFlagsRight}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource NoteText}" FontSize="12.5" Text="{x:Static resources:Strings.Menu_FastFlagEditor_AllowPhasmaStrapManageFFlagsOffEngine}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,16" Visibility="{Binding StatusVisibility}">
                    <Border Opacity="0.07" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PhasmaGoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PhasmaWarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border BorderThickness="1" Opacity="0.28" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource PhasmaGoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PhasmaWarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Checkmark24" />
                                    <Setter Property="Foreground" Value="{DynamicResource PhasmaGoodBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                            <Setter Property="Symbol" Value="Warning24" />
                                            <Setter Property="Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Grid.Column="1" Style="{StaticResource NoteText}" Text="{Binding Status}" />
                    </Grid>
                </Grid>

                <Border Margin="0,0,0,16" Padding="20,26" Style="{DynamicResource PhasmaCard}" Visibility="{Binding NoRulesVisibility}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Flag24" FontSize="30" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_FastFlagGames_NoGameHasItsOwnFlags}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,16" Padding="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PhasmaPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ItemsControl x:Name="RulesList" ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="18,14" MinHeight="72" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center" Style="{DynamicResource PhasmaThumb}" CornerRadius="8">
                                            <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                            <TextBlock Margin="0,1,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Subtitle}" />
                                            <TextBlock Margin="0,2,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ProfileSummary}" />
                                        </StackPanel>

                                        <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <ComboBox Width="150" Margin="0,2,12,2" VerticalAlignment="Center" ToolTip="{x:Static resources:Strings.Menu_FastFlagGames_ProfileGameUses}"
                                                      ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProfileId, Mode=TwoWay}" />
                                            <Button Margin="0,2,10,2" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" ToolTip="{x:Static resources:Strings.Menu_FastFlagGames_OpenGameSProfileFastFlag}"
                                                    Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Code24" FontSize="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagEditor_EditFlags}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,2,4,2" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_FastFlagGames_SeeEveryFlagGameStarts}"
                                                    AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlagGames_SeeEveryFlagGameStarts}"
                                                    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Eye24" FontSize="15" />
                                            </Button>
                                            <Button Margin="0,2,0,2" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_FastFlagGames_StopGivingGameItsOwnFlags}"
                                                    AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlagGames_StopGivingGameItsOwnFlags}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <controls:SettingsCard Header="{x:Static resources:Strings.Menu_FastFlagGames_WhenRobloxAlreadyOpen}"
                                       Description="Roblox only reads FastFlags when it starts. Joining from inside Roblox keeps the flags it started with.">
                    <Grid Margin="20,0,20,12" Visibility="{Binding TrackingOffVisibility, Mode=OneWay}">
                        <Border Background="{DynamicResource PhasmaWarnBrush}" Opacity="0.07" CornerRadius="10" />
                        <Border BorderBrush="{DynamicResource PhasmaWarnBrush}" BorderThickness="1" Opacity="0.28" CornerRadius="10" />
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource PhasmaWarnBrush}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource NoteText}" Text="{x:Static resources:Strings.Menu_FastFlagGames_ActivityTrackingOffIntegrationsPageSo}" />
                        </Grid>
                    </Grid>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_FastFlagGames_CloseRobloxFirstWhenLaunchNeeds}"
                                            Description="{x:Static resources:Strings.Menu_FastFlagGames_WhenYouClickPlayWebsiteLink}">
                        <ui:ToggleSwitch IsChecked="{Binding CloseRunningRoblox, Mode=TwoWay}" />
                    </controls:OptionControl>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Margin="0,0,14,14" Padding="20" VerticalAlignment="Top" Style="{DynamicResource PhasmaPanel}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border RenderTransformOrigin="0.5,0.5" Width="4" Height="20" Margin="3,0,12,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentBrush}">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-14" />
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="17" FontWeight="Bold" Foreground="White"
                                   Text="{Binding Source={x:Static resources:Strings.Menu_FastFlagGames_AddGame}, Converter={StaticResource PhasmaUpper}}" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" Grid.Column="0" Icon="Search24" PlaceholderText="{x:Static resources:Strings.Menu_FastFlagGames_GameNameGameLinkPlaceID}"
                                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource PhasmaSoftButton}" FontWeight="SemiBold" Command="{Binding SearchCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagGames_Find}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DockPanel Margin="0,16,0,10">
                        <ui:ProgressRing DockPanel.Dock="Right" Width="16" Height="16" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding ResultsHeader, Converter={StaticResource PhasmaUpper}}" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,10,10" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="Tile" BorderThickness="1" Background="{DynamicResource PhasmaS3Brush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                                                    <ContentPresenter />
                                                </Border>
                                                <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaAccentBrush}" Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource PhasmaStrokeStrongBrush}" />
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <Border Height="92" Background="{DynamicResource PhasmaS4Brush}" ClipToBounds="True">
                                            <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Margin="12,10,12,10">
                                            <TextBlock FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="13" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" />
                                            <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Tag}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding SelectedVisibility}">
                        <Border Padding="16,12" Background="{DynamicResource PhasmaS3Brush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" Style="{DynamicResource PhasmaThumb}" CornerRadius="8">
                                    <Image Source="{Binding Selected.IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Selected.Name}" />
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Selected" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_FastFlagGames_PickAnotherGame}"
                                        AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlagGames_PickAnotherGame}" Command="{Binding CancelAddCommand, Mode=OneTime}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,18,0,10" Style="{StaticResource Eyebrow}" Text="{Binding Source={x:Static resources:Strings.Menu_FastFlagGames_WhereShouldApply}, Converter={StaticResource PhasmaUpper}}" />
                        <RadioButton GroupName="FlagRuleScope" Content="The whole game, every place in it" IsChecked="{Binding WholeGame, Mode=TwoWay}" />
                        <DockPanel Margin="0,8,0,0">
                            <RadioButton DockPanel.Dock="Left" GroupName="FlagRuleScope" VerticalAlignment="Center" Content="Only one place" IsChecked="{Binding OnePlace, Mode=TwoWay}" />
                            <ComboBox Margin="12,0,0,0" IsEnabled="{Binding OnePlace}" ItemsSource="{Binding Places}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPlace, Mode=TwoWay}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}" Text="{Binding PlacesStatus}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource HintText}" Text="{x:Static resources:Strings.Menu_FastFlagGames_MostGamesAreMadeSeveralPlaces}" />

                        <TextBlock Margin="0,18,0,10" Style="{StaticResource Eyebrow}" Text="{Binding Source={x:Static resources:Strings.Menu_FastFlagGames_WhichFlags}, Converter={StaticResource PhasmaUpper}}" />
                        <ComboBox ItemsSource="{Binding AddProfileOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AddProfileId, Mode=TwoWay}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}" Text="{x:Static resources:Strings.Menu_FastFlagGames_NewProfileStartsEmptyOpensFast}" />

                        <TextBlock Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource PhasmaWarnBrush}" Visibility="{Binding ExistingNoteVisibility}" Text="{Binding ExistingNote}" />

                        <Button Margin="0,16,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding AddCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flag24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagGames_GiveGameItsOwnFlags}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</ui:UiPage>
