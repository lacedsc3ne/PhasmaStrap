<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.FFlagSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Dialogs"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_FFlagSearch_Title}"
        Width="1000"
        Height="700"
        MinWidth="800"
        MinHeight="600"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <base:WpfUiWindow.Resources>
        <ResourceDictionary>
            <Style x:Key="SectionHeaderStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="0,16,0,4" />
            </Style>
            <Style x:Key="DescriptionStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="CountStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolSoft" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource PhasmaSoftButton}">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style x:Key="ToolAccent" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource PhasmaAccentButton}">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <ControlTemplate x:Key="PhasmaTabsTemplate" TargetType="{x:Type TabControl}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                        <TabPanel IsItemsHost="True" />
                    </Border>
                    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>

            <Style x:Key="GridHeader" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PhasmaUpper}}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GridCell" TargetType="{x:Type DataGridCell}">
                <Setter Property="Height" Value="42" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border Padding="14,0" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PhasmaGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="AlternatingRowBackground" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}" />
                <Setter Property="CellStyle" Value="{StaticResource GridCell}" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            </Style>
            <Style x:Key="MonoCell" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="TextCell" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </base:WpfUiWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding Source={x:Static resources:Strings.Dialog_FFlagSearch_Title}, Converter={StaticResource PhasmaUpper}}" Grid.Row="0" Padding="12,8"
                     Background="{DynamicResource PhasmaChromeBrush}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Icon="pack://application:,,,/PhasmaStrap.ico" CanMaximize="True" ShowMaximize="True" ShowMinimize="True" KeyboardNavigation.TabNavigation="None" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <StackPanel Grid.Row="1" Margin="20,20,20,0">
            <StackPanel Orientation="Horizontal">
                <Border RenderTransformOrigin="0.5,0.5" Width="4" Height="20" Margin="3,0,12,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentBrush}">
                    <Border.RenderTransform>
                        <SkewTransform AngleX="-14" />
                    </Border.RenderTransform>
                </Border>
                <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="17" FontWeight="Bold" Foreground="White"
                           Text="{Binding Source={x:Static resources:Strings.Dialog_FFlagSearch_Heading}, Converter={StaticResource PhasmaUpper}}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,14" Style="{StaticResource DescriptionStyle}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_Description}" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="StatusText" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource PhasmaGoodBrush}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_StatusReady}" />
                <ProgressBar Name="LoadingProgress" Grid.Column="1" Height="3" Margin="14,0,0,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
            </Grid>
        </StackPanel>

        <TabControl Name="MainTabControl" Grid.Row="2" Margin="20,0,20,0" Template="{StaticResource PhasmaTabsTemplate}" ItemContainerStyle="{StaticResource PhasmaTabItem}">
            <TabItem Header="{Binding Source={x:Static resources:Strings.Dialog_FFlagSearch_Tab_LiveSearch}, Converter={StaticResource PhasmaUpper}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_LiveSearch_Heading}" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource DescriptionStyle}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_LiveSearch_Description}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Name="SearchTextBox" Height="38" Icon="Search32" PlaceholderText="{x:Static resources:Strings.Dialog_FFlagSearch_SearchPlaceholder}" TextChanged="SearchTextBox_TextChanged" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <CheckBox Name="TrueFlagsOnlyCheckBox" Margin="0,0,14,0" Content="{x:Static resources:Strings.Dialog_FFlagSearch_TrueOnly}" Checked="TrueFlagsOnlyCheckBox_CheckedChanged" Unchecked="TrueFlagsOnlyCheckBox_CheckedChanged" />
                                <CheckBox Name="FalseFlagsOnlyCheckBox" Margin="0,0,14,0" Content="{x:Static resources:Strings.Dialog_FFlagSearch_FalseOnly}" Checked="FalseFlagsOnlyCheckBox_CheckedChanged" Unchecked="FalseFlagsOnlyCheckBox_CheckedChanged" />
                                <ui:Button Name="AddFromSearchButton" Style="{StaticResource ToolAccent}" Content="{x:Static resources:Strings.Dialog_FFlagSearch_AddToFlags}" Click="AddFromSearchButton_Click" />
                                <ui:Button Name="ExportSearchResultsButton" Margin="0" Style="{StaticResource ToolSoft}" IsEnabled="False" Click="ExportSearchResultsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_FFlagSearch_ExportResults}" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1">
                        <DataGrid Name="SearchResultsDataGrid" Style="{StaticResource PhasmaGrid}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" MouseDoubleClick="SearchResultsDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Width="150" Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Width="180" Header="{x:Static resources:Strings.Dialog_FFlagSearch_ColumnSource}" Binding="{Binding Source}" ElementStyle="{StaticResource TextCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Name="SearchResultsCount" Grid.Row="3" Margin="0,10,0,12" Style="{StaticResource CountStyle}" Text="0" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static resources:Strings.Dialog_FFlagSearch_Tab_BulkValidation}, Converter={StaticResource PhasmaUpper}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_BulkValidation_Heading}" />

                    <StackPanel Grid.Row="1">
                        <TextBlock Style="{StaticResource DescriptionStyle}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_BulkValidation_Description}" />
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <ui:Button Name="LoadFileButton" Style="{StaticResource ToolSoft}" Click="LoadFileButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_FFlagSearch_LoadFile}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Name="ValidateButton" Style="{StaticResource ToolAccent}" Click="ValidateButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_FFlagSearch_Validate}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Name="ClearValidationButton" Style="{StaticResource ToolSoft}" Content="{x:Static resources:Strings.Dialog_FFlagSearch_Clear}" Click="ClearValidationButton_Click" />
                            <ui:Button Name="SampleFormatButton" Style="{StaticResource ToolSoft}" Click="SampleFormatButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_FFlagSearch_SampleFormat}" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                        <ui:TextBox Name="ValidationInputTextBox" Height="120" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" AcceptsReturn="True" AllowDrop="True" HorizontalScrollBarVisibility="Auto" PlaceholderText="{x:Static resources:Strings.Dialog_FFlagSearch_ValidationPlaceholder}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto">
                            <FrameworkElement.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static resources:Strings.Dialog_FFlagSearch_Paste}" InputGestureText="Ctrl+V" Click="PasteMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="{x:Static resources:Strings.Dialog_FFlagSearch_SelectAll}" InputGestureText="Ctrl+A" Click="SelectAllMenuItem_Click" />
                                    <MenuItem Header="{x:Static resources:Strings.Dialog_FFlagSearch_Clear}" Click="ClearMenuItem_Click" />
                                </ContextMenu>
                            </FrameworkElement.ContextMenu>
                        </ui:TextBox>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Margin="0,16,0,10" Style="{StaticResource SectionHeaderStyle}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_ValidationResultsHeading}" />

                    <Border Grid.Row="3" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1">
                        <DataGrid Name="ValidationResultsDataGrid" Style="{StaticResource PhasmaGrid}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Width="130" Header="{x:Static resources:Strings.Dialog_FFlagSearch_ColumnInputValue}" Binding="{Binding InputValue}" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Width="90" Header="{x:Static resources:Strings.Dialog_FFlagSearch_ColumnStatus}" Binding="{Binding Status}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextCell}">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static resources:Strings.Dialog_FFlagSearch_ValidStatus}">
                                                    <Setter Property="Foreground" Value="{DynamicResource PhasmaGoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static resources:Strings.Dialog_FFlagSearch_InvalidStatus}">
                                                    <Setter Property="Foreground" Value="{DynamicResource PhasmaRedTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="130" Header="{x:Static resources:Strings.Dialog_FFlagSearch_ColumnValidValue}" Binding="{Binding ValidValue}" ElementStyle="{StaticResource TextCell}" />
                                <DataGridTextColumn Width="200" Header="{x:Static resources:Strings.Dialog_FFlagSearch_ColumnNotes}" Binding="{Binding Notes}" ElementStyle="{StaticResource TextCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,10,0,12">
                        <TextBlock Name="ValidationResultsCount" Style="{StaticResource CountStyle}" Text="0" />
                        <ui:Button Name="ExportValidResultsButton" Margin="0" HorizontalAlignment="Right" Style="{StaticResource ToolSoft}" IsEnabled="False" Click="ExportValidResultsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_FFlagSearch_ExportValid}" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static resources:Strings.Dialog_FFlagSearch_Tab_Browse}, Converter={StaticResource PhasmaUpper}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_Browse_Heading}" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource DescriptionStyle}" Text="{x:Static resources:Strings.Dialog_FFlagSearch_Browse_Description}" />
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button Name="FetchSampleButton" Style="{StaticResource ToolAccent}" Click="FetchSampleButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_FFlagSearch_FetchSample}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Name="AddFromBrowseButton" Style="{StaticResource ToolSoft}" Content="{x:Static resources:Strings.Dialog_FFlagSearch_AddToFlags}" Click="AddFromBrowseButton_Click" />
                            <ui:Button Name="DownloadAllBrowseButton" Style="{StaticResource ToolSoft}" IsEnabled="False" Click="DownloadAllBrowseButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_FFlagSearch_DownloadAll}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Name="DownloadTrueBrowseButton" Style="{StaticResource ToolSoft}" Content="{x:Static resources:Strings.Dialog_FFlagSearch_DownloadTrueOnly}" IsEnabled="False" Click="DownloadTrueBrowseButton_Click" />
                            <ui:Button Name="DownloadFalseBrowseButton" Style="{StaticResource ToolSoft}" Margin="0" Content="{x:Static resources:Strings.Dialog_FFlagSearch_DownloadFalseOnly}" IsEnabled="False" Click="DownloadFalseBrowseButton_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1">
                        <DataGrid Name="BrowseResultsDataGrid" Style="{StaticResource PhasmaGrid}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" MouseDoubleClick="BrowseResultsDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Width="150" Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Width="180" Header="{x:Static resources:Strings.Dialog_FFlagSearch_ColumnSource}" Binding="{Binding Source}" ElementStyle="{StaticResource TextCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Name="BrowseResultsCount" Grid.Row="3" Margin="0,10,0,12" Style="{StaticResource CountStyle}" Text="0" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Name="CloseButton" MinWidth="90" Style="{StaticResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Close}" Click="CloseButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
