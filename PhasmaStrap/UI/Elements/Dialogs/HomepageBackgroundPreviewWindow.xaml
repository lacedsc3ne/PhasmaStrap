<Window
    x:Class="PhasmaStrap.UI.Elements.Dialogs.HomepageBackgroundPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    Title="Homepage background preview"
    Width="480" Height="270"
    MinWidth="240" MinHeight="135"
    Background="{DynamicResource PhasmaPanelBrush}"
    WindowStartupLocation="CenterScreen"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid">
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,12"
            Padding="8,3"
            Background="#CC0D0D12"
            BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}"
            BorderThickness="1">
            <TextBlock
                FontFamily="{DynamicResource PhasmaMono}"
                FontSize="11"
                Foreground="#B0FFFFFF"
                Text="Preview - click to close" />
        </Border>
    </Grid>
</Window>
