<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.RenderingFrameRatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="RenderingFrameRatePage"
      Scrollable="True"
      Loaded="Page_Loaded">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="Frame rate" />
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="Smoothing and limits that sit on top of the game." />

        <!--  Last session: recorded locally by the watcher while you play; hidden until there is one  -->
        <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding SessionTiles}" Visibility="{Binding SessionTilesVisibility}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:CardColumns Columns="4" MinColumnWidth="150" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource PhasmaCard}" Padding="16,14,16,12">
                        <StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Label}" />
                            <TextBlock Margin="0,4,0,8" TextTrimming="CharacterEllipsis">
                                <Run FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="22" FontWeight="SemiBold" Text="{Binding Value, Mode=OneWay}" />
                                <Run FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Unit, Mode=OneWay}" />
                            </TextBlock>
                            <ItemsControl Height="24" ItemsSource="{Binding Bars}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="1.5,0" VerticalAlignment="Bottom" Height="{Binding}" CornerRadius="2" Background="{DynamicResource PhasmaAccentBrush}" Opacity="0.75" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Caption}" ToolTip="{Binding Caption}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:CardColumns>
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Rendering_AntiAliasing}"
                                   Description="A GPU shader over the Roblox window that smooths jagged edges. Costs extra GPU time.">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_EnableAntiAliasingOverlay}" Description="{x:Static resources:Strings.Menu_Rendering_OffByDefaultSinceExtraRendering}">
                    <ui:ToggleSwitch IsChecked="{Binding AntiAliasingEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_AntiAliasingMethod}" Description="{x:Static resources:Strings.Menu_Rendering_WhichShaderTechniqueApplyOnceOverlay}">
                    <ComboBox Padding="10,5,10,5" MinWidth="140" IsEnabled="{Binding AntiAliasingEnabled}" ItemsSource="{Binding AntiAliasingMethodNames, Mode=OneTime}" SelectedIndex="{Binding AntiAliasingMethodIndex, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Rendering_FrameGeneration}"
                                   Description="Makes motion look smoother. It does not raise real FPS or cut input lag.">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_EnableFrameGeneration}" Description="{x:Static resources:Strings.Menu_Rendering_InterpolatesExtraFrameBetweenRealCaptured}">
                    <ui:ToggleSwitch IsChecked="{Binding FrameGenEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_FrameGenerationQuality}" Description="{x:Static resources:Strings.Menu_Rendering_HigherQualityCostsMoreGPUTime}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="120" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FrameGenQuality, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding FrameGenQualityDisplay, Mode=OneWay}" />
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard controls:CardColumns.FullRow="True" Header="Driver frame rate limit"
                                   Description="The NVIDIA driver limiter for the Roblox player. Zero means no limit. Same setting as on the NVIDIA tab.">
                <controls:OptionControl Header="Frames per second" Description="{Binding FrameLimitStatus, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox IntegersOnly="True" Width="110" Min="0" Max="1000" Value="{Binding DriverFrameLimit, Mode=TwoWay}" IsEnabled="{Binding FrameLimiterAvailable, Mode=OneWay}" />
                        <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaAccentButton}" Content="Apply" Command="{Binding ApplyFrameLimitCommand}" IsEnabled="{Binding FrameLimiterAvailable, Mode=OneWay}" />
                        <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_ClassicClient_Refresh}" Command="{Binding RefreshFrameLimitCommand}" IsEnabled="{Binding FrameLimiterAvailable, Mode=OneWay}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
