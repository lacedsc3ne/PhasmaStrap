<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.Dialogs.AddCustomThemeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Dialogs"
    Title="Add Custom Theme"
    Width="480"
    MinHeight="0"
    d:DataContext="{d:DesignInstance viewmodels:AddCustomThemeViewModel,
                                     IsDesignTimeCreatable=True}"
    Background="{DynamicResource PhasmaPanelBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <base:WpfUiWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <ControlTemplate x:Key="PhasmaTabsTemplate" TargetType="{x:Type TabControl}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                    <TabPanel IsItemsHost="True" />
                </Border>
                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
            </Grid>
        </ControlTemplate>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar
                Title="{Binding Source={x:Static resources:Strings.CustomTheme_Add_Title}, Converter={StaticResource PhasmaUpper}}"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Padding="12,8"
                Background="{DynamicResource PhasmaChromeBrush}"
                CanMaximize="False"
                FontFamily="{DynamicResource PhasmaMono}"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Icon="pack://application:,,,/PhasmaStrap.ico"
                KeyboardNavigation.TabNavigation="None"
                ShowMaximize="False"
                ShowMinimize="False" />
            <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

            <TabControl
                x:Name="Tabs"
                Grid.Row="1"
                Margin="20,14,20,20"
                ItemContainerStyle="{StaticResource PhasmaTabItem}"
                SelectedIndex="{Binding Path=SelectedTab, Mode=TwoWay}"
                Template="{StaticResource PhasmaTabsTemplate}">
                <TabItem Header="{Binding Source={x:Static resources:Strings.Common_CreateNew}, Converter={StaticResource PhasmaUpper}}">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static resources:Strings.Common_Name}, Converter={StaticResource PhasmaUpper}}" />
                        <TextBox Text="{Binding Path=Name, Mode=TwoWay}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12.5"
                            Foreground="{DynamicResource PhasmaRedTextBrush}"
                            Text="{Binding Path=NameError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Path=NameErrorVisibility, Mode=OneWay}" />

                        <TextBlock Margin="0,14,0,6" Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static resources:Strings.Common_Template}, Converter={StaticResource PhasmaUpper}}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Path=Templates, Mode=OneTime}"
                            Text="{Binding Path=Template, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{Binding Source={x:Static resources:Strings.Common_Import}, Converter={StaticResource PhasmaUpper}}">
                    <StackPanel Margin="0,18,0,0">
                        <Border
                            Margin="0,0,0,12"
                            Padding="12,9"
                            Background="{DynamicResource PhasmaChromeBrush}"
                            BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}"
                            BorderThickness="1"
                            Visibility="{Binding Path=FilePathVisibility}">
                            <TextBlock
                                FontFamily="{DynamicResource PhasmaMono}"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Path=FilePath}"
                                TextWrapping="Wrap" />
                        </Border>
                        <Button
                            HorizontalAlignment="Left"
                            Click="OnImportButtonClicked"
                            Style="{StaticResource PhasmaSoftButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentArrowUp16" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_ImportFromFile}" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="12.5"
                            Foreground="{DynamicResource PhasmaRedTextBrush}"
                            Text="{Binding Path=FileError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Path=FileErrorVisibility}" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Border
                Grid.Row="2"
                Padding="18,12"
                BorderBrush="{DynamicResource PhasmaStrokeBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel
                    HorizontalAlignment="Right"
                    FlowDirection="LeftToRight"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="90"
                        Content="{x:Static resources:Strings.Common_Cancel}"
                        IsCancel="True"
                        Style="{StaticResource PhasmaSoftButton}" />
                    <Button
                        MinWidth="90"
                        Margin="10,0,0,0"
                        Click="OnOkButtonClicked"
                        Content="{x:Static resources:Strings.Common_OK}"
                        IsDefault="True"
                        Style="{StaticResource PhasmaAccentButton}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</base:WpfUiWindow>
