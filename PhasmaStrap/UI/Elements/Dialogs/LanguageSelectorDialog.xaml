<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.LanguageSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Dialogs"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Installer_Title}"
        MinWidth="0"
        MinHeight="0"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Height="32"
            Padding="12,0,0,0"
            Background="{DynamicResource PhasmaChromeBrush}"
            FontFamily="{DynamicResource PhasmaMono}"
            FontSize="11"
            FontWeight="Medium"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Title="{Binding Source={x:Static resources:Strings.Installer_Title}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}"
            CanMaximize="False"
            Icon="pack://application:,,,/PhasmaStrap.ico"
            KeyboardNavigation.TabNavigation="None"
            ShowMaximize="False"
            ShowMinimize="False" />
        <Border Grid.Row="0" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" IsHitTestVisible="False" />

        <StackPanel Grid.Row="1" Margin="22,20,22,20">
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Strings.Dialog_LanguageSelector_Header}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,14" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Dialog_LanguageSelector_Subtext}" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding Languages, Mode=OneTime}" Text="{Binding SelectedLanguage, Mode=TwoWay}" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="18,12"
            Background="{DynamicResource PhasmaPanelBrush}"
            BorderBrush="{DynamicResource PhasmaStrokeBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" FlowDirection="LeftToRight" Orientation="Horizontal">
                <Button MinWidth="100" Command="{Binding SetLocaleCommand}" Content="{x:Static resources:Strings.Common_OK}" Style="{StaticResource PhasmaAccentButton}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
