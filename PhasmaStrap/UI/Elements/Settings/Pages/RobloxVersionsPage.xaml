<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.RobloxVersionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="RobloxVersionsPage">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" controls:ScrollBubbling.Enabled="True">
        <StackPanel Margin="0,0,14,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="{x:Static resources:Strings.Menu_Behaviour_RobloxVersion}" />
                <Border Margin="10,2,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                    <TextBlock Text="Launching" />
                </Border>
            </StackPanel>
            <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="Stay on a version, or go back to one still on this PC." />

            <!--  What is installed right now  -->
            <Border Margin="0,0,0,12" Padding="16,14,16,14" Style="{DynamicResource PhasmaCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" Margin="0,0,14,0" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{DynamicResource PhasmaAccentSoftBrush}">
                        <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding InstalledText}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LatestText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:CardColumns>
                <controls:SettingsCard Header="{x:Static resources:Strings.Menu_RobloxVersions_WhichVersionUse}">
                    <StackPanel Margin="0,0,0,10">
                        <RadioButton GroupName="RobloxVersionMode" Content="{x:Static resources:Strings.Menu_RobloxVersions_AlwaysNewestNormal}" IsChecked="{Binding ModeLatest, Mode=TwoWay}" />
                        <RadioButton Margin="0,8,0,0" GroupName="RobloxVersionMode" Content="Stay on the version I have now" IsChecked="{Binding ModeHold, Mode=TwoWay}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <RadioButton VerticalAlignment="Center" GroupName="RobloxVersionMode" Content="{x:Static resources:Strings.Menu_RobloxVersions_UseVersion}" IsChecked="{Binding ModePin, Mode=TwoWay}" />
                            <ComboBox MinWidth="140" MaxWidth="240" Margin="8,0,0,0" Padding="10,5,10,5" IsEnabled="{Binding ModePin}" ItemsSource="{Binding PinChoices}" DisplayMemberPath="Title" SelectedValuePath="Record.Guid" SelectedValue="{Binding PinnedVersion, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Margin="0,12,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource PhasmaWarnBrush}" Visibility="{Binding WarningVisibility}"
                                   Text="Roblox only lets recent versions into games. If an old one stops joining, switch back to Always the newest." />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Static resources:Strings.Menu_RobloxVersions_VersionsPC}">
                    <TextBlock Margin="0,0,0,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NothingKeptVisibility}"
                               Text="{x:Static resources:Strings.Menu_RobloxVersions_OnlyVersionUseHereKeepPrevious}" />

                    <ItemsControl ItemsSource="{Binding OnDisk}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{DynamicResource PhasmaDivider}" />
                                    <Grid Margin="2,10,2,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{DynamicResource PhasmaTag}" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="In use" />
                                        </Border>
                                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource PhasmaSoftButton}" Visibility="{Binding UseVisibility}"
                                                Content="{x:Static resources:Strings.Menu_RobloxVersions_UseVersion2}"
                                                Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_RobloxVersions_KeepPreviousVersionAfterUpdate}"
                                            Description="Going back is only possible to one still on this PC. Each kept version takes about 300 MB.">
                        <ui:ToggleSwitch IsChecked="{Binding KeepPrevious, Mode=TwoWay}" />
                    </controls:OptionControl>
                </controls:SettingsCard>

                <controls:SettingsCard controls:CardColumns.FullRow="True" Header="{x:Static resources:Strings.Menu_RobloxVersions_FlagsUpdates}">
                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_RobloxVersions_TellMeWhenUpdateRemovesFlags}"
                                            Description="Compares each new version with the one it replaced">
                        <ui:ToggleSwitch IsChecked="{Binding CheckFlags, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <StackPanel Margin="0,2,0,12">
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource PhasmaWarnBrush}"
                                   Visibility="{Binding MissingFlagsVisibility}" Text="{Binding MissingFlagsText}" />
                        <Button HorizontalAlignment="Left" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding CompareCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BranchCompare24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_RobloxVersions_CompareOtherVersionPC}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CompareStatus}" />
                    </StackPanel>
                </controls:SettingsCard>
            </controls:CardColumns>
        </StackPanel>
    </ScrollViewer>
</ui:UiPage>
