<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.PhasmaStrapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      d:DataContext="{d:DesignInstance Type=models:PhasmaStrapViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="BehaviourPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" VerticalAlignment="Center" Text="Account and backup" />
            <Border Style="{DynamicResource PhasmaTagNeutral}" Margin="12,0,0,0">
                <TextBlock FontSize="11" Text="PhasmaStrap" />
            </Border>
        </StackPanel>

        <!--  Account: its DataContext is a PhasmaAccountViewModel, set in the code behind  -->
        <Border x:Name="PhasmaAccountSection" Style="{DynamicResource PhasmaCard}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Margin="0,0,14,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentSoftBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" Text="{Binding AccountInitial}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{DynamicResource PhasmaHeading}" Text="{Binding AccountHeader}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding AccountDetail}" ToolTip="{Binding AccountIdTip}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding OpenProfileCommand}" Visibility="{Binding ProfileVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Profile on phasmastrap.com" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource PhasmaSoftButton}" Command="{Binding LinkRobloxCommand}" Visibility="{Binding LinkRobloxVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Link24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Link Roblox" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding AccountActionCommand}" IsEnabled="{Binding AccountActionEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding AccountActionText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <controls:CardColumns>
            <!--  Settings backup (needs an account, so it uses the account view model too)  -->
            <controls:SettingsCard Header="Settings backup"
                                   DataContext="{Binding DataContext, ElementName=PhasmaAccountSection}"
                                   Description="{Binding BackupDetail}"
                                   Visibility="{Binding BackupVisibility}">
                <controls:OptionControl Header="Back up on its own" Description="After you change something, at most hourly">
                    <ui:ToggleSwitch IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="What to include" Description="Everything adds friend notes and your games library">
                    <ComboBox MinWidth="170" Padding="10,5,10,5" ItemsSource="{Binding BackupScopes, Mode=OneTime}" SelectedItem="{Binding BackupScope, Mode=TwoWay}" />
                </controls:OptionControl>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Button Style="{DynamicResource PhasmaSoftButton}" Command="{Binding BackUpCommand}" IsEnabled="{Binding BackupEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Back up now" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding RestoreCommand}" IsEnabled="{Binding BackupEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Restore" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>

            <!--  Startup and updates  -->
            <controls:SettingsCard Header="Startup and updates">
                <controls:SettingsCard.HeaderContent>
                    <Border Style="{DynamicResource PhasmaTagNeutral}">
                        <TextBlock FontSize="11" Text="{Binding VersionTag, Mode=OneTime}" />
                    </Border>
                </controls:SettingsCard.HeaderContent>

                <!--  Which version is installed and whether a newer one is out  -->
                <controls:OptionControl Header="{Binding UpdateHeadline, Mode=OneWay}" Description="{Binding UpdateDetail, Mode=OneWay}">
                    <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Visibility="{Binding ReleaseNotesVisibility, Mode=OneWay}" Command="{Binding OpenReleaseNotesCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="What changed" />
                        </StackPanel>
                    </Button>
                </controls:OptionControl>

                <!--  Stable or Beta: App.GetLatestRelease follows it, so the updater does too  -->
                <controls:OptionControl Header="Update channel" Description="Beta gets features a week early">
                    <ComboBox MinWidth="120" Padding="10,5,10,5" ItemsSource="{Binding UpdateChannels, Mode=OneTime}" SelectedItem="{Binding UpdateChannel, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Behaviour_AutoUpdate_Title}"
                    Description="{x:Static resources:Strings.Menu_Behaviour_AutoUpdate_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding UpdateCheckingEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Behaviour_LaunchAtStartup_Title}"
                    Description="{x:Static resources:Strings.Menu_Behaviour_LaunchAtStartup_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding LaunchAtStartupEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Behaviour_MinimizeToTrayOnClose_Title}"
                    Description="{x:Static resources:Strings.Menu_Behaviour_MinimizeToTrayOnClose_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding MinimizeToTrayOnCloseEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_PhasmaStrap_DoubleClickTrayIcon}"
                    Description="{x:Static resources:Strings.Menu_PhasmaStrap_WhatDoubleClickingPhasmaStrapSIcon}">
                    <ComboBox MinWidth="140" Padding="10,5,10,5" ItemsSource="{Binding TrayDoubleClickActions, Mode=OneTime}" SelectedItem="{Binding TrayDoubleClickAction, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>
            </controls:SettingsCard>

            <!--  Privacy  -->
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_PhasmaStrap_Section_Privacy_Header}"
                                   Description="What PhasmaStrap sends back, if anything">
                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_PhasmaStrap_Analytics_Title}"
                    Description="{Binding Source={x:Static resources:Strings.Menu_PhasmaStrap_Analytics_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://phasmastrap.com/privacy'}">
                    <ui:ToggleSwitch IsChecked="{Binding AnalyticsEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Send crash reports" Description="Helps fix crashes faster. Sends the error, your Windows and PhasmaStrap version, and the last lines of the log.">
                    <ui:ToggleSwitch IsChecked="{Binding SendCrashReports, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Visibility="{Binding Path=WebEnvironmentVisibility}"
                    Header="{x:Static resources:Strings.Menu_PhasmaStrap_WebEnvironment}"
                    Description="{x:Static resources:Strings.Menu_PhasmaStrap_SiteUseMetrics}">
                    <ComboBox MinWidth="140" Padding="10,5,10,5" ItemsSource="{Binding WebEnvironments, Mode=OneWay}" SelectedValue="{Binding WebEnvironment, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <!--  Diagnostics: export, import, settings history  -->
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_PhasmaStrap_Section_Diagnostics_Header}"
                                   Description="Package up information for troubleshooting">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_PhasmaStrap_ExportData_Title}" Description="{x:Static resources:Strings.Menu_PhasmaStrap_ExportData_Description}">
                    <Button Command="{Binding ExportDataCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PhasmaSoftButton}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ElementName=ShouldExportConfig, Path=IsChecked}" Value="False" />
                                            <Condition Binding="{Binding ElementName=ShouldExportLogs, Path=IsChecked}" Value="False" />
                                            <Condition Binding="{Binding ElementName=ShouldExportSystemInfo, Path=IsChecked}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="False" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Common_Export}" />
                        </StackPanel>
                    </Button>
                </controls:OptionControl>

                <!--  What goes into the export  -->
                <WrapPanel Margin="0,0,0,10">
                    <CheckBox Margin="0,0,16,0" Name="ShouldExportConfig" Content="{x:Static resources:Strings.Menu_PhasmaStrap_ExportData_ExportConfig}" IsChecked="{Binding ShouldExportConfig}" />
                    <CheckBox Margin="0,0,16,0" Name="ShouldExportLogs" Content="{x:Static resources:Strings.Menu_PhasmaStrap_ExportData_ExportLogs}" IsChecked="{Binding ShouldExportLogs}" />
                    <CheckBox Name="ShouldExportSystemInfo" Content="{x:Static resources:Strings.Menu_PhasmaStrap_SystemInfo}" IsChecked="{Binding ShouldExportSystemInfo}" />
                </WrapPanel>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_PhasmaStrap_ImportConfig}" Description="{x:Static resources:Strings.Menu_PhasmaStrap_RestoreSettingsSavedStateFastFlagsFrom}">
                    <Button Style="{DynamicResource PhasmaSoftButton}" Command="{Binding ImportDataCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowImport24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Common_Import}" />
                        </StackPanel>
                    </Button>
                </controls:OptionControl>

                <controls:OptionControl x:Name="HistoryOption" Header="{x:Static resources:Strings.Menu_PhasmaStrap_SettingsHistory}" Description="A copy from before each round of changes">
                    <!--  HistoryExpander: checking it loads the list (handler in code behind) and shows the card below  -->
                    <ToggleButton Checked="HistoryExpander_Expanded">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource PhasmaChip}">
                                <Setter Property="Content" Value="Show" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="Hide" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </controls:OptionControl>
            </controls:SettingsCard>

            <!--  Settings history list, shown from the Diagnostics card  -->
            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_PhasmaStrap_SettingsHistory}"
                                   Description="{x:Static resources:Strings.Menu_PhasmaStrap_PhasmaStrapKeepsCopySettingsFastFlagsFrom}"
                                   Visibility="{Binding InnerContent.IsChecked, ElementName=HistoryOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsCard.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Command="{Binding RefreshBackupsCommand, Mode=OneTime}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                        </Button>
                        <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Capture_OpenFolder}" Command="{Binding OpenBackupsFolderCommand, Mode=OneTime}">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard.HeaderContent>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Margin="0,6,0,6" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NoBackupsVisibility, Mode=OneWay}" Text="{x:Static resources:Strings.Menu_PhasmaStrap_NothingHereYetFirstCopyMade}" />

                    <ItemsControl ItemsSource="{Binding Backups, Mode=OneWay}" MaxHeight="360">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" controls:ScrollBubbling.Enabled="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{DynamicResource PhasmaDivider}" />
                                    <Grid Margin="0,8,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{DynamicResource PhasmaGhostButton}"
                                                Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_PhasmaStrap_Restore}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
