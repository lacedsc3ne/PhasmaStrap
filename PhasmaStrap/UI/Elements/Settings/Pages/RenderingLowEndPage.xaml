<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.RenderingLowEndPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="RenderingLowEndPage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <Style x:Key="LevelTileLight" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaCard}">
            <Setter Property="Padding" Value="20,18,20,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLevel}" Value="Light">
                    <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelTileStrong" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaCard}">
            <Setter Property="Padding" Value="20,18,20,18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLevel}" Value="Strong">
                    <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelTilePlain" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaCard}">
            <Setter Property="Padding" Value="20,18,20,18" />
        </Style>

        <Style x:Key="LevelButtonLight" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource PhasmaSoftButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLevel}" Value="Light">
                    <Setter Property="Background" Value="{DynamicResource PhasmaAccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaAccentTextBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelButtonStrong" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource PhasmaSoftButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLevel}" Value="Strong">
                    <Setter Property="Background" Value="{DynamicResource PhasmaAccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaAccentTextBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnTagLight" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaTagBad}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLevel}" Value="Light">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnTagStrong" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaTagBad}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveLevel}" Value="Strong">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LevelTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PhasmaHeading}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="LevelText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <CollectionViewSource x:Key="ChangesByArea" Source="{Binding Changes}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Area" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Eyebrow="Performance · Rendering" Title="{x:Static resources:Strings.Menu_Rendering_LowEndMode}"
                             Subtitle="One click to make Roblox run on a weak PC: lower graphics, a tuned Roblox process, and PhasmaStrap's own heavy extras off. Turning it off puts back exactly what you had before." />

        <controls:SettingsCard Margin="0,0,0,18" Header="This PC" Description="{Binding HardwareText}">
            <StackPanel>
                <Border Margin="-20,0,-20,14" Style="{DynamicResource PhasmaDivider}" />
                <TextBlock Margin="0,0,0,18" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding RecommendationText}" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:CardColumns Columns="3" MinColumnWidth="220" Spacing="16">
            <Border Style="{StaticResource LevelTileLight}">
                <DockPanel LastChildFill="False">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                        <Border DockPanel.Dock="Right" Style="{StaticResource OnTagLight}"><TextBlock Text="ON" /></Border>
                        <TextBlock Style="{StaticResource LevelTitle}" Text="LIGHT" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,12,0,22" Style="{StaticResource LevelText}"
                               Text="Lower graphics and a tuned process. Most games still look normal." />
                    <Button DockPanel.Dock="Bottom" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource LevelButtonLight}" Content="Use Light"
                            Command="{Binding ApplyCommand, Mode=OneTime}" CommandParameter="Light" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource LevelTileStrong}">
                <DockPanel LastChildFill="False">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                        <Border DockPanel.Dock="Right" Style="{StaticResource OnTagStrong}"><TextBlock Text="ON" /></Border>
                        <TextBlock Style="{StaticResource LevelTitle}" Text="{Binding Source={x:Static resources:Strings.Menu_Rendering_Strong}, Converter={StaticResource PhasmaUpper}}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,12,0,22" Style="{StaticResource LevelText}"
                               Text="Everything Light does, plus textures, shadows and effects cut hard." />
                    <Button DockPanel.Dock="Bottom" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource LevelButtonStrong}" Content="Use Strong"
                            Command="{Binding ApplyCommand, Mode=OneTime}" CommandParameter="Strong" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource LevelTilePlain}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource LevelTitle}" Text="{Binding Source={x:Static resources:Strings.Menu_Rendering_TurnOff}, Converter={StaticResource PhasmaUpper}}" />
                    <TextBlock DockPanel.Dock="Top" Margin="0,12,0,8" Style="{StaticResource LevelText}"
                               Text="Puts back exactly what you had before." />
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,22" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource PhasmaWarnBrush}" Text="{Binding StatusText}" />
                    <Button DockPanel.Dock="Bottom" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Menu_Rendering_TurnOff}"
                            Visibility="{Binding TurnOffVisibility}" Command="{Binding TurnOffCommand, Mode=OneTime}" />
                </DockPanel>
            </Border>
        </controls:CardColumns>

        <controls:SettingsCard Margin="0,18,0,0" Header="{Binding ChangesHeader}">
            <controls:SettingsCard.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{DynamicResource PhasmaChip}" Content="{x:Static resources:Strings.Menu_Rendering_ShowLight}"
                                  IsChecked="{Binding PreviewIsLight, Mode=OneWay}" Command="{Binding ShowCommand, Mode=OneTime}" CommandParameter="Light" />
                    <ToggleButton Style="{DynamicResource PhasmaChip}" Margin="0" Content="{x:Static resources:Strings.Menu_Rendering_ShowStrong}"
                                  IsChecked="{Binding PreviewIsStrong, Mode=OneWay}" Command="{Binding ShowCommand, Mode=OneTime}" CommandParameter="Strong" />
                </StackPanel>
            </controls:SettingsCard.HeaderContent>

            <StackPanel>
                <Border Margin="-20,0,-20,16" Style="{DynamicResource PhasmaDivider}" />
                <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding Source={StaticResource ChangesByArea}, Path=Groups}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CardColumns Columns="3" MinColumnWidth="200" Spacing="28" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Margin="0,0,0,6" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" />
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid Margin="0,10,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaGoodBrush}" />
                                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" TextWrapping="Wrap" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Text="{Binding What, Mode=OneWay}" ToolTip="{Binding Area, Mode=OneWay}" />
                                                </Grid>
                                                <Border Style="{DynamicResource PhasmaDivider}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:SettingsCard>
    </StackPanel>
</ui:UiPage>
