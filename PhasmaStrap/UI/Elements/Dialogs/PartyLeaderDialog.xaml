<Window x:Class="PhasmaStrap.UI.Elements.Dialogs.PartyLeaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Make party leader"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource PhasmaBody}"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!--  Dims the app behind it, like the in-app dialogs in the mockups; a click outside the card cancels  -->
    <Grid x:Name="Scrim" Background="#8C000000" MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
        <Border x:Name="Card" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,22,22,20"
                Style="{DynamicResource PhasmaPopupSurface}" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource PhasmaSelectedBrush}" />
                        <TextBlock x:Name="InitialText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="?" />
                        <Ellipse x:Name="AvatarEllipse" Visibility="Collapsed" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SubtitleText" Margin="0,3,0,0" Style="{DynamicResource PhasmaSubtle}" FontSize="12" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:SymbolIcon Grid.Row="0" Grid.Column="0" Symbol="Play24" Filled="True" FontSize="13" Margin="0,1,12,0" VerticalAlignment="Top" Foreground="{DynamicResource PhasmaAccentBrush}" />
                    <TextBlock x:Name="LinePicks" Grid.Row="0" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />

                    <ui:SymbolIcon Grid.Row="1" Grid.Column="0" Symbol="People24" FontSize="14" Margin="0,11,12,0" VerticalAlignment="Top" Foreground="{DynamicResource PhasmaAccentBrush}" />
                    <TextBlock x:Name="LineStay" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" />

                    <ui:SymbolIcon Grid.Row="2" Grid.Column="0" Symbol="ArrowSwap24" FontSize="14" Margin="0,11,12,0" VerticalAlignment="Top" Foreground="{DynamicResource PhasmaAccentBrush}" />
                    <TextBlock x:Name="LineBack" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" />
                </Grid>

                <Border Margin="0,18,0,0" Padding="14,10" Style="{DynamicResource PhasmaCard}" Background="{DynamicResource PhasmaHoverBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="NoteText" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource PhasmaSubtle}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
                    </Grid>
                </Border>

                <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Padding="16,8" Content="Cancel" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Margin="8,0,0,0" Style="{DynamicResource PhasmaAccentButton}" Padding="16,8" Click="Confirm_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonSwap24" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Make leader" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
