<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.CaptureLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:CaptureLibraryPageViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="CaptureLibraryPage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <!--  Kind filter chips: RadioButtons so one stays lit  -->
        <Style x:Key="KindChip" TargetType="RadioButton" BasedOn="{StaticResource PhasmaChip}">
            <Setter Property="GroupName" Value="LibraryKind" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!--  Equal width buttons in the detail panel  -->
        <Style x:Key="DetailButton" TargetType="Button" BasedOn="{StaticResource PhasmaSoftButton}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!--  Thumbnail frame that lights up when its capture is picked  -->
        <Style x:Key="TileFrame" TargetType="Border" BasedOn="{StaticResource PhasmaThumb}">
            <Setter Property="CornerRadius" Value="{DynamicResource PhasmaCornerRadiusSmall}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:UiPage.Resources>

    <!--  Focusable so Delete, F2, Enter and Ctrl C work on the picked capture  -->
    <Grid x:Name="LibraryRoot" Margin="0,0,14,14" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!--  Left: filters and the grid  -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,6" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StorageText, Mode=OneWay}" />

                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource KindChip}" Content="Everything" IsChecked="{Binding ShowEverything, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource KindChip}" Content="Clips" IsChecked="{Binding ShowClips, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource KindChip}" Content="{x:Static resources:Strings.Menu_Capture_Screenshots}" IsChecked="{Binding ShowScreenshots, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource KindChip}" Content="GIFs" IsChecked="{Binding ShowGifs, Mode=TwoWay}" />
                    <ComboBox Width="170" Margin="4,0,0,6" ItemsSource="{Binding GameOptions}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" ToolTip="Only captures from this game" />
                </WrapPanel>
            </DockPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Margin="0,0,10,0" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CountText, Mode=OneWay}" />
                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status, Mode=OneWay}" />
            </WrapPanel>

            <Grid>
                <!--  Empty state  -->
                <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding EmptyVisibility}">
                    <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="32" Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" MaxWidth="320" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding EmptyText, Mode=OneWay}" />
                </StackPanel>

                <ScrollViewer x:Name="LibraryScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Margin="0,0,0,10" Style="{DynamicResource PhasmaHeading}" FontSize="14" Text="{Binding Title}" />
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="188" Margin="0,0,12,14" Background="Transparent" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding FileName}"
                                                            MouseLeftButtonDown="Tile_MouseLeftButtonDown">
                                                        <StackPanel>
                                                            <Grid Height="106">
                                                                <Border Style="{StaticResource TileFrame}">
                                                                    <Grid>
                                                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}" />
                                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="15" Background="#99000000" IsHitTestVisible="False" Visibility="{Binding PlayVisibility}">
                                                                    <ui:SymbolIcon Symbol="Play12" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Border Margin="7" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="5" Background="#AA000000" IsHitTestVisible="False">
                                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding TagText}" />
                                                                </Border>
                                                            </Grid>
                                                            <DockPanel Margin="1,6,1,0">
                                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding WhenText}" />
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding GameText}" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button HorizontalAlignment="Center" Margin="0,0,0,12" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding ShowMoreCommand}" Visibility="{Binding MoreVisibility}"
                                Content="{Binding MoreText}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!--  Right: the picked capture  -->
        <Border Grid.Column="1" Padding="16,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
            <Grid>
                <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding NoDetailVisibility}">
                    <ui:SymbolIcon Symbol="Image24" FontSize="28" Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" MaxWidth="220" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Pick a capture to see it here. Double click opens it, right click shows everything you can do." />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding DetailVisibility}">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Height="170" Style="{DynamicResource PhasmaThumb}" Cursor="Hand" MouseLeftButtonDown="Preview_MouseLeftButtonDown" ToolTip="Open">
                            <Grid>
                                <ui:SymbolIcon Symbol="{Binding Selected.Symbol}" FontSize="28" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" Background="#99000000" IsHitTestVisible="False" Visibility="{Binding Selected.PlayVisibility}">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel DockPanel.Dock="Top" Margin="0,12,0,12">
                            <TextBlock Style="{DynamicResource PhasmaHeading}" FontSize="14" Text="{Binding Selected.GameText}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Selected.KindText}" />
                            <TextBlock Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DetailMeta}" />
                            <TextBlock Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Selected.FileName}" ToolTip="{Binding Selected.Path}" />
                        </StackPanel>

                        <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,-8,0">
                            <Button Style="{StaticResource DetailButton}" Command="{Binding EditCommand}" Visibility="{Binding EditVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Edit}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DetailButton}" Command="{Binding CopyCommand}" ToolTip="Ready to paste into a chat with Ctrl V">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Copy}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DetailButton}" Command="{Binding ShareCommand}" Visibility="{Binding ShareVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Share24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Share to gallery" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DetailButton}" Command="{Binding RevealCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Capture_ShowFolder}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DetailButton}" Command="{Binding OpenCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Open}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DetailButton}" Command="{Binding RenameCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Rename24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Rename}" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!--  Applied when a screenshot is shared to the gallery  -->
                        <controls:SettingsCard DockPanel.Dock="Top" Margin="0,4,0,0" Header="Before sharing" Visibility="{Binding ShareVisibility}">
                            <controls:OptionControl Header="Hide names" Description="Blurs the chat and player list, where usernames show">
                                <ui:ToggleSwitch IsChecked="{Binding Capture.ShareHideNames, Mode=TwoWay}" />
                            </controls:OptionControl>
                            <controls:OptionControl Header="Stamp game and time" Description="Small label in the corner">
                                <ui:ToggleSwitch IsChecked="{Binding Capture.ShareStamp, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </controls:SettingsCard>

                        <Button DockPanel.Dock="Top" Margin="0,12,0,0" HorizontalAlignment="Left" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                Foreground="{DynamicResource PhasmaBadBrush}" Command="{Binding DeleteCommand}" ToolTip="Moves it to the Recycle Bin">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Common_Delete}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ui:UiPage>
