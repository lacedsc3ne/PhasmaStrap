<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="NotificationsPage"
      Scrollable="True"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Notifications_Title}" />
            <Border Style="{DynamicResource PhasmaTagNeutral}" Margin="12,0,0,0">
                <TextBlock FontSize="11" Text="Look and feel" />
            </Border>
        </StackPanel>
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="{Binding SummaryText, Mode=OneWay}" />

        <controls:CardColumns>
            <!--  General: master switch, placement and a test button  -->
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Notifications_General_Title}">
                <controls:OptionControl
                    x:Name="EnabledOption"
                    Header="{x:Static resources:Strings.Menu_Notifications_Enabled_Title}"
                    Description="{x:Static resources:Strings.Menu_Notifications_Enabled_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Notifications_DoNotDisturb}"
                    Description="{x:Static resources:Strings.Menu_Notifications_SuppressesScreenToastPopupRestSession}"
                    IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding DoNotDisturbEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Corner to start from" Description="They follow the screen Roblox is on"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <ComboBox MinWidth="140" Padding="10,5,10,5" ItemsSource="{Binding NotificationPositionOptions, Mode=OneTime}" SelectedIndex="{Binding NotificationPositionIndex, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Distance from the side" Description="In pixels"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="120" Minimum="0" Maximum="1200" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding NotificationOffsetX, Mode=TwoWay}" />
                        <TextBlock Width="40" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding NotificationOffsetX}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="Distance from the top or bottom" Description="In pixels, from the edge you picked"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="120" Minimum="0" Maximum="1200" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding NotificationOffsetY, Mode=TwoWay}" />
                        <TextBlock Width="40" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding NotificationOffsetY}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="Width" Description="How wide each pop up is, in pixels"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="120" Minimum="300" Maximum="700" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding NotificationWidth, Mode=TwoWay}" />
                        <TextBlock Width="40" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding NotificationWidth}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="Try it" Description="{Binding PlacementSummary, Mode=OneWay}"
                                        IsEnabled="{Binding InnerContent.IsChecked, ElementName=EnabledOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource PhasmaSoftButton}" Command="{Binding SendTestNotificationCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Notifications_SendTestNotification}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="Reset placement" Command="{Binding ResetPlacementCommand}">
                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>

            <!--  Every kind of pop up, grouped, with its own switch where there is one  -->
            <controls:SettingsCard Header="Everything that can pop up" Description="And what sets it off. Hover one to see when it shows.">
                <Border Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding Catalogue, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <Border Style="{DynamicResource PhasmaDivider}" Margin="0,0,0,8" />
                                    <TextBlock Style="{DynamicResource PhasmaCaption}" Margin="0,0,0,2" Text="{Binding Name}" />
                                    <ItemsControl ItemsSource="{Binding Kinds, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="30" Background="Transparent" ToolTip="{Binding Trigger}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Name}" />
                                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                                     IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                                     Visibility="{Binding HasToggle, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                     IsEnabled="{Binding DataContext.NotificationsEnabled, RelativeSource={RelativeSource AncestorType=ui:UiPage}, Mode=OneWay}" />
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasToggle}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border Style="{DynamicResource PhasmaTagNeutral}">
                                                            <TextBlock FontSize="10" Text="Always on" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </controls:SettingsCard>

            <!--  History of what has popped up this session  -->
            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_Notifications_History_Title}"
                                   Description="{x:Static resources:Strings.Menu_Notifications_HistoryOnlyShowsNotificationsFiredBy}">
                <controls:SettingsCard.HeaderContent>
                    <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ClearHistoryCommand, Mode=OneTime}" IsEnabled="{Binding HasHistory}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Notifications_History_Clear}" />
                        </StackPanel>
                    </Button>
                </controls:SettingsCard.HeaderContent>

                <Border Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Margin="0,6,0,6" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Notifications_History_Empty}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{DynamicResource PhasmaDivider}" />
                                        <Grid Margin="0,8,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
