<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ActivityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ActivityViewModel, IsDesignTimeCreatable=False}"
      Title="ActivityPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <!--  One bar of the small playtime charts; the exact value is in the tooltip  -->
        <DataTemplate x:Key="ActivityChartBar">
            <Grid Height="92" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="{Binding Height}" Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Opacity="{Binding Opacity}" Background="{DynamicResource PhasmaAccentBrush}" />
                <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Label}" />
            </Grid>
        </DataTemplate>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!--  Totals and refresh  -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource PhasmaSubtle}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" Text="{Binding TotalsText, Mode=OneWay}" />
                <TextBlock Margin="0,3,0,0" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" TextWrapping="Wrap" TextTrimming="None" Text="{Binding TrackedSinceText, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding RefreshCommand, Mode=OneTime}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Timeline  -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <Border Style="{DynamicResource PhasmaCard}" Padding="24,30" Visibility="{Binding TimelineEmptyVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Timeline24" FontSize="36" Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Style="{DynamicResource PhasmaSubtle}" FontSize="13"
                               Text="{x:Static resources:Strings.Menu_Activity_NoSessionsYetTheyAppearHere}" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="SessionsList" ItemsSource="{Binding Sessions, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Header}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding Summary}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Visits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Style="{DynamicResource PhasmaCard}" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="46" Height="46" VerticalAlignment="Center" Style="{DynamicResource PhasmaThumb}" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}">
                                                    <Border.Clip>
                                                        <RectangleGeometry Rect="0,0,46,46" RadiusX="8" RadiusY="8" />
                                                    </Border.Clip>
                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,1,0,0" Style="{DynamicResource PhasmaSubtle}" FontSize="11.5" Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource PhasmaGoodBrush}" Text="{Binding FriendsText}" Visibility="{Binding FriendsVisibility}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding SparkVisibility}">
                                                    <Viewbox Width="150" Height="30" Stretch="Fill">
                                                        <Canvas Width="260" Height="36" ClipToBounds="True">
                                                            <Polyline Points="{Binding Spark}" Stroke="{DynamicResource PhasmaAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Margin="0,3,0,0" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding FpsText}" />
                                                </StackPanel>

                                                <ItemsControl Grid.Column="3" Margin="12,0,0,0" MaxWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Captures}" Visibility="{Binding CapturesVisibility}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2,4,2" Height="30" MinWidth="44" CornerRadius="6" ToolTip="{Binding FileName}" Cursor="Hand"
                                                                    Background="{DynamicResource PhasmaSelectedBrush}" ClipToBounds="True">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenCaptureCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                                                                </Border.InputBindings>
                                                                <Grid>
                                                                    <Image Source="{Binding Thumbnail}" Height="30" Stretch="Uniform" Visibility="{Binding ThumbnailVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Margin="13,0" VerticalAlignment="Center" Visibility="{Binding IconVisibility}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="2,4,0,0" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" TextWrapping="Wrap" TextTrimming="None" Text="{x:Static resources:Strings.Menu_Activity_FPSLineNeedsSomethingWatchesGame}" />
        </StackPanel>

        <!--  Side panel  -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,0">
            <controls:SettingsCard Header="Playtime in detail">
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Margin="0,0,0,6" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{x:Static resources:Strings.Menu_Activity_Last14Days}" />
                    <ItemsControl ItemsSource="{Binding Days, Mode=OneWay}" ItemTemplate="{StaticResource ActivityChartBar}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Margin="0,14,0,6" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{x:Static resources:Strings.Menu_Activity_Last12Weeks}" />
                    <ItemsControl ItemsSource="{Binding Weeks, Mode=OneWay}" ItemTemplate="{StaticResource ActivityChartBar}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Margin="0,14,0,0" Style="{DynamicResource PhasmaDivider}" />
                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Activity_ByGame}" />
                        <ComboBox Grid.Column="1" Width="130" Padding="10,5,10,5" ItemsSource="{Binding RangeOptions, Mode=OneTime}" SelectedItem="{Binding SelectedRange, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Margin="0,4,0,4" Style="{DynamicResource PhasmaSubtle}" Visibility="{Binding GamesEmptyVisibility, Mode=OneWay}" Text="{x:Static resources:Strings.Menu_Activity_NothingPlayedPeriod}" />

                    <ItemsControl ItemsSource="{Binding Games, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,6" ToolTip="{Binding Detail}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaThumb}" CornerRadius="6">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,26,26" RadiusX="6" RadiusY="6" />
                                        </Border.Clip>
                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Style="{DynamicResource PhasmaSubtle}" Text="{Binding TimeText}" />
                                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Height="3" HorizontalAlignment="Left" CornerRadius="2"
                                            Width="{Binding Width}" Background="{DynamicResource PhasmaAccentBrush}" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Activity_Played}" Description="Friends who turned up in the same servers as you.">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Margin="0,0,0,6" Style="{DynamicResource PhasmaSubtle}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="None" Visibility="{Binding CompanionsEmptyVisibility, Mode=OneWay}" Text="{Binding CompanionsEmptyText, Mode=OneWay}" />

                    <ItemsControl ItemsSource="{Binding Companions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="30" Height="30" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource PhasmaSelectedBrush}" />
                                        <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Clip>
                                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                        <TextBlock Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding Together}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Activity_NoteWhichFriendsShareMyServer}" Description="{x:Static resources:Strings.Menu_Activity_WhileYouAreGamePhasmaStrapAsks}">
                    <ui:ToggleSwitch IsChecked="{Binding TrackFriends, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="Session history" Description="Kept on this PC only.">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Activity_KeepSessionHistory}" Description="{x:Static resources:Strings.Menu_Activity_WritesDownEachServerYouJoin}">
                    <ui:ToggleSwitch IsChecked="{Binding HistoryEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <StackPanel Margin="0,0,0,10">
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                            ToolTip="{x:Static resources:Strings.Menu_Activity_RemovesEveryRecordedSessionScreenshotsClips}" Command="{Binding ClearHistoryCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Activity_DeleteHistory}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>
    </Grid>
</ui:UiPage>
