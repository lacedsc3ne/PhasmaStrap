<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:HistoryViewModel, IsDesignTimeCreatable=True}"
      Title="HistoryPage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <Style x:Key="ShareBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource PhasmaS4Brush}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource PhasmaAccentBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:PageHeader Grid.Row="0" Eyebrow="Games" Title="History" Subtitle="{Binding SummaryText, Mode=OneWay}">
        <Button Height="40" Padding="18,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding RefreshCommand, Mode=OneTime}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" Margin="0,0,8,0" />
                <TextBlock Text="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </controls:PageHeader>
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,20,0" LastChildFill="True">

            <Border DockPanel.Dock="Top" Padding="26,22" Style="{DynamicResource PhasmaCard}" Visibility="{Binding EmptyVisibility}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Left" Symbol="History24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static resources:Strings.Menu_Home_NoHistoryYet}, Converter={StaticResource PhasmaUpper}}" Style="{DynamicResource PhasmaHeading}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StatusText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource PhasmaPanel}" VerticalAlignment="Top"><ItemsControl Margin="0,-1,0,0" ItemsSource="{Binding Entries, Mode=OneWay}" Focusable="False"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="{x:Type ItemsControl}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource PhasmaTableRow}" Padding="16,10" MinHeight="60">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="38" Background="{DynamicResource PhasmaS3Brush}">
                                    <Border>
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,1,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding TotalTimeText, Mode=OneWay}" />
                                        <Run Text="{x:Static resources:Strings.Menu_History_PlayedLastPlayed}" />
                                        <Run Text="{Binding LastPlayedText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Margin="0,0,10,0" Height="32" Padding="12,0" Style="{DynamicResource PhasmaSoftButton}" phui:CutCorners.Size="6"
                                            Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Link24" FontSize="14" Margin="0,0,7,0" />
                                            <TextBlock Text="{x:Static resources:Strings.Menu_History_CopyLink}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Height="32" Padding="14,0" Style="{DynamicResource PhasmaAccentButton}" phui:CutCorners.Size="6"
                                            Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="12" Margin="0,0,7,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                            <TextBlock Text="{x:Static resources:Strings.Common_Launch}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl></Border>
        </DockPanel>

        <StackPanel Grid.Column="1">
            <Border Padding="16,12" CornerRadius="10" Background="#126AA8FF" BorderBrush="#406AA8FF" BorderThickness="1">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,1,12,0" VerticalAlignment="Top" Symbol="Info24" FontSize="16" Foreground="{DynamicResource PhasmaInfoBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static resources:Strings.Menu_History_EveryGameYouVePlayedThrough}" />
                </DockPanel>
            </Border>

            <Border Margin="0,16,0,0" Style="{DynamicResource PhasmaPanel}" Visibility="{Binding ListVisibility}">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding Source='Most played', Converter={StaticResource PhasmaUpper}}" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="15" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <ItemsControl Margin="20,16,20,4" ItemsSource="{Binding MostPlayed}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dmodels:MostPlayedRow}">
                                <StackPanel Margin="0,0,0,14">
                                    <Grid>
                                        <TextBlock Margin="0,0,44,0" Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding HoursText}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <ProgressBar Margin="0,6,0,0" Style="{StaticResource ShareBar}" Value="{Binding Fraction, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
    </Grid>
</ui:UiPage>
