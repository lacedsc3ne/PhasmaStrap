<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.GoogleFontsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Dialogs"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:phui="clr-namespace:PhasmaStrap.UI"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_GoogleFonts_Title}"
        MinWidth="0"
        MinHeight="0"
        Width="460"
        Height="580"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" />
        <StackPanel Grid.Row="0" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False" Panel.ZIndex="1">
            <Image Width="14" Height="14" Margin="0,0,8,0" Source="pack://application:,,,/Resources/PhasmaStrapLogo.png" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding Source={x:Static resources:Strings.Dialog_GoogleFonts_Title}, Converter={StaticResource PhasmaUpper}}" />
        </StackPanel>
        <ui:TitleBar Grid.Row="0" Height="32" MinHeight="32" Padding="0" Title="" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />

        <Grid Grid.Row="1" Margin="20,18,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,12" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="16" FontWeight="Bold" Foreground="White"
                       Text="{Binding Source={x:Static resources:Strings.Dialog_GoogleFonts_Header}, Converter={StaticResource PhasmaUpper}}" />

            <ui:TextBox x:Name="SearchTextBox" Grid.Row="1" Icon="Search32" PlaceholderText="{x:Static resources:Strings.Dialog_GoogleFonts_SearchWatermark}" TextChanged="SearchTextBox_TextChanged" Margin="0,0,0,10" />

            <Border Grid.Row="2" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="FontListBox" BorderThickness="0" Background="Transparent" SelectionChanged="FontListBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Padding="4,6" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ui:ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsIndeterminate="True" Visibility="Collapsed" />

                    <TextBlock x:Name="NoResultsText" Text="{x:Static resources:Strings.Dialog_GoogleFonts_NoResults}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="0,10,0,0" Padding="14,10" MinHeight="56" phui:CutCorners.Size="9" Background="{DynamicResource PhasmaS3Brush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="PreviewText" Text="{x:Static resources:Strings.Dialog_GoogleFonts_Preview}" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:ProgressRing x:Name="PreviewLoadingRing" Width="18" Height="18" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <CheckBox x:Name="ApplyToAppCheckBox" Grid.Row="4" Content="{x:Static resources:Strings.Dialog_GoogleFonts_ApplyToApp}" Margin="0,12,0,0" />
        </Grid>

        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right">
                <Button MinWidth="80" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" Style="{DynamicResource PhasmaSoftButton}" />
                <Button x:Name="ApplyButton" MinWidth="80" Margin="8,0,0,0" Content="{x:Static resources:Strings.Dialog_GoogleFonts_Apply}" Click="ApplyButton_Click" IsEnabled="False" Style="{DynamicResource PhasmaAccentButton}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
