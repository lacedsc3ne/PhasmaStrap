<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="AppearancePage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="StudioLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StudioValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="StudioHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SwatchRing" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="phui:CutCorners.Size" Value="6" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TileBadge" TargetType="{x:Type Border}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="{DynamicResource PhasmaChromeBrush}" />
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="TextElement.FontSize" Value="10.5" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Eyebrow="Settings · Look and feel" Title="{x:Static resources:Strings.Menu_Appearance_Title}" Subtitle="Theme, effects and background for PhasmaStrap." />

        <controls:CardColumns Margin="0,0,0,12">
            <controls:SettingsCard Header="Theme and language" Description="How PhasmaStrap itself looks and reads">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Global_Theme_Title}" Description="Switching plays the theme transition">
                    <ComboBox Padding="10,5,10,5" MinWidth="150" ItemsSource="{Binding Themes, Mode=OneTime}" Text="{Binding Theme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Language_Title}" Description="Needs a relaunch">
                    <ComboBox Padding="10,5,10,5" MinWidth="200" MaxWidth="220" ItemsSource="{Binding Languages, Mode=OneTime}" Text="{Binding SelectedLanguage, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Title}" Description="Overrides colours in PhasmaStrap's own menus">
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,10,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding EditColorThemeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Edit24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Common_Edit}" />
                            </StackPanel>
                        </Button>
                        <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding CustomColorThemeEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Appearance_VisualEffects_Title}" Description="Motion and material">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_WindowBackdrop_Title}" Description="Material behind PhasmaStrap's windows">
                    <ComboBox Padding="10,5,10,5" MinWidth="150" ItemsSource="{Binding BackdropStyles, Mode=OneTime}" Text="{Binding WindowBackdropStyle, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_ThemeTransition_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding ThemeTransitionEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_SmoothProgressBars_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding SmoothProgressBarsEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_SnowEffect_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding SnowEffectEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_ControllerNavigation}" Description="Use an Xbox or generic gamepad">
                    <ui:ToggleSwitch IsChecked="{Binding ControllerNavigationEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>
        </controls:CardColumns>

        <controls:SettingsCard Header="Theme studio" Description="Accent, glass, roundness and spacing. Changes show up straight away everywhere in PhasmaStrap.">
            <controls:SettingsCard.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ImportLookCommand}" ToolTip="Import .phtheme">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowImport24" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Import" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ExportLookCommand}" ToolTip="Save as a .phtheme file to share">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Export" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding ResetLookCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Reset" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard.HeaderContent>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" VerticalAlignment="Top" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" />

                <StackPanel Grid.Column="0">
                    <StackPanel Margin="20,22,20,20">
                        <TextBlock Margin="0,0,0,10" Text="START FROM" Style="{StaticResource StudioLabel}" />
                        <ItemsControl ItemsSource="{Binding LookPresets}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,0" Padding="12,10" HorizontalContentAlignment="Left" Style="{DynamicResource PhasmaSoftButton}"
                                            Command="{Binding DataContext.ApplyLookPresetCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,22,0,10" Text="ACCENT" Style="{StaticResource StudioLabel}" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding AccentSwatches}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="34" Height="34" Margin="0,0,4,0" Padding="0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{Binding Hex}"
                                                Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                CommandParameter="{Binding Hex}">
                                            <Grid>
                                                <Border Style="{StaticResource SwatchRing}" />
                                                <Border Width="24" Height="24" phui:CutCorners.Size="5" Background="{Binding Brush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:TextBox Width="120" Margin="16,0,0,0" VerticalAlignment="Center" PlaceholderText="#RRGGBB"
                                        Text="{Binding AccentHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </WrapPanel>

                        <TextBlock Margin="0,22,0,6" Text="PANEL OPACITY" Style="{StaticResource StudioLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center" Minimum="30" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                    Value="{Binding PanelOpacityPercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StudioValue}" Text="{Binding PanelOpacityPercent, StringFormat={}{0:0}%}" />
                        </Grid>

                        <Grid Margin="0,20,0,6">
                            <TextBlock Text="PANEL COLOUR" Style="{StaticResource StudioLabel}" />
                            <Button HorizontalAlignment="Right" Margin="0,-6,-8,-6" Style="{DynamicResource PhasmaGhostButton}" Background="Transparent" BorderThickness="0"
                                    Command="{Binding FollowThemePanelCommand}" ToolTip="Go back to the colour your theme uses">
                                <TextBlock Text="Use theme colour" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaRedTextBrush}" />
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource StudioHint}" Text="The card every page sits on. Panel opacity sets how see through it is." />
                        <WrapPanel Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding PanelSwatches}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="34" Height="34" Margin="0,0,4,0" Padding="0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{Binding Hex}"
                                                Command="{Binding DataContext.SelectPanelColorCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                CommandParameter="{Binding Hex}">
                                            <Grid>
                                                <Border Style="{StaticResource SwatchRing}" />
                                                <Border Width="24" Height="24" phui:CutCorners.Size="5" Background="{Binding Brush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:TextBox Width="120" Margin="16,0,0,0" VerticalAlignment="Center" PlaceholderText="#RRGGBB"
                                        Text="{Binding PanelColorHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding PickPanelColorCommand}" ToolTip="Choose any colour">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Color24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Pick" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Margin="0,20,0,6" Text="WINDOW TINT" Style="{StaticResource StudioLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center" Minimum="40" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                    Value="{Binding WindowTintPercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StudioValue}" Text="{Binding WindowTintPercent, StringFormat={}{0:0}%}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource StudioHint}" Text="Lower lets the desktop blur or your background picture show through more." />

                        <TextBlock Margin="0,20,0,6" Text="CORNER CUT" Style="{StaticResource StudioLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center" Minimum="0" Maximum="24" SmallChange="1" LargeChange="4" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True"
                                    Value="{Binding CornerRadiusValue, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StudioValue}" Text="{Binding CornerCutPixels, StringFormat={}{0:0} px}" />
                        </Grid>
                    </StackPanel>

                    <controls:OptionControl Header="Compact spacing" Description="Tighter rows and padding to fit more on screen.">
                        <ui:ToggleSwitch IsChecked="{Binding CompactDensity, Mode=TwoWay}" />
                    </controls:OptionControl>
                    <controls:OptionControl Header="Drifting mist" Description="The soft coloured glow behind the window.">
                        <ui:ToggleSwitch IsChecked="{Binding MistEnabled, Mode=TwoWay}" />
                    </controls:OptionControl>
                    <controls:OptionControl Header="Section colours" Description="Each section gets its own colour. Turn this off to use the one accent you picked everywhere.">
                        <ui:ToggleSwitch IsChecked="{Binding SectionColors, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <Border Padding="20,14,20,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                        <Button HorizontalAlignment="Left" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding EditColorThemeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Color24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Edit every colour in the colour theme editor" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Padding="20,22,20,20" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" Background="{DynamicResource PhasmaSubnavBrush}" IsHitTestVisible="False" Focusable="False">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="APPLICATION" Style="{StaticResource StudioLabel}" />
                            <Border HorizontalAlignment="Right" Style="{DynamicResource PhasmaTagNeutral}">
                                <TextBlock FontSize="10" Text="Updates as you drag" />
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0" Height="196" ClipToBounds="True" phui:CutCorners.Size="{DynamicResource PhasmaCutSize}"
                                Background="{DynamicResource PhasmaScrimBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="8,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource PhasmaAccentBrush}" />
                                        <TextBlock Margin="5,0,0,0" FontSize="9.5" FontWeight="SemiBold" FontFamily="{DynamicResource PhasmaHeadingFont}" Text="PhasmaStrap" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1" CornerRadius="4" Background="{DynamicResource PhasmaAccentBrush}">
                                        <TextBlock FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaAccentTextBrush}" Text="Launch" />
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Margin="6,0,6,6" Padding="6" phui:CutCorners.Size="{DynamicResource PhasmaCutSizeSmall}"
                                        Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Border Padding="6,4" CornerRadius="5" Background="{DynamicResource PhasmaSelectedBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Games24" FontSize="10" />
                                                    <TextBlock Margin="5,0,0,0" FontSize="9.5" FontWeight="SemiBold" Text="Games" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Margin="6,6,0,0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="People24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Social" />
                                            </StackPanel>
                                            <StackPanel Margin="6,6,0,0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Gauge24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Performance" />
                                            </StackPanel>
                                            <StackPanel Margin="6,6,0,0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Flag24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="FastFlags" />
                                            </StackPanel>
                                            <StackPanel Margin="6,6,0,0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Color24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Capture" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <Border Style="{DynamicResource PhasmaCard}" Padding="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="5" Background="{DynamicResource PhasmaAccentSoftBrush}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaAccentBrush}" Text="BF" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" FontFamily="{DynamicResource PhasmaHeadingFont}" TextTrimming="CharacterEllipsis" Text="Blox Fruits" />
                                                        <TextBlock FontSize="8.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="Second Sea" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" VerticalAlignment="Center" Padding="7,2" CornerRadius="4" Background="{DynamicResource PhasmaAccentBrush}">
                                                        <TextBlock FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaAccentTextBrush}" Text="Play" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Margin="0,6,0,0" Style="{DynamicResource PhasmaCard}" Padding="7,2">
                                                <StackPanel>
                                                    <Grid Margin="0,5,0,5">
                                                        <TextBlock VerticalAlignment="Center" FontSize="9.5" FontWeight="SemiBold" Text="Unlock frame rate" />
                                                        <Border HorizontalAlignment="Right" Width="20" Height="11" CornerRadius="6" Background="{DynamicResource PhasmaAccentBrush}">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,2,0" HorizontalAlignment="Right" Fill="{DynamicResource PhasmaAccentTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <Border Style="{DynamicResource PhasmaDivider}" />
                                                    <Grid Margin="0,5,0,5">
                                                        <TextBlock VerticalAlignment="Center" FontSize="9.5" FontWeight="SemiBold" Text="FastFlag profile" />
                                                        <Border HorizontalAlignment="Right" Padding="5,0" CornerRadius="4" Background="{DynamicResource PhasmaAccentSoftBrush}">
                                                            <TextBlock FontSize="8.5" Foreground="{DynamicResource PhasmaAccentBrush}" Text="Low ping PvP" />
                                                        </Border>
                                                    </Grid>
                                                    <Border Style="{DynamicResource PhasmaDivider}" />
                                                    <Grid Margin="0,5,0,5">
                                                        <TextBlock VerticalAlignment="Center" FontSize="9.5" FontWeight="SemiBold" Text="Render scale" />
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="100%" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,16,0,0" Text="CONTROLS" Style="{StaticResource StudioLabel}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ToggleButton Content="Lowest ping" IsChecked="True" Style="{DynamicResource PhasmaChip}" Focusable="False" />
                            <ToggleButton Content="Hide full" Style="{DynamicResource PhasmaChip}" Focusable="False" />
                        </WrapPanel>
                        <Border Margin="0,10,0,0" HorizontalAlignment="Left" Style="{DynamicResource PhasmaTag}">
                            <TextBlock Text="Low ping PvP" />
                        </Border>
                        <ui:TextBox Margin="0,10,0,0" PlaceholderText="Text box" Focusable="False" IsTabStop="False" />
                    </StackPanel>
                </Border>
            </Grid>
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_Title}"
                               Description="A picture, GIF or video behind this window. Copied into PhasmaStrap so it keeps working.">
            <controls:SettingsCard.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,12,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaGhostButton}" IsEnabled="{Binding NotImporting, Mode=OneWay}" Command="{Binding AddBackgroundCommand}"
                            Visibility="{Binding GlobalBackgroundEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_AddImageGIFVideo}" />
                        </StackPanel>
                    </Button>
                    <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding GlobalBackgroundEnabled, Mode=TwoWay}" />
                </StackPanel>
            </controls:SettingsCard.HeaderContent>

            <StackPanel Visibility="{Binding GlobalBackgroundEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Padding="20,16,20,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding BackgroundStatus, Mode=OneWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundStatus}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Padding="20" BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeBrush}" phui:CutCorners.Size="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBackgrounds}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon HorizontalAlignment="Center" Symbol="ImageMultiple24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Appearance_NoBackgroundsAddedYet}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl Margin="-6,0,-6,0" ItemsSource="{Binding Backgrounds, Mode=OneWay}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6,0,6,12" Background="{DynamicResource PhasmaS3Brush}" Cursor="Hand" Focusable="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.SelectBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <KeyBinding Key="Space" Command="{Binding DataContext.SelectBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <Grid Height="140" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TileBadge}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAnimated}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_GIF}" />
                                                </Border>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TileBadge}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Play12" FontSize="10" Foreground="White" Margin="0,0,4,0" />
                                                        <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_VIDEO}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Grid Margin="12,8,6,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                <Button Grid.Column="1" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Appearance_RemoveBackground}"
                                                        Command="{Binding DataContext.RemoveBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Delete16" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_OpacityTitle}"
                                        Description="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_OpacityDescription}"
                                        ToolTip="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_OpacityDescription}">
                    <Grid Width="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider VerticalAlignment="Center" Minimum="0" Maximum="1" Value="{Binding GlobalBackgroundOverlayOpacity, Mode=TwoWay}"
                                ToolTip="{x:Static resources:Strings.Menu_Appearance_GlobalBackground_OpacityDescription}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource StudioValue}" Text="{Binding GlobalBackgroundOverlayOpacity, StringFormat={}{0:P0}}" />
                    </Grid>
                </controls:OptionControl>

                <controls:OptionControl Header="Pause a video background while the window is not in front" Description="It then costs nothing while you play">
                    <ui:ToggleSwitch IsChecked="{Binding VideoPauseInactive, Mode=TwoWay}"
                                     ToolTip="{x:Static resources:Strings.Menu_Appearance_PauseVideoBackgroundWhileSettingsWindow}" />
                </controls:OptionControl>
            </StackPanel>
        </controls:SettingsCard>
    </StackPanel>
</ui:UiPage>
