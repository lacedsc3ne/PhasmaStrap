<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:FriendsViewModel, IsDesignTimeCreatable=False}"
      Title="FriendsPage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FriendPresenceDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Online">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaInfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="InGame">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="InStudio">
                    <Setter Property="Fill" Value="{DynamicResource PhasmaWarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FriendStarIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StarFilled}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FriendCap" TargetType="TextBlock" BasedOn="{StaticResource PhasmaCaption}">
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style x:Key="FriendRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Fill" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border x:Name="Marker" Width="2" HorizontalAlignment="Left" Background="{DynamicResource PhasmaAccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FriendGlyph" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource PhasmaS3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="phui:CutCorners.Size" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FriendCardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="FriendGhostSm" TargetType="ButtonBase" BasedOn="{StaticResource PhasmaGhostButton}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource PhasmaCard}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="14,14,14,10">
                    <ui:TextBox Icon="Search24" PlaceholderText="{x:Static resources:Strings.Menu_Friends_SearchNamesNotes}" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" Margin="0" Style="{DynamicResource PhasmaChip}" IsChecked="{Binding FavouritesOnly, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Star24" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Friends_FavouritesOnly}" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Grid.Column="2" Style="{DynamicResource PhasmaIconButton}" Width="30" Height="30" ToolTip="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Command="{Binding RefreshCommand, Mode=OneTime}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                        </Button>
                    </Grid>

                    <TextBlock Margin="0,10,0,0" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" TextWrapping="Wrap" TextTrimming="None"
                               Text="{Binding Status}" ToolTip="{Binding Status}" />
                </StackPanel>

                <ListBox x:Name="FriendsList" Grid.Row="1" ItemsSource="{Binding Friends, Mode=OneWay}" SelectedItem="{Binding SelectedFriend, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource FriendRowItem}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ToggleButton x:Name="GroupToggle" IsChecked="True" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Grid>
                                                                    <Border Background="{DynamicResource PhasmaHoverBrush}" Opacity="0.35" />
                                                                    <Border x:Name="Bar" Background="Transparent" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                                                                        <ContentPresenter HorizontalAlignment="Left" />
                                                                    </Border>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon x:Name="GroupChevron" Symbol="ChevronDown24" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <TextBlock Style="{DynamicResource PhasmaCaption}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <Run Text="{Binding Name, Mode=OneWay, Converter={StaticResource PhasmaUpper}}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ItemsPresenter x:Name="GroupItems" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="Offline">
                                                        <Setter TargetName="GroupToggle" Property="IsChecked" Value="False" />
                                                    </DataTrigger>
                                                    <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                                        <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="GroupChevron" Property="Symbol" Value="ChevronRight24" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource PhasmaSelectedBrush}" />
                                    <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip>
                                            <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                                        </Image.Clip>
                                    </Image>
                                    <Ellipse Width="11" Height="11" Margin="0,0,-1,-1" HorizontalAlignment="Right" VerticalAlignment="Bottom" StrokeThickness="2" Stroke="{DynamicResource PhasmaPanelBrush}" Style="{StaticResource FriendPresenceDot}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{DynamicResource PhasmaSubtle}" FontSize="11" Text="{Binding StatusText}" />
                                </StackPanel>

                                <ToggleButton Grid.Column="2" Margin="4,0,0,0" Width="26" Height="26" Padding="0" VerticalAlignment="Center" Focusable="False"
                                              Style="{DynamicResource PhasmaIconButton}" IsChecked="{Binding IsFavourite, Mode=TwoWay}"
                                              ToolTip="{x:Static resources:Strings.Menu_Friends_FavouriteKeepsFriendTopList}" AutomationProperties.Name="Favourite">
                                    <ui:SymbolIcon Symbol="Star24" Filled="{Binding StarFilled}" FontSize="14" Style="{StaticResource FriendStarIcon}" />
                                </ToggleButton>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,24" Visibility="{Binding EmptyStateVisibility}">
                    <ui:SymbolIcon Symbol="People24" FontSize="36" Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Style="{DynamicResource PhasmaSubtle}" Text="{x:Static resources:Strings.Menu_Friends_NoFriendsShowYet}" />
                </StackPanel>

                <Border Grid.Row="2" Padding="14,10" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Padding="5,1" Margin="0,0,6,0" Background="{DynamicResource PhasmaS4Brush}" CornerRadius="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FriendCap}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Enter" />
                            </Border>
                            <TextBlock Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Text="Join selected friend" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="Right-click for more" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="16,0,0,0" Style="{DynamicResource PhasmaCard}" Padding="0" ClipToBounds="True">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding NoSelectionVisibility}">
                    <ui:SymbolIcon Symbol="PersonCircle24" FontSize="38" Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Style="{DynamicResource PhasmaSubtle}"
                               Text="Pick a friend on the left to see their details." />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectionVisibility}">
                    <StackPanel DataContext="{Binding SelectedFriend}">
                        <Border Height="96" Background="{DynamicResource PhasmaAccentSoftBrush}" />

                        <StackPanel Margin="20,-42,20,0">
                            <Grid Width="84" Height="84" HorizontalAlignment="Left">
                                <Ellipse Margin="-3" Fill="{DynamicResource PhasmaPanelBrush}" />
                                <Ellipse Fill="{DynamicResource PhasmaSelectedBrush}" />
                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="42,42" RadiusX="42" RadiusY="42" />
                                    </Image.Clip>
                                </Image>
                                <Ellipse Width="18" Height="18" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" StrokeThickness="3" Stroke="{DynamicResource PhasmaPanelBrush}" Style="{StaticResource FriendPresenceDot}" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                    <TextBlock FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="22" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Username, Mode=OneWay, StringFormat=@{0}}" /><Run Text="{Binding FriendsSinceSuffix, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <ToggleButton Margin="0,0,8,0" Width="34" Height="34" Padding="0" Style="{StaticResource FriendGhostSm}"
                                                  IsChecked="{Binding IsFavourite, Mode=TwoWay}" ToolTip="{x:Static resources:Strings.Menu_Friends_FavouriteKeepsFriendTopList}" AutomationProperties.Name="Favourite">
                                        <ui:SymbolIcon Symbol="Star24" Filled="{Binding StarFilled}" FontSize="15" Style="{StaticResource FriendStarIcon}" />
                                    </ToggleButton>

                                    <Button Margin="0,0,8,0" Style="{StaticResource FriendGhostSm}"
                                            Visibility="{Binding DataContext.PartyInviteVisibility, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                            Command="{Binding DataContext.InviteToPartyCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="PersonAdd24" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Invite to party" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{DynamicResource PhasmaAccentButton}" Padding="14,7" FontSize="13"
                                            Visibility="{Binding Joinable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_ServerBrowser_Join}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>

                            <Border Margin="0,16,0,0" Padding="14,12" Background="{DynamicResource PhasmaS3Brush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,10,0" VerticalAlignment="Center" Style="{StaticResource FriendPresenceDot}" Visibility="{Binding PresenceDotVisibility}" />
                                    <Border Grid.Column="0" Width="46" Height="46" Margin="0,0,12,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaThumb}"
                                            Background="{DynamicResource PhasmaS4Brush}" Visibility="{Binding GameTileVisibility}">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="14" FontWeight="Bold" Opacity="0.5" Text="{Binding GameInitials}" />
                                            <Border>
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding GameIconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="Right now" Visibility="{Binding RightNowCaptionVisibility}" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding PlayingForVisibility}">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource PhasmaGoodBrush}" />
                                            <TextBlock Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Foreground="{DynamicResource PhasmaGoodBrush}" Text="{Binding PlayingForText}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Text="{Binding StatusText}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                                   Text="{Binding ServerText}" ToolTip="{Binding ServerToolTip}" Visibility="{Binding ServerTextVisibility}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource FriendGhostSm}"
                                            Visibility="{Binding SameServerVisibility}" ToolTip="Join the exact server they are on"
                                            Command="{Binding DataContext.SameServerCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Server24" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Same server" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Margin="0,20,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource FriendCap}" Text="{Binding Source='Played together recently', Converter={StaticResource PhasmaUpper}}" />
                                <Button Grid.Column="1" Style="{DynamicResource PhasmaGhostButton}" Padding="8,3" FontSize="12"
                                        Command="{Binding DataContext.OpenActivityCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="Activity" />
                                        <ui:SymbolIcon Margin="4,0,0,0" Symbol="ChevronRight24" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl Margin="-5,0,-5,0" ItemsSource="{Binding PlayedTogether}" Visibility="{Binding PlayedTogetherVisibility}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="5,0" Style="{DynamicResource PhasmaGameCard}" ToolTip="{Binding ToolTip}">
                                            <StackPanel>
                                                <Border Height="70" Background="{DynamicResource PhasmaS3Brush}" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="14" FontWeight="Bold" Opacity="0.5" Text="{Binding Initials}" />
                                                        <Border>
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding IconUrl}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="10,8,10,8">
                                                    <TextBlock FontFamily="{DynamicResource PhasmaHeadingFont}" FontWeight="Bold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" />
                                                    <TextBlock Margin="0,2,0,0" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding When}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="{Binding PlayedTogetherEmptyText}" Visibility="{Binding PlayedTogetherEmptyVisibility}" />

                            <TextBlock Margin="0,20,0,6" Style="{StaticResource FriendCap}" Text="{Binding Source='Ran into each other', Converter={StaticResource PhasmaUpper}}" />
                            <TextBlock Margin="0,0,0,18" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding RanIntoText}" />
                        </StackPanel>

                        <Border Padding="20,14" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" Text="Alerts for this friend" />
                                    <TextBlock Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                               Text="Overrides the friend alerts on the right for just this person." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Margin="12,0,0,0" Width="190" Padding="10,5,10,5" VerticalAlignment="Center"
                                          ItemsSource="{Binding DataContext.AlertModeOptions, RelativeSource={RelativeSource AncestorType=ui:UiPage}, Mode=OneTime}"
                                          SelectedIndex="{Binding AlertModeIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding DataContext.AlertsEnabled, RelativeSource={RelativeSource AncestorType=ui:UiPage}, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="20,4,20,18">
                            <TextBlock Margin="0,0,0,6" Style="{StaticResource FriendCap}" Text="{Binding Source='Your note', Converter={StaticResource PhasmaUpper}}" />
                            <ui:TextBox x:Name="FriendNoteBox" FontSize="12" MaxLength="200" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="6"
                                        PlaceholderText="{x:Static resources:Strings.Menu_Accounts_AddNote}" ClearButtonEnabled="False" ToolTip="{x:Static resources:Strings.Menu_Friends_OwnNoteAboutFriendOnlyStored}"
                                        Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=350}" />
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal"
                                       Text="{Binding Text.Length, ElementName=FriendNoteBox, StringFormat={}{0} / 200 · saved on this PC}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Border Margin="0,0,0,12" Style="{DynamicResource PhasmaCard}" Padding="0">
              <StackPanel>
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource FriendGlyph}">
                        <ui:SymbolIcon Symbol="PersonAdd24" FontSize="16" />
                    </Border>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource FriendCardTitle}" Text="{Binding Source='Party', Converter={StaticResource PhasmaUpper}}" />
                    <Border Grid.Column="2" Style="{DynamicResource PhasmaTagNeutral}">
                        <TextBlock FontSize="10.5" Text="{Binding PartyTagText, Mode=OneWay, Converter={StaticResource PhasmaUpper}}" />
                    </Border>
                </Grid>

                <Border Padding="16,14,16,4" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{Binding PartyText, Mode=OneWay}" />

                        <StackPanel Margin="0,0,0,10" Visibility="{Binding PartyStartVisibility, Mode=OneWay}">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{DynamicResource PhasmaAccentButton}" Padding="14,7" FontSize="13" Command="{Binding StartPartyCommand, Mode=OneTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Start a party" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" MaxLength="6" CharacterCasing="Upper" FontFamily="{DynamicResource PhasmaLabelFont}" PlaceholderText="QK7MRD" ClearButtonEnabled="False"
                                            Text="{Binding PartyJoinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource FriendGhostSm}" Content="Join" Command="{Binding JoinPartyCommand, Mode=OneTime}" />
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,10" Visibility="{Binding PartyInVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaLabelFont}" FontSize="20" FontWeight="SemiBold" Foreground="White" Text="{Binding PartyCode, Mode=OneWay}" />
                            <Button Grid.Column="1" Style="{StaticResource FriendGhostSm}" Command="{Binding OpenPartyCommand, Mode=OneTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Open party" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Margin="0,0,0,10" HorizontalAlignment="Left" Style="{StaticResource FriendGhostSm}" Command="{Binding OpenPartyCommand, Mode=OneTime}"
                                Visibility="{Binding PartyOpenVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Go to Party" />
                            </StackPanel>
                        </Button>

                        <TextBlock Margin="0,0,0,10" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" TextWrapping="Wrap"
                                   Text="{Binding PartyMessage, Mode=OneWay}" Visibility="{Binding PartyMessageVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Margin="0,0,0,12" Style="{DynamicResource PhasmaCard}" Padding="0">
              <StackPanel>
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource FriendGlyph}">
                        <ui:SymbolIcon Symbol="Person24" FontSize="16" />
                    </Border>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource FriendCardTitle}" Text="{Binding Source='Accounts', Converter={StaticResource PhasmaUpper}}" />
                    <Button Grid.Column="2" Style="{DynamicResource PhasmaGhostButton}" Padding="8,3" FontSize="12" Command="{Binding OpenAccountsCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Manage" />
                            <ui:SymbolIcon Margin="4,0,0,0" Symbol="ChevronRight24" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding SavedAccounts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="48" Padding="16,8" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource PhasmaAccentBrush}" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding Initial}" />
                                        <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Clip>
                                                <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="2" Margin="8,0,0,0" Symbol="CheckmarkCircle24" FontSize="15" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PhasmaGoodBrush}" Visibility="{Binding CurrentVisibility}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="16,10" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Visibility="{Binding AccountsMoreVisibility, Mode=OneWay}">
                    <TextBlock Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding AccountsMoreText, Mode=OneWay}" />
                </Border>
                <Border Padding="16,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Visibility="{Binding AccountsEmptyVisibility, Mode=OneWay}">
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                               Text="No saved accounts yet. Save one in Accounts to switch with one click." />
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{DynamicResource PhasmaCard}" Padding="0">
              <StackPanel>
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top" Style="{StaticResource FriendGlyph}">
                        <ui:SymbolIcon Symbol="Alert24" FontSize="16" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource FriendCardTitle}" Text="{Binding Source='Friend alerts', Converter={StaticResource PhasmaUpper}}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="Whether to be told, how often to check, and who counts." />
                    </StackPanel>
                </Grid>
                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Friends_FriendActivityAlerts}" Description="{x:Static resources:Strings.Menu_Friends_ToastWhenFriendComesOnlineStarts}" x:Name="AlertsOption">
                    <ui:ToggleSwitch IsChecked="{Binding AlertsEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Friends_CheckEvery}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=AlertsOption, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" Width="70" Min="20" Max="600" Value="{Binding PollSeconds, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{x:Static resources:Strings.Menu_Friends_Seconds}" />
                    </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Flat="True" Header="When anyone comes online" IsEnabled="{Binding InnerContent.IsChecked, ElementName=AlertsOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding AlertOnline, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Flat="True" Header="When they join a game" IsEnabled="{Binding InnerContent.IsChecked, ElementName=AlertsOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding AlertGame, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Friends_OnlyAlertFavourites}" Description="{x:Static resources:Strings.Menu_Friends_ToastsOnlyFriendsYouStarredBelow}" IsEnabled="{Binding InnerContent.IsChecked, ElementName=AlertsOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding AlertFavouritesOnly, Mode=TwoWay}" />
                </controls:OptionControl>
              </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:UiPage>
