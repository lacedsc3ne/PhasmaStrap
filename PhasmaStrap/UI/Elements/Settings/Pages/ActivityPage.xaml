<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ActivityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ActivityViewModel, IsDesignTimeCreatable=False}"
      Title="ActivityPage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <DataTemplate x:Key="ActivityChartBar">
            <Grid Height="92" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="{Binding Height}" Margin="2,0" VerticalAlignment="Bottom" CornerRadius="2,2,0,0" Opacity="{Binding Opacity}" Background="{DynamicResource PhasmaAccentBrush}" />
                <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ActGlyph" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource PhasmaS3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="phui:CutCorners.Size" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ActCardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ActCap" TargetType="TextBlock" BasedOn="{StaticResource PhasmaCaption}">
            <Setter Property="FontSize" Value="10.5" />
        </Style>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <controls:PageHeader Grid.Row="0" Grid.ColumnSpan="2" Title="Activity" Subtitle="{Binding TotalsText, Mode=OneWay}">
            <Button Style="{DynamicResource PhasmaGhostButton}" Padding="12,6" FontSize="13" Command="{Binding RefreshCommand, Mode=OneTime}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" />
                </StackPanel>
            </Button>
        </controls:PageHeader>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="2,0,0,10" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" TextWrapping="Wrap" TextTrimming="None" Text="{Binding TrackedSinceText, Mode=OneWay}" />

            <Border Grid.Row="1" Style="{DynamicResource PhasmaCard}" Padding="24,30" Visibility="{Binding TimelineEmptyVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Timeline24" FontSize="36" Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Style="{DynamicResource PhasmaSubtle}" FontSize="13"
                               Text="{x:Static resources:Strings.Menu_Activity_NoSessionsYetTheyAppearHere}" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="SessionsList" Grid.Row="2" ItemsSource="{Binding Sessions, Mode=OneWay}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,4,10">
                            <StackPanel Orientation="Horizontal" Margin="2,4,0,12">
                                <Border Width="4" Height="20" Margin="3,0,12,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <SkewTransform AngleX="-14" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Text="{Binding Header, Converter={StaticResource PhasmaUpper}}" />
                                <TextBlock Margin="12,2,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding Summary, Converter={StaticResource PhasmaUpper}}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Visits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="20,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="46" Height="46" VerticalAlignment="Top" Background="{DynamicResource PhasmaS3Brush}">
                                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" />
                                                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource PhasmaGoodBrush}" Text="{Binding FriendsText}" Visibility="{Binding FriendsVisibility}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top" Visibility="{Binding SparkVisibility}">
                                                        <Viewbox Width="150" Height="30" Stretch="Fill">
                                                            <Canvas Width="260" Height="36" ClipToBounds="True">
                                                                <Polyline Points="{Binding Spark}" Stroke="{DynamicResource PhasmaAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding FpsText}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Padding="20,8" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Visibility="{Binding CapturesVisibility}">
                                                    <ItemsControl ItemsSource="{Binding Captures}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,2,6,2" Height="30" MinWidth="54" ToolTip="{Binding FileName}" Cursor="Hand" Focusable="True"
                                                                        Background="{DynamicResource PhasmaS3Brush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" ClipToBounds="True">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenCaptureCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                                                                        <KeyBinding Key="Enter" Command="{Binding DataContext.OpenCaptureCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
                                                                    </Border.InputBindings>
                                                                    <Grid>
                                                                        <Image Source="{Binding Thumbnail}" Height="28" Stretch="Uniform" Visibility="{Binding ThumbnailVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" Margin="16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding IconVisibility}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3" Margin="2,8,0,0" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" TextWrapping="Wrap" TextTrimming="None" Text="{x:Static resources:Strings.Menu_Activity_FPSLineNeedsSomethingWatchesGame}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Margin="0,0,0,12" Style="{DynamicResource PhasmaCard}" Padding="0">
                    <StackPanel>
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource ActGlyph}">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="16" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ActCardTitle}" Text="{Binding Source='Playtime in detail', Converter={StaticResource PhasmaUpper}}" />
                        </Grid>

                        <Border Padding="16,14,16,6" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource ActCap}" Text="{Binding Source={x:Static resources:Strings.Menu_Activity_Last14Days}, Converter={StaticResource PhasmaUpper}}" />
                                <ItemsControl ItemsSource="{Binding Days, Mode=OneWay}" ItemTemplate="{StaticResource ActivityChartBar}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <TextBlock Margin="0,16,0,8" Style="{StaticResource ActCap}" Text="{Binding Source={x:Static resources:Strings.Menu_Activity_Last12Weeks}, Converter={StaticResource PhasmaUpper}}" />
                                <ItemsControl ItemsSource="{Binding Weeks, Mode=OneWay}" ItemTemplate="{StaticResource ActivityChartBar}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Padding="16,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource ActCap}" Text="{Binding Source={x:Static resources:Strings.Menu_Activity_ByGame}, Converter={StaticResource PhasmaUpper}}" />
                                    <ComboBox Grid.Column="1" Width="130" Padding="10,5,10,5" ItemsSource="{Binding RangeOptions, Mode=OneTime}" SelectedItem="{Binding SelectedRange, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Margin="0,4,0,4" Style="{DynamicResource PhasmaSubtle}" Visibility="{Binding GamesEmptyVisibility, Mode=OneWay}" Text="{x:Static resources:Strings.Menu_Activity_NothingPlayedPeriod}" />

                                <ItemsControl ItemsSource="{Binding Games, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5,0,5" ToolTip="{Binding Detail}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaS3Brush}">
                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="White" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaCaption}" FontWeight="Normal" Text="{Binding TimeText}" />
                                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                                    <Border Height="3" Background="{DynamicResource PhasmaSelectedBrush}" />
                                                    <Border Height="3" HorizontalAlignment="Left" Width="{Binding Width}" Background="{DynamicResource PhasmaAccentBrush}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,12" Style="{DynamicResource PhasmaCard}" Padding="0">
                    <StackPanel>
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,12,0" Style="{StaticResource ActGlyph}">
                                <ui:SymbolIcon Symbol="People24" FontSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ActCardTitle}" Text="{Binding Source={x:Static resources:Strings.Menu_Activity_Played}, Converter={StaticResource PhasmaUpper}}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="Friends who turned up in the same servers as you." />
                            </StackPanel>
                        </Grid>

                        <Border Padding="16,10,16,6" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="{Binding CompanionsEmptyVisibility, Mode=OneWay}" Text="{Binding CompanionsEmptyText, Mode=OneWay}" />

                                <ItemsControl ItemsSource="{Binding Companions, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="30" Height="30" VerticalAlignment="Top">
                                                    <Ellipse Fill="{DynamicResource PhasmaS4Brush}" />
                                                    <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Together}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <controls:OptionControl Flat="True" IsEnabled="{Binding HistoryEnabled, Mode=OneWay}" Header="{x:Static resources:Strings.Menu_Activity_NoteWhichFriendsShareMyServer}" Description="{x:Static resources:Strings.Menu_Activity_WhileYouAreGamePhasmaStrapAsks}">
                            <ui:ToggleSwitch IsChecked="{Binding TrackFriends, Mode=TwoWay}" />
                        </controls:OptionControl>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource PhasmaCard}" Padding="0">
                    <StackPanel>
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,12,0" Style="{StaticResource ActGlyph}">
                                <ui:SymbolIcon Symbol="History24" FontSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ActCardTitle}" Text="{Binding Source='Session history', Converter={StaticResource PhasmaUpper}}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="Kept on this PC only." />
                            </StackPanel>
                        </Grid>

                        <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Activity_KeepSessionHistory}" Description="{x:Static resources:Strings.Menu_Activity_WritesDownEachServerYouJoin}">
                            <ui:ToggleSwitch IsChecked="{Binding HistoryEnabled, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <Border Padding="16,12,16,14" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                            <Button HorizontalAlignment="Left" Style="{DynamicResource PhasmaGhostButton}" Padding="12,6" FontSize="13"
                                    ToolTip="{x:Static resources:Strings.Menu_Activity_RemovesEveryRecordedSessionScreenshotsClips}" Command="{Binding ClearHistoryCommand, Mode=OneTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Activity_DeleteHistory}" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:UiPage>
