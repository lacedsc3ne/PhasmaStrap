<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.ExceptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"

        xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Dialogs"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        xmlns:phui="clr-namespace:PhasmaStrap.UI"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_Exception_Title}"
        Width="540"
        MinHeight="0"
        SizeToContent="Height"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="RootTitleBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Height="32"
            Padding="12,0,0,0"
            Background="{DynamicResource PhasmaChromeBrush}"
            FontFamily="{DynamicResource PhasmaMono}"
            FontSize="11"
            FontWeight="Medium"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Title="{Binding Source={x:Static resources:Strings.Dialog_Exception_Title}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}"
            CanMaximize="False"
            KeyboardNavigation.TabNavigation="None"
            ShowMaximize="False"
            ShowMinimize="False" />
        <Border Grid.Row="0" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" IsHitTestVisible="False" />

        <StackPanel Grid.Row="1" Margin="22,20,22,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Margin="0,0,12,0"
                    phui:CutCorners.Size="6"
                    Background="{DynamicResource PhasmaAccentSoftBrush}">
                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="{DynamicResource PhasmaRedTextBrush}" Symbol="DismissCircle24" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static resources:Strings.Dialog_Exception_Info_1}"
                    TextWrapping="Wrap" />
            </Grid>
            <RichTextBox
                x:Name="ErrorRichTextBox"
                Margin="0,14,0,0"
                Padding="8"
                Background="{DynamicResource PhasmaChromeBrush}"
                BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}"
                Block.LineHeight="2"
                FontFamily="{DynamicResource PhasmaMono}"
                FontSize="11.5"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                IsReadOnly="True" />
            <controls:MarkdownTextBlock
                x:Name="HelpMessageMDTextBlock"
                Margin="0,14,0,0"
                FontSize="13.5"
                LineHeight="20"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="18,12"
            Background="{DynamicResource PhasmaPanelBrush}"
            BorderBrush="{DynamicResource PhasmaStrokeBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    x:Name="VersionText"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource PhasmaMono}"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="Version 2.8.0" />

                <StackPanel HorizontalAlignment="Right" FlowDirection="LeftToRight" Orientation="Horizontal">
                    <Button x:Name="ReportExceptionButton" Content="{x:Static resources:Strings.Dialog_Exception_Report}" Style="{StaticResource PhasmaSoftButton}" />
                    <Button x:Name="LocateLogFileButton" Margin="10,0,0,0" Content="{x:Static resources:Strings.Common_OpenLogFile}" Style="{StaticResource PhasmaSoftButton}" />
                    <Button x:Name="CloseButton" MinWidth="100" Margin="10,0,0,0" Content="{x:Static resources:Strings.Common_Close}" Style="{StaticResource PhasmaAccentButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
