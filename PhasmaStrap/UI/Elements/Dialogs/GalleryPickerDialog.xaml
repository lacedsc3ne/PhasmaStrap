<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.Dialogs.GalleryPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Gallery"
    Width="560"
    Height="520"
    Background="{DynamicResource PhasmaPanelBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <base:WpfUiWindow.Resources>
        <Style x:Key="GalleryRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PhasmaAccentStrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBarElement"
            Grid.Row="0"
            Padding="12,8"
            Background="{DynamicResource PhasmaChromeBrush}"
            CanMaximize="False"
            FontFamily="{DynamicResource PhasmaMono}"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Icon="pack://application:,,,/PhasmaStrap.ico"
            KeyboardNavigation.TabNavigation="None"
            ShowMaximize="False"
            ShowMinimize="False" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <StackPanel Grid.Row="1" Margin="22,18,22,12">
            <TextBlock x:Name="PromptText" Margin="0,0,0,12" FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search by name, description or author" Icon="Search24" KeyDown="SearchBox_KeyDown" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="14,0,14,12">
            <ListBox x:Name="ItemsList" MouseDoubleClick="ItemsList_MouseDoubleClick" SelectionChanged="ItemsList_SelectionChanged"
                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource GalleryRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Text="Nothing published yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="3" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="90" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" Style="{StaticResource PhasmaSoftButton}" />
                <Button x:Name="AddButton" MinWidth="100" Margin="10,0,0,0" IsEnabled="False" Click="OnAddClicked" Style="{StaticResource PhasmaAccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                        <TextBlock VerticalAlignment="Center" Text="Add this one" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
