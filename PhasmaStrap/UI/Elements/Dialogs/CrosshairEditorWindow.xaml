<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.CrosshairEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:phui="clr-namespace:PhasmaStrap.UI"
        xmlns:vm="clr-namespace:PhasmaStrap.UI.ViewModels.Dialogs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:CrosshairEditorViewModel, IsDesignTimeCreatable=False}"
        Title="Crosshair editor"
        Width="1000"
        Height="760"
        MinWidth="860"
        MinHeight="600"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <base:WpfUiWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SliderRow" TargetType="Grid">
            <Setter Property="Margin" Value="28,2,0,2" />
        </Style>
        <Style x:Key="PartCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="PartHeading" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PartDivider" TargetType="Border" BasedOn="{StaticResource PhasmaDivider}">
            <Setter Property="Margin" Value="-20,14,-20,14" />
        </Style>

        <DataTemplate x:Key="ChoiceTemplate">
            <Button Margin="0,0,6,6" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                    Command="{Binding DataContext.UseChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Padding="6,4,10,4" phui:CutCorners.Size="6" BorderThickness="1"
                                Background="{DynamicResource PhasmaS3Brush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PhasmaS4Brush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource PhasmaAccentStrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Border Width="18" Height="18" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource PhasmaS4Brush}">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Margin="6,0,0,0" MaxWidth="120" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <Button Margin="4,0,-4,0" Width="18" Height="18" Padding="0" VerticalAlignment="Center" ToolTip="Delete this design" AutomationProperties.Name="Delete this design"
                            Style="{DynamicResource PhasmaIconButton}" Visibility="{Binding DeleteVisibility}"
                            Command="{Binding DataContext.DeleteDesignCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Dismiss12" FontSize="10" />
                    </Button>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SwatchTemplate">
            <Border Width="18" Height="18" Margin="0,0,6,0" CornerRadius="9" Background="{Binding}" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="{Binding}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Border.InputBindings>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OutlineSwatchTemplate">
            <Border Width="18" Height="18" Margin="0,0,6,0" CornerRadius="9" Background="{Binding}" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="{Binding}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PickOutlineColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Border.InputBindings>
            </Border>
        </DataTemplate>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" />
        <StackPanel Grid.Row="0" Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False" Panel.ZIndex="1">
            <Border Width="30" Height="30" phui:CutCorners.Size="6" Background="{DynamicResource PhasmaAccentBrush}">
                <ui:SymbolIcon Symbol="Target24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="15" FontWeight="Bold" Foreground="White" Text="CROSSHAIR EDITOR" />
        </StackPanel>
        <ui:TitleBar Grid.Row="0" Height="56" MinHeight="56" Padding="0" Title="" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,20,20,16">
                    <Border Height="300" phui:CutCorners.Size="9" ClipToBounds="True" Background="{Binding Backdrop.Brush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding Preview}" Width="{Binding PreviewPixels}" Height="{Binding PreviewPixels}" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,80,16,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="#AAFFFFFF" Visibility="{Binding EmptyVisibility}"
                                       Text="Nothing to see yet. Turn on the arms, the dot or the ring." />
                            <Border Margin="8" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#CC0D0D12" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" IsHitTestVisible="False">
                                <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Zoom, StringFormat={}{0}X ZOOM}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,10,0" Text="Background" Style="{StaticResource Label}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Backdrops}" SelectedItem="{Binding Backdrop, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Margin="12,0,10,0" Text="Zoom" Style="{StaticResource Label}" ToolTip="1x is the size it has in the game" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding Zoom, Mode=TwoWay}" ItemStringFormat="{}{0}x" ToolTip="1x is the size it has in the game" />
                    </Grid>

                    <TextBlock Text="START FROM" Style="{DynamicResource PhasmaSectionLabel}" />
                    <ItemsControl ItemsSource="{Binding BuiltIn}" ItemTemplate="{StaticResource ChoiceTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="MY DESIGNS" Style="{DynamicResource PhasmaSectionLabel}" Margin="2,12,0,8" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding MineEmptyVisibility}" Text="None saved yet. Name a design below and save it." />
                    <ItemsControl ItemsSource="{Binding Mine}" ItemTemplate="{StaticResource ChoiceTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="SAVE AND SHARE" Style="{DynamicResource PhasmaSectionLabel}" Margin="2,12,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="86" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="Name of this design" Text="{Binding DesignName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" Command="{Binding SaveDesignCommand}" ToolTip="Save to my designs" Style="{DynamicResource PhasmaSoftButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Save" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="86" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" FontFamily="{DynamicResource PhasmaMono}" PlaceholderText="Paste a PHX1 code" Text="{Binding ImportCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" Command="{Binding ImportCodeCommand}" Style="{DynamicResource PhasmaSoftButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Load" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CopyCodeCommand}" ToolTip="A short text anyone with PhasmaStrap can paste into their editor" Style="{DynamicResource PhasmaSoftButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Copy code" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" FontFamily="{DynamicResource PhasmaMono}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ShareCode}" ToolTip="{Binding ShareCode}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,20,20,16">
                        <CheckBox Content="ARMS" IsChecked="{Binding Arms, Mode=TwoWay}" Style="{StaticResource PartCheck}" />
                        <StackPanel IsEnabled="{Binding Arms}">
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Length" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding ArmLength, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding ArmLength}" Style="{StaticResource Value}" />
                            </Grid>
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thickness" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="16" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding ArmThickness, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding ArmThickness}" Style="{StaticResource Value}" />
                            </Grid>
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Gap" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="-10" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Gap, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding Gap}" Style="{StaticResource Value}" />
                            </Grid>
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rotation" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="89" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Rotation, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding Rotation, StringFormat={}{0}°}" Style="{StaticResource Value}" />
                            </Grid>
                            <CheckBox Margin="28,4,0,0" FontSize="12.5" Content="T shape (no top arm)" IsChecked="{Binding TStyle, Mode=TwoWay}" />
                        </StackPanel>

                        <Border Style="{StaticResource PartDivider}" />
                        <CheckBox Content="CENTRE DOT" IsChecked="{Binding Dot, Mode=TwoWay}" Style="{StaticResource PartCheck}" />
                        <StackPanel IsEnabled="{Binding Dot}">
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Size" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="16" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding DotSize, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding DotSize}" Style="{StaticResource Value}" />
                            </Grid>
                            <CheckBox Margin="28,4,0,0" FontSize="12.5" Content="Round" IsChecked="{Binding DotRound, Mode=TwoWay}" />
                        </StackPanel>

                        <Border Style="{StaticResource PartDivider}" />
                        <CheckBox Content="RING" IsChecked="{Binding Ring, Mode=TwoWay}" Style="{StaticResource PartCheck}" />
                        <StackPanel IsEnabled="{Binding Ring}">
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Radius" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="2" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding RingRadius, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding RingRadius}" Style="{StaticResource Value}" />
                            </Grid>
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thickness" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="12" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding RingThickness, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding RingThickness}" Style="{StaticResource Value}" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource PartDivider}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COLOUR" Style="{StaticResource PartHeading}" />
                            <Border Grid.Column="1" Width="22" Height="22" phui:CutCorners.Size="4" Margin="0,0,8,0" Background="{Binding ColorBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" />
                            <ui:TextBox Grid.Column="2" Width="120" FontFamily="{DynamicResource PhasmaMono}" Text="{Binding ColorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                        </Grid>
                        <ItemsControl Margin="0,10,0,0" HorizontalAlignment="Right" ItemsSource="{Binding Swatches}" ItemTemplate="{StaticResource SwatchTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Style="{StaticResource PartDivider}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="138" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OPACITY" Style="{StaticResource PartHeading}" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0.05" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Opacity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" Style="{StaticResource Value}" />
                        </Grid>

                        <Border Style="{StaticResource PartDivider}" />
                        <CheckBox Content="OUTLINE" IsChecked="{Binding Outline, Mode=TwoWay}" Style="{StaticResource PartCheck}" />
                        <StackPanel IsEnabled="{Binding Outline}">
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thickness" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="4" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding OutlineThickness, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding OutlineThickness}" Style="{StaticResource Value}" />
                            </Grid>
                            <Grid Margin="28,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Colour" Style="{StaticResource Label}" />
                                <Border Grid.Column="1" Width="22" Height="22" phui:CutCorners.Size="4" Margin="0,0,8,0" Background="{Binding OutlineColorBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" />
                                <ui:TextBox Grid.Column="2" Width="120" FontFamily="{DynamicResource PhasmaMono}" Text="{Binding OutlineColorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                            </Grid>
                            <ItemsControl Margin="0,10,0,0" HorizontalAlignment="Right" ItemsSource="{Binding Swatches}" ItemTemplate="{StaticResource OutlineSwatchTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Click="Close_Click" Style="{DynamicResource PhasmaSoftButton}">
                        <TextBlock Text="Close" FontWeight="SemiBold" />
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding ApplyCommand}" Style="{DynamicResource PhasmaAccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Apply" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
