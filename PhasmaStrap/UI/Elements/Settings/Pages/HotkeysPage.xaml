<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.HotkeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:HotkeysViewModel, IsDesignTimeCreatable=True}"
      Title="HotkeysPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <!--  Local colours for keys held as a modifier (the mockup's blue)  -->
        <SolidColorBrush x:Key="HotkeyModifierFill" Color="#556366F1" />
        <SolidColorBrush x:Key="HotkeyModifierStroke" Color="#996366F1" />

        <Style x:Key="HotkeyKeyCapStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Bound">
                    <Setter Property="Background" Value="{DynamicResource PhasmaAccentStrokeBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="ToolTipService.IsEnabled" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Modifier">
                    <Setter Property="Background" Value="{StaticResource HotkeyModifierFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource HotkeyModifierStroke}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="ToolTipService.IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  The key field: looks like an input, lights up while it is listening  -->
        <Style x:Key="HotkeyCaptureButton" TargetType="Button" BasedOn="{StaticResource PhasmaSoftButton}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="ToolTip" Value="Click, then press the key or combination. Esc cancels and keeps the current hotkey." />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasGesture}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsListening}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Hotkeys_Hotkeys}" />
            <Border Style="{DynamicResource PhasmaTagNeutral}" Margin="12,0,0,0">
                <TextBlock FontSize="11" Text="Look and feel" />
            </Border>
        </StackPanel>

        <controls:CardColumns>
            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_Hotkeys_Hotkeys}"
                                   Description="These work while Roblox is in front">
                <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Style="{DynamicResource PhasmaDivider}" />
                                <TextBlock Style="{DynamicResource PhasmaCaption}" Margin="0,10,0,0" Text="{Binding Name}" ToolTip="{Binding Description}" />

                                <ItemsControl ItemsSource="{Binding Rows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding DisplayName}" />
                                                    <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" />

                                                    <!--  Whether the feature behind this hotkey is on  -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FeatureIsOn}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource PhasmaGoodBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding FeatureIsBlocking}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource PhasmaWarnBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding FeatureText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FeatureIsBlocking}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!--  Uid="Capture" and Tag are used by the code behind to keep listening when this is clicked  -->
                                                    <Button Uid="Capture" Width="160" Focusable="False"
                                                            Style="{StaticResource HotkeyCaptureButton}"
                                                            Content="{Binding ButtonText}"
                                                            Tag="{Binding}"
                                                            Click="CaptureButton_Click" />
                                                    <Button Margin="6,0,0,0" Focusable="False" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                                            Content="{x:Static resources:Strings.ContextMenu_OutputConsole_Clear}"
                                                            IsEnabled="{Binding HasGesture}"
                                                            Tag="{Binding}"
                                                            Click="ClearButton_Click" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap" Text="{Binding StatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasStatus}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SettingsCard>

            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="Soft Key"
                                   Description="When you hold two opposite movement keys, the one you pressed last wins instead of cancelling out. Only acts while Roblox is the window in front, and starts with your next launch.">
                <controls:OptionControl Header="Resolve opposite keys" Description="Also known as SOCD or snap tap. Some games count this as an unfair advantage, so check their rules">
                    <ui:ToggleSwitch IsChecked="{Binding SoftKeyEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Movement keys" Description="The layout you move with">
                    <ComboBox Padding="10,5,10,5" MinWidth="140" ItemsSource="{Binding SoftKeyProfiles, Mode=OneTime}" SelectedItem="{Binding SoftKeyProfile, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="Keyboard map"
                                   Description="What your bindings take up. Hover a coloured key to see which hotkey uses it.">
                <controls:SettingsCard.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentStrokeBrush}" />
                        <TextBlock Margin="6,0,14,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Bound to a hotkey" />
                        <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource HotkeyModifierFill}" />
                        <TextBlock Margin="6,0,14,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Held as a modifier" />
                        <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource PhasmaSelectedBrush}" />
                        <TextBlock Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Free" />
                    </StackPanel>
                </controls:SettingsCard.HeaderContent>

                <Border Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding Keyboard, Mode=OneWay}" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Keys, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="26" Margin="2" Padding="2,0" CornerRadius="5" BorderThickness="1"
                                                    Width="{Binding Width, Mode=OneTime}"
                                                    ToolTip="{Binding Caption}"
                                                    Style="{StaticResource HotkeyKeyCapStyle}">
                                                <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Label, Mode=OneTime}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
