<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ServerBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ServerBrowserViewModel, IsDesignTimeCreatable=True}"
      Title="ServerBrowserPage"
      Scrollable="False">
    <ui:UiPage.Resources>
        <!--  Thin fill bar for how full a server is  -->
        <Style x:Key="FillBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource PhasmaSelectedBrush}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource PhasmaAccentBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Ping coloured by how good it is  -->
        <Style x:Key="PingText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PingTone}" Value="good">
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingTone}" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PingTone}" Value="bad">
                    <Setter Property="Foreground" Value="{DynamicResource PhasmaBadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:UiPage.Resources>

    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,14">

            <!--  Which place to look at  -->
            <Border Padding="16,12" Style="{DynamicResource PhasmaCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  The game's icon once the place is known, the server icon before that  -->
                    <Grid Width="40" Height="40">
                        <Border CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{DynamicResource PhasmaAccentSoftBrush}">
                            <ui:SymbolIcon Symbol="Server24" FontSize="18" Foreground="{DynamicResource PhasmaAccentBrush}" />
                        </Border>
                        <Border CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Visibility="{Binding HasGameIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding GameIconUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle, Mode=OneWay}" FontSize="14" Style="{DynamicResource PhasmaHeading}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding HeaderDetail, Mode=OneWay}" Style="{DynamicResource PhasmaSubtle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Width="180" PlaceholderText="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_PlaceholderText}"
                                    Text="{Binding PlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_Title}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand, Mode=OneTime}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding SearchCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_ServerBrowser_Search}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaAccentButton}"
                                IsEnabled="{Binding HasPingedServers, Mode=OneWay}"
                                Command="{Binding JoinFastestCommand, Mode=OneTime}"
                                ToolTip="{x:Static resources:Strings.Menu_ServerBrowser_JoinsWhicheverServerAboveReportedLowest}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_ServerBrowser_JoinFastest}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Public servers  -->
            <Border Margin="0,12,0,0" Padding="8,4" Style="{DynamicResource PhasmaCard}">
                <StackPanel>
                    <Grid Margin="10,10,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Server" Style="{DynamicResource PhasmaCaption}" />
                        <TextBlock Grid.Column="1" Text="Region" Style="{DynamicResource PhasmaCaption}" />
                        <TextBlock Grid.Column="2" Text="Players" Style="{DynamicResource PhasmaCaption}" />
                        <TextBlock Grid.Column="3" Text="Reported ping" Style="{DynamicResource PhasmaCaption}" />
                    </Grid>

                    <ItemsControl x:Name="ServerList" ItemsSource="{Binding Servers, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Background="Transparent">
                                    <Border Style="{DynamicResource PhasmaDivider}" />
                                    <Grid Margin="10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding ShortJobId}" FontFamily="{DynamicResource PhasmaMono}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding JobId}" />
                                        <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding City}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Region}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ProgressBar Width="90" Style="{StaticResource FillBar}" Maximum="{Binding MaxPlayers}" Value="{Binding Playing, Mode=OneWay}" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding PlayersText}" FontSize="12.5" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding PingText}" FontSize="12.5" FontWeight="SemiBold" Style="{StaticResource PingText}" />
                                        <Button Grid.Column="4" HorizontalAlignment="Right" Padding="12,4" Style="{DynamicResource PhasmaSoftButton}"
                                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="{x:Static resources:Strings.Menu_ServerBrowser_Join}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="14,10" Style="{DynamicResource PhasmaCard}" Background="{DynamicResource PhasmaPanelBrush}">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" Symbol="Info24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Uses the game's own public server list. It does not sign in, read your session, or measure real ping to any server. For a measured pick, turn on the Matchmaker in Deployment settings." />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:UiPage>
