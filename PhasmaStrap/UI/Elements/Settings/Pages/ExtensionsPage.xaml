<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ExtensionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="ExtensionsPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="Extensions" />
            <Border Margin="10,2,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                <TextBlock Text="Launching" />
            </Border>
        </StackPanel>
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="Rojo, plus other tools to launch alongside Roblox." />

        <!--  Rojo: downloaded and managed by PhasmaStrap  -->
        <Border Margin="0,0,0,12" Padding="16,14,16,14" Style="{DynamicResource PhasmaCard}" DataContext="{Binding Rojo}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{Binding TileBrush, Mode=OneTime}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Georgia" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="{Binding Initials, Mode=OneTime}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Extensions_Rojo}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Syncs files into Roblox Studio. PhasmaStrap downloads and manages Rojo itself." />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding VersionText, Mode=OneWay}" />
                        <Run Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text=" · project " />
                        <Run FontFamily="{DynamicResource PhasmaMono}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ProjectPathText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                    <WrapPanel>
                        <Button Margin="0,0,8,6" Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding CanInstallOrUpdate}" Command="{Binding InstallOrUpdateCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding InstallOrUpdateButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,6" Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding CanInstallOrUpdate}" Command="{Binding BrowseProjectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Extensions_BrowseProject}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,6" Style="{DynamicResource PhasmaAccentButton}" IsEnabled="{Binding CanToggleServe}" Command="{Binding ToggleServeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ServeButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,0,6" Style="{DynamicResource PhasmaGhostButton}" IsEnabled="{Binding CanUninstall}" Command="{Binding UninstallCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Uninstaller_Uninstall}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="0,8,0,10" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Installer_Extensions_Other_Title}" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Point PhasmaStrap at a tool you already have. It does not bundle or download these." />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Extensions}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:CardColumns />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16,14,16,14" Style="{DynamicResource PhasmaCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{Binding TileBrush, Mode=OneTime}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Georgia" FontSize="13" FontWeight="SemiBold" Foreground="White" Text="{Binding Initials, Mode=OneTime}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Description}" />
                                <TextBlock Margin="0,2,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis" Text="{Binding ShortStatusText}" ToolTip="{Binding PathText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PhasmaGoodBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{DynamicResource PhasmaSoftButton}" IsEnabled="{Binding IsInstalled}"
                                        Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static resources:Strings.Common_Launch}" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Common_Browse}"
                                        Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="14" />
                                </Button>
                                <Button Margin="4,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.ContextMenu_OutputConsole_Clear}" IsEnabled="{Binding IsInstalled}"
                                        Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
