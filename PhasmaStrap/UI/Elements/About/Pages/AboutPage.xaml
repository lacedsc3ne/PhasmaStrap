<ui:UiPage x:Class="PhasmaStrap.UI.Elements.About.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.About"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance dmodels:AboutViewModel, IsDesignTimeCreatable=True}"
      Title="AboutPage"
      KeyDown="UiPage_KeyDown"
      Scrollable="True">

    <ui:UiPage.Resources>
        <Storyboard x:Key="EggStoryboard">
            <DoubleAnimation Storyboard.TargetName="Image1" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" />
            <DoubleAnimation Storyboard.TargetName="Image2" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:3" />
        </Storyboard>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="Image1" Grid.Column="0" Width="72" Height="72" VerticalAlignment="Center" Source="pack://application:,,,/Resources/PhasmaStrapLogo.png" RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="Image2" Grid.Column="0" Width="72" Height="72" VerticalAlignment="Center" Source="pack://application:,,,/Resources/BootstrapperStyles/ByfronDialog/Matt.png" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Bottom" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="PHASMASTRAP" />
                    <TextBlock Margin="10,0,0,4" VerticalAlignment="Bottom" FontFamily="{DynamicResource PhasmaMono}" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Version, Mode=OneTime}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" FontSize="13.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_About_Description}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <WrapPanel Orientation="Horizontal">
            <ui:Anchor Margin="0,0,8,8" Padding="12,7" Content="{x:Static resources:Strings.Menu_About_GithubRepository}" FontSize="13" FontWeight="SemiBold" Icon="Code24" NavigateUri="https://github.com/lacedsc3ne/PhasmaStrap" />
            <ui:Anchor Margin="0,0,8,8" Padding="12,7" Content="Discord" FontSize="13" FontWeight="SemiBold" Icon="ChatMultiple24" NavigateUri="https://discord.gg/x4M4cZS4p7" />
            <ui:Anchor Margin="0,0,0,8" Padding="12,7" Content="Support on Ko-fi" FontSize="13" FontWeight="SemiBold" Icon="Heart24" NavigateUri="https://ko-fi.com/lacedscene" />
        </WrapPanel>

        <Border Margin="0,10,0,0" Padding="0" Style="{StaticResource PhasmaCard}" Visibility="{Binding BuildInformationVisibility, Mode=OneTime}">
            <StackPanel>
                <Border Padding="16,11" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                    <TextBlock FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="BUILD INFORMATION" />
                </Border>
                <Grid Margin="16,10,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,24,5" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Timestamp" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,5,0,5" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding BuildTimestamp, Mode=OneTime}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,24,5" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Machine" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding BuildMetadata.Machine, Mode=OneTime}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,24,5" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Commit Hash" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,5" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}">
                        <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding BuildCommitHashUrl, Mode=OneTime}" Foreground="{DynamicResource PhasmaRedTextBrush}">
                            <TextBlock Text="{Binding BuildMetadata.CommitHash, Mode=OneTime}" />
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5,24,5" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Commit Ref" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,5,0,5" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding BuildMetadata.CommitRef, Mode=OneTime}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</ui:UiPage>
