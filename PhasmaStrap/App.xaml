                                                </Canvas>
                                            </Viewbox>
                                        </ui:Button>
                                        <ui:Button
                                            x:Name="PART_MaximizeButton"
                                            Grid.Column="2"
                                            Command="{Binding Path=TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            CommandParameter="maximize"
                                            KeyboardNavigation.IsTabStop="True"
