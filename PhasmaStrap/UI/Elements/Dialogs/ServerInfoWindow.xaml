<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.ServerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:phui="clr-namespace:PhasmaStrap.UI"
        mc:Ignorable="d"
        Title="Server information"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FactLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="FactValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="FactCard" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource PhasmaS3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="phui:CutCorners.Size" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="12,8" Title="SERVER INFORMATION" ShowMinimize="False" ShowMaximize="False" Icon="pack://application:,,,/PhasmaStrap.ico"
                     Background="{DynamicResource PhasmaChromeBrush}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <StackPanel Grid.Row="1" Margin="22,20,22,14">
            <TextBlock x:Name="GameText" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="17" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StateText" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <UniformGrid Grid.Row="2" Margin="22,0,14,0" Columns="3">
            <Border Style="{StaticResource FactCard}">
                <StackPanel>
                    <TextBlock Text="PLAYERS" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="PlayersText" Style="{StaticResource FactValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FactCard}">
                <StackPanel>
                    <TextBlock Text="PING" Style="{StaticResource FactLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PingDot" Width="7" Height="7" Margin="0,4,6,0" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="PingText" Style="{StaticResource FactValue}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FactCard}">
                <StackPanel>
                    <TextBlock Text="REGION" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="RegionText" Style="{StaticResource FactValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FactCard}">
                <StackPanel>
                    <TextBlock Text="UP FOR" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="UptimeText" Style="{StaticResource FactValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FactCard}">
                <StackPanel>
                    <TextBlock Text="SERVER FPS" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="ServerFpsText" Style="{StaticResource FactValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FactCard}" ToolTip="Average frame rate of PhasmaStrap players in this server">
                <StackPanel>
                    <TextBlock Text="PLAYERS' FPS" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="ClientFpsText" Style="{StaticResource FactValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="3" Margin="22,10,22,0">
            <TextBlock Text="FRIENDS HERE" Style="{StaticResource FactLabel}" />
            <TextBlock x:Name="FriendsText" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="22,16,22,20">
            <TextBlock Text="SERVER ID" Style="{StaticResource FactLabel}" />
            <Border Margin="0,6,0,0" Padding="12,4,4,4" Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" phui:CutCorners.Size="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="JobIdText" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource PhasmaIconButton}" Click="CopyJobId_Click" ToolTip="Copy server ID" AutomationProperties.Name="Copy server ID">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                    </Button>
                </Grid>
            </Border>
            <TextBlock x:Name="NoteText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <Border Grid.Row="5" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="90" Click="Close_Click" Style="{StaticResource PhasmaSoftButton}" Content="Close" />
                <Button x:Name="JoinButton" Margin="10,0,0,0" Click="Join_Click" Style="{StaticResource PhasmaAccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                        <TextBlock Text="Join this server" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
