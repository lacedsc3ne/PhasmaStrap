<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.LaunchAccountPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        Title="Which account?"
        Width="420" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True">
    <base:WpfUiWindow.Resources>
        <Style x:Key="AccountRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PhasmaAccentStrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="12,8" Title="WHICH ACCOUNT?" Background="{DynamicResource PhasmaChromeBrush}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" Icon="pack://application:,,,/PhasmaStrap.ico" ShowMaximize="False" ShowMinimize="False" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <TextBlock Grid.Row="1" Margin="22,18,22,12" FontSize="13.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
            <Run Text="Roblox starts on the account you pick. You can turn this question off on the " /><Run Foreground="{DynamicResource PhasmaRedTextBrush}" Text="Deployment" /><Run Text=" page." />
        </TextBlock>

        <ListBox x:Name="AccountList" Grid.Row="2" Margin="14,0,14,12" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource AccountRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="AccountList_MouseDoubleClick" SelectionChanged="AccountList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,12,0">
                            <Ellipse Fill="{DynamicResource PhasmaAccentSoftBrush}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="{Binding Initial}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                        </StackPanel>

                        <Border Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource PhasmaTagGood}" Visibility="{Binding CurrentVisibility}">
                            <TextBlock FontSize="10.5" Text="IN USE" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="90" Style="{StaticResource PhasmaSoftButton}" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="LaunchButton" MinWidth="100" Margin="10,0,0,0" Style="{StaticResource PhasmaAccentButton}" IsDefault="True" IsEnabled="False" Click="Launch_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                        <TextBlock VerticalAlignment="Center" Text="Launch" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
