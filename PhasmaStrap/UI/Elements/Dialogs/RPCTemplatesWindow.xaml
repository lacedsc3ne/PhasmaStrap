<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.RPCTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Menu_Integrations_RPCTemplates_Title}"
        Width="880"
        Height="560"
        MinWidth="680"
        MinHeight="440"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <base:WpfUiWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource PhasmaCaption}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="TemplateItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Row" Background="Transparent">
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource PhasmaAccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="16,12" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </base:WpfUiWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" />
        <StackPanel Grid.Row="0" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False" Panel.ZIndex="1">
            <Image Width="14" Height="14" Margin="0,0,8,0" Source="pack://application:,,,/Resources/PhasmaStrapLogo.png" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding Source={x:Static resources:Strings.Menu_Integrations_RPCTemplates_Title}, Converter={StaticResource PhasmaUpper}}" />
        </StackPanel>
        <ui:TitleBar Grid.Row="0" Height="32" MinHeight="32" Padding="0" Title="" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />

        <Border Grid.Row="1" Padding="22,16" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Integrations_RPCTemplates_Description}" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="RPCTemplatesListBox" Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemsSource="{Binding RPCTemplates, Mode=OneWay}" ItemContainerStyle="{StaticResource TemplateItem}"
                             SelectionChanged="RPCTemplateSelection" SelectedIndex="{Binding SelectedRPCTemplateIndex, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding GameID}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" Padding="16,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding AddRPCTemplateCommand, Mode=OneTime}" Style="{DynamicResource PhasmaSoftButton}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_New}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button IsEnabled="{Binding IsRPCTemplateSelected, Mode=OneWay}" Command="{Binding DeleteRPCTemplateCommand, Mode=OneTime}" Style="{DynamicResource PhasmaSoftButton}" Foreground="{DynamicResource PhasmaRedTextBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaRedTextBrush}" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Delete}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="22,18,22,20">
                    <Grid.Style>
                        <Style>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRPCTemplateSelected}" Value="False">
                                    <Setter Property="Grid.Visibility" Value="Hidden"></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="3" Content="Enabled" FontWeight="SemiBold" IsChecked="{Binding SelectedRPCTemplate.Enabled}" />

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PLACE ID" />
                        <ui:TextBox FontFamily="{DynamicResource PhasmaMono}" PlaceholderText="606849621" Text="{Binding SelectedRPCTemplate.GameID, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="DETAILS TEXT" />
                        <ui:TextBox FontFamily="{DynamicResource PhasmaMono}" PlaceholderText="Playing {gameName}" Text="{Binding SelectedRPCTemplate.DetailsTemplate, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="STATE TEXT" />
                        <ui:TextBox FontFamily="{DynamicResource PhasmaMono}" PlaceholderText="{}{status}" Text="{Binding SelectedRPCTemplate.StateTemplate, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="LARGE IMAGE URL (OPTIONAL)" />
                        <ui:TextBox FontFamily="{DynamicResource PhasmaMono}" Text="{Binding SelectedRPCTemplate.LargeImageUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SMALL IMAGE URL (OPTIONAL)" />
                        <ui:TextBox FontFamily="{DynamicResource PhasmaMono}" Text="{Binding SelectedRPCTemplate.SmallImageUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTRA BUTTON LABEL (OPTIONAL)" />
                        <ui:TextBox FontFamily="{DynamicResource PhasmaMono}" Text="{Binding SelectedRPCTemplate.ButtonLabel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTRA BUTTON URL (OPTIONAL)" />
                        <ui:TextBox FontFamily="{DynamicResource PhasmaMono}" Text="{Binding SelectedRPCTemplate.ButtonUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Column="1" Text="No template selected" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <TextBlock.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRPCTemplateSelected}" Value="True">
                                <Setter Property="TextBlock.Visibility" Value="Hidden"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</base:WpfUiWindow>
