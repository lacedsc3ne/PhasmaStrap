<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ModsViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="800" d:DesignWidth="900"
      Title="ModsPage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  The three quick links at the top of the page  -->
        <Style x:Key="ModsActionTile" TargetType="{x:Type Button}" BasedOn="{StaticResource PhasmaSoftButton}">
            <Setter Property="Background" Value="{DynamicResource PhasmaPanelRaisedBrush}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!--  Small image slot used by the cursor set editor and the skybox editor  -->
        <Style x:Key="ModsSlot" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PhasmaCornerRadiusSmall}" />
        </Style>

        <!--  A managed mod row. BorderBrush comes from the style so the drag highlight can be cleared back to it.  -->
        <Style x:Key="ManagedModRow" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PhasmaCornerRadiusSmall}" />
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="{x:Static resources:Strings.Menu_Mods_Title}" />
            <Border Margin="10,2,0,0" Style="{DynamicResource PhasmaTagNeutral}">
                <TextBlock Text="Launching" />
            </Border>
        </StackPanel>
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="File mods swapped into Roblox every time it starts." />

        <UniformGrid Margin="-6,0,-6,12" Columns="3">
            <Button x:Name="OpenModFolderCardAction" Margin="6,0,6,0" Style="{StaticResource ModsActionTile}" Command="{Binding OpenModsFolderCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Margin="0,0,12,0" VerticalAlignment="Center" Symbol="Folder24" FontSize="16" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Open mods folder" />
                        <TextBlock Margin="0,1,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Manage your own mods" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Margin="6,0,6,0" Style="{StaticResource ModsActionTile}" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://bloxstraplabs.com/wiki/features/modding/">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Margin="0,0,12,0" VerticalAlignment="Center" Symbol="Info24" FontSize="16" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{x:Static resources:Strings.Common_Help}" />
                        <TextBlock Margin="0,1,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Managing and making mods" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Margin="6,0,6,0" Style="{StaticResource ModsActionTile}" Command="{Binding OpenCompatSettingsCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Margin="0,0,12,0" VerticalAlignment="Center" Symbol="WindowWrench24" FontSize="16" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Compatibility settings" />
                        <controls:MarkdownTextBlock Margin="0,1,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    MarkdownText="{Binding Source={x:Static resources:Strings.Menu_Mods_Misc_CompatibilitySettings_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://devblogs.microsoft.com/directx/demystifying-full-screen-optimizations/'}" />
                    </StackPanel>
                </Grid>
            </Button>
        </UniformGrid>

        <controls:CardColumns>
            <!--  Mod management  -->
            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_Mods_ModManagement_Title}"
                                   Description="Drag a mod to change apply order, or drop files here to make a new one">
                <controls:SettingsCard.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource PhasmaAccentButton}" Command="{Binding AddManagedModCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Mods_AddMod}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding OpenManagedModsRootCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Mods_OpenLibrary}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="4,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding RefreshManagedModsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsCard.HeaderContent>

                <Border Style="{DynamicResource PhasmaDivider}" />
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{x:Static resources:Strings.Menu_Mods_SearchModsIdentifiers}" Text="{Binding ManagedModSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ManagedModsSummary}" />
                        <ProgressBar Width="120" Height="3" Margin="0,6,0,0" IsIndeterminate="True" Visibility="{Binding ManagedModsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,0,0,14" Padding="24" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ManagedMods.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon HorizontalAlignment="Center" Symbol="BoxMultiple24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding ManagedModsEmptyTitle}" />
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ManagedModsEmptyDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="ManagedModsList" Margin="0,0,0,8" AllowDrop="True" DragOver="ManagedModsList_DragOver" Drop="ManagedModsList_Drop" ItemsSource="{Binding ManagedMods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:ManagedModItem}">
                            <StackPanel>
                                <Border Style="{DynamicResource PhasmaDivider}" />
                                <Border Margin="0,2,0,2" Padding="0,6,2,6" AllowDrop="True" Style="{StaticResource ManagedModRow}" DragEnter="ManagedModCard_DragEnter" DragLeave="ManagedModCard_DragLeave" DragOver="ManagedModCard_DragOver" Drop="ManagedModCard_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Width="26" Height="34" Margin="0,0,6,0" Background="Transparent" Cursor="SizeAll" AutomationProperties.Name="Drag mod to change apply order" PreviewMouseLeftButtonDown="ManagedModDragHandle_MouseLeftButtonDown" PreviewMouseMove="ManagedModDragHandle_MouseMove">
                                            <ui:SymbolIcon FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="ReOrderDotsVertical24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name, Mode=OneWay}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <Run Text="{Binding FileSummary, Mode=OneWay}" /><Run Text="{x:Static resources:Strings.Menu_Mods_ID}" /><Run Text="{Binding ShortId, Mode=OneWay}" />
                                            </TextBlock>
                                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PhasmaWarnBrush}" Text="{Binding ConflictText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConflictText}" />
                                                <Button Margin="8,-4,0,-4" Padding="6,2" VerticalAlignment="Center" Style="{DynamicResource PhasmaGhostButton}" FontSize="12"
                                                        Command="{Binding DataContext.ToggleManagedModConflictsCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Show conflicts" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowConflicts}" Value="True">
                                                                        <Setter Property="Text" Value="Hide conflicts" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource PhasmaBadBrush}" Text="{Binding ScanError, Mode=OneWay}" Visibility="{Binding HasScanError, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="Open its folder" AutomationProperties.Name="Open mod folder" Command="{Binding DataContext.OpenManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" />
                                            </Button>
                                            <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Common_Rename}" AutomationProperties.Name="Rename mod" Command="{Binding DataContext.RenameManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="14" />
                                            </Button>
                                            <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="Export as .zip" AutomationProperties.Name="Export mod as a zip file" Command="{Binding DataContext.ExportManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="FolderZip24" FontSize="14" />
                                            </Button>
                                            <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="Copy full mod identifier" AutomationProperties.Name="Copy full mod identifier" Command="{Binding DataContext.CopyManagedModIdCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                                            </Button>
                                            <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Common_Delete}" AutomationProperties.Name="Remove mod" Command="{Binding DataContext.RemoveManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="{DynamicResource PhasmaBadBrush}" />
                                            </Button>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="3" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding DataContext.ToggleManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}" AutomationProperties.Name="Enable or disable this mod" />

                                        <!--  Every file this mod shares with another active mod or the mods folder  -->
                                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,2,2" Padding="10,8" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}"
                                                Background="{DynamicResource PhasmaHoverBrush}" Visibility="{Binding ShowConflicts, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{Binding Conflicts, Mode=OneTime}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type dmodels:ManagedModConflict}">
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Margin="0,0,12,0" FontFamily="Consolas" FontSize="11.5" TextTrimming="CharacterEllipsis" Text="{Binding Path, Mode=OneTime}" ToolTip="{Binding Path, Mode=OneTime}" />
                                                            <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource PhasmaWarnBrush}" Text="{Binding With, Mode=OneTime, StringFormat='also in {0}'}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SettingsCard>

            <!--  Cursor appearance  -->
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Mods_CursorAppearance}"
                                   Description="A bundled cursor, or your own images">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Presets_MouseCursor_Title}">
                    <ComboBox Padding="10,5,10,5" MinWidth="140" ItemsSource="{Binding CursorTypeTask.Selections, Mode=OneTime}" SelectedItem="{Binding CursorTypeTask.NewState, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Mods_CustomCursorSetQuickFolder}"
                    Description="Pick any picture to use as your arrow">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Margin="0,0,6,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding PreviewCustomCursorSetCommand}" Visibility="{Binding PreviewCustomCursorSetVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Eye16" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_Preview}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding ManageCustomCursorSetCommand}" Visibility="{Binding ChooseCustomCursorSetVisibility, Mode=OneWay}" />
                            <Button Style="{DynamicResource PhasmaSoftButton}" Foreground="{DynamicResource PhasmaBadBrush}" Content="{x:Static resources:Strings.Menu_Mods_Remove}" Command="{Binding ManageCustomCursorSetCommand}" Visibility="{Binding DeleteCustomCursorSetVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" MaxWidth="220" HorizontalAlignment="Right" TextAlignment="Right" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CustomCursorSetFolderDisplay, Mode=OneWay}" ToolTip="{Binding CustomCursorSetFolderDisplay, Mode=OneWay}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl
                    x:Name="CursorSetManagerOption"
                    Header="{x:Static resources:Strings.Menu_Mods_Misc_CursorSetManager_Title}"
                    Description="Saved sets to switch between and share">
                    <ToggleButton Style="{DynamicResource PhasmaSoftButton}" Content="Manage" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <!--  Client presets  -->
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Mods_ClientPresets}"
                                   Description="More visual and sound tweaks">
                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Mods_Presets_ModApplyTarget_Title}">
                    <ComboBox Padding="10,5,10,5" MinWidth="150" ItemsSource="{Binding ModApplyTargets, Mode=OneTime}" SelectedItem="{Binding ModApplyTarget, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding OldAvatarBackgroundTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding OldCharacterSoundsTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Title}">
                    <ComboBox Padding="10,5,10,5" MinWidth="130" ItemsSource="{Binding EmojiFontTask.Selections, Mode=OneTime}" Text="{Binding EmojiFontTask.NewState, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_PhasmaStrapLogoGameTopBar}" Description="On the round menu button at the top left of every game">
                    <ui:ToggleSwitch IsChecked="{Binding TopBarPhasmaLogo, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Mods_Misc_CustomDeathSound_Title}"
                    Description="{x:Static resources:Strings.Menu_Mods_Misc_CustomDeathSound_Description}">
                    <StackPanel>
                        <Button Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Menu_Mods_ChooseSound}" Command="{Binding AddCustomDeathSoundCommand}" Visibility="{Binding ChooseCustomDeathSoundVisibility, Mode=OneWay}" />
                        <Button Style="{DynamicResource PhasmaSoftButton}" Foreground="{DynamicResource PhasmaBadBrush}" Content="{x:Static resources:Strings.Menu_Mods_Remove}" Command="{Binding RemoveCustomDeathSoundCommand}" Visibility="{Binding DeleteCustomDeathSoundVisibility, Mode=OneWay}" />
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>

            <!--  Cursor set manager, opened from the Manage button above  -->
            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_Mods_Misc_CursorSetManager_Title}"
                                   Description="Saved cursor sets you can switch between, import and export"
                                   Visibility="{Binding InnerContent.IsChecked, ElementName=CursorSetManagerOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsCard.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource PhasmaSoftButton}" Command="{Binding AddCustomCursorSetCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Common_New}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource PhasmaBadBrush}" IsEnabled="{Binding IsCustomCursorSetSelected}" Command="{Binding DeleteCustomCursorSetCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Common_Delete}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsCard.HeaderContent>

                <Border Style="{DynamicResource PhasmaDivider}" />
                <StackPanel Margin="0,12,0,14">
                    <ListBox MaxHeight="280" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding CursorSets}" SelectedItem="{Binding SelectedCursorSet, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="120" Margin="2">
                                    <Border Height="56" Style="{StaticResource ModsSlot}">
                                        <Image Stretch="Uniform" Margin="6" Source="{Binding ArrowCursorPreview, TargetNullValue={x:Null}}" />
                                    </Border>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,12,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_NoCursorSetSelected}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NoCursorSetSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCustomCursorSetSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Margin="0,0,0,12" Style="{DynamicResource PhasmaDivider}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Text="{Binding SelectedCursorSet.Name}" />
                            <Button Grid.Column="1" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding RenameCustomCursorSetCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Edit16" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Rename}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <UniformGrid Margin="-4,0,-4,0" Columns="4" Rows="1">
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="{x:Static resources:Strings.Menu_Mods_Shiftlock}" FontSize="12" TextAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border Height="64" Style="{StaticResource ModsSlot}">
                                    <Image Stretch="Uniform" Margin="6" Source="{Binding SelectedCursorSet.ShiftlockCursorPreview, TargetNullValue={x:Null}}" />
                                </Border>
                                <Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding BrowseCursorSetFileCommand}" CommandParameter="MouseLockedCursor.png" />
                                <Button Margin="0,2,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource PhasmaBadBrush}" Content="{x:Static resources:Strings.Menu_Mods_Remove}" Command="{Binding RemoveCursorSetFileCommand}" CommandParameter="MouseLockedCursor.png" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="{x:Static resources:Strings.Menu_Mods_Arrow}" FontSize="12" TextAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border Height="64" Style="{StaticResource ModsSlot}">
                                    <Image Stretch="Uniform" Margin="6" Source="{Binding SelectedCursorSet.ArrowCursorPreview, TargetNullValue={x:Null}}" />
                                </Border>
                                <Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding BrowseCursorSetFileCommand}" CommandParameter="ArrowCursor.png" />
                                <Button Margin="0,2,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource PhasmaBadBrush}" Content="{x:Static resources:Strings.Menu_Mods_Remove}" Command="{Binding RemoveCursorSetFileCommand}" CommandParameter="ArrowCursor.png" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="{x:Static resources:Strings.Menu_Mods_ArrowFar}" FontSize="12" TextAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border Height="64" Style="{StaticResource ModsSlot}">
                                    <Image Stretch="Uniform" Margin="6" Source="{Binding SelectedCursorSet.ArrowFarCursorPreview, TargetNullValue={x:Null}}" />
                                </Border>
                                <Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding BrowseCursorSetFileCommand}" CommandParameter="ArrowFarCursor.png" />
                                <Button Margin="0,2,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource PhasmaBadBrush}" Content="{x:Static resources:Strings.Menu_Mods_Remove}" Command="{Binding RemoveCursorSetFileCommand}" CommandParameter="ArrowFarCursor.png" />
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="{x:Static resources:Strings.Menu_Mods_IBeam}" FontSize="12" TextAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border Height="64" Style="{StaticResource ModsSlot}">
                                    <Image Stretch="Uniform" Margin="6" Source="{Binding SelectedCursorSet.IBeamCursorPreview, TargetNullValue={x:Null}}" />
                                </Border>
                                <Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding BrowseCursorSetFileCommand}" CommandParameter="IBeamCursor.png" />
                                <Button Margin="0,2,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource PhasmaBadBrush}" Content="{x:Static resources:Strings.Menu_Mods_Remove}" Command="{Binding RemoveCursorSetFileCommand}" CommandParameter="IBeamCursor.png" />
                            </StackPanel>
                        </UniformGrid>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Margin="0,0,8,6" Style="{DynamicResource PhasmaAccentButton}" ToolTip="{x:Static resources:Strings.Menu_Mods_CopySetSImagesIntoMods}" Command="{Binding ApplyCursorSetCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark20" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Dialog_GoogleFonts_Apply}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,6" Style="{DynamicResource PhasmaSoftButton}" ToolTip="{x:Static resources:Strings.Menu_Mods_CopyCurrentlyAppliedCursorsIntoSet}" Command="{Binding GetCurrentCursorSetCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CollectionsAdd24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Mods_Fetch}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,6" Style="{DynamicResource PhasmaSoftButton}" ToolTip="{x:Static resources:Strings.Menu_Mods_ImportCursorSetFromZipFile}" Command="{Binding ImportCursorSetCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Import}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,0,6" Style="{DynamicResource PhasmaSoftButton}" ToolTip="{x:Static resources:Strings.Menu_Mods_ExportSetZipFile}" Command="{Binding ExportCursorSetCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowExportRtl24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Common_Export}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </controls:SettingsCard>

            <!--  Skybox and font  -->
            <controls:SettingsCard Header="Skybox and font">
                <controls:OptionControl
                    x:Name="SkyboxEditorOption"
                    Header="{x:Static resources:Strings.Menu_Mods_Misc_Skybox_Title}"
                    Description="Replace the default sky with your own images">
                    <ToggleButton Style="{DynamicResource PhasmaSoftButton}" Content="Choose" />
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Mods_Misc_CustomFont_Title}"
                    Description="Replaces the font Roblox uses for its interface">
                    <StackPanel>
                        <Button Margin="0,0,0,4" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Menu_Mods_Misc_GoogleFonts_Browse}" Command="{Binding BrowseGoogleFontsCommand}" Visibility="{Binding ChooseCustomFontVisibility, Mode=OneWay}" />
                        <Button HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaGhostButton}" Content="{x:Static resources:Strings.Menu_Mods_Misc_CustomFont_Choose}" Command="{Binding ManageCustomFontCommand}" Visibility="{Binding ChooseCustomFontVisibility, Mode=OneWay}" />
                        <Button HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Foreground="{DynamicResource PhasmaBadBrush}" Content="{x:Static resources:Strings.Menu_Mods_Misc_CustomFont_Remove}" Command="{Binding ManageCustomFontCommand}" Visibility="{Binding DeleteCustomFontVisibility, Mode=OneWay}" />
                    </StackPanel>
                </controls:OptionControl>

                <Grid Margin="2,0,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="84" Height="40" Style="{StaticResource ModsSlot}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Text="Aa Bb Cc" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Roblox is using its own font." Visibility="{Binding ChooseCustomFontVisibility, Mode=OneWay}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="A custom font is in use." Visibility="{Binding DeleteCustomFontVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </controls:SettingsCard>

            <!--  Home page background  -->
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Mods_Overlays_Title}"
                                   Description="A color or gradient behind PhasmaStrap's own Home page. Not the in game overlays.">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Overlays_Enable_Title}">
                    <ui:ToggleSwitch IsChecked="{Binding HomepageBackgroundEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Overlays_HomepageBackground_Title}" IsEnabled="{Binding HomepageBackgroundEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox MinWidth="130" Padding="10,5,10,5" ItemsSource="{Binding HomepageBackgroundModes, Mode=OneTime}" SelectedItem="{Binding SelectedHomepageBackgroundMode, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Appearance_Preview}" IsEnabled="{Binding PreviewHomepageBackgroundEnabled}" Command="{Binding PreviewHomepageBackgroundCommand}">
                            <ui:SymbolIcon Symbol="Eye16" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:OptionControl>

                <StackPanel Margin="2,0,2,12" IsEnabled="{Binding HomepageBackgroundEnabled}">
                    <Grid Visibility="{Binding ShowHomepageSolidColor, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_BackgroundColor}" />
                        <Button Grid.Column="1" MinWidth="110" Style="{DynamicResource PhasmaSoftButton}" Content="{Binding HomepageBackgroundOverlayColor}" Command="{Binding PickHomepageBackgroundColorCommand}" />
                    </Grid>

                    <StackPanel Visibility="{Binding ShowHomepageGradient, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_StartColor}" />
                                <Button HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{Binding HomepageBackgroundOverlayColor}" Command="{Binding PickHomepageBackgroundColorCommand}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_EndColor}" />
                                <Button HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{Binding HomepageBackgroundOverlayGradientColor}" Command="{Binding PickHomepageBackgroundGradientColorCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_Direction}" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="360" TickFrequency="1" Value="{Binding HomepageBackgroundOverlayGradientAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding HomepageBackgroundOverlayGradientAngleDisplay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </controls:SettingsCard>

            <!--  Skybox editor, opened from the Choose button above  -->
            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_Mods_Misc_Skybox_Title}"
                                   Description="One image for every side, or a picture per face"
                                   Visibility="{Binding InnerContent.IsChecked, ElementName=SkyboxEditorOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsCard.HeaderContent>
                    <Button Style="{DynamicResource PhasmaSoftButton}" Command="{Binding ChooseSingleSkyboxImageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ImageAdd24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Mods_UseOneImageEverySide}" />
                        </StackPanel>
                    </Button>
                </controls:SettingsCard.HeaderContent>

                <Border Style="{DynamicResource PhasmaDivider}" />
                <StackPanel Margin="0,12,0,14">
                    <UniformGrid Margin="-4,0,-4,0" Columns="3" Rows="2">
                        <Border Margin="4,0,4,8" Padding="10" Style="{StaticResource ModsSlot}">
                            <StackPanel>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Back}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CustomSkyboxBack}" ToolTip="{Binding CustomSkyboxBack}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Back" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4,0,4,8" Padding="10" Style="{StaticResource ModsSlot}">
                            <StackPanel>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Down}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CustomSkyboxDown}" ToolTip="{Binding CustomSkyboxDown}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Down" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4,0,4,8" Padding="10" Style="{StaticResource ModsSlot}">
                            <StackPanel>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Front}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CustomSkyboxFront}" ToolTip="{Binding CustomSkyboxFront}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Front" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4,0,4,0" Padding="10" Style="{StaticResource ModsSlot}">
                            <StackPanel>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Left}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CustomSkyboxLeft}" ToolTip="{Binding CustomSkyboxLeft}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Left" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4,0,4,0" Padding="10" Style="{StaticResource ModsSlot}">
                            <StackPanel>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Right}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CustomSkyboxRight}" ToolTip="{Binding CustomSkyboxRight}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Right" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4,0,4,0" Padding="10" Style="{StaticResource ModsSlot}">
                            <StackPanel>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Up}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CustomSkyboxUp}" ToolTip="{Binding CustomSkyboxUp}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Up" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource PhasmaBadBrush}" Command="{Binding RemoveCustomSkyboxCommand}" Visibility="{Binding HasCustomSkybox, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Mods_RemoveCustom}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource PhasmaAccentButton}" Content="{x:Static resources:Strings.Menu_Mods_SaveUse}" Command="{Binding ApplyCustomSkyboxCommand}" IsEnabled="{Binding CustomSkyboxCanApply}" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsCard>
        </controls:CardColumns>

    </StackPanel>
</ui:UiPage>
