<UserControl
    x:Class="PhasmaStrap.UI.Elements.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Focusable="False">

    <StackPanel>
        <Border x:Name="Card" Margin="0,0,0,24" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="2" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentBrush}" />
                        <TextBlock
                            x:Name="EyebrowText"
                            FontFamily="{DynamicResource PhasmaMono}"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{DynamicResource PhasmaRedTextBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TitleText"
                        Margin="0,10,0,0"
                        FontFamily="{DynamicResource PhasmaHeadingFont}"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,6,0,0"
                        MaxWidth="680"
                        HorizontalAlignment="Left"
                        FontSize="14.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ContentPresenter x:Name="ActionsPresenter" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
        <Border x:Name="TabLine" Margin="0,0,0,22" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
        </Border>
    </StackPanel>
</UserControl>
