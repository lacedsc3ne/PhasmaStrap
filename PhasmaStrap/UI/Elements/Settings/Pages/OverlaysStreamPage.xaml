<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.OverlaysStreamPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      Title="OverlaysStreamPage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <Style x:Key="StepNumber" TargetType="{x:Type Border}" BasedOn="{StaticResource PhasmaTag}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="StepText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SegCell" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource PhasmaFocusVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Fill" Height="28" Padding="12,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="13" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaS4Brush}" />
                                <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource PhasmaStrokeStrongBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Eyebrow="Performance · Overlays" Title="Stream-safe mode"
                             Subtitle="Give OBS a copy of the game with chat, names and other areas you mark hidden. Your own screen stays untouched." />

        <controls:CardColumns Spacing="16">
            <controls:SettingsCard VerticalAlignment="Top" Header="Stream safe mode">
                <controls:SettingsCard.HeaderContent>
                    <Border Style="{DynamicResource PhasmaTagGood}" Visibility="{Binding StreamSafeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource PhasmaGoodBrush}" />
                            <TextBlock Text="ON" />
                        </StackPanel>
                    </Border>
                </controls:SettingsCard.HeaderContent>

                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Rendering_HideChatNamesStream}" Description="OBS gets its own copy of the game with your marked areas pixelated">
                    <ui:ToggleSwitch IsChecked="{Binding StreamSafeEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" IsEnabled="{Binding StreamSafeEnabled}" Header="{x:Static resources:Strings.Menu_Rendering_HiddenAreas}" Description="{Binding StreamSafeSummary}">
                    <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding OpenStreamSafeEditorCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_EditAreas}" />
                        </StackPanel>
                    </Button>
                </controls:OptionControl>

                <controls:OptionControl Flat="True" IsEnabled="{Binding StreamSafeEnabled}" Header="{x:Static resources:Strings.Menu_Rendering_HowHiddenAreasLook}">
                    <Border Padding="3" Background="{DynamicResource PhasmaS3Brush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" phui:CutCorners.Size="6">
                        <ListBox Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource SegCell}" SelectedIndex="{Binding StreamSafeStyleIndex, Mode=TwoWay}">
                            <ListBox.Template>
                                <ControlTemplate TargetType="{x:Type ListBox}">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="{x:Static resources:Strings.Menu_Rendering_Pixelated}" />
                            <ListBoxItem Content="{x:Static resources:Strings.Menu_Rendering_Black}" />
                        </ListBox>
                    </Border>
                </controls:OptionControl>

                <controls:OptionControl Flat="True" IsEnabled="{Binding StreamSafeEnabled}" Header="{x:Static resources:Strings.Menu_Rendering_ShowCrosshairStream}">
                    <ui:ToggleSwitch IsChecked="{Binding StreamSafeCrosshair, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard VerticalAlignment="Top" IsEnabled="{Binding StreamSafeEnabled}" Header="{x:Static resources:Strings.Menu_Rendering_SettingUpOBS}">
                <StackPanel>
                    <Border Margin="-20,0,-20,0" Style="{DynamicResource PhasmaDivider}" />
                    <DockPanel Margin="0,16,0,16">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" HorizontalAlignment="Center" /></Border>
                        <TextBlock Style="{StaticResource StepText}" Text="Join a game with this switched on and saved." />
                    </DockPanel>
                    <Border Margin="-20,0,-20,0" Style="{DynamicResource PhasmaDivider}" />
                    <DockPanel Margin="0,16,0,16">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" HorizontalAlignment="Center" /></Border>
                        <TextBlock Style="{StaticResource StepText}" Text="In OBS, add a Window Capture source and pick PhasmaStrap Stream View." />
                    </DockPanel>
                    <Border Margin="-20,0,-20,0" Style="{DynamicResource PhasmaDivider}" />
                    <DockPanel Margin="0,16,0,16">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" HorizontalAlignment="Center" /></Border>
                        <TextBlock Style="{StaticResource StepText}" Text="Set its capture method to Windows 10 (1903 and up), then hide your old capture." />
                    </DockPanel>

                    <Border Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource PhasmaInfoBrush}" phui:CutCorners.Size="6">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top" Foreground="{DynamicResource PhasmaInfoBrush}" />
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="The stream view only updates while Roblox is in front. When you tab out, the stream keeps the last game picture." />
                        </DockPanel>
                    </Border>

                    <Border Margin="-20,16,-20,0" Style="{DynamicResource PhasmaDivider}" />
                    <Button Margin="0,14,0,16" HorizontalAlignment="Left" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding CopyStreamViewNameCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_CopyWindowName}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
