<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ShortcutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ShortcutsViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="ShortcutsPage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <Style x:Key="ShortcutSegItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="12,6" Margin="1" Background="Transparent" phui:CutCorners.Size="4"
                                TextElement.FontSize="13" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PhasmaS4Brush}" />
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShortcutSegList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ShortcutSegItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" Padding="2" phui:CutCorners.Size="6">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Title="{x:Static resources:Strings.Common_Shortcuts}" />

        <controls:SettingsCard Header="Create a shortcut" Description="A game shortcut uses that game's own icon.">
            <controls:OptionControl Flat="True" Header="What it launches" Description="Opens PhasmaStrap, starts Roblox or Studio, or goes straight into one game">
                <ListBox Style="{StaticResource ShortcutSegList}"
                         ItemsSource="{Binding ShortcutTargets, Mode=OneTime}"
                         DisplayMemberPath="Name"
                         SelectedItem="{Binding SelectedShortcutTarget, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Flat="True" Padding="36,0,0,0" Header="Place ID or game link"
                                    Description="{x:Static resources:Strings.Menu_Shortcuts_GameShortcuts_Description}"
                                    Visibility="{Binding IsGameTargetSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:TextBox Width="380" Icon="Link24" PlaceholderText="{x:Static resources:Strings.Menu_Shortcuts_PlaceIDGameLink}" Text="{Binding GameShortcutInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:OptionControl>

            <controls:OptionControl Flat="True" Header="Where to put it" Description="Desktop or the Start menu">
                <ListBox Style="{StaticResource ShortcutSegList}"
                         ItemsSource="{Binding ShortcutLocations, Mode=OneTime}"
                         SelectedItem="{Binding SelectedShortcutLocation, Mode=TwoWay}" />
            </controls:OptionControl>

            <Grid Margin="18,0,18,0">
                <Border Margin="-18,0,-18,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource PhasmaAccentButton}"
                                IsEnabled="{Binding NotBusy, Mode=OneWay}" Command="{Binding CreateShortcutCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Shortcuts_CreateShortcut}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GameShortcutStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </controls:SettingsCard>

        <controls:CardColumns>
            <controls:SettingsCard VerticalAlignment="Top" Header="Your shortcuts" Description="Shortcuts on your Desktop and Start menu that open PhasmaStrap">
                <controls:SettingsCard.HeaderContent>
                    <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="Refresh" Command="{Binding RefreshShortcutsCommand, Mode=OneTime}">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                    </Button>
                </controls:SettingsCard.HeaderContent>

                <Grid Margin="18,0,18,0">
                    <StackPanel Margin="-18,0,-18,0">
                        <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,16,20,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasExistingShortcuts}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="No shortcuts yet. Make one above, or turn on a quick shortcut." />
                        </Border>

                        <ItemsControl x:Name="ShortcutsList" ItemsSource="{Binding ExistingShortcuts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,10,16,10" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" Background="{DynamicResource PhasmaS3Brush}">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="Link24" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Image Source="{Binding Icon, Mode=OneTime}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Name, Mode=OneTime}" ToolTip="{Binding Path, Mode=OneTime}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Launches, Mode=OneTime}" />
                                                    <TextBlock FontSize="12.5" Margin="5,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="&#183;" />
                                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Location, Mode=OneTime}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{DynamicResource PhasmaIconButton}" ToolTip="Rename" AutomationProperties.Name="Rename shortcut"
                                                        Command="{Binding DataContext.RenameShortcutCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Edit24" FontSize="14" />
                                                </Button>
                                                <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaSoftButton}" FontWeight="SemiBold" Content="Remove"
                                                        Command="{Binding DataContext.RemoveShortcutCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </controls:SettingsCard>

            <controls:SettingsCard VerticalAlignment="Top" Header="Quick shortcuts" Description="Desktop and Start menu icons">
                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Common_Shortcuts_Desktop}" Description="Opens the launch menu">
                    <ui:ToggleSwitch IsChecked="{Binding DesktopIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Common_Shortcuts_StartMenu}">
                    <ui:ToggleSwitch IsChecked="{Binding StartMenuIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" ToolTip="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding PlayerIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}" ToolTip="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}"
                                        Visibility="{Binding IsStudioOptionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding StudioIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Title}" ToolTip="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding SettingsIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True"
                    Header="{x:Static resources:Strings.Menu_Shortcuts_ExtractIcons_Title}"
                    Description="{Binding Source={x:Static resources:Strings.Menu_Shortcuts_ExtractIcons_Description}, Converter={StaticResource StringFormatConverter},ConverterParameter='https://bloxstraplabs.com/wiki/info/using-roblox-icons-for-shortcuts/'}">
                    <ui:ToggleSwitch IsChecked="{Binding ExtractIconsTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard controls:CardColumns.FullRow="True"
                                   Header="{x:Static resources:Strings.Menu_Shortcuts_StudioCompanion_Title}"
                                   Description="A Studio plugin that tells PhasmaStrap what you are working on">
                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Shortcuts_EnableStudioCompanion}" Description="{Binding StudioPluginStatus, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,14,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                IsEnabled="{Binding StudioPluginEnabled}" Command="{Binding ReinstallStudioPluginCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Shortcuts_Reinstall}" />
                            </StackPanel>
                        </Button>
                        <ui:ToggleSwitch IsChecked="{Binding StudioPluginEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
