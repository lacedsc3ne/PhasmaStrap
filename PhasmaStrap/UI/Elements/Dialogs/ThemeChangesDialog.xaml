<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.Dialogs.ThemeChangesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Changes_Title}"
    Width="560"
    MinHeight="0"
    Background="{DynamicResource PhasmaPanelBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Source={x:Static resources:Strings.Menu_Appearance_ColorTheme_Changes_Title}, Converter={StaticResource PhasmaUpper}}"
            Grid.Row="0"
            Padding="12,8"
            Background="{DynamicResource PhasmaChromeBrush}"
            CanMaximize="False"
            FontFamily="{DynamicResource PhasmaMono}"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Icon="pack://application:,,,/PhasmaStrap.ico"
            KeyboardNavigation.TabNavigation="None"
            ShowMaximize="False"
            ShowMinimize="False" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <TextBlock
            x:Name="SummaryText"
            Grid.Row="1"
            Margin="20,20,20,0"
            FontSize="13.5"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="2"
            MaxHeight="360"
            Margin="20,14,20,20"
            Background="{DynamicResource PhasmaPanelBrush}"
            BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}"
            BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChangesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,0" MinHeight="44" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Label}"
                                        TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="1" Width="96" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            Background="{Binding OldSwatch}"
                                            BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Visibility="{Binding HasOld, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource PhasmaMono}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding OldHex}"
                                            Visibility="{Binding HasOld, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource PhasmaMono}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="new"
                                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <ui:SymbolIcon
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Symbol="ChevronRight24" />

                                    <StackPanel Grid.Column="3" Width="96" Margin="6,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            Background="{Binding NewSwatch}"
                                            BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource PhasmaMono}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding NewHex}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Row="3"
            Padding="18,12"
            BorderBrush="{DynamicResource PhasmaStrokeBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">
                <Button
                    MinWidth="90"
                    Click="CancelButton_Click"
                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Changes_Cancel}"
                    IsCancel="True"
                    Style="{StaticResource PhasmaSoftButton}" />
                <Button
                    MinWidth="90"
                    Margin="10,0,0,0"
                    Click="SaveButton_Click"
                    Content="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Changes_Save}"
                    Style="{StaticResource PhasmaAccentButton}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
