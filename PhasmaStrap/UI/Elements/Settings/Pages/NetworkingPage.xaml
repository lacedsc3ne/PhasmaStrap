<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.NetworkingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      Title="NetworkingPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  Sub pages listed down the left like a side menu; switching views keeps the TabItem headers that settings search uses  -->
        <Style x:Key="PillTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PhasmaFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Fill" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="Bar" Width="2" Margin="0,6,0,6" HorizontalAlignment="Left" CornerRadius="1" Background="{DynamicResource PhasmaAccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaSelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Tag holds the small caps heading shown above the list  -->
        <Style x:Key="PillTabControl" TargetType="{x:Type TabControl}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource PillTabItem}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,18,0" Padding="0,0,10,0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                                <StackPanel>
                                    <TextBlock Margin="10,2,0,8" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="{x:Static resources:Strings.Menu_FastFlags_Section_Networking}" />
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}" Text="A local proxy that changes what your own client is told, plus the asset engine." />

        <TabControl Tag="NETWORKING" Style="{StaticResource PillTabControl}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Proxy" />
                    </StackPanel>
                </TabItem.Header>

                <StackPanel>
                    <controls:CardColumns>
                        <controls:SettingsCard Header="Local proxy">
                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Networking_EnableLocalProxy}" Description="{Binding StatusText, Mode=OneWay}">
                                <ui:ToggleSwitch IsChecked="{Binding ProxyEnabled, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Networking_LocalProxyCertificate}" Description="{Binding CertificateStatusText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Installer_Install_Title}" Command="{Binding InstallCertificateCommand, Mode=OneTime}" />
                                    <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Mods_Remove}" Command="{Binding RemoveCertificateCommand, Mode=OneTime}" />
                                </StackPanel>
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Networking_BlockRobloxTelemetry}" Description="{Binding TelemetryBlockerStatusText, Mode=OneWay}">
                                <ui:ToggleSwitch IsChecked="{Binding BlockRobloxTelemetry, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="What the proxy changes">
                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Networking_PresenceMode}" Description="The session type Roblox's servers think you connect from">
                                <ComboBox MinWidth="110" ItemsSource="{Binding PresenceSpoofModes, Mode=OneTime}" SelectedItem="{Binding SelectedPresenceSpoofMode, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Networking_DisplayedBalance}" Description="Your own screen only. Blank turns it off.">
                                <ui:TextBox Width="120" PlaceholderText="{x:Static resources:Strings.Menu_Networking_RealBalance}" Text="{Binding RobuxSpoofAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:OptionControl>

                            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Networking_DisplayNameOverride}" Description="Blank turns it off">
                                <ui:TextBox Width="120" PlaceholderText="{x:Static resources:Strings.Menu_Networking_RealName}" Text="{Binding UsernameSpoofName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:OptionControl>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Networking_PreloadCache}">
                            <controls:OptionControl x:Name="PreloadEntriesOption" Header="Cached responses" Description="{Binding PreloadCacheSummary, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{DynamicResource PhasmaIconButton}" ToolTip="Show the cached entries">
                                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="14" />
                                    </ToggleButton>
                                    <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Command="{Binding RefreshPreloadCacheCommand, Mode=OneTime}">
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                                    </Button>
                                    <Button Margin="6,0,0,0" Style="{DynamicResource PhasmaSoftButton}" Content="{x:Static resources:Strings.Menu_Networking_ClearAll}" Command="{Binding ClearPreloadCacheCommand, Mode=OneTime}" />
                                </StackPanel>
                            </controls:OptionControl>

                            <StackPanel Margin="0,0,0,10" Visibility="{Binding InnerContent.Children[0].IsChecked, ElementName=PreloadEntriesOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{DynamicResource PhasmaDivider}" Margin="0,0,0,10" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Networking_EachEntryCachedAssetResolutionResponse}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding PreloadCacheEntries, Mode=OneWay}" MaxHeight="240">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" controls:ScrollBubbling.Enabled="True">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" Padding="8,4" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{DynamicResource PhasmaHoverBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="11" FontFamily="Consolas" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0" VerticalAlignment="Center">
                                                        <Run Text="{Binding SizeDisplay, Mode=OneWay}" /><Run Text=" • " /><Run Text="{Binding LastAccessedDisplay, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <Button Grid.Column="2" Style="{DynamicResource PhasmaIconButton}" Padding="4" ToolTip="{x:Static resources:Strings.Common_Delete}"
                                                            Command="{Binding DataContext.DeletePreloadCacheEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </controls:SettingsCard>

                        <!--  Panic wipe: one compact row like the mockup  -->
                        <Border Style="{DynamicResource PhasmaCard}" Margin="0,0,0,12" AutomationProperties.Name="{x:Static resources:Strings.Menu_Networking_PanicWipe}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="17" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaBadBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Networking_PanicWipe}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Signs you out of Roblox and clears every cache and log folder in one go" />
                                </StackPanel>
                                <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaSoftButton}" Foreground="{DynamicResource PhasmaBadBrush}" Command="{Binding WipeAllCommand, Mode=OneTime}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static resources:Strings.Menu_Networking_Wipe}" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding WipeStatus, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </Grid>
                        </Border>
                    </controls:CardColumns>

                    <TextBlock Style="{DynamicResource PhasmaSectionLabel}" Text="SPOOFING" />

                    <controls:CardColumns DataContext="{Binding Spoofer, Mode=OneTime}">
                        <controls:SettingsCard Header="{x:Static resources:Strings.Menu_FastFlagSettings_SpoofOtherPlayers}"
                                               Description="{x:Static resources:Strings.Menu_FastFlagSettings_OverridesWhatYouSeeOtherPlayers}">
                            <controls:OptionControl
                                Header="{x:Static resources:Strings.Menu_AssetWarp_SpoofOthersName_Title}"
                                Description="{x:Static resources:Strings.Menu_AssetWarp_SpoofOthersName_Description}">
                                <ui:TextBox Width="140" Text="{Binding SpoofOthersName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:OptionControl>

                            <controls:OptionControl
                                Header="{x:Static resources:Strings.Menu_AssetWarp_SpoofOthersApplyIngame_Title}"
                                Description="{x:Static resources:Strings.Menu_AssetWarp_SpoofOthersApplyIngame_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding SpoofOthersApplyIngame, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl
                                Header="{x:Static resources:Strings.Menu_AssetWarp_SpoofOthersVerified_Title}"
                                Description="{x:Static resources:Strings.Menu_AssetWarp_SpoofOthersVerified_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding SpoofOthersVerified, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Static resources:Strings.Menu_FastFlagSettings_SpoofYourself}"
                                               Description="{x:Static resources:Strings.Menu_FastFlagSettings_OverridesOwnDisplayedNameVerificationRobux}">
                            <controls:OptionControl
                                Header="{x:Static resources:Strings.Menu_AssetWarp_SpoofSelfName_Title}"
                                Description="{x:Static resources:Strings.Menu_AssetWarp_SpoofSelfName_Description}">
                                <ui:TextBox Width="140" Text="{Binding SpoofSelfName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:OptionControl>

                            <controls:OptionControl
                                Header="{x:Static resources:Strings.Menu_AssetWarp_SpoofSelfApplyIngame_Title}"
                                Description="{x:Static resources:Strings.Menu_AssetWarp_SpoofSelfApplyIngame_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding SpoofSelfApplyIngame, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl
                                Header="{x:Static resources:Strings.Menu_AssetWarp_SpoofSelfVerified_Title}"
                                Description="{x:Static resources:Strings.Menu_AssetWarp_SpoofSelfVerified_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding SpoofSelfVerified, Mode=TwoWay}" />
                            </controls:OptionControl>

                            <controls:OptionControl
                                Header="{x:Static resources:Strings.Menu_AssetWarp_SpoofSelfGameCreator_Title}"
                                Description="{x:Static resources:Strings.Menu_AssetWarp_SpoofSelfGameCreator_Description}">
                                <ui:ToggleSwitch IsChecked="{Binding SpoofSelfGameCreator, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </controls:SettingsCard>
                    </controls:CardColumns>
                </StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagSettings_AssetEngine}" />
                    </StackPanel>
                </TabItem.Header>
                <Frame Source="AssetEnginePage.xaml"
                       NavigationUIVisibility="Hidden"
                       JournalOwnership="OwnsJournal"
                       Background="Transparent" />
            </TabItem>
        </TabControl>
    </StackPanel>
</ui:UiPage>
