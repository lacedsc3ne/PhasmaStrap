<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.RenderingPerGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:converters="clr-namespace:PhasmaStrap.UI.Converters"
      mc:Ignorable="d"
      Title="RenderingPerGamePage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <converters:PlaceDisplayConverter x:Key="PlaceDisplay" />
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Eyebrow="Performance · Rendering" Title="Per game overrides" Subtitle="Skip the runtime optimiser for some games, or give them a preset of their own." />

        <controls:CardColumns Spacing="16">
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Performance_EngineExcludedPlaces_Title}"
                                   VerticalAlignment="Top" Description="The optimiser is skipped entirely for these places.">
                <controls:SettingsCard.HeaderContent>
                    <Border Style="{DynamicResource PhasmaTagNeutral}">
                        <TextBlock Text="{Binding EngineExcludedPlaces.Count}" />
                    </Border>
                </controls:SettingsCard.HeaderContent>
                <StackPanel>
                <Border Margin="-20,0,-20,14" Style="{DynamicResource PhasmaDivider}" />
                <WrapPanel Margin="0,0,0,10">
                    <ui:TextBox Width="190" Margin="0,0,10,4" PlaceholderText="{x:Static resources:Strings.Menu_Performance_EngineExcludedPlaces_PlaceholderText}" Text="{Binding EngineExcludePlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="0,0,0,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding AddEngineExcludedPlaceCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_Add}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                </StackPanel>

                <ItemsControl Margin="0,0,0,0" ItemsSource="{Binding EngineExcludedPlaces, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="-20,0,-20,0">
                                <Border Style="{DynamicResource PhasmaDivider}" />
                                <Grid Margin="20,12,20,12" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Text="{Binding Converter={StaticResource PlaceDisplay}}" />
                                    <Button Grid.Column="1" Margin="12,0,0,0" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Mods_Remove}"
                                            Command="{Binding DataContext.RemoveEngineExcludedPlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Performance_EngineAssignments_Title}"
                                   VerticalAlignment="Top" Description="A preset only for the listed places.">
                <controls:SettingsCard.HeaderContent>
                    <Border Style="{DynamicResource PhasmaTagNeutral}">
                        <TextBlock Text="{Binding EngineProfileAssignments.Count}" />
                    </Border>
                </controls:SettingsCard.HeaderContent>
                <StackPanel>
                <Border Margin="-20,0,-20,14" Style="{DynamicResource PhasmaDivider}" />
                <WrapPanel Margin="0,0,0,10">
                    <ui:TextBox Width="160" Margin="0,0,10,4" PlaceholderText="{x:Static resources:Strings.Menu_Performance_EngineAssignments_PlaceholderText}" Text="{Binding EngineAssignPlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="170" Margin="0,0,10,4" Padding="10,5,10,5" ItemsSource="{Binding EnginePresetNames, Mode=OneTime}" SelectedItem="{Binding EngineAssignPresetName, Mode=TwoWay}" />
                    <Button Margin="0,0,0,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding AddEngineProfileAssignmentCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_Add}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                </StackPanel>

                <ItemsControl Margin="0,0,0,0" ItemsSource="{Binding EngineProfileAssignments, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="-20,0,-20,0">
                                <Border Style="{DynamicResource PhasmaDivider}" />
                                <Grid Margin="20,12,20,12" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Text="{Binding Display}" />
                                    <Button Grid.Column="1" Margin="12,0,0,0" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Mods_Remove}"
                                            Command="{Binding DataContext.RemoveEngineProfileAssignmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
