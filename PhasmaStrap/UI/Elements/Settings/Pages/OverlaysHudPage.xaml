<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.OverlaysHudPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="OverlaysHudPage"
      Scrollable="True">

    <Grid Margin="0,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!--  Left: what the HUD shows  -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <controls:SettingsCard>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_ShowFps_Title}" Description="A small FPS readout in the corner of the game">
                    <ui:ToggleSwitch IsChecked="{Binding HudEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_Diagnostics_Title}" Description="Adds a Can't see overlays? item to the tray menu">
                    <ui:ToggleSwitch IsChecked="{Binding DiagnosticsEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Rendering_ExtraHUDRows}" Description="{Binding ExtraRowsSummary, Mode=OneWay}">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_FrameTime}" Description="Milliseconds per frame">
                    <ui:ToggleSwitch IsChecked="{Binding ShowFrameTime, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_CPUUsage}" Description="All cores">
                    <ui:ToggleSwitch IsChecked="{Binding ShowCpu, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_RAMUsage}">
                    <ui:ToggleSwitch IsChecked="{Binding ShowRam, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_ServerPing}">
                    <ui:ToggleSwitch IsChecked="{Binding ShowPing, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Game name">
                    <ui:ToggleSwitch IsChecked="{Binding ShowGame, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Session time">
                    <ui:ToggleSwitch IsChecked="{Binding ShowSessionTime, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_ServerRegion}" Description="Such as Frankfurt, DE">
                    <ui:ToggleSwitch IsChecked="{Binding ShowRegion, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <!--  Finer look settings that do not fit the narrow column  -->
            <controls:SettingsCard Header="Fine tuning" Description="Exact spacing, corners, shadow and colours.">
                <Border Margin="0,0,0,12" HorizontalAlignment="Left" MaxWidth="480" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" ClipToBounds="True"
                        BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                    <Image Source="{Binding HudPreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_DistanceFromSide}" Description="{x:Static resources:Strings.Menu_Rendering_PixelsMiddlePositionsShiftRight}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="150" Minimum="0" Maximum="400" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding HudOffsetX, Mode=TwoWay}" />
                        <TextBlock Width="40" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding HudOffsetX}" />
                    </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_DistanceFromTopBottom}" Description="{x:Static resources:Strings.Menu_Rendering_Pixels}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="150" Minimum="0" Maximum="400" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding HudOffsetY, Mode=TwoWay}" />
                        <TextBlock Width="40" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding HudOffsetY}" />
                    </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_RoundedCorners}" Description="{x:Static resources:Strings.Menu_Rendering_HowRoundBackgroundSCornersAre}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="150" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HudCornerRadius, Mode=TwoWay}" />
                        <TextBlock Width="40" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding HudCornerRadius}" />
                    </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_TextShadow}" Description="Keeps text readable over bright scenes">
                    <ui:ToggleSwitch IsChecked="{Binding HudTextShadow, Mode=TwoWay}" />
                </controls:OptionControl>

                <!--  Colours: one line each so they fit any width  -->
                <StackPanel Margin="0,0,0,4">
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <TextBlock Margin="2,10,0,0" FontSize="13.5" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Appearance_ColorTheme_Editor_ColoursTab}" />
                    <TextBlock Margin="2,2,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="As #RRGGBB" />
                    <WrapPanel Margin="2,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" Background="{Binding HudBackgroundBrush}" />
                            <TextBlock Margin="8,0,6,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Rendering_Background}" />
                            <ui:TextBox Width="92" ClearButtonEnabled="False" ToolTip="{x:Static resources:Strings.Menu_Rendering_Background}" Text="{Binding HudBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" Background="{Binding HudLabelBrush}" />
                            <TextBlock Margin="8,0,6,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Rendering_Labels}" />
                            <ui:TextBox Width="92" ClearButtonEnabled="False" ToolTip="{x:Static resources:Strings.Menu_Rendering_Labels}" Text="{Binding HudLabelColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" Background="{Binding HudValueBrush}" />
                            <TextBlock Margin="8,0,6,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Rendering_Numbers}" />
                            <ui:TextBox Width="92" ClearButtonEnabled="False" ToolTip="{x:Static resources:Strings.Menu_Rendering_Numbers}" Text="{Binding HudValueColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <Border Style="{DynamicResource PhasmaDivider}" />
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding ResetHudLookCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_ResetHUDLook}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>

        <!--  Right: live preview and the main look settings  -->
        <StackPanel Grid.Column="1">
            <TextBlock Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Rendering_ActualSize}" />
            <Border Height="210" CornerRadius="{DynamicResource PhasmaCornerRadius}" ClipToBounds="True" Padding="10" Background="#FF2A5A8C"
                    BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                <Image Source="{Binding HudPreviewActual}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
            <TextBlock Margin="2,8,0,12" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{x:Static resources:Strings.Menu_Rendering_FPSCountsFramesGameActuallyShows}" />

            <controls:SettingsCard Header="Look and position">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_Position}">
                    <ComboBox Width="110" Padding="10,5,10,5" ItemsSource="{Binding HudPositionOptions, Mode=OneTime}" SelectedIndex="{Binding HudPositionIndex, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_Background}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="96" VerticalAlignment="Center" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding HudBackgroundOpacity, Mode=TwoWay}"
                                ToolTip="{Binding HudBackgroundOpacity}" />
                        <TextBlock Width="38" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding HudBackgroundOpacity, StringFormat={}{0}%}" />
                    </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairSize_Title}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="96" VerticalAlignment="Center" Minimum="50" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding HudScale, Mode=TwoWay}"
                                ToolTip="{Binding HudScale}" />
                        <TextBlock Width="38" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding HudScale, StringFormat={}{0}%}" />
                    </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_Layout}">
                    <ComboBox Width="100" Padding="10,5,10,5" SelectedIndex="{Binding HudLayoutIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Rendering_List}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Rendering_OneLine}" />
                    </ComboBox>
                </controls:OptionControl>
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Rendering_ShowLabels}">
                    <ui:ToggleSwitch IsChecked="{Binding HudShowLabels, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>
        </StackPanel>
    </Grid>
</ui:UiPage>
