<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ReleasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ReleasesViewModel, IsDesignTimeCreatable=True}"
      Title="ReleasesPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <Style x:Key="ReleaseListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Fill" Padding="16,12,16,12" Background="Transparent" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="{DynamicResource PhasmaAccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Title="News" Subtitle="PhasmaStrap releases from GitHub: what changed, and the files for each version." />

        <Border Style="{DynamicResource PhasmaCard}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center" phui:CutCorners.Size="6" Background="{DynamicResource PhasmaAccentBrush}">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Text="{Binding UpdateHeadline, Mode=OneWay}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding UpdateDetail, Mode=OneWay}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Margin="0,0,12,0" MaxWidth="220" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StatusText, Mode=OneWay}" />

                <Button Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaAccentButton}"
                        Visibility="{Binding UpdateActionVisibility, Mode=OneWay}" Command="{Binding UpdateCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Update" />
                    </StackPanel>
                </Button>

                <ui:TextBox Grid.Column="4" Width="240" VerticalAlignment="Center" Icon="Search24" PlaceholderText="{x:Static resources:Strings.Menu_Releases_SearchPlaceholder}"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaIconButton}"
                        ToolTip="{x:Static resources:Strings.Menu_Releases_Refresh}" Command="{Binding RefreshCommand, Mode=OneTime}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <controls:SettingsCard Margin="0,20,0,0" Header="{Binding WhatsNewTitle, Mode=OneTime}" Description="The version you are running" Visibility="{Binding WhatsNewVisibility}">
            <Grid Margin="18,0,18,0">
                <Border Margin="-18,0,-18,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,16,20,18">
                    <controls:MarkdownTextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" MarkdownText="{Binding WhatsNew}" />
                </Border>
            </Grid>
        </controls:SettingsCard>

        <Border Margin="0,8,0,0" Style="{DynamicResource PhasmaPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="RELEASES" />
                        </Border>
                        <ListBox VerticalAlignment="Top" MaxHeight="620" HorizontalContentAlignment="Stretch"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource ReleaseListItem}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                 controls:ScrollBubbling.Enabled="True"
                                 ItemsSource="{Binding Releases, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedRelease, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Text="{Binding PublishedText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource PhasmaTagGood}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Source={x:Static resources:Strings.Menu_Releases_Installed}, Converter={StaticResource PhasmaUpper}}" FontSize="10" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <StackPanel Margin="24,20,24,22" Visibility="{Binding DetailVisibility, Mode=OneWay}">
                        <StackPanel DataContext="{Binding SelectedRelease, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border RenderTransformOrigin="0.5,0.5" Width="4" Height="22" Margin="3,0,12,0" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentBrush}">
                                        <Border.RenderTransform>
                                            <SkewTransform AngleX="-14" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="20" FontWeight="Bold" Foreground="White"
                                               Text="{Binding Name, Converter={StaticResource PhasmaUpper}}" />
                                    <Border Margin="12,0,0,0" Style="{DynamicResource PhasmaTagGood}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Source={x:Static resources:Strings.Menu_Releases_Installed}, Converter={StaticResource PhasmaUpper}}" FontSize="10.5" />
                                    </Border>
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PublishedText}" />
                                </WrapPanel>

                                <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                        Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding HtmlUrl}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static resources:Strings.Menu_Releases_ViewOnGitHub}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <controls:MarkdownTextBlock Margin="0,16,0,0" FontSize="13.5" TextWrapping="Wrap" MarkdownText="{Binding Body}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <StackPanel Margin="0,20,0,0" Visibility="{Binding AssetsVisibility, Mode=OneWay}">
                                <Border Style="{DynamicResource PhasmaDivider}" />
                                <TextBlock Margin="0,14,0,6" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <Run Text="{Binding AssetCount, Mode=OneWay}" />
                                    <Run Text="{Binding Source={x:Static resources:Strings.Menu_Releases_Assets}, Mode=OneWay, Converter={StaticResource PhasmaUpper}}" />
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Assets, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0" Symbol="Box24" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SizeText}" />
                                                    <Button Grid.Column="3" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                                            Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding DownloadUrl}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,8,0" />
                                                            <TextBlock Text="Download" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="24,40" VerticalAlignment="Top" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding NoSelectionVisibility, Mode=OneWay}"
                               Text="Pick a release on the left to read its notes and downloads." />
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</ui:UiPage>
