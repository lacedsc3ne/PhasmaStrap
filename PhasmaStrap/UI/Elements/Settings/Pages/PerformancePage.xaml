<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      mc:Ignorable="d"
      Title="PerformancePage"
      Scrollable="False">
    <controls:SectionHost x:Name="Host" Header="Performance" Layout="Rail">
        <controls:SectionItem Label="Frame rate" PageType="{x:Type pages:RenderingFrameRatePage}" />
        <controls:SectionItem Label="Resolution" PageType="{x:Type pages:RenderingResolutionPage}" />
        <controls:SectionItem Label="Per-game" PageType="{x:Type pages:RenderingPerGamePage}" />
        <controls:SectionItem Label="Low-end mode" PageType="{x:Type pages:RenderingLowEndPage}" />
        <controls:SectionItem Label="Boost options" PageType="{x:Type pages:RenderingBoostPage}" />
        <controls:SectionItem Label="System" PageType="{x:Type pages:RenderingSystemPage}" />
        <controls:SectionItem Label="Overlays" TabLabel="Stats overlay" PageType="{x:Type pages:OverlaysHudPage}" />
        <controls:SectionItem Label="Crosshair" TabParent="{x:Type pages:OverlaysHudPage}" PageType="{x:Type pages:OverlaysCrosshairPage}" />
        <controls:SectionItem Label="Stream-safe mode" TabParent="{x:Type pages:OverlaysHudPage}" PageType="{x:Type pages:OverlaysStreamPage}" />
        <controls:SectionItem Label="RiShade" PageType="{x:Type pages:RiShadePage}" />
        <controls:SectionItem Label="NVIDIA" PageType="{x:Type pages:NvidiaPage}" />
        <controls:SectionItem Label="Network" PageType="{x:Type pages:NetworkingPage}" />
        <controls:SectionItem Label="Settings file" PageType="{x:Type pages:GBSEditorPage}" />
    </controls:SectionHost>
</ui:UiPage>
