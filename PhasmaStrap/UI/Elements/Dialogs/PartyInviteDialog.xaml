<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.PartyInviteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:phui="clr-namespace:PhasmaStrap.UI"
        Title="Invite to your party"
        Width="460" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True">
    <base:WpfUiWindow.Resources>
        <Style x:Key="InviteButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PhasmaAccentButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="phui:CutCorners.Size" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource PhasmaS4Brush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="12,8" Title="INVITE TO YOUR PARTY" Background="{DynamicResource PhasmaChromeBrush}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" Icon="pack://application:,,,/PhasmaStrap.ico" ShowMaximize="False" ShowMinimize="False" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <TextBlock Grid.Row="1" Margin="22,18,22,10" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding Status, Mode=OneWay}" />

        <ItemsControl Grid.Row="2" Margin="22,0,22,8" ItemsSource="{Binding Friends, Mode=OneWay}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="{x:Type ItemsControl}">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="0,10" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{DynamicResource PhasmaS4Brush}" />
                                <Image Source="{Binding Avatar}" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                                    </Image.Clip>
                                </Image>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource InviteButton}" Content="{Binding ButtonText}" IsEnabled="{Binding CanInvite}"
                                    Command="{Binding DataContext.InviteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button HorizontalAlignment="Left" Style="{StaticResource PhasmaSoftButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button MinWidth="90" HorizontalAlignment="Right" Style="{StaticResource PhasmaAccentButton}" Content="Close" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
