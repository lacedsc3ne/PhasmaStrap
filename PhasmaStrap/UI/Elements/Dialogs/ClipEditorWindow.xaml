<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.Dialogs.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        mc:Ignorable="d"
        Title="Edit clip"
        Width="1180"
        Height="840"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource PhasmaPanelBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <base:WpfUiWindow.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource PhasmaSoftButton}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="CropActiveButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaAccentStrokeBrush}" />
        </Style>
        <Style x:Key="PlayStyle" TargetType="Button" BasedOn="{StaticResource PhasmaAccentButton}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource PhasmaIconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="ToolIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="6,0,12,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource PhasmaStrokeStrongBrush}" />
        </Style>
        <Style x:Key="BarLabel" TargetType="TextBlock" BasedOn="{StaticResource PhasmaCaption}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,10,0" />
        </Style>
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource PhasmaS4Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="KeyLabel" TargetType="TextBlock" BasedOn="{StaticResource PhasmaCaption}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" />
        <ui:TitleBar Grid.Row="0" x:Name="RootTitleBar" Height="32" MinHeight="32" Padding="14,0,0,0" Title="Edit clip" Icon="pack://application:,,,/Resources/PhasmaStrapLogo.png"
                     FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <Border Grid.Row="1" Margin="20,18,20,0" Background="#FF000000" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Viewbox Stretch="Uniform" Margin="2">
                    <Grid x:Name="Surface" Width="1280" Height="720">
                        <MediaElement x:Name="Player" Stretch="Fill" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" IsMuted="False" Volume="0.6"
                                      MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed" />
                        <Image x:Name="StillImage" Stretch="Fill" Visibility="Collapsed" />
                        <Canvas x:Name="CropCanvas" Background="Transparent" ClipToBounds="True"
                                MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown" MouseMove="CropCanvas_MouseMove" MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp" />
                    </Grid>
                </Viewbox>
                <Border Margin="12" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#CC0D0D12" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" IsHitTestVisible="False">
                    <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedItem.Content, ElementName=SpeedBox, StringFormat={}{0} PREVIEW}" />
                </Border>
                <Button x:Name="BigPlay" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Click="Play_Click" ToolTip="Play (Space)"
                        Background="{DynamicResource PhasmaAccentBrush}" Foreground="White" BorderBrush="Transparent" BorderThickness="0">
                    <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="22" />
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Disc" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Disc" Property="Opacity" Value="0.88" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="VideoMessage" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Padding="10,4" Background="#AA000000" Foreground="White" FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,14,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionText" Grid.Column="0" Text="0:00.00" VerticalAlignment="Center" Width="72" FontSize="13" FontFamily="{DynamicResource PhasmaMono}" />
            <Grid x:Name="Timeline" Grid.Column="1" Height="62" Background="Transparent" ClipToBounds="True"
                  SizeChanged="Timeline_SizeChanged"
                  MouseLeftButtonDown="Timeline_MouseLeftButtonDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseLeftButtonUp">
                <Border Margin="8,4" Background="{DynamicResource PhasmaPanelRaisedBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" ClipToBounds="True">
                    <UniformGrid x:Name="ThumbStrip" Rows="1" />
                </Border>
                <Canvas x:Name="TimelineCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="DimLeft" Fill="#B0000000" />
                    <Rectangle x:Name="DimRight" Fill="#B0000000" />
                    <Rectangle x:Name="RangeOutline" Stroke="{DynamicResource PhasmaAccentBrush}" StrokeThickness="2" />
                    <Border x:Name="StartHandle" Width="10" Background="{DynamicResource PhasmaAccentBrush}">
                        <Rectangle Width="2" Height="16" Fill="{DynamicResource PhasmaAccentTextBrush}" Opacity="0.85" />
                    </Border>
                    <Border x:Name="EndHandle" Width="10" Background="{DynamicResource PhasmaAccentBrush}">
                        <Rectangle Width="2" Height="16" Fill="{DynamicResource PhasmaAccentTextBrush}" Opacity="0.85" />
                    </Border>
                    <Rectangle x:Name="Playhead" Width="2" Fill="White" />
                </Canvas>
            </Grid>
            <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00.00" VerticalAlignment="Center" Width="72" TextAlignment="Right" FontSize="13" FontFamily="{DynamicResource PhasmaMono}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Border Grid.Row="3" Padding="20,12,20,4" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,1">
            <WrapPanel x:Name="ToolsPanel" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="PlayButton" Style="{StaticResource PlayStyle}" Click="Play_Click" ToolTip="Play / pause the selection (Space)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="PlayIcon" Style="{StaticResource ToolIcon}" Symbol="Play24" Margin="0,0,6,0" Foreground="White" />
                            <TextBlock x:Name="PlayLabel" Text="Play" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StepButton}" AutomationProperties.Name="Back one frame" Click="StepBack_Click" ToolTip="Back one frame (Left arrow)">
                        <ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="Previous24" />
                    </Button>
                    <Button Style="{StaticResource StepButton}" AutomationProperties.Name="Forward one frame" Click="StepForward_Click" ToolTip="Forward one frame (Right arrow)">
                        <ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="Next24" />
                    </Button>
                </StackPanel>
                <Rectangle Style="{StaticResource ToolDivider}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource ToolButton}" Click="SetStart_Click" ToolTip="Start the clip at the current position (I or [)">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="ArrowPrevious24" Margin="0,0,6,0" /><TextBlock Text="Set start" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="SetEnd_Click" ToolTip="End the clip at the current position (O or ])">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="ArrowNext24" Margin="0,0,6,0" /><TextBlock Text="Set end" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="ResetTrim_Click" ToolTip="Select the whole clip again">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="ArrowRepeatAll24" Margin="0,0,6,0" /><TextBlock Text="Reset trim" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
                <Rectangle Style="{StaticResource ToolDivider}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="CropButton" Style="{StaticResource ToolButton}" Click="Crop_Click" ToolTip="Drag a rectangle over the video to keep only that area (C)">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="Crop24" Margin="0,0,6,0" /><TextBlock Text="Crop" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="ClearCropButton" Style="{StaticResource ToolButton}" Click="ClearCrop_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="Dismiss24" Margin="0,0,6,0" /><TextBlock Text="Clear crop" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
                <Rectangle Style="{StaticResource ToolDivider}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                    <TextBlock Text="SPEED" Style="{StaticResource BarLabel}" />
                    <ComboBox x:Name="SpeedBox" Width="96" SelectionChanged="SpeedBox_SelectionChanged" ToolTip="Slow motion or fast forward - the preview plays at this speed and the saved clip keeps it">
                        <ComboBoxItem Content="0.25×" Tag="0.25" />
                        <ComboBoxItem Content="0.5×" Tag="0.5" />
                        <ComboBoxItem Content="1×" Tag="1" IsSelected="True" />
                        <ComboBoxItem Content="1.5×" Tag="1.5" />
                        <ComboBoxItem Content="2×" Tag="2" />
                        <ComboBoxItem Content="4×" Tag="4" />
                    </ComboBox>
                </StackPanel>
                <Rectangle Style="{StaticResource ToolDivider}" />
                <StackPanel x:Name="GifTools" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="GIF" Style="{StaticResource BarLabel}" />
                    <ComboBox x:Name="GifWidthBox" Width="104" Margin="0,0,6,0" ToolTip="Width of the GIF - smaller means a much smaller file">
                        <ComboBoxItem Content="320 px" Tag="320" />
                        <ComboBoxItem Content="480 px" Tag="480" />
                        <ComboBoxItem Content="640 px" Tag="640" IsSelected="True" />
                        <ComboBoxItem Content="800 px" Tag="800" />
                        <ComboBoxItem Content="Full size" Tag="0" />
                    </ComboBox>
                    <ComboBox x:Name="GifFpsBox" Width="92" Margin="0,0,12,0" ToolTip="Frames per second of the GIF - fewer means a smaller file">
                        <ComboBoxItem Content="10 fps" Tag="10" />
                        <ComboBoxItem Content="15 fps" Tag="15" IsSelected="True" />
                        <ComboBoxItem Content="20 fps" Tag="20" />
                        <ComboBoxItem Content="25 fps" Tag="25" />
                        <ComboBoxItem Content="33 fps" Tag="33" />
                    </ComboBox>
                    <CheckBox x:Name="GifDitherBox" Content="Smooth colours" Margin="0,0,12,0" VerticalAlignment="Center" Focusable="False" ToolTip="Dither gradients such as skies so they don't band - the file gets around a third bigger" />
                    <Button x:Name="GifButton" Style="{StaticResource ToolButton}" Margin="0" Click="ExportGif_Click" ToolTip="Save the selection as an animated GIF next to the clip (keeps the trim, crop and speed) and copy it, ready to paste into a chat">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="Gif24" Margin="0,0,6,0" /><TextBlock Text="Make GIF" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="4" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" FontSize="11.5" FontFamily="{DynamicResource PhasmaMono}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ExportProgress" Margin="0,8,0,0" Height="4" Minimum="0" Maximum="1" Visibility="Collapsed" Style="{DynamicResource PhasmaMiniBar}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelSaveButton" Margin="0,0,8,0" Focusable="False" Style="{DynamicResource PhasmaSoftButton}" Content="Cancel saving" Visibility="Collapsed" ToolTip="Stop saving and keep the clip as it was" Click="CancelSave_Click" />
                    <StackPanel x:Name="FooterButtons" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Focusable="False" Style="{DynamicResource PhasmaSoftButton}" ToolTip="Save the frame on screen as a screenshot - it shows up in the gallery above, where you can edit it" Click="SaveFrame_Click">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="Camera24" Margin="0,0,6,0" /><TextBlock Text="Save frame" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Focusable="False" Style="{DynamicResource PhasmaSoftButton}" ToolTip="Copy the clip to the clipboard so you can paste it into a chat (saves your edits as a copy first)" Click="CopyClip_Click">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="Copy24" Margin="0,0,6,0" /><TextBlock Text="Copy" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Focusable="False" Style="{DynamicResource PhasmaSoftButton}" ToolTip="Keep the original and write the edited clip next to it (Ctrl+S)" Click="SaveCopy_Click">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="DocumentCopy24" Margin="0,0,6,0" /><TextBlock Text="Save as copy" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Focusable="False" Style="{DynamicResource PhasmaAccentButton}" ToolTip="Replace the original clip with the edited one" Click="Save_Click">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Style="{StaticResource ToolIcon}" Symbol="Save24" Margin="0,0,6,0" Foreground="White" /><TextBlock Text="Save clip" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Focusable="False" Style="{DynamicResource PhasmaSoftButton}" Content="Close" Click="Close_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" Padding="20,6" Background="{DynamicResource PhasmaChromeBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Style="{StaticResource Key}"><TextBlock Style="{StaticResource KeyText}" Text="Space" /></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="PLAY" />
                    <Border Style="{StaticResource Key}"><TextBlock Style="{StaticResource KeyText}" Text="Left Right" /></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="FRAME" />
                    <Border Style="{StaticResource Key}"><TextBlock Style="{StaticResource KeyText}" Text="Home End" /></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="JUMP" />
                    <Border Style="{StaticResource Key}"><TextBlock Style="{StaticResource KeyText}" Text="I [" /></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="START" />
                    <Border Style="{StaticResource Key}"><TextBlock Style="{StaticResource KeyText}" Text="O ]" /></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="END" />
                    <Border Style="{StaticResource Key}"><TextBlock Style="{StaticResource KeyText}" Text="C" /></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="CROP" />
                    <Border Style="{StaticResource Key}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl S" /></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="SAVE AS COPY" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Drag the accent edges to trim" />
            </DockPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
