<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.RenderingFrameRatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      Title="RenderingFrameRatePage"
      Scrollable="True"
      Loaded="Page_Loaded">

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Eyebrow="Performance · Rendering" Title="Frame rate" Subtitle="Smoothing and limits that sit on top of the game." />

        <StackPanel Margin="0,0,0,8" Orientation="Horizontal" Visibility="{Binding SessionTilesVisibility}">
            <Border Margin="3,0,0,0" RenderTransformOrigin="0.5,0.5" Width="4" Height="20" VerticalAlignment="Center" Background="{DynamicResource PhasmaAccentBrush}">
                <Border.RenderTransform>
                    <SkewTransform AngleX="-14" />
                </Border.RenderTransform>
            </Border>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="17" FontWeight="Bold" Foreground="White" Text="LAST SESSION" />
        </StackPanel>

        <ItemsControl Margin="0,6,0,20" ItemsSource="{Binding SessionTiles}" Visibility="{Binding SessionTilesVisibility}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:CardColumns Columns="4" MinColumnWidth="150" Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource PhasmaCard}" Padding="15,14,15,12" ToolTip="{Binding Caption}">
                        <StackPanel>
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Label, Converter={StaticResource PhasmaUpper}}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                <Run FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="26" FontWeight="Bold" Foreground="White" Text="{Binding Value, Mode=OneWay}" />
                                <Run FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Unit, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Caption}" />
                            <ItemsControl Height="22" Margin="0,10,0,0" ItemsSource="{Binding Bars}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="1,0" VerticalAlignment="Bottom" Height="{Binding}" CornerRadius="1" Background="{DynamicResource PhasmaAccentBrush}" Opacity="0.75" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:CardColumns Spacing="16">
            <controls:SettingsCard VerticalAlignment="Top" Header="{x:Static resources:Strings.Menu_Rendering_AntiAliasing}"
                                   Description="A GPU shader over the Roblox window that smooths jagged edges. Costs extra GPU time.">
                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Rendering_EnableAntiAliasingOverlay}" Description="{x:Static resources:Strings.Menu_Rendering_OffByDefaultSinceExtraRendering}">
                    <ui:ToggleSwitch IsChecked="{Binding AntiAliasingEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Rendering_AntiAliasingMethod}" Description="{x:Static resources:Strings.Menu_Rendering_WhichShaderTechniqueApplyOnceOverlay}">
                    <ComboBox Padding="10,5,10,5" Width="170" IsEnabled="{Binding AntiAliasingEnabled}" ItemsSource="{Binding AntiAliasingMethodNames, Mode=OneTime}" SelectedIndex="{Binding AntiAliasingMethodIndex, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard VerticalAlignment="Top" Header="{x:Static resources:Strings.Menu_Rendering_FrameGeneration}"
                                   Description="Makes motion look smoother. It does not raise real FPS or cut input lag.">
                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Rendering_EnableFrameGeneration}" Description="{x:Static resources:Strings.Menu_Rendering_InterpolatesExtraFrameBetweenRealCaptured}">
                    <ui:ToggleSwitch IsChecked="{Binding FrameGenEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Header="{x:Static resources:Strings.Menu_Rendering_FrameGenerationQuality}" Description="{x:Static resources:Strings.Menu_Rendering_HigherQualityCostsMoreGPUTime}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="128" VerticalAlignment="Center" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding FrameGenEnabled}" Value="{Binding FrameGenQuality, Mode=TwoWay}" />
                        <TextBlock MinWidth="60" VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding FrameGenQualityDisplay, Mode=OneWay}" />
                    </StackPanel>
                </controls:OptionControl>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
