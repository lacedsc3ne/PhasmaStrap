<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.IntegrationsPage"
      x:Name="IntegrationsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:converters="clr-namespace:PhasmaStrap.UI.Converters"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      xmlns:app="clr-namespace:PhasmaStrap"
      mc:Ignorable="d"
      d:DesignHeight="1080" d:DesignWidth="800"
      Title="IntegrationsPage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CustomIntegrationSummaryConverter x:Key="CustomIntegrationSummary" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="ProgramListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Fill" Padding="16,12,16,12" Background="Transparent" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="{DynamicResource PhasmaAccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Title="{x:Static resources:Strings.Menu_Integrations_Title}"
                             Subtitle="Discord Rich Presence, what PhasmaStrap can see about your session, and other programs that start with Roblox." />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <controls:SettingsCard Grid.Column="0" VerticalAlignment="Top" Header="{x:Static resources:Strings.Common_DiscordRichPresence}" Description="What your Discord profile shows while you play">
                <Border Margin="0,0,0,16" Padding="16,12" phui:CutCorners.Size="6" BorderThickness="1"
                        BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" Background="{DynamicResource PhasmaS3Brush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top" Foreground="{DynamicResource PhasmaInfoBrush}" />
                        <controls:MarkdownTextBlock Grid.Column="1" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                    MarkdownText="{Binding Source={x:Static resources:Strings.Menu_Integrations_RequiresActivityTracking}, Converter={StaticResource StringFormatConverter}, ConverterParameter={x:Static app:App.ProjectHelpLink}}" />
                    </Grid>
                </Border>

                <controls:OptionControl Flat="True"
                    x:Name="DiscordActivityOption"
                    Header="{x:Static resources:Strings.Menu_Integrations_ShowGameActivity_Title}"
                    Description="{Binding Source={x:Static resources:Strings.Menu_Integrations_ShowGameActivity_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://bloxstraplabs.com/wiki/help/discord-rich-presence-not-working/'}"
                    IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding DiscordActivityEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0"
                    Header="{x:Static resources:Strings.Menu_Integrations_ShowAccountOnProfile_Title}"
                    Description="{x:Static resources:Strings.Menu_Integrations_ShowAccountOnProfile_Description}"
                    IsEnabled="{Binding InnerContent.IsChecked, ElementName=DiscordActivityOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding DiscordAccountOnProfile, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0"
                    Header="{x:Static resources:Strings.Menu_Integrations_AllowActivityJoining_Title}"
                    Description="{x:Static resources:Strings.Menu_Integrations_AllowActivityJoining_Description}"
                    IsEnabled="{Binding InnerContent.IsChecked, ElementName=DiscordActivityOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding DiscordActivityJoinEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="72,0,0,0"
                    Header="{x:Static resources:Strings.Menu_Integrations_UseDiscordSOwnJoinButton}"
                    Description="{x:Static resources:Strings.Menu_Integrations_FriendsGetDiscordSJoinButton}"
                    IsEnabled="{Binding DiscordActivityJoinEnabled, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding DiscordNativeJoin, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0"
                    Header="{x:Static resources:Strings.Menu_Integrations_ShowAsPlayingPhasmaStrap}"
                    Description="{x:Static resources:Strings.Menu_Integrations_NamesActivityPhasmaStrapShowsFromMoment}"
                    IsEnabled="{Binding InnerContent.IsChecked, ElementName=DiscordActivityOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding DiscordShowAsPhasmaStrap, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True" Padding="36,0,0,0"
                    Header="{x:Static resources:Strings.Menu_Integrations_TranslateGameSStatusText}"
                    Description="{x:Static resources:Strings.Menu_Integrations_GameNamesStatusLinesOtherLanguages}"
                    IsEnabled="{Binding InnerContent.IsChecked, ElementName=DiscordActivityOption, Mode=OneWay}">
                    <ui:ToggleSwitch IsChecked="{Binding RpcAutoTranslate, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True"
                    Header="{x:Static resources:Strings.Menu_Integrations_RPCTemplates_Title}"
                    Description="{x:Static resources:Strings.Menu_Integrations_RPCTemplates_Description}">
                    <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Content="{x:Static resources:Strings.Menu_Integrations_View}" Command="{Binding OpenCustomRPCCommand, Mode=OneTime}" />
                </controls:OptionControl>

                <controls:OptionControl Flat="True"
                    Header="{x:Static resources:Strings.Menu_Integrations_ShowRobloxStudioProfile}"
                    Description="{x:Static resources:Strings.Menu_Integrations_WhileYouBuildRobloxStudioDiscord}">
                    <ui:ToggleSwitch IsChecked="{Binding StudioRichPresenceEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Grid.Column="2" VerticalAlignment="Top" Header="Live preview" Description="A sample of what friends see">
                <controls:SettingsCard.HeaderContent>
                    <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding CyclePreviewCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Eye24" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_Preview}" />
                        </StackPanel>
                    </Button>
                </controls:SettingsCard.HeaderContent>

                <StackPanel Margin="20,4,20,18">
                    <Border Padding="14" phui:CutCorners.Size="6" BorderThickness="1" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" Background="{DynamicResource PhasmaChromeBrush}">
                        <StackPanel>
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{x:Static resources:Strings.Menu_Integrations_PlayingRoblox}" />

                            <Grid Margin="0,10,0,0" Visibility="{Binding HasPreviewData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="64" Height="64" Style="{DynamicResource PhasmaThumb}">
                                    <Image Source="{Binding PreviewIconUrl, IsAsync=True}" Width="64" Height="64" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding PreviewGame, Mode=OneWay}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PreviewStateText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Integrations_NoGamesPlayedYetPlaySomething}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPreviewData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Margin="0,14,0,0" Padding="10,7" phui:CutCorners.Size="4"
                                    BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="1" Cursor="Help"
                                    ToolTip="{Binding JoinPreviewTooltip, Mode=OneWay}" ToolTipService.ShowDuration="60000"
                                    AutomationProperties.Name="{Binding JoinPreviewTooltip, Mode=OneWay}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PhasmaS3Brush}" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding JoinPreviewActive, Mode=OneWay}" Value="False">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeStrongBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" Text="{Binding JoinPreviewText, Mode=OneWay}" />
                                    <TextBlock Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="off">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding JoinPreviewActive, Mode=OneWay}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Integrations_CardAboveAlwaysShowsSampleSettings}" />
                </StackPanel>
            </controls:SettingsCard>
        </Grid>

        <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Integrations_ActivityTracking}" Description="What PhasmaStrap can detect about your session">
            <controls:OptionControl Flat="True"
                x:Name="ActivityTrackingOption"
                Header="{x:Static resources:Strings.Menu_Integrations_EnableActivityTracking_Title}"
                Description="{x:Static resources:Strings.Menu_Integrations_EnableActivityTracking_Description}"
                HelpLink="https://bloxstraplabs.com/wiki/features/activity-tracking/">
                <ui:ToggleSwitch IsChecked="{Binding ActivityTrackingEnabled, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Flat="True" Padding="36,0,0,0"
                Header="{x:Static resources:Strings.Menu_Integrations_WatchExternalLaunches_Title}"
                Description="{x:Static resources:Strings.Menu_Integrations_WatchExternalLaunches_Description}"
                IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}">
                <ui:ToggleSwitch IsChecked="{Binding WatchExternalLaunchesEnabled, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Flat="True" Padding="36,0,0,0"
                Header="{x:Static resources:Strings.Menu_Integrations_QueryServerLocation_Title}"
                Description="{Binding Source={x:Static resources:Strings.Menu_Integrations_QueryServerLocation_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://ipinfo.io'}"
                HelpLink="https://bloxstraplabs.com/wiki/features/server-location-hints/"
                IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}">
                <ui:ToggleSwitch IsChecked="{Binding ShowServerDetailsEnabled, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Flat="True" Padding="36,0,0,0"
                Header="{x:Static resources:Strings.Menu_Integrations_DesktopApp_Title}"
                Description="{Binding Source={x:Static resources:Strings.Menu_Integrations_DesktopApp_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://bloxstraplabs.com/wiki/features/dont-exit-to-desktop-app/'}"
                HelpLink="https://bloxstraplabs.com/wiki/features/dont-exit-to-desktop-app/"
                IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}">
                <ui:ToggleSwitch IsChecked="{Binding DisableAppPatchEnabled, Mode=TwoWay}" />
            </controls:OptionControl>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Custom programs" Description="Other programs that launch with Roblox">
            <controls:SettingsCard.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding AddIntegrationCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static resources:Strings.Common_New}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="10,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Foreground="{DynamicResource PhasmaRedTextBrush}" FontWeight="SemiBold"
                            IsEnabled="{Binding IsCustomIntegrationSelected, Mode=OneWay}" Command="{Binding DeleteIntegrationCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static resources:Strings.Common_Delete}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard.HeaderContent>

            <Grid Margin="18,0,18,0">
                <Border Margin="-18,0,-18,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,1,0" MinHeight="120">
                            <ListBox x:Name="CustomIntegrationsListBox" MaxHeight="420" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Top"
                                     ItemContainerStyle="{StaticResource ProgramListItem}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemsSource="{Binding CustomIntegrations, Mode=OneWay}"
                                     SelectionChanged="CustomIntegrationSelection"
                                     SelectedIndex="{Binding SelectedCustomIntegrationIndex, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding Location}">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                <TextBlock Margin="0,2,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource CustomIntegrationSummary}" Mode="OneWay">
                                                            <Binding Path="AutoClose" />
                                                            <Binding Path="AutoCloseOnGame" />
                                                            <Binding Path="SpecifyGame" />
                                                            <Binding Path="GameID" />
                                                            <Binding Path="RunMinimized" />
                                                            <Binding Path="RunAsAdmin" />
                                                            <Binding Path="Delay" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource PhasmaSoftButton}" Padding="10,4" FontSize="12" FontWeight="SemiBold" Content="{x:Static resources:Strings.Common_Edit}" Click="EditIntegration_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Grid Grid.Column="1" Margin="20,6,20,20">
                            <TextBlock Margin="0,14,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Integrations_Custom_NoneSelected}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomIntegrationSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomIntegrationSelected}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="340" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Common_Name}" />
                                        <ui:TextBox Text="{Binding SelectedCustomIntegration.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Menu_Integrations_LaunchDelayMs}" />
                                        <ui:NumberBox ClearButtonEnabled="False" IntegersOnly="True" HorizontalAlignment="Left" Width="140" Min="0" Max="30000" Value="{Binding SelectedCustomIntegration.Delay}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Menu_Integrations_Custom_AppLocation}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static resources:Strings.Menu_Integrations_CWindowsSystem32CmdExe}" Text="{Binding SelectedCustomIntegration.Location}" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Style="{DynamicResource PhasmaGhostButton}" Command="{Binding BrowseIntegrationLocationCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{x:Static resources:Strings.Common_Browse}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static resources:Strings.Menu_Integrations_Custom_LaunchArgs}" />
                                <ui:TextBox FontFamily="{DynamicResource PhasmaMono}" MinHeight="64" PlaceholderText="{Binding Source='/k echo {0}', Converter={StaticResource StringFormatConverter}, ConverterParameter={x:Static resources:Strings.Menu_Integrations_Custom_LaunchArgs_Placeholder}}" Text="{Binding SelectedCustomIntegration.LaunchArgs}" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox Content="{x:Static resources:Strings.Menu_Integrations_Custom_AutoClose}" IsChecked="{Binding SelectedCustomIntegration.AutoClose}" />
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <CheckBox VerticalAlignment="Center" Content="{x:Static resources:Strings.Menu_Integrations_OnlySpecificGame}" IsChecked="{Binding SelectedCustomIntegration.SpecifyGame}" />
                                            <ui:TextBox Margin="10,0,0,0" Width="130" VerticalAlignment="Center" PlaceholderText="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_Title}" Text="{Binding SelectedCustomIntegration.GameID}" IsEnabled="{Binding SelectedCustomIntegration.SpecifyGame}" />
                                        </StackPanel>
                                        <CheckBox Margin="0,8,0,0" Content="{x:Static resources:Strings.Menu_Integrations_CloseWhenLeavingGame}" IsChecked="{Binding SelectedCustomIntegration.AutoCloseOnGame}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <CheckBox Content="{x:Static resources:Strings.Menu_Integrations_RunAsAdministrator}" IsChecked="{Binding SelectedCustomIntegration.RunAsAdmin}" />
                                        <CheckBox Margin="0,8,0,0" Content="{x:Static resources:Strings.Menu_Integrations_RunMinimized}" IsChecked="{Binding SelectedCustomIntegration.RunMinimized}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </controls:SettingsCard>
    </StackPanel>
</ui:UiPage>
