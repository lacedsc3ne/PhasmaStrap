<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.ContextMenu.RPCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.ContextMenu"
        xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels.ContextMenu"
        xmlns:resources="clr-namespace:PhasmaStrap.Resources"
        d:DataContext="{d:DesignInstance Type=models:RPCWindowViewModel}"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.ContextMenu_RPCWindow_Title}"
        MinWidth="480"
        MinHeight="420"
        Width="560"
        Height="600"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="RootTitleBar" Title="{Binding Source={x:Static resources:Strings.ContextMenu_RPCWindow_Title}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" ShowMinimize="True" ShowMaximize="True" CanMaximize="True" KeyboardNavigation.TabNavigation="None" Icon="pack://application:,,,/PhasmaStrap.ico" Height="32" Padding="12,0,0,0" Background="{DynamicResource PhasmaChromeBrush}" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" IsHitTestVisible="False" />

        <TextBlock Grid.Row="1" Margin="22,16,22,4" FontSize="13" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="2">
            <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_Placeholder}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Visible" />
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="22,8,22,8">
                    <Border Margin="0,0,0,10" Style="{StaticResource PhasmaCard}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,2" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source={x:Static resources:Strings.ContextMenu_RPCWindow_Details}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" />
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,2,0,10" />
                            <TextBlock Margin="0,0,0,2" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source={x:Static resources:Strings.ContextMenu_RPCWindow_State}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" />
                            <TextBlock Text="{Binding State}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10" Style="{StaticResource PhasmaCard}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source={x:Static resources:Strings.ContextMenu_RPCWindow_Images}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" />
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_LargeImageKey}" />
                            <TextBlock Text="{Binding LargeImageKey}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_LargeImageText}" />
                            <TextBlock Text="{Binding LargeImageText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_SmallImageKey}" />
                            <TextBlock Text="{Binding SmallImageKey}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_SmallImageText}" />
                            <TextBlock Text="{Binding SmallImageText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10" Style="{StaticResource PhasmaCard}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source={x:Static resources:Strings.ContextMenu_RPCWindow_Timestamps}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" />
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_TimestampStart}" />
                            <TextBlock Text="{Binding TimestampStart}" Margin="0,0,0,6" />
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.ContextMenu_RPCWindow_TimestampEnd}" />
                            <TextBlock Text="{Binding TimestampEnd}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10" Style="{StaticResource PhasmaCard}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source={x:Static resources:Strings.ContextMenu_RPCWindow_Buttons}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}" />
                            <ItemsControl ItemsSource="{Binding Buttons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding Url, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Static resources:Strings.ContextMenu_RPCWindow_NoButtons}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasButtons, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Padding="18,12" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="{x:Static resources:Strings.ContextMenu_RPCWindow_LastUpdated}" />
                    <Run Text=" " />
                    <Run Text="{Binding LastUpdated, Mode=OneWay}" />
                </TextBlock>
                <Button Grid.Column="1" MinWidth="100" Style="{StaticResource PhasmaAccentButton}" Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneTime}" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>
