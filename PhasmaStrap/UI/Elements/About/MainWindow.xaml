<base:WpfUiWindow x:Class="PhasmaStrap.UI.Elements.About.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.About.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:PhasmaStrap.Resources"
             mc:Ignorable="d"
             Title="{x:Static resources:Strings.About_Title}"
             MinWidth="800"
             Width="800"
             Height="440"
             ExtendsContentIntoTitleBar="True"
             WindowStartupLocation="CenterScreen"
             Loaded="MainWindow_MistLoaded">

    <Window.Resources>

        <Storyboard x:Key="MistDrift" />
        <Style x:Key="AboutTab" TargetType="{x:Type ui:NavigationItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Width" Value="158" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource PhasmaFocusVisual}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:NavigationItem}">
                        <Grid Background="Transparent">
                            <Border x:Name="Fill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" />
                            <StackPanel Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="Glyph" FontSize="15" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="{TemplateBinding Icon}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#0AFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                <Setter TargetName="Fill" Property="BorderBrush" Value="#8CE0202F" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource PhasmaRedTextBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.08,0.05" GradientOrigin="0.08,0.05" RadiusX="0.75" RadiusY="0.9">
                    <GradientStop Offset="0" Color="#2EE0202F" />
                    <GradientStop Offset="0.6" Color="#0DE0202F" />
                    <GradientStop Offset="1" Color="#00E0202F" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <ui:TitleBar
            x:Name="RootTitleBar"
            Grid.Row="0"
            Height="32"
            Padding="12,0,0,0"
            Background="{DynamicResource PhasmaChromeBrush}"
            FontFamily="{DynamicResource PhasmaMono}"
            FontSize="11"
            FontWeight="Medium"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Title="{Binding Source={x:Static resources:Strings.About_Title}, Converter={StaticResource PhasmaUpper}, Mode=OneTime}"
            ForceShutdown="False"
            Icon="pack://application:,,,/PhasmaStrap.ico"
            MinimizeToTray="False"
            UseSnapLayout="True" />
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" IsHitTestVisible="False" />

        <Grid x:Name="RootGrid" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource PhasmaSubnavBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,1,0" />

            <ui:NavigationStore x:Name="RootNavigation" Grid.Row="1" Grid.Column="0" Width="160" Margin="10,16,10,0" HorizontalAlignment="Left" Frame="{Binding ElementName=RootFrame}" SelectedPageIndex="0">
                <ui:NavigationStore.Items>
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_About_Title}" PageType="{x:Type pages:AboutPage}" Icon="QuestionCircle24" Tag="about" Style="{StaticResource AboutTab}" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.About_Licenses_Title}" PageType="{x:Type pages:LicensesPage}" Icon="Code24" Tag="licenses" Style="{StaticResource AboutTab}" />
                </ui:NavigationStore.Items>
            </ui:NavigationStore>

            <Frame x:Name="RootFrame" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="28,22,6,0" />
        </Grid>
    </Grid>
</base:WpfUiWindow>
