<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.Editor.BootstrapperEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Editor"
    xmlns:local="clr-namespace:PhasmaStrap.UI.Elements.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Path=Title, Mode=OneTime}"
    Width="1000"
    Height="500"
    d:DataContext="{d:DesignInstance dmodels:BootstrapperEditorWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    Closed="OnClosed"
    Closing="OnClosing"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="RootTitleBar"
            Title="{Binding Path=Title, Mode=OneTime, Converter={StaticResource PhasmaUpper}}"
            Grid.Row="0"
            Height="32"
            Padding="12,0,0,0"
            Background="{DynamicResource PhasmaChromeBrush}"
            FontFamily="{DynamicResource PhasmaMono}"
            FontSize="11"
            FontWeight="Medium"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            ForceShutdown="False"
            Icon="pack://application:,,,/PhasmaStrap.ico"
            MinimizeToTray="False"
            UseSnapLayout="True" />
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaStrokeBrush}" IsHitTestVisible="False" />

        <Border Grid.Row="2" Background="{DynamicResource PhasmaPanelBrush}" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" />

        <avalonedit:TextEditor
            x:Name="UIXML"
            Grid.Row="1"
            Margin="0"
            Padding="8,8,0,0"
            ShowLineNumbers="True"
            Style="{StaticResource NewTextEditor}"
            SyntaxHighlighting="XML" />

        <StackPanel
            Grid.Row="2"
            Margin="18,12"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,5,0"
                Command="{Binding Path=OpenThemeFolderCommand, Mode=OneTime}"
                Style="{StaticResource PhasmaSoftButton}"
                Content="{x:Static resources:Strings.CustomTheme_Editor_OpenThemeDirectory}" />

            <ui:Button
                Margin="5,0,0,0"
                Click="OpenExternal_Click"
                Style="{StaticResource PhasmaSoftButton}"
                Content="{x:Static resources:Strings.CustomTheme_Editor_OpenExternal_Button}" />
        </StackPanel>

        <Grid
            Grid.Row="2"
            Margin="18,12"
            HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
                Grid.Column="0"
                Margin="0,0,5,0"
                Command="{Binding Path=PreviewCommand, Mode=OneTime}"
                Style="{StaticResource PhasmaSoftButton}"
                Content="{x:Static resources:Strings.CustomTheme_Editor_Preview}" />

            <ui:Button
                Grid.Column="1"
                Margin="5,0,0,0"
                Appearance="Primary"
                Command="{Binding Path=SaveCommand, Mode=OneTime}"
                Style="{StaticResource PhasmaAccentButton}"
                Content="{x:Static resources:Strings.CustomTheme_Editor_Save}" />
        </Grid>

        <ui:Snackbar
            x:Name="Snackbar"
            Grid.RowSpan="3"
            Margin="200,0,200,20"
            Panel.ZIndex="9"
            Timeout="3000" />
    </Grid>
</base:WpfUiWindow>
