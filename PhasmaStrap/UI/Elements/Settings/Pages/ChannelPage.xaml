<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ChannelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      Title="ChannelPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <controls:PageHeader Eyebrow="Settings · Launching" Title="Channel and downloads" Subtitle="Which Roblox channel you get, how it downloads, and when games tend to update." />

        <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
            <RadioButton x:Name="RobloxTab" GroupName="ChannelTabs" Style="{DynamicResource PhasmaTab}" Content="{x:Static resources:Strings.Menu_Integrations_Tabs_Roblox}" IsChecked="True" Click="Tab_Click" Tag="{Binding ElementName=ChannelCard}" />
            <RadioButton GroupName="ChannelTabs" Style="{DynamicResource PhasmaTab}" Content="{x:Static resources:Strings.Menu_Channel_Installer}" Click="Tab_Click" Tag="{Binding ElementName=InstallerCard}" />
            <RadioButton GroupName="ChannelTabs" Style="{DynamicResource PhasmaTab}" Content="{x:Static resources:Strings.Menu_Channel_UpdateHeatmap}" Click="Tab_Click" Tag="{Binding ElementName=HeatmapCard}" />
        </StackPanel>

        <controls:CardColumns>
            <controls:SettingsCard x:Name="ChannelCard" Header="{x:Static resources:Strings.ContextMenu_ChatLogs_ColumnChannel}"
                                   Description="Which deployment channel PhasmaStrap installs and launches">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Channel_CurrentlyActiveChannel}"
                                        Description="{Binding CurrentActiveChannel, Mode=OneWay, StringFormat='Roblox is currently running on the {0} channel.'}">
                    <Border Height="28" Padding="10,0,12,0" phui:CutCorners.Size="6" Background="{DynamicResource PhasmaS3Brush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="{DynamicResource PhasmaGoodBrush}" />
                            <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Text="{Binding CurrentActiveChannel, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Channel_RobloxChannel}"
                    Description="Blank uses the default channel">
                    <StackPanel Orientation="Horizontal">
                        <ui:AutoSuggestBox
                            Width="150"
                            PlaceholderText="{x:Static resources:Strings.Menu_Channel_Production}"
                            Text="{Binding RobloxChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding KnownChannels, Mode=OneTime}" />
                        <Button
                            Margin="8,0,0,0"
                            Style="{DynamicResource PhasmaSoftButton}"
                            Content="{x:Static resources:Strings.Dialog_ChannelLists_BrowseButton}"
                            Click="BrowseChannelsButton_Click" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Channel_IfRobloxSChannelChanges}"
                    Description="Automatic keeps yours. Prompt asks first. Ignore follows Roblox.">
                    <ComboBox Padding="10,5,10,5" MinWidth="130" ItemsSource="{Binding ChannelChangeModes, Mode=OneTime}" SelectedItem="{Binding SelectedChannelChangeMode, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Channel_ChannelBuildInfo}"
                                   Description="Which build is live on the channel above, without switching to it">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Channel_LookUpBuild}">
                    <Button Style="{DynamicResource PhasmaGhostButton}" Command="{Binding LookupChannelInfoCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Channel_LookUp}" />
                        </StackPanel>
                    </Button>
                </controls:OptionControl>

                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChannelInfoStatusText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChannelInfoStatusText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Opacity="0.08" phui:CutCorners.Size="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PhasmaGoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowChannelInfoError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PhasmaBadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border BorderThickness="1" Opacity="0.35" phui:CutCorners.Size="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource PhasmaGoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowChannelInfoError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PhasmaBadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Margin="14,11,14,11" TextWrapping="Wrap" FontSize="12.5" Text="{Binding ChannelInfoStatusText, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowChannelInfoError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PhasmaRedTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChannelDeployInfo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Margin="-20,0,-20,0" Padding="20,12,20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Dialog_ChannelLists_ColumnVersion}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ChannelDeployInfo.Version, Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <Border Margin="-20,0,-20,0" Padding="20,12,20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Dialog_ChannelLists_ColumnVersionGuid}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ChannelDeployInfo.VersionGuid, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="InstallerCard" Header="{x:Static resources:Strings.Menu_Channel_Installer}"
                                   Description="How PhasmaStrap downloads Roblox's packages">
                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Channel_PreferredMirror}" Description="Auto picks whichever answers fastest">
                    <ComboBox Padding="10,5,10,5" MinWidth="130" MaxWidth="300" ItemsSource="{Binding MirrorChoices, Mode=OneTime}" DisplayMemberPath="Display" SelectedValuePath="Url" SelectedValue="{Binding PreferredMirror, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Channel_DownloadBufferSizeKB}" Description="{x:Static resources:Strings.Menu_Channel_LargerBuffersCanSpeedUpDownloads}">
                    <ComboBox Padding="10,5,10,5" MinWidth="100" ItemsSource="{Binding DownloadBufferOptions, Mode=OneTime}" SelectedItem="{Binding DownloadBufferKb, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Channel_ConcurrentDownloads}" Description="Higher is faster but uses more bandwidth">
                    <ComboBox Padding="10,5,10,5" MinWidth="80" ItemsSource="{Binding ConcurrentDownloadOptions, Mode=OneTime}" SelectedItem="{Binding MaxConcurrentDownloads, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{x:Static resources:Strings.Menu_Channel_SegmentsPerFile}" Description="Splits big packages into parallel downloads">
                    <ComboBox Padding="10,5,10,5" MinWidth="80" ItemsSource="{Binding DownloadSegmentOptions, Mode=OneTime}" SelectedItem="{Binding MaxDownloadSegments, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="HeatmapCard" Header="{x:Static resources:Strings.Menu_Channel_UpdateHeatmap}"
                                   Description="Which days of the week a game usually ships updates">
                <StackPanel>
                    <Border Margin="-20,0,-20,0" Padding="20,14,20,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="200" PlaceholderText="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_Title}" ToolTip="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_Title}"
                                        Text="{Binding HeatmapPlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaGhostButton}" Content="{x:Static resources:Strings.Menu_Channel_Load}" Command="{Binding LoadHeatmapCommand, Mode=OneTime}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,0,0,6" FontSize="13" TextWrapping="Wrap" Text="{Binding HeatmapStatusText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ItemsControl Margin="-3,10,-3,18" ItemsSource="{Binding HeatmapDays, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,0,3,0" ToolTip="{Binding Tip}">
                                    <Border phui:CutCorners.Size="6" Background="{DynamicResource PhasmaS3Brush}" />
                                    <Border phui:CutCorners.Size="6" Background="{DynamicResource PhasmaAccentBrush}" Opacity="{Binding TileOpacity}" />
                                    <StackPanel Margin="4,12,4,12">
                                        <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Label, Converter={StaticResource PhasmaUpper}}" />
                                        <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Count}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>