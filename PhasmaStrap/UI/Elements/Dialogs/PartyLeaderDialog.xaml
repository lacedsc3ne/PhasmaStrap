<Window x:Class="PhasmaStrap.UI.Elements.Dialogs.PartyLeaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Make party leader"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource PhasmaBody}"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="Scrim" Background="#8C000000" MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
        <Border x:Name="Card" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0"
                Style="{DynamicResource PhasmaPopupSurface}" Background="{DynamicResource PhasmaPanelBrush}" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <StackPanel>
                <StackPanel Margin="22,22,22,6" HorizontalAlignment="Center">
                    <Grid Width="52" Height="52" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource PhasmaSelectedBrush}" />
                        <TextBlock x:Name="InitialText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Text="?" />
                        <Ellipse x:Name="AvatarEllipse" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="TitleText" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtitleText" Margin="0,6,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Margin="22,10,22,0">
                    <Border Padding="0,11" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Play24" FontSize="14" Margin="0,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="LinePicks" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <Border Padding="0,11" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Person24" FontSize="14" Margin="0,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="LineStay" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <Border Padding="0,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSwap24" FontSize="14" Margin="0,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="LineBack" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,4,0,18">
                        <Border Background="{DynamicResource PhasmaInfoBrush}" Opacity="0.08" />
                        <Border BorderBrush="{DynamicResource PhasmaInfoBrush}" BorderThickness="1" Opacity="0.35" />
                        <Grid Margin="14,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="15" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource PhasmaInfoBrush}" />
                            <TextBlock x:Name="NoteText" Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <Border Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PhasmaSoftButton}" MinWidth="90" Content="Cancel" Click="Cancel_Click" />
                        <Button x:Name="ConfirmButton" Margin="10,0,0,0" Style="{StaticResource PhasmaAccentButton}" Click="Confirm_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentTextBrush}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Make leader" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
