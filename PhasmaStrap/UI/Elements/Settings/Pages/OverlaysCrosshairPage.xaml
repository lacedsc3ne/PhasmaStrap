<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.OverlaysCrosshairPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      mc:Ignorable="d"
      Title="OverlaysCrosshairPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <controls:SettingsCard>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Overlays_CrosshairEnabled_Title}" Description="Centred on the game window while you are in a game">
                <ui:ToggleSwitch IsChecked="{Binding CrosshairEnabled, Mode=TwoWay}" />
            </controls:OptionControl>
        </controls:SettingsCard>

        <!--  Current crosshair and the way into the editor  -->
        <Border Margin="0,0,0,12" Style="{DynamicResource PhasmaCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="140" Height="140" CornerRadius="{DynamicResource PhasmaCornerRadius}" ClipToBounds="True" Background="#FF2A5A8C">
                    <Image Source="{Binding CrosshairPreview}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource PhasmaHeading}" FontSize="16" Text="{Binding CrosshairName}" />
                    <TextBlock Margin="0,6,0,12" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Shown at its real size. Build your own from arms, a centre dot and a ring, with outline, rotation, T shape and opacity. Save designs and share them as a short code." />
                    <Button HorizontalAlignment="Left" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding OpenCrosshairEditorCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Target24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_OpenCrosshairEditor}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <controls:CardColumns>
            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Rendering_FocusMode}">
                <controls:OptionControl Header="Overlay focus mode" Description="Hides the HUD and crosshair without turning them off. Bind it on Hotkeys.">
                    <ui:ToggleSwitch IsChecked="{Binding FocusModeEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Static resources:Strings.Menu_Rendering_GameOverrides}"
                                   Description="A place with its own HUD and crosshair state.">
                <WrapPanel Margin="0,0,0,8">
                    <ui:TextBox Width="160" Margin="0,0,8,4" PlaceholderText="{x:Static resources:Strings.Menu_ServerBrowser_PlaceId_Title}" Text="{Binding AssignPlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Rendering_HUD}" />
                        <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding AssignHudEnabled, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Overlays_Crosshair_Title}" />
                        <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding AssignCrosshairEnabled, Mode=TwoWay}" />
                    </StackPanel>
                    <Button Margin="0,0,0,4" Style="{DynamicResource PhasmaSoftButton}" Command="{Binding AddPlaceProfileCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Rendering_Add}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding PlaceProfiles, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Style="{DynamicResource PhasmaDivider}" />
                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Display}" />
                                    <Button Grid.Column="1" Margin="12,0,0,0" Width="28" Height="28" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Menu_Mods_Remove}"
                                            Command="{Binding DataContext.RemovePlaceProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SettingsCard>
        </controls:CardColumns>
    </StackPanel>
</ui:UiPage>
