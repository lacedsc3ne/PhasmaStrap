<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.ReleasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:models="clr-namespace:PhasmaStrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ReleasesViewModel, IsDesignTimeCreatable=True}"
      Title="ReleasesPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource PhasmaPageTitle}" VerticalAlignment="Center" Text="News" />
            <Border Style="{DynamicResource PhasmaTagNeutral}" Margin="12,0,0,0">
                <TextBlock FontSize="11" Text="PhasmaStrap" />
            </Border>
        </StackPanel>

        <!--  Update status, search and refresh  -->
        <Border Style="{DynamicResource PhasmaCard}" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" CornerRadius="{DynamicResource PhasmaCornerRadiusSmall}" Background="{DynamicResource PhasmaAccentSoftBrush}">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PhasmaAccentBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding UpdateHeadline, Mode=OneWay}" />
                    <TextBlock Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UpdateDetail, Mode=OneWay}" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StatusText, Mode=OneWay}" />
                </StackPanel>

                <Button Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaAccentButton}"
                        Visibility="{Binding UpdateActionVisibility, Mode=OneWay}" Command="{Binding UpdateCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Update" />
                    </StackPanel>
                </Button>

                <ui:TextBox Grid.Column="3" Width="220" VerticalAlignment="Center" Icon="Search24" PlaceholderText="{x:Static resources:Strings.Menu_Releases_SearchPlaceholder}"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaIconButton}"
                        ToolTip="{x:Static resources:Strings.Menu_Releases_Refresh}" Command="{Binding RefreshCommand, Mode=OneTime}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <!--  Notes for the version you have  -->
        <controls:SettingsCard Margin="0,12,0,0" Header="{Binding WhatsNewTitle, Mode=OneTime}" Visibility="{Binding WhatsNewVisibility}">
            <controls:MarkdownTextBlock Margin="0,0,0,10" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MarkdownText="{Binding WhatsNew}" />
        </controls:SettingsCard>

        <!--  Releases list and the selected release  -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource PhasmaCard}" Padding="6" VerticalAlignment="Top">
                <ListBox VerticalAlignment="Top" MaxHeight="620" HorizontalContentAlignment="Stretch"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{DynamicResource PhasmaListItem}"
                         controls:ScrollBubbling.Enabled="True"
                         ItemsSource="{Binding Releases, Mode=OneWay}"
                         SelectedItem="{Binding SelectedRelease, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11" Text="{Binding PublishedText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource PhasmaTag}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Releases_Installed}" FontSize="10" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Border Style="{DynamicResource PhasmaCard}" Padding="18,16" VerticalAlignment="Top" Visibility="{Binding DetailVisibility, Mode=OneWay}">
                    <StackPanel DataContext="{Binding SelectedRelease, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource PhasmaHeading}" VerticalAlignment="Center" Text="{Binding Name}" />
                                <Border Margin="10,0,0,0" Style="{DynamicResource PhasmaTag}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Releases_Installed}" FontSize="11" />
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PublishedText}" />
                            </WrapPanel>

                            <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold"
                                    Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding HtmlUrl}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Releases_ViewOnGitHub}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <controls:MarkdownTextBlock Margin="0,12,0,0" FontSize="12.5" TextWrapping="Wrap" MarkdownText="{Binding Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding AssetsVisibility, Mode=OneWay}">
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding AssetCount, Mode=OneWay}" />
                                <Run Text="{x:Static resources:Strings.Menu_Releases_Assets}" />
                            </TextBlock>

                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Assets, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Style="{DynamicResource PhasmaDivider}" />
                                            <Grid Margin="0,7,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SizeText}" />
                                                <Button Grid.Column="2" Style="{DynamicResource PhasmaSoftButton}"
                                                        Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding DownloadUrl}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="Download" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource PhasmaCard}" Padding="18,30" VerticalAlignment="Top" Visibility="{Binding NoSelectionVisibility, Mode=OneWay}">
                    <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Pick a release on the left to read its notes and downloads." />
                </Border>
            </Grid>
        </Grid>
    </StackPanel>
</ui:UiPage>
