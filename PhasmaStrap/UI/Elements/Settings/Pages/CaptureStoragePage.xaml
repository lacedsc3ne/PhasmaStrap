<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.CaptureStoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:CaptureViewModel, IsDesignTimeCreatable=True}"
      Title="CaptureStoragePage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <SolidColorBrush x:Key="ScreenshotsBrush" Color="#FF7C8CFF" />

        <Style x:Key="LegendDot" TargetType="Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Style="{DynamicResource PhasmaPageTitle}" Text="{x:Static resources:Strings.Menu_Capture_Storage}" />
        <TextBlock Style="{DynamicResource PhasmaPageSubtitle}"
                   Text="Keep the screenshot and clip folders from growing forever. The oldest captures go to the Recycle Bin right after a new one is saved. Never the newest one, and never a file you marked read only." />

        <Border Margin="0,0,0,20" Padding="20,22,20,20" Style="{DynamicResource PhasmaCard}" DataContext="{Binding Storage}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Bottom" FontFamily="{DynamicResource PhasmaHeadingFont}" FontSize="32" FontWeight="Bold" Foreground="White" Text="{Binding UsedText}" />
                    <TextBlock Margin="0,0,0,6" VerticalAlignment="Bottom" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding OfText}" />
                </WrapPanel>

                <Grid Height="10" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ClipsWidth}" />
                        <ColumnDefinition Width="{Binding ScreenshotsWidth}" />
                        <ColumnDefinition Width="{Binding GifsWidth}" />
                        <ColumnDefinition Width="{Binding FreeWidth}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource PhasmaAccentBrush}" />
                    <Border Grid.Column="1" Background="{StaticResource ScreenshotsBrush}" />
                    <Border Grid.Column="2" Background="{DynamicResource PhasmaWarnBrush}" />
                    <Border Grid.Column="3" Background="{DynamicResource PhasmaS4Brush}" />
                </Grid>

                <WrapPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                        <Border Style="{StaticResource LegendDot}" Background="{DynamicResource PhasmaAccentBrush}" />
                        <TextBlock FontSize="13" FontWeight="Medium" Text="Clips" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ClipsText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                        <Border Style="{StaticResource LegendDot}" Background="{StaticResource ScreenshotsBrush}" />
                        <TextBlock FontSize="13" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_Capture_Screenshots}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ScreenshotsText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource LegendDot}" Background="{DynamicResource PhasmaWarnBrush}" />
                        <TextBlock FontSize="13" FontWeight="Medium" Text="GIFs" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding GifsText}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <controls:SettingsCard Header="Clean up" Description="Limits apply right after each new capture is saved">
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_SizeLimit}" Description="{x:Static resources:Strings.Menu_Capture_HowMuchRoomScreenshotsClipsGIFs}">
                <ComboBox Width="130" ItemsSource="{Binding StorageLimitOptions, Mode=OneTime}" SelectedItem="{Binding SelectedStorageLimit, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Capture_RemoveCapturesOlderThan}" Description="{x:Static resources:Strings.Menu_Capture_CapturesPastAgeAreCleanedUp}">
                <ComboBox Width="130" ItemsSource="{Binding MaxAgeOptions, Mode=OneTime}" SelectedItem="{Binding SelectedMaxAge, Mode=TwoWay}" />
            </controls:OptionControl>

            <Border Padding="0,14,0,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PhasmaStrokeBrush}">
                <TextBlock FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StorageUsageText, Mode=OneWay}" />
            </Border>
        </controls:SettingsCard>
    </StackPanel>
</ui:UiPage>
