<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.Dialogs.TextInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TextInputDialog"
    Width="380"
    MinHeight="0"
    Background="{DynamicResource PhasmaPanelBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBarElement"
            Grid.Row="0"
            Padding="12,8"
            Background="{DynamicResource PhasmaChromeBrush}"
            CanMaximize="False"
            FontFamily="{DynamicResource PhasmaMono}"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Icon="pack://application:,,,/PhasmaStrap.ico"
            KeyboardNavigation.TabNavigation="None"
            ShowMaximize="False"
            ShowMinimize="False" />
        <Border Grid.Row="0" VerticalAlignment="Bottom" Style="{DynamicResource PhasmaDivider}" />

        <StackPanel Grid.Row="1" Margin="22,20,22,20">
            <TextBlock x:Name="PromptText" Margin="0,0,0,10" FontSize="13.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ui:TextBox x:Name="ValueBox" KeyDown="ValueBox_KeyDown" />
        </StackPanel>

        <Border Grid.Row="2" Padding="18,12" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">
                <Button
                    MinWidth="100"
                    Click="OnOkButtonClicked"
                    Content="{x:Static resources:Strings.Common_OK}"
                    Style="{StaticResource PhasmaAccentButton}" />
                <Button
                    MinWidth="100"
                    Margin="10,0,0,0"
                    Content="{x:Static resources:Strings.Common_Cancel}"
                    IsCancel="True"
                    Style="{StaticResource PhasmaSoftButton}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
