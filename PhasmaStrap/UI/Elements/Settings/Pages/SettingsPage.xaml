<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:pages="clr-namespace:PhasmaStrap.UI.Elements.Settings.Pages"
      mc:Ignorable="d"
      Title="SettingsPage"
      Scrollable="False">
    <controls:SectionHost x:Name="Host" Header="Settings" Layout="Rail">
        <controls:SectionItem Group="Launching" Label="Deployment" PageType="{x:Type pages:BehaviourPage}" />
        <controls:SectionItem Group="Launching" Label="Roblox version" TabLabel="Version" PageType="{x:Type pages:RobloxVersionsPage}" />
        <controls:SectionItem Group="Launching" Label="Channel and downloads" PageType="{x:Type pages:ChannelPage}" />
        <controls:SectionItem Group="Launching" Label="Classic client" PageType="{x:Type pages:ClassicClientPage}" />
        <controls:SectionItem Group="Launching" Label="Mods" PageType="{x:Type pages:ModsPage}" />
        <controls:SectionItem Group="Launching" Label="Extensions" PageType="{x:Type pages:ExtensionsPage}" />
        <controls:SectionItem Group="Look and feel" Label="Appearance" PageType="{x:Type pages:AppearancePage}" />
        <controls:SectionItem Group="Look and feel" Label="Launcher window" PageType="{x:Type pages:BootstrapperStylePage}" />
        <controls:SectionItem Group="Look and feel" Label="Notifications" PageType="{x:Type pages:NotificationsPage}" />
        <controls:SectionItem Group="Look and feel" Label="Hotkeys" PageType="{x:Type pages:HotkeysPage}" />
        <controls:SectionItem Group="Look and feel" Label="Shortcuts" PageType="{x:Type pages:ShortcutsPage}" />
        <controls:SectionItem Group="PhasmaStrap" Label="Account and backup" PageType="{x:Type pages:PhasmaStrapPage}" />
        <controls:SectionItem Group="PhasmaStrap" Label="Integrations" PageType="{x:Type pages:IntegrationsPage}" />
        <controls:SectionItem Group="PhasmaStrap" Label="Game chat" PageType="{x:Type pages:GameChatPage}" />
        <controls:SectionItem Group="PhasmaStrap" Label="News" PageType="{x:Type pages:ReleasesPage}" />
        <controls:SectionItem Group="Developer" Label="Developer tools" TabLabel="Developer tools" PageType="{x:Type pages:DeveloperToolsPage}" />
        <controls:SectionItem Group="Developer" Label="Diagnostics" PageType="{x:Type pages:DiagnosticsPage}" />
    </controls:SectionHost>
</ui:UiPage>
