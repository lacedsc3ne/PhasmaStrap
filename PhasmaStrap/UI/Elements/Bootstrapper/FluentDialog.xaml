<base:WpfUiWindow
    x:Class="PhasmaStrap.UI.Elements.Bootstrapper.FluentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PhasmaStrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:PhasmaStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:PhasmaStrap.UI.ViewModels.Bootstrapper"
    Width="500"
    Height="280"
    MinHeight="0"
    d:DataContext="{d:DesignInstance vms:FluentDialogViewModel,
                                     IsDesignTimeCreatable=True}"
    Background="Transparent"
    Closing="UiWindow_Closing"
    Loaded="FluentDialog_Loaded"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="{Binding Path=WindowBackdropType, Mode=OneTime}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="WindowEntrance">
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation
                Storyboard.TargetName="RootTranslate"
                Storyboard.TargetProperty="Y"
                From="14" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="LogoEntrance" BeginTime="0:0:0.08">
            <DoubleAnimation
                Storyboard.TargetName="LogoImage"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.3" />
            <DoubleAnimation
                Storyboard.TargetName="LogoScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.8" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="LogoScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.8" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="LogoBreathe" />
        <Storyboard x:Key="LogoGlowPulse" />
        <Storyboard x:Key="MistDrift" />
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>

    <Grid x:Name="RootGrid" Background="{Binding Path=BackgroundColourBrush, Mode=OneTime}" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="14" />
        </Grid.RenderTransform>

        <Border x:Name="RedWash" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0.2" GradientOrigin="0.12,0.2" RadiusX="0.85" RadiusY="1.2">
                    <GradientStop Offset="0" Color="#47E0202F" />
                    <GradientStop Offset="0.55" Color="#1AE0202F" />
                    <GradientStop Offset="1" Color="#00E0202F" />
                </RadialGradientBrush>
            </Border.Background>
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowBackdropType, Mode=OneTime}" Value="Aero">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PhasmaStrokeStrongBrush}" BorderThickness="1" />

        <ui:TitleBar
            VerticalAlignment="Top"
            CanMaximize="False"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Margin="32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="110" Height="110">
                <Ellipse x:Name="LogoGlow" Width="110" Height="110" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#40E0202F" />
                            <GradientStop Offset="0.5" Color="#1AE0202F" />
                            <GradientStop Offset="1" Color="#00E0202F" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Image
                    x:Name="LogoImage"
                    Width="80"
                    Height="80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Icon, Mode=OneWay}"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.8" ScaleY="0.8" />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                FontSize="18"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <ProgressBar
                Grid.Row="2"
                Height="4"
                MinHeight="4"
                Margin="0,0,0,16"
                IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                Value="{Binding ProgressValue, Mode=OneWay}" />

            <Button
                Grid.Row="3"
                Width="120"
                Padding="4"
                HorizontalAlignment="Center"
                Command="{Binding CancelInstallCommand}"
                Content="{x:Static resources:Strings.Common_Cancel}"
                FontSize="14"
                IsEnabled="{Binding CancelEnabled, Mode=OneWay}" />
        </Grid>
    </Grid>
</base:WpfUiWindow>
