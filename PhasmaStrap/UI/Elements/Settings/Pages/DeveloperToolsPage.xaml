<ui:UiPage x:Class="PhasmaStrap.UI.Elements.Settings.Pages.DeveloperToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:PhasmaStrap.Resources"
      xmlns:controls="clr-namespace:PhasmaStrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:PhasmaStrap.UI.ViewModels.Settings"
      xmlns:phui="clr-namespace:PhasmaStrap.UI"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:DeveloperToolsViewModel, IsDesignTimeCreatable=False}"
      Title="DeveloperToolsPage"
      Scrollable="False"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <ui:UiPage.Resources>
        <Style x:Key="ToolTabItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontFamily" Value="{DynamicResource PhasmaHeadingFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PhasmaFocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Height="44" Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource PhasmaAccentBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolHeading" TargetType="TextBlock" BasedOn="{StaticResource PhasmaHeading}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ToolDescription" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="ToolHeaderBar" TargetType="Border">
            <Setter Property="Padding" Value="20,16,20,16" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhasmaStrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="ColumnLabel" TargetType="TextBlock" BasedOn="{StaticResource PhasmaCaption}" />
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Developer tools" Subtitle="FastFlag snapshots, the local proxy's traffic, the newest logs and a Studio plugin installer." />

        <Border Grid.Row="1" Margin="0,-8,0,20" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1">
            <ListBox x:Name="ToolRail" HorizontalAlignment="Left"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Tools, Mode=OneTime}"
                     SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ToolTabItemStyle}"
                     SelectionChanged="ToolRail_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Converter={StaticResource PhasmaUpper}}" ToolTip="{Binding Label}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,4,0">

                    <Border VerticalAlignment="Top" Style="{DynamicResource PhasmaPanel}" Visibility="{Binding SnapshotsVisibility, Mode=OneWay}">
                        <StackPanel>
                            <Border Style="{StaticResource ToolHeaderBar}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ToolHeading}" Text="{x:Static resources:Strings.Menu_DeveloperTools_FastFlagSnapshots}" />
                                    <TextBlock Style="{StaticResource ToolDescription}" Text="Save your current flag set, put a saved one back, or compare any two." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ToolHeaderBar}" Padding="20,14,20,14">
                                <WrapPanel>
                                    <ui:TextBox Width="420" VerticalAlignment="Center" PlaceholderText="{x:Static resources:Strings.Menu_DeveloperTools_SnapshotName}" Text="{Binding NewSnapshotName, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Margin="16,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding SaveSnapshotCommand, Mode=OneTime}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{x:Static resources:Strings.Menu_DeveloperTools_SaveCurrentAsSnapshot}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SnapshotStatus, Mode=OneWay}" />
                                </WrapPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="7*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,1,0">
                                    <StackPanel>
                                        <TextBlock Margin="16,16,16,8" Style="{StaticResource ColumnLabel}" Text="SAVED" />
                                        <TextBlock Margin="16,12" HorizontalAlignment="Center" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="No snapshots yet. Name one above and save it.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Snapshots.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Snapshots, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,10,16,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                                <TextBlock FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                                    <Run Text="{Binding FlagCount, Mode=OneWay}" /><Run Text="{x:Static resources:Strings.Menu_DeveloperTools_FlagSSaved}" /><Run Text="{Binding CreatedDisplay, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource PhasmaSoftButton}" Padding="10,4" FontSize="12.5" FontWeight="SemiBold" Content="{x:Static resources:Strings.Dialog_GoogleFonts_Apply}"
                                                                    Command="{Binding DataContext.ApplySnapshotCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Grid.Column="2" Margin="6,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Common_Delete}"
                                                                    Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}"
                                                                    CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,16,20,16">
                                    <TextBlock Margin="0,0,0,10" Style="{StaticResource ColumnLabel}" Text="{x:Static resources:Strings.Menu_DeveloperTools_CompareTwoSnapshots}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Padding="10,5,10,5" ItemsSource="{Binding Snapshots, Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSnapshotA, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_DeveloperTools_Vs}" VerticalAlignment="Center" Margin="12,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ComboBox Grid.Column="2" Padding="10,5,10,5" ItemsSource="{Binding Snapshots, Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSnapshotB, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,12,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip="Making one live writes it to your flags. Roblox reads flags when it starts, so restart it to play on the other set.">
                                            <Button Style="{DynamicResource PhasmaSoftButton}" Padding="10,4" FontSize="12.5" FontWeight="SemiBold" Content="Make A live" Command="{Binding ApplyACommand}" />
                                            <Button Margin="8,0,0,0" Style="{DynamicResource PhasmaSoftButton}" Padding="10,4" FontSize="12.5" FontWeight="SemiBold" Content="Make B live" Command="{Binding ApplyBCommand}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DiffSummary, Mode=OneWay}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding DiffEntries, Mode=OneWay}"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300" CanContentScroll="True" controls:ScrollBubbling.Enabled="True">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Margin="0,0,16,0" MinWidth="80" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource PhasmaTagNeutral}">
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ChangeType}" Value="Added">
                                                                            <Setter Property="Background" Value="#1F3DDC97" />
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PhasmaGoodBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ChangeType}" Value="Removed">
                                                                            <Setter Property="Background" Value="{DynamicResource PhasmaAccentSoftBrush}" />
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PhasmaRedTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10.5" Text="{Binding ChangeType, Converter={StaticResource PhasmaUpper}}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" FontFamily="{DynamicResource PhasmaMono}" Foreground="White" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" FontFamily="{DynamicResource PhasmaMono}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{Binding OldValue, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding NewValue, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
                                <Button HorizontalAlignment="Left" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding CompareWithDefaultsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Compare with Roblox's defaults" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top" Style="{DynamicResource PhasmaPanel}" Visibility="{Binding ProxyVisibility, Mode=OneWay}">
                        <StackPanel>
                            <Border Style="{StaticResource ToolHeaderBar}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource ToolHeading}" Text="{x:Static resources:Strings.Menu_DeveloperTools_LiveProxyTraffic}" />
                                        <TextBlock Style="{StaticResource ToolDescription}" Text="Requests handled by the local proxy in this window. Launched Roblox sessions run their own proxy and do not show up here." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding RefreshProxyTrafficCommand, Mode=OneTime}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="10,0,0,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding ClearProxyTrafficCommand, Mode=OneTime}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{x:Static resources:Strings.ContextMenu_OutputConsole_Clear}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ToolHeaderBar}" Padding="20,12,20,12">
                                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ProxyStatus, Mode=OneWay}" />
                            </Border>

                            <Grid Margin="16,12,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource ColumnLabel}" Text="TIME" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnLabel}" Text="REQUEST" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ColumnLabel}" Text="OUTCOME" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ProxyTraffic, Mode=OneWay}"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460" CanContentScroll="True" controls:ScrollBubbling.Enabled="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,11,16,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" FontFamily="{DynamicResource PhasmaMono}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12.5" FontFamily="{DynamicResource PhasmaMono}" Foreground="White" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                                                <Border Grid.Column="2" Style="{DynamicResource PhasmaTagNeutral}">
                                                    <TextBlock FontSize="10.5" Text="{Binding OutcomeDisplay, Converter={StaticResource PhasmaUpper}}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top" Style="{DynamicResource PhasmaPanel}" Visibility="{Binding LogsVisibility, Mode=OneWay}">
                        <StackPanel>
                            <Border Style="{StaticResource ToolHeaderBar}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource ToolHeading}" Text="{x:Static resources:Strings.Menu_DeveloperTools_LogViewer}" />
                                        <TextBlock Style="{StaticResource ToolDescription}" Text="{Binding LogSubtitle, Mode=OneWay}" ToolTip="{Binding LogDescription, Mode=OneTime}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding CopyLogsCommand, Mode=OneTime}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{x:Static resources:Strings.Common_Copy}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="10,0,0,0" Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding BundleDiagnosticsCommand, Mode=OneTime}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="FolderZip24" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="Bundle for a bug report" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="10,0,0,0" Style="{DynamicResource PhasmaIconButton}" ToolTip="{x:Static resources:Strings.Dialog_ChannelLists_Refresh}" Command="{Binding RefreshLogsCommand, Mode=OneTime}">
                                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ToolHeaderBar}" Padding="20,12,20,12">
                                <WrapPanel>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LogStatus, Mode=OneWay}" />
                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaRedTextBrush}" Text="{Binding LogErrorCountText, Mode=OneWay}" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource PhasmaMono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PhasmaWarnBrush}" Text="{Binding LogWarningCountText, Mode=OneWay}" />
                                </WrapPanel>
                            </Border>

                            <Grid Margin="16,12,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource ColumnLabel}" Text="TIME" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnLabel}" Text="SOURCE" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ColumnLabel}" Text="MESSAGE" />
                            </Grid>

                            <ItemsControl Margin="0,0,0,6" ItemsSource="{Binding LogRows, Mode=OneWay}" Focusable="False"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="520" CanContentScroll="True" controls:ScrollBubbling.Enabled="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dmodels:LogRow}">
                                        <Border BorderBrush="{DynamicResource PhasmaStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,6,16,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Time, Mode=OneTime}" />
                                                <TextBlock Grid.Column="1" Margin="0,0,10,0" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{Binding SourceBrush, Mode=OneTime}" Text="{Binding Source, Mode=OneTime}" ToolTip="{Binding Source, Mode=OneTime}" />
                                                <TextBlock Grid.Column="2" FontFamily="{DynamicResource PhasmaMono}" FontSize="12.5" TextWrapping="NoWrap" Text="{Binding Message, Mode=OneTime}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PhasmaRedTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PhasmaWarnBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="Header">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top" Style="{DynamicResource PhasmaPanel}" Visibility="{Binding PluginsVisibility, Mode=OneWay}">
                        <StackPanel>
                            <Border Style="{StaticResource ToolHeaderBar}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ToolHeading}" Text="{x:Static resources:Strings.Menu_DeveloperTools_StudioPluginInstaller}" />
                                    <TextBlock Style="{StaticResource ToolDescription}" Text="{x:Static resources:Strings.Menu_DeveloperTools_InstallAnyStudioPluginByIts}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="20,14,20,18">
                                <WrapPanel>
                                    <ui:TextBox Width="260" Margin="0,0,16,0" Icon="Box24" PlaceholderText="{x:Static resources:Strings.Menu_DeveloperTools_AssetID}" Text="{Binding PluginAssetId, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Margin="0,0,10,0" Style="{DynamicResource PhasmaAccentButton}" Command="{Binding InstallPluginCommand, Mode=OneTime}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{x:Static resources:Strings.Installer_Install_Title}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource PhasmaGhostButton}" FontWeight="SemiBold" Command="{Binding OpenPluginsFolderCommand, Mode=OneTime}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{x:Static resources:Strings.Menu_DeveloperTools_OpenPluginsFolder}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PluginInstallStatus, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</ui:UiPage>
